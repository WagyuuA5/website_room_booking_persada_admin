@inject NavigationManager Navigation

<div class="sidebar-header">
    <img src="icon/logoo_psd-removebg-preview 2.svg" alt="PERSADA" class="sidebar-logo" title="Klik dua kali untuk ciutkan/perluas" />
</div>

<div class="sidebar-nav-container">
    @if (!IsCollapsed)
    {
        <div class="sidebar-section-title">Menu Utama</div>
    }

    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All" title="Dashboard">
                <img src="icon/icon_5_admin.svg" alt="Dashboard" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Dashboard</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="booking-management" Match="NavLinkMatch.All" title="Manajemen Booking">
                <img src="icon/calendar.svg" alt="Booking" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Manajemen Booking</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="rooms" Match="NavLinkMatch.All" title="Ruangan">
                <img src="icon/icon_1_admin.svg" alt="Ruangan" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Ruangan</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="rooms/status" Match="NavLinkMatch.All" title="Status">
                <img src="icon/icon_12_admin.svg" alt="Status" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Status</span>
                }
            </NavLink>
        </div>
    </nav>

    @if (!IsCollapsed)
    {
        <div class="sidebar-section-title">Administrasi</div>
    }

    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="users" Match="NavLinkMatch.All" title="Manajemen User">
                <img src="icon/icon_13_admin.svg" alt="Users" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Manajemen User</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="reports" Match="NavLinkMatch.All" title="Laporan Sistem">
                <img src="icon/icon_15_admin.svg" alt="Reports" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Laporan Sistem</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="audit-log" Match="NavLinkMatch.All" title="Audit Log">
                <img src="icon/icon_16_admin.svg" alt="Audit Log" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Audit Log</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="facility-requests" Match="NavLinkMatch.All" title="Permintaan Fasilitas">
                <img src="icon/coffee.svg" alt="Facility" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Permintaan Fasilitas</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="room-calendar" Match="NavLinkMatch.All" title="Kalender Ruangan">
                <img src="icon/icon_6_admin.svg" alt="Calendar" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Kalender Ruangan</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="settings" Match="NavLinkMatch.All" title="Pengaturan">
                <img src="icon/icon_18_admin.svg" alt="Settings" class="nav-icon" />
                @if (!IsCollapsed)
                {
                    <span>Pengaturan</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

<div class="sidebar-footer">
    <div class="nav-item">
        <a class="nav-link footer-link logout-link" href="#" @onclick="HandleLogout" @onclick:preventDefault title="Keluar">
            <img src="icon/icon_14_admin.svg" alt="Logout" class="nav-icon logout-icon" />
            @if (!IsCollapsed)
            {
                <span>Keluar</span>
            }
        </a>
    </div>
</div>

@code {
    [Parameter] public bool IsCollapsed { get; set; }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/", replace: true);
    }
}
