@inherits LayoutComponentBase
@inject booking_room_admin.Components.Services.LayoutStateService LayoutState
@using booking_room_admin.Components.Shared
@implements IDisposable

<div class="admin-layout @(LayoutState.IsSidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="admin-sidebar">
        <NavMenu IsCollapsed="@LayoutState.IsSidebarCollapsed" />
    </aside>

    <div class="admin-main">
        <article class="admin-content">
            @Body
        </article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan tak terduga.
    <a href="." class="reload">Muat Ulang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        LayoutState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }
}