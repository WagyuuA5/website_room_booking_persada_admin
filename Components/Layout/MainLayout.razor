@inherits LayoutComponentBase
@inject booking_room_admin.Components.Services.LayoutStateService LayoutState
@inject IJSRuntime JSRuntime
@using booking_room_admin.Components.Shared
@implements IDisposable

<div class="admin-layout @(LayoutState.IsSidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="admin-sidebar scroll-area">
        <button type="button" class="sr-only" @onclick="LayoutState.ToggleSidebar">Toggle Navigasi Sidebar</button>
        <NavMenu IsCollapsed="@LayoutState.IsSidebarCollapsed" />
        <div class="sidebar-drag-handle" title="Tarik atau klik dua kali untuk mengecilkan/membesarkan sidebar"></div>
    </aside>

    <div class="admin-main">
        <article class="admin-content">
            @Body
        </article>
    </div>

    <Toast />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan tak terduga.
    <a href="." class="reload">Muat Ulang</a>
    <span class="dismiss">?</span>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += StateHasChanged;
        await LayoutState.InitStateAsync();
        try
        {
            await JSRuntime.InvokeVoidAsync("applyThemeMode", LayoutState.IsDarkMode);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("applyThemeMode", LayoutState.IsDarkMode);
            }
            catch { }

            _objRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("initSidebarDrag", _objRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void ToggleSidebarFromJs()
    {
        LayoutState.ToggleSidebar();
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
        _objRef?.Dispose();
    }
}
