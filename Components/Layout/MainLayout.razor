@inherits LayoutComponentBase
@inject booking_room_admin.Components.Services.LayoutStateService LayoutState
@inject booking_room_admin.Components.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using booking_room_admin.Components.Shared
@implements IDisposable

<div class="admin-layout @(LayoutState.IsSidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="admin-sidebar scroll-area">
        <button type="button" class="sr-only" @onclick="LayoutState.ToggleSidebar">Toggle Navigasi Sidebar</button>
        <NavMenu IsCollapsed="@LayoutState.IsSidebarCollapsed" />
        <div class="sidebar-drag-handle" title="Tarik atau klik dua kali untuk mengecilkan/membesarkan sidebar"></div>
    </aside>

    <div class="admin-main">
        <article class="admin-content">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-fallback" style="padding: 2rem; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 12px; margin: 1.5rem; color: #991B1B;">
                        <h3 style="font-weight: 600; margin-bottom: 0.5rem;">Terjadi kesalahan saat menampilkan halaman ini.</h3>
                        <p style="font-size: 0.88rem; color: #B91C1C; margin-bottom: 1rem;">@ex.Message</p>
                        <button type="button" class="btn-primary-pill btn-danger" onclick="location.reload()" style="padding: 0.4rem 1rem; font-size: 0.82rem;">
                            Muat Ulang Halaman
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </div>

    <Toast />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan tak terduga.
    <a href="." class="reload">Muat Ulang</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        LayoutState.OnChange += StateHasChanged;
        await LayoutState.InitStateAsync();
        try
        {
            await JSRuntime.InvokeVoidAsync("applyThemeMode", LayoutState.IsDarkMode);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("applyThemeMode", LayoutState.IsDarkMode);
            }
            catch { }

            _objRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("initSidebarDrag", _objRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void ToggleSidebarFromJs()
    {
        LayoutState.ToggleSidebar();
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
        _objRef?.Dispose();
    }
}
