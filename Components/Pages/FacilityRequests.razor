@page "/facility-requests"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services


<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Permintaan Fasilitas" PageSubtitle="Tinjau dan proses permintaan tambahan fasilitas." ShowGlobalSearch="true" ShowGlobalDate="true" />
<div class="facility-requests">
    <div class="fr-toolbar">
        <div class="fr-tabs">
            @foreach (var tab in statusTabs)
            {
                <button class="fr-tab @(selectedTab == tab.Key ? "active" : "")" @onclick="() => SelectTab(tab.Key)">
                    <span>@tab.Label</span>
                    <span class="fr-tab-badge">@GetTabCount(tab.Key)</span>
                </button>
            }
        </div>
        <div class="fr-actions">
            <select class="fr-dept-filter" @bind="selectedDepartment">
                <option value="">Semua Departemen</option>
                <option value="IT Dept">IT Dept</option>
                <option value="HR Dept">HR Dept</option>
                <option value="Marketing">Marketing</option>
                <option value="Finance">Finance</option>
                <option value="Operations">Operations</option>
            </select>
            <button class="btn-export" @onclick="@(() => showFrExport = true)">
                <img src="icon/icon_17_admin.svg" alt="Export" class="export-icon-white" />
                <span>Export</span>
            </button>
        </div>
    </div>

    <div class="fr-list">
        @if (!filteredRequests.Any())
        {
            <div class="fr-empty">
                <span class="fr-empty-icon">??</span>
                <span class="fr-empty-text">Tidak ada permintaan untuk filter ini.</span>
            </div>
        }
        else
        {
            @foreach (var req in filteredRequests)
            {
                <ActionCard
                    BorderColor="@GetBorderColor(req)"
                    IconBgColor="@GetIconBg(req)"
                    IconContent="@(b => b.AddMarkupContent(0, GetIconSvg(req)))"
                    Title="@req.Title"
                    ReferenceId="@req.RequestId"
                    Subtitle="@($"{req.RoomName} • {req.BookingDate:dd MMM yyyy} • {req.Category}")"
                    SubtitleColor="@GetSubtitleColor(req)"
                    ActionLabel="@GetActionLabel(req)"
                    OnActionClick="() => OpenDetail(req)" />
            }
        }
    </div>
</div>

<ExportModal IsOpen="@showFrExport" IsOpenChanged="@(v => { showFrExport = v; StateHasChanged(); })"
             ExportTitle="Permintaan Fasilitas" Columns="@_frColumns"
             CurrentViewRows="@(filteredRequests.ToList().Cast<object>())" AllRows="@(allRequests.Cast<object>())" />

@* Detail Popup *@
@if (showDetail && selectedRequest != null)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) CloseDetail(); })" Title="@($"{selectedRequest.Title} #{selectedRequest.RequestId}")" Size="large">
        <ChildContent>
            <div class="detail-content">
                <div class="detail-row">
                    <div class="detail-badge">
                        <StatusBadge Status="@selectedRequest.Status" />
                    </div>
                </div>

                <div class="detail-section">
                    <h5 class="detail-section-title">Informasi Pemohon</h5>
                    <div class="detail-requester">
                        <div class="detail-avatar">@selectedRequest.RequesterInitials</div>
                        <div>
                            <div class="detail-name">@selectedRequest.RequesterName</div>
                            <div class="detail-meta">@selectedRequest.RequesterRole • @selectedRequest.RequesterEmail</div>
                        </div>
                    </div>
                </div>

                <div class="detail-section">
                    <h5 class="detail-section-title">Ruangan & Jadwal</h5>
                    <p class="detail-text">@selectedRequest.RoomName — @selectedRequest.BookingDate.ToString("dd MMMM yyyy")</p>
                </div>

                <div class="detail-section">
                    <h5 class="detail-section-title">Item yang Diminta</h5>
                    <div class="detail-items">
                        @foreach (var item in selectedRequest.Items)
                        {
                            <div class="detail-item">
                                <span class="item-icon">@((MarkupString)item.Icon)</span>
                                <span class="item-name">@item.Category — @item.Name x@item.Quantity</span>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(selectedRequest.RequesterNote))
                {
                    <div class="detail-section">
                        <h5 class="detail-section-title">Catatan Pemohon</h5>
                        <div class="detail-note">@selectedRequest.RequesterNote</div>
                    </div>
                }

                <div class="detail-section">
                    <h5 class="detail-section-title">Tugaskan Ke</h5>
                    <select class="form-control-sm" @bind="assignTo">
                        <option value="">Pilih Tim/Staff...</option>
                        <option value="Tim Katering">Tim Katering</option>
                        <option value="Tim AV">Tim Audio Visual</option>
                        <option value="Tim Furnitur">Tim Furnitur</option>
                        <option value="General Affairs">General Affairs</option>
                    </select>
                </div>

                <div class="detail-section">
                    <h5 class="detail-section-title">Catatan Internal</h5>
                    <textarea class="form-control-sm" rows="3" placeholder="Catatan internal (tidak terlihat pemohon)..." @bind="internalNotes"></textarea>
                </div>

                <div class="detail-section">
                    <h5 class="detail-section-title">Riwayat Aktivitas</h5>
                    <div class="activity-log">
                        @foreach (var log in selectedRequest.ActivityLog.OrderByDescending(l => l.Timestamp))
                        {
                            <div class="activity-entry">
                                <span class="activity-time">@log.Timestamp.ToString("HH:mm")</span>
                                <span class="activity-action">@log.Action</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button class="btn-outline-pill" @onclick="() => RejectRequest(selectedRequest)">Tolak</button>
            <button class="btn-primary-pill" @onclick="() => AssignRequest(selectedRequest)">Tugaskan & Proses</button>
        </FooterContent>
    </AppModal>
}

@code {
    private string selectedTab = "all";
    private string selectedDepartment = "";
    private bool showDetail = false;
    private FacilityRequest? selectedRequest;
    private string assignTo = "";
    private string internalNotes = "";

    private List<(string Key, string Label)> statusTabs = new()
    {
        ("all", "Semua"),
        ("pending", "Menunggu"),
        ("preparing", "Diproses"),
        ("ready", "Siap"),
        ("fulfilled", "Selesai"),
    };

    private List<FacilityRequest> allRequests = new();

    private IEnumerable<FacilityRequest> filteredRequests
    {
        get
        {
            var query = allRequests.AsEnumerable();
            if (selectedTab != "all")
                query = query.Where(r => r.Status == selectedTab);
            if (!string.IsNullOrEmpty(selectedDepartment))
                query = query.Where(r => r.RequesterDepartment == selectedDepartment);
            return query.OrderByDescending(r => r.CreatedAt);
        }
    }

    protected override void OnInitialized()
    {

        allRequests = new()
        {
            new() { Id = 1, RequestId = "FAC-2241", Title = "Permintaan Katering Rapat Direksi", Category = "Katering", RequesterName = "Rina Kartika", RequesterInitials = "RK", RequesterRole = "Staff IT", RequesterEmail = "rina@persada.co.id", RequesterDepartment = "IT Dept", RoomName = "Ruang Rapat Utama", BookingDate = DateTime.Now.AddDays(2), Status = "pending", RequesterNote = "Mohon disediakan makan siang untuk 32 orang, termasuk 4 vegetarian.", Items = new() { new() { Name = "Executive Lunch", Quantity = 32, Category = "Katering", Icon = SvgKatering }, new() { Name = "Extra Chairs", Quantity = 2, Category = "Furnitur", Icon = SvgFurnitur } }, ActivityLog = new() { new() { Timestamp = DateTime.Now.AddHours(-2), Action = "Permintaan Dibuat" }, new() { Timestamp = DateTime.Now.AddHours(-1), Action = "Menunggu Penugasan" } } },
            new() { Id = 2, RequestId = "FAC-2238", Title = "Peralatan Audio Visual Meeting", Category = "Audio Visual", RequesterName = "Dimas Prasetyo", RequesterInitials = "DP", RequesterRole = "Engineer", RequesterEmail = "dimas@persada.co.id", RequesterDepartment = "IT Dept", RoomName = "Ruang Rapat A", BookingDate = DateTime.Now.AddDays(1), Status = "pending", Items = new() { new() { Name = "Proyektor 4K", Quantity = 1, Category = "AV", Icon = SvgAv }, new() { Name = "Wireless Mic", Quantity = 2, Category = "AV", Icon = "??" } }, ActivityLog = new() { new() { Timestamp = DateTime.Now.AddHours(-5), Action = "Permintaan Dibuat" } } },
            new() { Id = 3, RequestId = "FAC-2235", Title = "Pengaturan Furnitur Workshop", Category = "Furnitur", RequesterName = "Maya Putri", RequesterInitials = "MP", RequesterRole = "Marketing Lead", RequesterEmail = "maya@persada.co.id", RequesterDepartment = "Marketing", RoomName = "Ruang Diskusi", BookingDate = DateTime.Now.AddDays(3), Status = "preparing", AssignedTo = "Tim Furnitur", Items = new() { new() { Name = "Meja Lipat", Quantity = 5, Category = "Furnitur", Icon = SvgFurnitur } }, ActivityLog = new() { new() { Timestamp = DateTime.Now.AddDays(-1), Action = "Permintaan Dibuat" }, new() { Timestamp = DateTime.Now.AddHours(-6), Action = "Ditugaskan ke Tim Furnitur" } } },
            new() { Id = 4, RequestId = "FAC-2230", Title = "Katering Rapat Bulanan", Category = "Katering", RequesterName = "Ahmad Fauzi", RequesterInitials = "AF", RequesterRole = "Manager", RequesterEmail = "ahmad@persada.co.id", RequesterDepartment = "Finance", RoomName = "Ruang Rapat B", BookingDate = DateTime.Now, Status = "ready", AssignedTo = "Tim Katering", Items = new() { new() { Name = "Snack Box", Quantity = 15, Category = "Katering", Icon = "??" } }, ActivityLog = new() { new() { Timestamp = DateTime.Now.AddDays(-2), Action = "Permintaan Dibuat" }, new() { Timestamp = DateTime.Now.AddDays(-1), Action = "Ditugaskan ke Tim Katering" }, new() { Timestamp = DateTime.Now.AddHours(-3), Action = "Persiapan Selesai — Siap Diantar" } } },
            new() { Id = 5, RequestId = "FAC-2225", Title = "Setup Video Conference", Category = "Audio Visual", RequesterName = "Budi Santoso", RequesterInitials = "BS", RequesterRole = "HR Manager", RequesterEmail = "budi@persada.co.id", RequesterDepartment = "HR Dept", RoomName = "Ruang Rapat Utama", BookingDate = DateTime.Now.AddDays(-1), Status = "fulfilled", AssignedTo = "Tim AV", Items = new() { new() { Name = "Webcam 4K", Quantity = 1, Category = "AV", Icon = "??" }, new() { Name = "Speaker", Quantity = 2, Category = "AV", Icon = "??" } }, ActivityLog = new() { new() { Timestamp = DateTime.Now.AddDays(-3), Action = "Permintaan Dibuat" }, new() { Timestamp = DateTime.Now.AddDays(-2), Action = "Ditugaskan ke Tim AV" }, new() { Timestamp = DateTime.Now.AddDays(-1), Action = "Selesai" } } },
        };
    }

    private int GetTabCount(string tab) => tab == "all" ? allRequests.Count : allRequests.Count(r => r.Status == tab);

    private string GetBorderColor(FacilityRequest req) => req.Status switch
    {
        "pending" => "#F59E0B",
        "preparing" => "#2563EB",
        "ready" => "#10B981",
        "fulfilled" => "#6B7280",
        _ => "#F59E0B"
    };

    private string GetIconBg(FacilityRequest req) => req.Category switch
    {
        "Katering" => "#FEF3C7",
        "Audio Visual" => "#DBEAFE",
        "Furnitur" => "#E0E7FF",
        _ => "#F3F4F6"
    };

        private const string SvgKatering = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"cat-svg\"><path d=\"M17 8h1a4 4 0 1 1 0 8h-1\"/><path d=\"M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z\"/><line x1=\"6\" y1=\"2\" x2=\"6\" y2=\"4\"/><line x1=\"10\" y1=\"2\" x2=\"10\" y2=\"4\"/><line x1=\"14\" y1=\"2\" x2=\"14\" y2=\"4\"/></svg>";
    private const string SvgAv = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"cat-svg\"><polygon points=\"23 7 16 12 23 17 23 7\"/><rect x=\"1\" y=\"5\" width=\"15\" height=\"14\" rx=\"2\" ry=\"2\"/></svg>";
    private const string SvgFurnitur = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"cat-svg\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg>";
    private const string SvgDefault = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"cat-svg\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>";

    private string GetIconSvg(FacilityRequest req) => req.Category switch
    {
        "Katering" => SvgKatering,
        "Audio Visual" => SvgAv,
        "Furnitur" => SvgFurnitur,
        _ => SvgDefault
    };

    private string GetSubtitleColor(FacilityRequest req) => req.Status switch
    {
        "pending" => "#92400E",
        "preparing" => "#1E40AF",
        _ => "#6B7280"
    };

    private string GetActionLabel(FacilityRequest req) => req.Status switch
    {
        "pending" => "Proses",
        "preparing" => "Update",
        "ready" => "Selesaikan",
        _ => "Lihat"
    };

    private void SelectTab(string tab) { selectedTab = tab; }

    private void OpenDetail(FacilityRequest req)
    {
        selectedRequest = req;
        assignTo = req.AssignedTo ?? "";
        internalNotes = req.InternalNotes ?? "";
        showDetail = true;
    }

    private void CloseDetail() { showDetail = false; selectedRequest = null; }

    private void AssignRequest(FacilityRequest req)
    {
        req.AssignedTo = assignTo;
        req.InternalNotes = internalNotes;
        req.Status = req.Status == "pending" ? "preparing" : req.Status == "preparing" ? "ready" : "fulfilled";
        req.ActivityLog.Add(new() { Timestamp = DateTime.Now, Action = $"Status diubah ke {req.Status} oleh Admin", Actor = "Admin Wahyu" });
        CloseDetail();
    }

    private void RejectRequest(FacilityRequest req)
    {
        req.Status = "rejected";
        req.ActivityLog.Add(new() { Timestamp = DateTime.Now, Action = "Permintaan Ditolak", Actor = "Admin Wahyu" });
        CloseDetail();
    }

    private bool showFrExport;
    private List<ExportColumn> _frColumns = new()
    {
        new() { Header = "ID", PropertyName = "RequestId", CellType = ExportCellType.Text },
        new() { Header = "Judul", PropertyName = "Title", CellType = ExportCellType.Text },
        new() { Header = "Kategori", PropertyName = "Category", CellType = ExportCellType.Text },
        new() { Header = "Pemohon", PropertyName = "RequesterName", CellType = ExportCellType.Text },
        new() { Header = "Departemen", PropertyName = "RequesterDepartment", CellType = ExportCellType.Text },
        new() { Header = "Ruangan", PropertyName = "RoomName", CellType = ExportCellType.Text },
        new() { Header = "Tanggal", PropertyName = "BookingDate", CellType = ExportCellType.Date },
        new() { Header = "Status", PropertyName = "Status", CellType = ExportCellType.Text },
    };
}






