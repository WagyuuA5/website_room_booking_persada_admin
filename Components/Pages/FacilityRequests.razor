                RequesterInitials = "SR",
                RequesterEmail = "siti.rahma@company.com",
                Department = "Human Resources",
                AvatarBg = "#9333EA",
                IsUrgent = false,
                Status = "fulfilled",
                ItemsSummary = "Katering - Kopi Premium & Pastry (8 pax)",
                RequesterNote = "Interview Direksi.",
                Assignee = "Catering Service PIC",
                Items = new List<RequestItemDetail>
                {
                    new() { Category = "Katering", Description = "Mesin Kopi Arabika + Keranjang Croissant" }
                },
                ActivityLogs = new List<RequestActivityLog>
                {
                    new() { Title = "Permintaan Dibuat", Timestamp = DateTime.Now.AddHours(-5) },
                    new() { Title = "Diantar ke Ruangan", Timestamp = DateTime.Now.AddHours(-3) },
                    new() { Title = "Ditandai Selesai", Timestamp = DateTime.Now.AddHours(-2) }
                }
            }
        };
    }

    private IEnumerable<FacilityRequestItem> FilteredRequests
    {
        get
        {
            var q = allRequests.AsEnumerable();
            if (selectedTab != "all") q = q.Where(r => r.Status.Equals(selectedTab, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(selectedDept)) q = q.Where(r => r.Department.Equals(selectedDept, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.ToLowerInvariant();
                q = q.Where(r => r.Title.ToLowerInvariant().Contains(query) ||
                                 r.RequesterName.ToLowerInvariant().Contains(query) ||
                                 r.RoomName.ToLowerInvariant().Contains(query) ||
                                 r.RequestId.ToLowerInvariant().Contains(query));
            }
            return q;
        }
    }

    private int currentPage = 1;
    private int pageSize = 5;

    private IEnumerable<FacilityRequestItem> PagedRequests =>
        FilteredRequests.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void HandlePageChanged(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private int GetCount(string status) => allRequests.Count(r => r.Status.Equals(status, StringComparison.OrdinalIgnoreCase));

    private void SelectTab(string tab)
    {
        selectedTab = tab;
        currentPage = 1;
    }

    private void ResetFilters()
    {
        searchQuery = "";
        selectedTab = "all";
        selectedDept = "";
    }

    private void OpenDetail(FacilityRequestItem req)
    {
        selectedRequest = req;
        showDetailModal = true;
    }

    private void ProcessRequest()
    {
        if (selectedRequest != null)
        {
            selectedRequest.Status = selectedRequest.Status == "pending" ? "preparing" : "ready";
            selectedRequest.ActivityLogs.Add(new RequestActivityLog
            {
                Title = $"Status diperbarui menjadi {selectedRequest.Status.ToUpper()} oleh Admin",
                Timestamp = DateTime.Now
            });
            Toast.Success($"Permintaan #{selectedRequest.RequestId} berhasil diproses.");
            showDetailModal = false;
        }
    }

    private void RejectRequest()
    {
        if (selectedRequest != null)
        {
            selectedRequest.Status = "rejected";
            selectedRequest.ActivityLogs.Add(new RequestActivityLog
            {
                Title = "Permintaan Ditolak oleh Admin",
                Timestamp = DateTime.Now
            });
            Toast.Error($"Permintaan #{selectedRequest.RequestId} telah ditolak.");
            showDetailModal = false;
        }
    }
}


