@page "/facility-requests"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast

<TopBar Title="Permintaan Fasilitas" Subtitle="Kelola permintaan catering, AV, dan tata ruang yang masuk." />

<div class="facility-requests-page">
    @* -- Baris Aksi: Search + Ekspor -- *@
    <div class="action-row">
        <div class="page-search-bar" style="max-width: 400px;">
            <Icon Name="search" Size="15" CssClass="search-icon" />
            <input type="text" placeholder="Cari fasilitas, permintaan, atau pengguna..." @bind="searchQuery" @bind:event="oninput" />
        </div>
        <DateFilter OnDateSelectedCallback="HandleDateChanged" />
        <button type="button" class="btn-outline-pill" @onclick="@(() => showExportModal = true)">
            <Icon Name="download" Size="14" />
            <span>Ekspor</span>
        </button>
    </div>

    @* -- Status Filter Pills & Dept Dropdown -- *@
    <div class="fr-toolbar-row">
        <div class="fr-status-pills">
            <button type="button" class="fr-pill @(selectedTab == "all" ? "active" : "")" @onclick='() => SelectTab("all")'>
                <span>Semua</span>
                <span class="fr-pill-count count-all">@allRequests.Count</span>
            </button>
            <button type="button" class="fr-pill @(selectedTab == "pending" ? "active" : "")" @onclick='() => SelectTab("pending")'>
                <span>Menunggu</span>
                <span class="fr-pill-count count-pending">@GetCount("pending")</span>
            </button>
            <button type="button" class="fr-pill @(selectedTab == "preparing" ? "active" : "")" @onclick='() => SelectTab("preparing")'>
                <span>Diproses</span>
                <span class="fr-pill-count count-preparing">@GetCount("preparing")</span>
            </button>
            <button type="button" class="fr-pill @(selectedTab == "ready" ? "active" : "")" @onclick='() => SelectTab("ready")'>
                <span>Siap</span>
                <span class="fr-pill-count count-ready">@GetCount("ready")</span>
            </button>
            <button type="button" class="fr-pill @(selectedTab == "fulfilled" ? "active" : "")" @onclick='() => SelectTab("fulfilled")'>
                <span>Selesai</span>
                <span class="fr-pill-count count-fulfilled">@GetCount("fulfilled")</span>
            </button>
        </div>

        <div class="fr-dept-select-wrap">
            <select class="sr-pill-select" @bind="selectedDept">
                <option value="">Filter berdasarkan Departemen</option>
                <option value="IT & Digital">IT & Digital</option>
                <option value="Operasional">Operasional</option>
                <option value="Human Resources">Human Resources</option>
                <option value="Finance">Finance</option>
                <option value="Marketing">Marketing</option>
            </select>
        </div>
    </div>

    @* -- Request Card List -- *@
    <div class="fr-cards-list">
                @if (isLoading)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div class="fr-card" style="padding:1rem;">
                    <div style="display:flex; gap:1rem; width:100%;">
                        <SkeletonBlock Width="40px" Height="40px" CssClass="rounded-circle" />
                        <div style="flex:1; display:flex; flex-direction:column; gap:0.5rem;">
                            <SkeletonBlock Width="40%" Height="20px" />
                            <SkeletonBlock Width="60%" Height="16px" />
                            <SkeletonBlock Width="30%" Height="16px" />
                        </div>
                    </div>
                </div>
            }
        }
        else if (!FilteredRequests.Any())
        {
            <EmptyState Title="Tidak Ada Permintaan" Description="Tidak ada permintaan fasilitas yang cocok dengan filter atau kata kunci saat ini." ActionLabel="Reset Filter" OnAction="ResetFilters" />
        }
        else
        {
            @foreach (var req in PagedRequests)
            {
                <div class="fr-request-card @(req.IsUrgent ? "card-urgent" : "")" @onclick="() => OpenDetail(req)">
                    <div class="fr-card-left">
                        <div class="fr-avatar-col">
                            <div class="fr-avatar" style="background: @req.AvatarBg;">@req.RequesterInitials</div>
                        </div>
                        <div class="fr-main-col">
                            <div class="fr-card-top-row">
                                <h4 class="fr-card-title">@req.Title</h4>
                                @if (req.IsUrgent)
                                {
                                    <span class="badge-urgent-pill"><Icon Name="alert-triangle" Size="12" /> Mendesak</span>
                                }
                            </div>
                            <div class="fr-card-meta-row">
                                <span class="fr-meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="fr-meta-icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @req.RoomName
                                </span>
                                <span class="fr-meta-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="fr-meta-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @req.BookingDate.ToString("dd MMM yyyy, HH:mm")
                                </span>
                                <span class="fr-meta-item code-text">#@req.RequestId</span>
                                <span class="fr-meta-item user-info">@req.RequesterName (@req.Department)</span>
                            </div>
                            <div class="fr-card-items-summary">
                                <span><Icon Name="package" Size="14" /> @req.ItemsSummary</span>
                            </div>
                        </div>
                    </div>
                    <div class="fr-card-right" @onclick:stopPropagation="true">
                        <StatusBadge Status="@req.Status" />
                        <button type="button" class="btn-action-quick @(req.Status == "pending" ? "btn-process" : "btn-update")" @onclick="() => OpenDetail(req)">
                            @(req.Status == "pending" ? "Proses" : "Perbarui")
                        </button>
                    </div>
                </div>
            }

            <PaginationBar CurrentPage="@currentPage" CurrentPageChanged="HandlePageChanged" TotalData="@FilteredRequests.Count()" PageSize="@pageSize" />
        }
    </div>
</div>

@* -- Detail Popup Modal -- *@
@if (selectedRequest != null)
{
    <AppModal IsOpen="@showDetailModal" IsOpenChanged="@((bool v) => showDetailModal = v)" Size="large">
        <HeaderContent>
            <div class="fr-modal-header">
                <h3 class="fr-modal-title">@selectedRequest.Title</h3>
                <div class="fr-modal-badges">
                    <span class="badge-req-id">#@selectedRequest.RequestId</span>
                    <StatusBadge Status="@selectedRequest.Status" />
                    @if (selectedRequest.IsUrgent)
                    {
                        <span class="badge-urgent">MENDESAK</span>
                    }
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="fr-modal-body-grid">
                @* Requester Info Box *@
                <div class="fr-requester-box">
                    <div class="fr-req-avatar" style="background: @selectedRequest.AvatarBg;">@selectedRequest.RequesterInitials</div>
                    <div class="fr-req-info">
                        <strong class="fr-req-name">@selectedRequest.RequesterName</strong>
                        <span class="fr-req-role">@selectedRequest.Department - @selectedRequest.RequesterEmail</span>
                    </div>
                    <div class="fr-room-pin-badge">
                        <span><Icon Name="map-pin" Size="14" /> @selectedRequest.RoomName</span>
                    </div>
                    <div class="fr-date-badge">
                        <span><Icon Name="clock" Size="14" /> @selectedRequest.BookingDate.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                </div>

                @* Requested Items Section *@
                <div class="fr-section">
                    <h5 class="fr-section-title">Item Permintaan</h5>
                    <div class="fr-items-list">
                        @foreach (var item in selectedRequest.Items)
                        {
                            <div class="fr-item-row">
                                <div class="fr-item-icon"><Icon Name="package" Size="18" /></div>
                                <div class="fr-item-text">
                                    <strong>@item.Category</strong>
                                    <span>@item.Description</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Requester Note (Sticky Note Style) *@
                @if (!string.IsNullOrWhiteSpace(selectedRequest.RequesterNote))
                {
                    <div class="fr-note-box">
                        <div class="fr-note-header">
                            <span><Icon Name="file-text" Size="14" /> Catatan Pemohon</span>
                        </div>
                        <p class="fr-note-text">@selectedRequest.RequesterNote</p>
                    </div>
                }

                @* Action Fields: Assign To & Internal Notes *@
                <div class="fr-action-fields-grid">
                    <div class="fr-field">
                        <label class="fr-field-label">Tugaskan Ke (PIC)</label>
                        <select class="fr-modal-input" @bind="selectedRequest.Assignee">
                            <option value="">Pilih Tim / PIC</option>
                            <option value="Sarah Jenkins (General Affairs)">Sarah Jenkins (General Affairs)</option>
                            <option value="Rian Wahyu (IT Support)">Rian Wahyu (IT Support)</option>
                            <option value="Budi Santoso (Facility Team)">Budi Santoso (Facility Team)</option>
                            <option value="Catering Service PIC">Catering Service PIC</option>
                        </select>
                    </div>
                    <div class="fr-field">
                        <label class="fr-field-label">Catatan Internal (Khusus Admin)</label>
                        <textarea class="fr-modal-textarea" rows="2" placeholder="Catatan internal tim operasional..." @bind="selectedRequest.InternalNotes"></textarea>
                    </div>
                </div>

                @* Activity Log Timeline *@
                <div class="fr-section">
                    <h5 class="fr-section-title">Riwayat Aktivitas</h5>
                    <div class="fr-timeline">
                        @foreach (var act in selectedRequest.ActivityLogs)
                        {
                            <div class="fr-timeline-item">
                                <div class="fr-timeline-bullet"></div>
                                <div class="fr-timeline-content">
                                    <span class="fr-timeline-title">@act.Title</span>
                                    <span class="fr-timeline-time">@act.Timestamp.ToString("dd MMM yyyy, HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => showDetailModal = false">Tutup</button>
            <button type="button" class="btn-outline-pill btn-reject" @onclick="RejectRequest">Tolak</button>
            <button type="button" class="btn-primary-pill btn-yellow" @onclick="ProcessRequest">Tugaskan & Proses</button>
        </FooterContent>
    </AppModal>
}

<ExportModal IsOpen="@showExportModal" IsOpenChanged="@((bool v) => showExportModal = v)" ExportTitle="Permintaan Fasilitas" Columns="exportColumns" CurrentViewRows="FilteredRequests.Cast<object>()" AllRows="allRequests.Cast<object>()" />

@code {
    private string searchQuery = "";
    private string selectedTab = "all";
    private string selectedDept = "";
    private bool showDetailModal = false;
    private bool showExportModal = false;
    private bool isLoading = false;

    public class RequestItemDetail { public string Category { get; set; } = ""; public string Description { get; set; } = ""; }
    public class RequestActivityLog { public string Title { get; set; } = ""; public DateTime Timestamp { get; set; } }

    public class FacilityRequestItem
    {
        public string RequestId { get; set; } = "";
        public string Title { get; set; } = "";
        public string RoomName { get; set; } = "";
        public DateTime BookingDate { get; set; }
        public string RequesterName { get; set; } = "";
        public string RequesterInitials { get; set; } = "";
        public string RequesterEmail { get; set; } = "";
        public string Department { get; set; } = "";
        public string AvatarBg { get; set; } = "#2563EB";
        public bool IsUrgent { get; set; }
        public string Status { get; set; } = "pending";
        public string ItemsSummary { get; set; } = "";
        public string RequesterNote { get; set; } = "";
        public string Assignee { get; set; } = "";
        public string InternalNotes { get; set; } = "";
        public List<RequestItemDetail> Items { get; set; } = new();
        public List<RequestActivityLog> ActivityLogs { get; set; } = new();
    }

    private FacilityRequestItem? selectedRequest;
    private List<FacilityRequestItem> allRequests = new();

    private void HandleDateChanged(DateTime? date)
    {
        StateHasChanged();
    }

    private List<ExportColumn> exportColumns = new()
    {
        new() { Header = "ID", PropertyName = "RequestId" },
        new() { Header = "Judul", PropertyName = "Title" },
        new() { Header = "Pemohon", PropertyName = "RequesterName" },
        new() { Header = "Departemen", PropertyName = "Department" },
        new() { Header = "Ruangan", PropertyName = "RoomName" },
        new() { Header = "Status", PropertyName = "Status" }
    };

    protected override void OnInitialized()
    {
        InitDummyRequests();
    }

    private void InitDummyRequests()
    {
        allRequests = new List<FacilityRequestItem>
        {
            new()
            {
                RequestId = "FAC-901",
                Title = "Catering & Extra AV Setup",
                RoomName = "Ruang Rapat Utama",
                BookingDate = DateTime.Today.AddHours(9).AddMinutes(30),
                RequesterName = "Ahmad Fauzi",
                RequesterInitials = "AF",
                RequesterEmail = "ahmad.fauzi@company.com",
                Department = "IT & Digital",
                AvatarBg = "#0B1E39",
                IsUrgent = true,
                Status = "pending",
                ItemsSummary = "Catering & Furniture - Executive Lunch (x12), Extra Chairs (x2)",
                RequesterNote = "Mohon setup sound system dan proyektor siap 15 menit sebelum acara dimulai.",
                Assignee = "Sarah Jenkins (General Affairs)",
                InternalNotes = "Sudah dikoordinasikan dengan vendor katering.",
                Items = new List<RequestItemDetail>
                {
                    new() { Category = "Catering", Description = "Executive Lunch Box (12 pax) + Snack Sore" },
                    new() { Category = "AV Equipment", Description = "Wireless Mic (2 unit) & Sound System Stand" }
                },
                ActivityLogs = new List<RequestActivityLog>
                {
                    new() { Title = "Permintaan Dibuat", Timestamp = DateTime.Now.AddHours(-2) },
                    new() { Title = "Menunggu Penugasan", Timestamp = DateTime.Now.AddHours(-1) }
                }
            },
            new()
            {
                RequestId = "FAC-902",
                Title = "Kursi Tambahan & Spidol Papan Tulis",
                RoomName = "Ruang Diskusi B",
                BookingDate = DateTime.Today.AddHours(14),
                RequesterName = "Dewi Lestari",
                RequesterInitials = "DL",
                RequesterEmail = "dewi.lestari@company.com",
                Department = "Finance",
                AvatarBg = "#16A34A",
                IsUrgent = false,
                Status = "preparing",
                ItemsSummary = "Perlengkapan Ruangan - 4 Kursi Tambahan, Spidol Papan Tulis",
                RequesterNote = "Butuh kursi tambahan karena ada tamu auditor eksternal.",
                Assignee = "Budi Santoso (Facility Team)",
                Items = new List<RequestItemDetail>
                {
                    new() { Category = "Perabotan", Description = "Kursi Rapat Ergonomis (4 buah)" },
                    new() { Category = "Alat Tulis", Description = "Spidol Whiteboard 3 Warna + Penghapus" }
                },
                ActivityLogs = new List<RequestActivityLog>
                {
                    new() { Title = "Permintaan Dibuat", Timestamp = DateTime.Now.AddHours(-3) },
                    new() { Title = "Ditugaskan ke Budi Santoso", Timestamp = DateTime.Now.AddHours(-2) },
                    new() { Title = "Status Diubah menjadi Diproses", Timestamp = DateTime.Now.AddMinutes(-45) }
                }
            },
            new()
            {
                RequestId = "FAC-903",
                Title = "Live Streaming Townhall & Setup Panggung",
                RoomName = "Auditorium Serbaguna",
                BookingDate = DateTime.Today.AddDays(1).AddHours(10),
                RequesterName = "Rudi Hartono",
                RequesterInitials = "RH",
                RequesterEmail = "rudi.hartono@company.com",
                Department = "Marketing",
                AvatarBg = "#F59E0B",
                IsUrgent = true,
                Status = "ready",
                ItemsSummary = "Peralatan AV & Panggung - Kamera Live Streaming 4K, Lighting, Podium",
                RequesterNote = "Townhall Q4 seluruh perusahaan, disiarkan langsung ke cabang Surabaya & Bandung.",
                Assignee = "Rian Wahyu (IT Support)",
                Items = new List<RequestItemDetail>
                {
                    new() { Category = "Peralatan AV", Description = "Dual Camera 4K + OBS Live Studio Switcher" },
                    new() { Category = "Pencahayaan", Description = "Lampu Panggung Warm Light (4 Bar)" }
                },
                ActivityLogs = new List<RequestActivityLog>
                {
                    new() { Title = "Permintaan Dibuat", Timestamp = DateTime.Now.AddDays(-1) },
                    new() { Title = "Gladi Bersih Teknis Selesai", Timestamp = DateTime.Now.AddHours(-4) },
                    new() { Title = "Status Diubah menjadi Siap", Timestamp = DateTime.Now.AddHours(-1) }
                }
            },
            new()
            {
                RequestId = "FAC-904",
                Title = "Coffee Break & Layanan Teh",
                RoomName = "Ruang Dirantara VIP",
                BookingDate = DateTime.Today.AddHours(-2),
