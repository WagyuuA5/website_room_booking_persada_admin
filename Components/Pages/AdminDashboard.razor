@page "/dashboard"
@layout booking_room_admin.Components.Layout.MainLayout
@using ApexCharts
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Services
@inject NavigationManager Navigation
@inject ToastService Toast

<TopBar Title="Dashboard Admin" Subtitle="Ringkasan performa sistem pemesanan ruangan perusahaan.">
    <RightSlot>
        <DateFilter OnDateSelectedCallback="HandleDateChanged" />
    </RightSlot>
</TopBar>

@if (isPageLoading)
{
    <SkeletonPage Variant="full" />
}
else
{
<div class="dashboard">
    @* -- Bagian 1: Ringkasan Statistik -- *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><Icon Name="building" Size="24" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Ruangan<br>Aktif</span>
                <span class="stat-value">32</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><Icon Name="users" Size="24" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna<br>Terdaftar</span>
                <span class="stat-value">124</span>
                <span class="stat-trend up"><Icon Name="trending-up" Size="14" /> +12%</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><Icon Name="calendar" Size="24" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna<br>Booking</span>
                <span class="stat-value">86</span>
                <span class="stat-trend up"><Icon Name="trending-up" Size="14" /> +8%</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><Icon Name="activity" Size="24" /></div>
            <div class="stat-info">
                <span class="stat-label">Rata-rata<br>Utilisasi</span>
                <span class="stat-value">72%</span>
                <span class="stat-trend up"><Icon Name="trending-up" Size="14" /> +5%</span>
            </div>
        </div>
    </div>

    @* -- Bagian 2: Requests Overview Cards -- *@
    <div class="section-header">
        <h3 class="section-title">Ringkasan Permintaan</h3>
    </div>
    <div class="summary-cards-grid">
        <div class="summary-card clickable" @onclick='() => OpenRequestModal("facility")' title="Lihat daftar permintaan fasilitas">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge icon-badge-facility">
                        <Icon Name="package" Size="18" />
                    </div>
                    <span>Permintaan Fasilitas</span>
                </div>
                @if (facilityRequests.Count > 0)
                {
                    <span class="summary-counter">@facilityRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@facilityRequests.Count</h2>
                <span class="summary-status">MENUNGGU</span>
            </div>
        </div>

        <div class="summary-card clickable" @onclick='() => OpenRequestModal("account")' title="Lihat daftar permohonan penghapusan akun">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge icon-badge-account">
                        <Icon Name="user-x" Size="18" />
                    </div>
                    <span>Penghapusan Akun</span>
                </div>
                @if (accountRequests.Count > 0)
                {
                    <span class="summary-counter">@accountRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@accountRequests.Count</h2>
                <span class="summary-status">MENUNGGU</span>
            </div>
        </div>

        <div class="summary-card clickable" @onclick='() => OpenRequestModal("it")' title="Lihat daftar tiket IT support">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge icon-badge-it">
                        <Icon Name="wrench" Size="18" />
                    </div>
                    <span>Tiket IT Support</span>
                </div>
                @if (itRequests.Count > 0)
                {
                    <span class="summary-counter">@itRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@itRequests.Count</h2>
                <span class="summary-status">MENUNGGU</span>
            </div>
        </div>

        <div class="summary-card clickable" @onclick='() => OpenRequestModal("bug")' title="Lihat daftar laporan bug">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge icon-badge-bug">
                        <Icon Name="bug" Size="18" />
                    </div>
                    <span>Laporan Bug</span>
                </div>
                @if (bugRequests.Count > 0)
                {
                    <span class="summary-counter">@bugRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@bugRequests.Count</h2>
                <span class="summary-status">MENUNGGU</span>
            </div>
        </div>
    </div>

    @* -- Bagian 3: Charts -- *@
    <div class="charts-row">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Tren Pemesanan Ruangan</h3>
                <div class="chart-actions">
                    <button class="chart-export-btn" title="Unduh data tren" @onclick="() => showTrendExport = true">
                        <Icon Name="download" Size="15" />
                        <span>Ekspor</span>
                    </button>
                </div>
            </div>
            <ApexChart TItem="TrendPoint" Options="_trendOptions" Height="@("250px")">
                <ApexPointSeries TItem="TrendPoint"
                                 Items="_trendData"
                                 Name="Pemesanan"
                                 SeriesType="SeriesType.Area"
                                 XValue="e => e.Bulan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3>Ruangan Paling Sering Digunakan</h3>
                <div class="chart-actions">
                    <button class="chart-export-btn" title="Unduh data ruangan" @onclick="() => showDonutExport = true">
                        <Icon Name="download" Size="15" />
                        <span>Ekspor</span>
                    </button>
                </div>
            </div>
            <ApexChart TItem="RoomUsagePoint" Options="_donutOptions" Height="@("250px")">
                <ApexPointSeries TItem="RoomUsagePoint"
                                 Items="_donutData"
                                 Name="Ruangan"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.NamaRuangan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
    </div>

    @* -- Bagian 4: Tables Row (Permintaan Terbaru & Riwayat Booking) -- *@
    <div class="tables-row">
        @* Tabel Permintaan Terbaru *@
        <div class="table-card">
            <div class="table-header">
                <div>
                    <h3 class="table-title">Permintaan Terbaru</h3>
                    <span class="table-subtitle">Klik baris pemohon untuk melihat detail permintaan</span>
                </div>
                <div class="table-header-actions">
                    <a href="/facility-requests" class="table-link">
                        <span>Lihat Semua</span>
                        <Icon Name="chevron-right" Size="14" />
                    </a>
                </div>
            </div>
            <div class="mini-table-container">
                <div class="mini-table-header" style="grid-template-columns: 1.4fr 1.6fr 2fr 1fr;">
                    <div class="mini-table-header-cell">JENIS PERMINTAAN</div>
                    <div class="mini-table-header-cell">PEMOHON</div>
                    <div class="mini-table-header-cell">RINGKASAN</div>
                    <div class="mini-table-header-cell text-right">STATUS</div>
                </div>
                <div class="mini-table-body">
                    @foreach (var req in recentRequests.Take(5))
                    {
                        <div class="mini-table-row clickable-row" style="grid-template-columns: 1.4fr 1.6fr 2fr 1fr;" @onclick="() => HandleRecentRequestClick(req)" title="Klik untuk membuka detail @req.RequesterName">
                            <div class="req-type-cell">
                                <div class="cat-icon-badge" style="background:@req.TypeVisual.BgColor; color:@req.TypeVisual.TextColor;">
                                    <Icon Name="@req.TypeVisual.IconName" Size="15" />
                                </div>
                                <span class="td-primary" title="@req.TypeLabel">@req.TypeLabel</span>
                            </div>
                            <div class="user-cell">
                                <UserAvatar Initials="@req.Initials" BgColor="@req.AvatarColor" Size="34px" />
                                <div class="user-cell-info" title="@($"{req.RequesterName} ({req.Department})")">
                                    <span class="td-primary user-name-truncate">@req.RequesterName</span>
                                    <span class="td-secondary">@req.Department</span>
                                </div>
                            </div>
                            <div class="td-summary" title="@req.Summary">@req.Summary</div>
                            <div class="text-right"><StatusBadge Status="@req.Status" /></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Tabel Riwayat Pemesanan *@
        <div class="table-card">
            <div class="table-header">
                <div>
                    <h3 class="table-title">Riwayat Pemesanan</h3>
                    <span class="table-subtitle">Aktivitas pemesanan ruangan terbaru</span>
                </div>
                <div class="table-header-actions">
                    <a href="/booking-management" class="table-link">
                        <span>Lihat Semua</span>
                        <Icon Name="chevron-right" Size="14" />
                    </a>
                </div>
            </div>
            <div class="mini-table-container">
                <div class="mini-table-header" style="grid-template-columns: 1.8fr 1.4fr 1.6fr 1fr;">
                    <div class="mini-table-header-cell">PENGGUNA</div>
                    <div class="mini-table-header-cell">RUANGAN</div>
                    <div class="mini-table-header-cell">JADWAL</div>
                    <div class="mini-table-header-cell text-right">STATUS</div>
                </div>
                <div class="mini-table-body">
                    @foreach (var booking in historyBookings.Take(5))
                    {
                        <div class="mini-table-row clickable-row" style="grid-template-columns: 1.8fr 1.4fr 1.6fr 1fr;" @onclick="() => HandleHistoryBookingClick(booking)" title="@($"Klik untuk melihat detail pemesanan {booking.UserName}")">
                            <div class="user-cell">
                                <UserAvatar Initials="@booking.Initials" BgColor="@booking.AvatarColor" Size="34px" />
                                <div class="user-cell-info" title="@($"{booking.UserName} ({booking.Department})")">
                                    <span class="td-primary user-name-truncate">@booking.UserName</span>
                                    <span class="td-secondary">@booking.Department</span>
                                </div>
                            </div>
                            <div class="td-primary" title="@booking.Room">@booking.Room</div>
                            <div class="schedule-cell">
                                <span class="td-primary" style="font-weight: 500;">@booking.ScheduleDate</span>
                                <span class="td-secondary">@booking.ScheduleTime</span>
                            </div>
                            <div class="text-right"><StatusBadge Status="@booking.Status" /></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
}

@* ==========================================
   MODAL DAFTAR RINGKASAN PERMINTAAN (Level 1)
   ========================================== *@

@* 1. Modal List Permintaan Fasilitas *@
<AppModal IsOpen="@(_activeRequestModal == "facility")" IsOpenChanged="@(CloseRequestModal)" Title="Daftar Permintaan Fasilitas" Size="medium">
    <ChildContent>
        <div class="request-detail-list">
            @foreach (var r in facilityRequests)
            {
                <div class="custom-action-card" style="border-left-color: #F59E0B;">
                    <div class="custom-card-avatar">
                        <UserAvatar Initials="@r.Initials" BgColor="@r.AvatarColor" Size="42px" />
                    </div>
                    <div class="custom-card-content">
                        <div class="custom-card-title-row">
                            <strong class="custom-card-title">@r.Title</strong>
                            <span class="custom-card-id">#@StripId(r.Id)</span>
                        </div>
                        <div class="custom-card-requester">@r.RequesterName • @r.Department</div>
                        <div class="custom-card-subtitle">@r.Room • @r.SubmittedAt</div>
                    </div>
                    <div class="custom-card-action">
                        <button type="button" class="btn-process-action" @onclick="() => OpenFacilityDetail(r)">
                            Proses
                        </button>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent><a class="btn-primary-pill btn-yellow" href="/facility-requests">Lihat Semua Permintaan</a></FooterContent>
</AppModal>

@* 2. Modal List Penghapusan Akun *@
<AppModal IsOpen="@(_activeRequestModal == "account")" IsOpenChanged="@(CloseRequestModal)" Title="Daftar Penghapusan Akun" Size="medium">
    <ChildContent>
        <div class="request-detail-list">
            @foreach (var r in accountRequests)
            {
                <div class="custom-action-card" style="border-left-color: #EF4444;">
                    <div class="custom-card-avatar">
                        <UserAvatar Initials="@r.Initials" BgColor="@r.AvatarColor" Size="42px" />
                    </div>
                    <div class="custom-card-content">
                        <div class="custom-card-title-row">
                            <strong class="custom-card-title">@r.UserName</strong>
                            <span class="custom-card-id">#@StripId(r.Id)</span>
                        </div>
                        <div class="custom-card-requester">ID: @r.UserId • @r.Department</div>
                        <div class="custom-card-subtitle" style="color: #DC2626; font-weight: 600;">@r.Reason</div>
                    </div>
                    <div class="custom-card-action">
                        <button type="button" class="btn-process-action" @onclick="() => OpenAccountDetail(r)">
                            Tinjau
                        </button>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent><a class="btn-primary-pill btn-yellow" href="/users">Kelola Pengguna</a></FooterContent>
</AppModal>

@* 3. Modal List Tiket IT Support *@
<AppModal IsOpen="@(_activeRequestModal == "it")" IsOpenChanged="@(CloseRequestModal)" Title="Daftar Tiket IT Support" Size="medium">
    <ChildContent>
        <div class="request-detail-list">
            @foreach (var r in itRequests)
            {
                var visual = IssueIconHelper.GetVisual(r.Title);
                <div class="custom-action-card" style="border-left-color: @visual.BorderColor;">
                    <div class="custom-card-icon" style="background: @visual.BgColor; color: @visual.TextColor;">
                        <Icon Name="@visual.IconName" Size="20" />
                    </div>
                    <div class="custom-card-content">
                        <div class="custom-card-title-row">
                            <strong class="custom-card-title">@r.Title</strong>
                            <span class="custom-card-id">#@StripId(r.Id)</span>
                        </div>
                        <div class="custom-card-requester">@r.RequesterName • @r.Department</div>
                        <div class="custom-card-subtitle">@r.Category • @r.Urgency</div>
                    </div>
                    <div class="custom-card-action">
                        <button type="button" class="btn-process-action" @onclick="() => OpenITDetail(r)">
                            Perbaiki
                        </button>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent><a class="btn-primary-pill btn-yellow" href="/facility-requests">Lihat Semua Permintaan</a></FooterContent>
</AppModal>

@* 4. Modal List Laporan Bug *@
<AppModal IsOpen="@(_activeRequestModal == "bug")" IsOpenChanged="@(CloseRequestModal)" Title="Daftar Laporan Bug" Size="medium">
    <ChildContent>
        <div class="request-detail-list">
            @foreach (var r in bugRequests)
            {
                var visual = IssueIconHelper.GetVisual(r.Title);
                <div class="custom-action-card" style="border-left-color: @visual.BorderColor;">
                    <div class="custom-card-icon" style="background: @visual.BgColor; color: @visual.TextColor;">
                        <Icon Name="@visual.IconName" Size="20" />
                    </div>
                    <div class="custom-card-content">
                        <div class="custom-card-title-row">
                            <strong class="custom-card-title">@r.Title</strong>
                            <span class="custom-card-id">#@StripId(r.Id)</span>
                        </div>
                        <div class="custom-card-requester">@r.ReporterName • @r.Department</div>
                        <div class="custom-card-subtitle" style="color: @(r.Urgency == "Kritis" ? "#DC2626" : "#D97706"); font-weight:600;">@r.Module • @r.Urgency</div>
                    </div>
                    <div class="custom-card-action">
                        <button type="button" class="btn-process-action" @onclick="() => OpenBugDetail(r)">
                            Investigasi
                        </button>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent><a class="btn-primary-pill btn-yellow" href="/facility-requests">Lihat Semua Permintaan</a></FooterContent>
</AppModal>

@* ==========================================
   MODAL DETAIL SPESIFIK (Level 2)
   ========================================== *@

@* A. Detail Permintaan Fasilitas *@
@if (selectedFacilityDetail != null)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) selectedFacilityDetail = null; })" Title="Detail Permintaan Fasilitas" Size="medium">
        <HeaderContent>
            <div class="modal-detail-header-row">
                <div>
                    <h3 class="modal-detail-title">@selectedFacilityDetail.Title</h3>
                    <span class="modal-detail-id">#@selectedFacilityDetail.Id</span>
                </div>
                <StatusBadge Status="@selectedFacilityDetail.Status" />
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="modal-detail-body">
                @* Info Pemohon *@
                <div class="modal-info-card">
                    <UserAvatar Initials="@selectedFacilityDetail.Initials" BgColor="@selectedFacilityDetail.AvatarColor" Size="48px" />
                    <div class="modal-info-text">
                        <strong class="modal-user-name">@selectedFacilityDetail.RequesterName</strong>
                        <span class="modal-user-dept">@selectedFacilityDetail.Department</span>
                        <span class="modal-user-meta"><Icon Name="map-pin" Size="13" /> @selectedFacilityDetail.Room • <Icon Name="clock" Size="13" /> @selectedFacilityDetail.SubmittedAt</span>
                    </div>
                </div>

                @* Kebutuhan & Deskripsi *@
                <div class="modal-section-box">
                    <span class="modal-section-label">JENIS PERMINTAAN</span>
                    <strong class="modal-section-val">@selectedFacilityDetail.RequestType</strong>
                </div>

                <div class="modal-section-box">
                    <span class="modal-section-label">ITEM YANG DIBUTUHKAN</span>
                    <strong class="modal-section-val">@selectedFacilityDetail.ItemsSummary</strong>
                </div>

                <div class="modal-section-box">
                    <span class="modal-section-label">DESKRIPSI LENGKAP</span>
                    <p class="modal-desc-text">@selectedFacilityDetail.Description</p>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => RejectFacility(selectedFacilityDetail)">Tolak Permintaan</button>
            <button type="button" class="btn-primary-pill btn-blue" @onclick="() => ApproveFacility(selectedFacilityDetail)">Setujui & Proses</button>
        </FooterContent>
    </AppModal>
}

@* B. Detail Penghapusan Akun *@
@if (selectedAccountDetail != null)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) selectedAccountDetail = null; })" Title="Detail Permohonan Penghapusan Akun" Size="medium">
        <HeaderContent>
            <div class="modal-detail-header-row">
                <div>
                    <h3 class="modal-detail-title">Permohonan Penghapusan Akun</h3>
                    <span class="modal-detail-id">#@selectedAccountDetail.Id</span>
                </div>
                <StatusBadge Status="@selectedAccountDetail.Status" />
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="modal-detail-body">
                @* Info User *@
                <div class="modal-info-card">
                    <UserAvatar Initials="@selectedAccountDetail.Initials" BgColor="@selectedAccountDetail.AvatarColor" Size="48px" />
                    <div class="modal-info-text">
                        <strong class="modal-user-name">@selectedAccountDetail.UserName</strong>
                        <span class="modal-user-dept">ID Karyawan: @selectedAccountDetail.UserId • @selectedAccountDetail.Department</span>
                        <span class="modal-user-meta"><Icon Name="calendar" Size="13" /> Tanggal Efektif: @selectedAccountDetail.EffectiveDate</span>
                    </div>
                </div>

                <div class="modal-section-box alert-box-red">
                    <span class="modal-section-label" style="color: #991B1B;">ALASAN PENGHAPUSAN AKUN</span>
                    <strong class="modal-section-val" style="color: #B91C1C;">@selectedAccountDetail.Reason</strong>
                </div>

                <div class="modal-section-box">
                    <span class="modal-section-label">CATATAN HRD & VERIFIKASI</span>
                    <p class="modal-desc-text">@selectedAccountDetail.HrNotes</p>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => RejectAccountDeletion(selectedAccountDetail)">Tolak Permohonan</button>
            <button type="button" class="btn-primary-pill btn-danger" @onclick="() => ApproveAccountDeletion(selectedAccountDetail)">Setujui Penghapusan</button>
        </FooterContent>
    </AppModal>
}

@* C. Detail Investigasi Laporan Bug *@
@if (selectedBugDetail != null)
{
    var visual = IssueIconHelper.GetVisual(selectedBugDetail.Title);
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) selectedBugDetail = null; })" Title="Investigasi Laporan Bug" Size="large">
        <HeaderContent>
            <div class="modal-detail-header-row">
                <div style="display:flex; align-items:center; gap:10px;">
                    <div class="cat-icon-badge" style="background:@visual.BgColor; color:@visual.TextColor; width:34px; height:34px;">
                        <Icon Name="@visual.IconName" Size="18" />
                    </div>
                    <div>
                        <h3 class="modal-detail-title">@selectedBugDetail.Title</h3>
                        <span class="modal-detail-id">#@selectedBugDetail.Id • @selectedBugDetail.Module</span>
                    </div>
                </div>
                <span class="badge-urgency @(selectedBugDetail.Urgency == "Kritis" ? "urgent-critical" : "urgent-medium")">
                    @selectedBugDetail.Urgency.ToUpper()
                </span>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="modal-detail-body">
                @* Info Pelapor *@
                <div class="modal-info-card">
                    <UserAvatar Initials="@selectedBugDetail.ReporterInitials" BgColor="@selectedBugDetail.AvatarColor" Size="42px" />
                    <div class="modal-info-text">
                        <strong class="modal-user-name">@selectedBugDetail.ReporterName</strong>
                        <span class="modal-user-dept">Pelapor • @selectedBugDetail.Department</span>
                    </div>
                </div>

                @* Detail Error *@
                <div class="modal-section-box">
                    <span class="modal-section-label">DESKRIPSI & GEJALA BUG</span>
                    <p class="modal-desc-text">@selectedBugDetail.Description</p>
                </div>

                @* Form Penanganan Admin Langsung *@
                <div class="modal-admin-action-box">
                    <h5 class="admin-box-title">TINDAKAN INVESTIGASI ADMIN</h5>
                    <div class="admin-form-row">
                        <div class="form-group-col">
                            <label class="form-label">Status Investigasi Saat Ini</label>
                            <select class="admin-select-input" @bind="selectedBugDetail.Status">
                                <option value="Diinvestigasi">Diinvestigasi</option>
                                <option value="Sedang Ditangani">Sedang Ditangani</option>
                                <option value="Selesai">Selesai</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group-col">
                        <label class="form-label">Catatan Penanganan Admin / Resolusi Teknis</label>
                        <textarea class="admin-textarea-input" rows="3" placeholder="Tuliskan temuan analisis, langkah perbaikan, atau catatan eskalasi..." @bind="selectedBugDetail.AdminNotes"></textarea>
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => EscalateBug(selectedBugDetail)">Eskalasi ke Engineering</button>
