@* E. Detail Riwayat Pemesanan *@
@if (selectedHistoryBooking != null)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => { if (!v) selectedHistoryBooking = null; })" Title="Detail Pemesanan Ruangan" Size="medium">
        <ChildContent>
            <div class="booking-detail-modal-body">
                <div class="bdm-room-photo-wrap">
                    <img src="@GetRoomPhoto(selectedHistoryBooking.Room)" alt="@selectedHistoryBooking.Room" class="bdm-room-photo" />
                    <span class="bdm-room-badge"><Icon Name="building" Size="14" /> @selectedHistoryBooking.Room</span>
                </div>

                <div class="bdm-user-card">
                    <div class="bdm-user-left">
                        <UserAvatar Initials="@selectedHistoryBooking.Initials" BgColor="@selectedHistoryBooking.AvatarColor" Size="44px" />
                        <div>
                            <strong class="bdm-user-name">@selectedHistoryBooking.UserName</strong>
                            <span class="bdm-user-dept">@selectedHistoryBooking.Department</span>
                        </div>
                    </div>
                    <StatusBadge Status="@selectedHistoryBooking.Status" />
                </div>

                <div class="bdm-grid">
                    <div class="bdm-grid-item">
                        <span class="bdm-label"><Icon Name="calendar" Size="14" /> Tanggal</span>
                        <strong class="bdm-val">@selectedHistoryBooking.ScheduleDate</strong>
                    </div>
                    <div class="bdm-grid-item">
                        <span class="bdm-label"><Icon Name="clock" Size="14" /> Waktu</span>
                        <strong class="bdm-val">@selectedHistoryBooking.ScheduleTime</strong>
                    </div>
                    <div class="bdm-grid-item">
                        <span class="bdm-label"><Icon Name="users" Size="14" /> Peserta</span>
                        <strong class="bdm-val">12 Orang</strong>
                    </div>
                    <div class="bdm-grid-item">
                        <span class="bdm-label"><Icon Name="file-text" Size="14" /> Keperluan</span>
                        <strong class="bdm-val">Rapat Koordinasi Internal</strong>
                    </div>
                </div>

                <RoomLocationMiniMap RoomName="@selectedHistoryBooking.Room"
                                     LocationText="@GetRoomLocationText(selectedHistoryBooking.Room)"
                                     PinX="@GetRoomPinX(selectedHistoryBooking.Room)"
                                     PinY="@GetRoomPinY(selectedHistoryBooking.Room)" />
            </div>
        </ChildContent>
        <FooterContent>
            @if (selectedHistoryBooking.Status == "pending" || selectedHistoryBooking.Status == "menunggu")
            {
                <button type="button" class="btn-outline-pill" @onclick="() => RejectBooking(selectedHistoryBooking)">Tolak</button>
                <button type="button" class="btn-primary-pill btn-yellow" @onclick="() => ApproveBooking(selectedHistoryBooking)">Setujui</button>
            }
            else
            {
                <button type="button" class="btn-outline-pill" @onclick="() => selectedHistoryBooking = null">Tutup</button>
            }
        </FooterContent>
    </AppModal>
}

