                        <Icon Name="@visual.IconName" Size="18" />
                    </div>
                    <div>
                        <h3 class="modal-detail-title">@selectedITDetail.Title</h3>
                        <span class="modal-detail-id">#@selectedITDetail.Id • @selectedITDetail.Category</span>
