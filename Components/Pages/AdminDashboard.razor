@page "/admin"
@layout booking_room_admin.Components.Layout.MainLayout
@using ApexCharts
@inject booking_room_admin.Components.Services.LayoutTitleService LayoutTitleService

<div class="dashboard">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_1_admin.svg" alt="Ruangan" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Ruangan Aktif</span>
                <span class="stat-value">32</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_2_admin.svg" alt="Pengguna" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna Terdaftar</span>
                <span class="stat-value">124</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_4_admin.svg" alt="Booking" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna Booking</span>
                <span class="stat-value">72</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_3_admin.svg" alt="Utilisasi" /></div>
            <div class="stat-info">
                <span class="stat-label">Rata-rata Utilisasi</span>
                <span class="stat-value">86%</span>
            </div>
        </div>
    </div>

    <div class="requests-grid">
        <div class="request-card">
            <div class="request-icon"><img src="icon/coffee.svg" alt="Fasilitas" /></div>
            <div class="request-info">
                <span class="request-label">Permintaan Fasilitas</span>
                <span class="request-badge pending">Menunggu</span>
            </div>
        </div>
        <div class="request-card">
            <div class="request-icon"><img src="icon/icon_9_admin.svg" alt="Akun" /></div>
            <div class="request-info">
                <span class="request-label">Penghapusan Akun</span>
                <span class="request-badge pending">Menunggu</span>
            </div>
        </div>
        <div class="request-card">
            <div class="request-icon"><img src="icon/icon_10_admin.svg" alt="IT" /></div>
            <div class="request-info">
                <span class="request-label">Tiket Dukungan IT</span>
                <span class="request-badge pending">Menunggu</span>
            </div>
        </div>
        <div class="request-card">
            <div class="request-icon"><img src="icon/icon_11_admin.svg" alt="Bug" /></div>
            <div class="request-info">
                <span class="request-label">Laporan Bug</span>
                <span class="request-badge pending">Menunggu</span>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="chart-card wide">
            <div class="chart-header">
                <img src="icon/icon_5_admin.svg" alt="Tren" class="chart-icon" />
                <h3>Tren Booking</h3>
            </div>
            <ApexChart TItem="TrendPoint" Options="_trendOptions" Height="320">
                <ApexPointSeries TItem="TrendPoint"
                                 Items="_trendData"
                                 Name="Booking"
                                 SeriesType="SeriesType.Area"
                                 XValue="e => e.Bulan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3>Ruangan Paling Sering Digunakan</h3>
            </div>
            <ApexChart TItem="RoomUsagePoint" Options="_donutOptions" Height="320">
                <ApexPointSeries TItem="RoomUsagePoint"
                                 Items="_donutData"
                                 Name="Ruangan"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.NamaRuangan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
    </div>

    <div class="tables-row">
        <div class="table-card">
            <div class="table-header">
                <h3>Permintaan Terbaru</h3>
                <a href="requests" class="table-link">Lihat Semua di Pusat Permintaan</a>
            </div>
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Jenis Permintaan</th>
                            <th>Pemohon</th>
                            <th>Ringkasan</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="td-primary">Permintaan Fasilitas</span></td>
                            <td><span class="td-primary">Ahmad Fauzi</span><span class="td-secondary">Staff Marketing</span></td>
                            <td>Proyektor ruang rapat tidak terdeteksi</td>
                            <td><span class="badge badge-pending">Menunggu</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Penghapusan Akun</span></td>
                            <td><span class="td-primary">Siti Nurhaliza</span><span class="td-secondary">Kepala Keuangan</span></td>
                            <td>Permintaan nonaktifkan akun setelah resign</td>
                            <td><span class="badge badge-confirmed">Dikonfirmasi</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Tiket Dukungan IT</span></td>
                            <td><span class="td-primary">Budi Santoso</span><span class="td-secondary">HRD</span></td>
                            <td>Akses booking terblokir sejak pagi</td>
                            <td><span class="badge badge-progress">Dikerjakan</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Laporan Bug</span></td>
                            <td><span class="td-primary">Dewi Kartika</span><span class="td-secondary">IT Support</span></td>
                            <td>Jadwal bentrok meskipun ruang kosong</td>
                            <td><span class="badge badge-forwarded">Diteruskan</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="table-card">
            <div class="table-header">
                <h3>Riwayat Booking</h3>
            </div>
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Pengguna</th>
                            <th>Ruangan</th>
                            <th>Jadwal</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="td-primary">Ahmad Fauzi</span><span class="td-secondary">Marketing</span></td>
                            <td><span class="td-primary">Ruang Rapat A</span></td>
                            <td>20 Sep 2026, 09:00 - 11:00</td>
                            <td><span class="badge badge-confirmed">Dikonfirmasi</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Siti Nurhaliza</span><span class="td-secondary">Keuangan</span></td>
                            <td><span class="td-primary">Ruang Rapat B</span></td>
                            <td>20 Sep 2026, 13:00 - 15:00</td>
                            <td><span class="badge badge-pending">Menunggu</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Budi Santoso</span><span class="td-secondary">HRD</span></td>
                            <td><span class="td-primary">Ruang Diskusi</span></td>
                            <td>19 Sep 2026, 10:00 - 12:00</td>
                            <td><span class="badge badge-rejected">Ditolak</span></td>
                        </tr>
                        <tr>
                            <td><span class="td-primary">Dewi Kartika</span><span class="td-secondary">IT Support</span></td>
                            <td><span class="td-primary">Ruang Rapat Utama</span></td>
                            <td>19 Sep 2026, 14:00 - 16:00</td>
                            <td><span class="badge badge-confirmed">Dikonfirmasi</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TrendPoint> _trendData = new();
    private ApexChartOptions<TrendPoint> _trendOptions = new();
    private List<RoomUsagePoint> _donutData = new();
    private ApexChartOptions<RoomUsagePoint> _donutOptions = new();

    protected override void OnInitialized()
    {
        LayoutTitleService.Title = "Dashboard Admin";
        LayoutTitleService.Subtitle = "Ringkasan performa sistem pemesanan ruangan perusahaan.";

        _trendData = new List<TrendPoint>
        {
            new("Mei", 18),
            new("Jun", 24),
            new("Jul", 35),
            new("Ags", 28),
            new("Sep", 42),
            new("Okt", 38),
            new("Nov", 45),
            new("Des", 52)
        };

        _trendOptions = new ApexChartOptions<TrendPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Area,
                Animations = new Animations
                {
                    Enabled = true,
                    Easing = Easing.Easeinout,
                    Speed = 1200,
                    AnimateGradually = new AnimateGradually { Enabled = true, Delay = 150 }
                },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Fill = new Fill { Opacity = 0.35, Type = FillType.Gradient, Gradient = new FillGradient { ShadeIntensity = 1, OpacityFrom = 0.7, OpacityTo = 0.1, Stops = new List<double> { 0, 90, 100 } } },
            DataLabels = new DataLabels { Enabled = false },
            Markers = new Markers { Size = 4, Hover = new MarkersHover { Size = 6 } },
            Xaxis = new XAxis { Categories = _trendData.Select(d => d.Bulan).ToList() },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { FontWeight = "600" } } } },
            Grid = new Grid { BorderColor = "#e5e7eb", StrokeDashArray = 4 },
            Tooltip = new Tooltip { X = new TooltipX { Format = "dd MMM yyyy" } },
            Theme = new Theme { Mode = Mode.Light, Palette = PaletteType.Palette1 }
        };

        _donutData = new List<RoomUsagePoint>
        {
            new("Ruangan A", 35),
            new("Ruangan B", 25),
            new("Ruangan C", 20),
            new("Ruangan D", 12),
            new("Ruangan E", 8)
        };

        _donutOptions = new ApexChartOptions<RoomUsagePoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Donut,
                Animations = new Animations
                {
                    Enabled = true,
                    Easing = Easing.Easeinout,
                    Speed = 1000,
                    AnimateGradually = new AnimateGradually { Enabled = true, Delay = 200 }
                }
            },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    Donut = new PlotOptionsDonut
                    {
                        Size = "70%",
                        Labels = new DonutLabels
                        {
                            Show = true,
                            Name = new DonutLabelName { Show = true, FontSize = "14px", FontWeight = "600" },
                            Value = new DonutLabelValue { Show = true, FontSize = "28px", FontWeight = "800", Color = "#111827" },
                            Total = new DonutLabelTotal
                            {
                                Show = true,
                                Label = "Total",
                                FontSize = "12px",
                                FontWeight = "600",
                                Color = "#6b7280",
                                ShowAlways = true
                            }
                        }
                    }
                }
            },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
                FontSize = "13px",
                FontWeight = "500",
                Markers = new LegendMarkers { Width = 10, Height = 10, Radius = 2 },
                ItemMargin = new LegendItemMargin { Horizontal = 10, Vertical = 5 }
            },
            Stroke = new Stroke { Width = 0 },
            Theme = new Theme { Mode = Mode.Light, Palette = PaletteType.Palette1 }
        };
    }

    public record TrendPoint(string Bulan, int Jumlah);
    public record RoomUsagePoint(string NamaRuangan, int Jumlah);
}