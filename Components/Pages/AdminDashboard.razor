                    <div class="modal-info-text">
                        <strong class="modal-user-name">@selectedITDetail.RequesterName</strong>
                        <span class="modal-user-dept">Pemohon • @selectedITDetail.Department</span>
                        <span class="modal-user-meta">Prioritas: @selectedITDetail.Urgency</span>
