@page "/dashboard"
@layout booking_room_admin.Components.Layout.MainLayout
@using ApexCharts
@using booking_room_admin.Components.Shared


<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Dashboard Admin" PageSubtitle="Ringkasan performa sistem pemesanan ruangan perusahaan." />
<div class="dashboard">
    @* ── Bagian 1: Ringkasan Statistik ── *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_1_admin.svg" alt="Ruangan" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Ruangan<br>Aktif</span>
                <span class="stat-value">32</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_2_admin.svg" alt="Pengguna" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna<br>Terdaftar</span>
                <span class="stat-value">124</span>
                <span class="stat-trend up">↑ +12%</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_4_admin.svg" alt="Booking" /></div>
            <div class="stat-info">
                <span class="stat-label">Total Pengguna<br>Booking</span>
                <span class="stat-value">86</span>
                <span class="stat-trend up">↑ +8%</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><img src="icon/icon_3_admin.svg" alt="Utilisasi" /></div>
            <div class="stat-info">
                <span class="stat-label">Rata-rata<br>Utilisasi</span>
                <span class="stat-value">72%</span>
                <span class="stat-trend up">↑ +5%</span>
            </div>
        </div>
    </div>

    @* ── Bagian 2: Requests Overview dengan ActionCard ── *@
    <div class="section-header">
        <h3 class="section-title">Requests Overview</h3>
    </div>
    <div class="summary-cards-grid">
        <div class="summary-card">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge" style="background:#FCE7F3;color:#BE185D;">
                        <img src="icon/coffee.svg" alt="Fasilitas" />
                    </div>
                    <span>Permintaan Fasilitas</span>
                </div>
                @if (facilityRequests.Count > 0)
                {
                    <span class="summary-counter">@facilityRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@facilityRequests.Count</h2>
                <span class="summary-status">PENDING</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge" style="background:#FEF3C7;color:#D97706;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="23" y2="12"/><line x1="23" y1="8" x2="19" y2="12"/></svg>
                    </div>
                    <span>Penghapusan Akun</span>
                </div>
                @if (accountRequests.Count > 0)
                {
                    <span class="summary-counter">@accountRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@accountRequests.Count</h2>
                <span class="summary-status">PENDING</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge" style="background:#DBEAFE;color:#1D4ED8;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    </div>
                    <span>Tiket IT Support</span>
                </div>
                @if (itRequests.Count > 0)
                {
                    <span class="summary-counter">@itRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@itRequests.Count</h2>
                <span class="summary-status">PENDING</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card-header">
                <div class="summary-icon-title">
                    <div class="icon-badge" style="background:#FEE2E2;color:#B91C1C;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v22"/><path d="m5 10 3 3-3 3"/><path d="m19 10-3 3 3 3"/><path d="M2 14h20"/><path d="M2 10h20"/><path d="M8 2h8"/></svg>
                    </div>
                    <span>Laporan Bug</span>
                </div>
                @if (bugRequests.Count > 0)
                {
                    <span class="summary-counter">@bugRequests.Count</span>
                }
            </div>
            <div class="summary-card-body">
                <h2>@bugRequests.Count</h2>
                <span class="summary-status">PENDING</span>
            </div>
        </div>
    </div>

    @* -- Bagian 3: Charts ── *@
    <div class="charts-row">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Tren Booking</h3>
                <div class="chart-actions">
                    <button class="chart-export-btn" title="Export">📥</button>
                </div>
            </div>
            <ApexChart TItem="TrendPoint" Options="_trendOptions" Height="@("250px")">
                <ApexPointSeries TItem="TrendPoint"
                                 Items="_trendData"
                                 Name="Booking"
                                 SeriesType="SeriesType.Area"
                                 XValue="e => e.Bulan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <h3>Ruangan Paling Sering Digunakan</h3>
                <div class="chart-actions">
                    <button class="chart-export-btn" title="Export">📥</button>
                </div>
            </div>
            <ApexChart TItem="RoomUsagePoint" Options="_donutOptions" Height="@("250px")">
                <ApexPointSeries TItem="RoomUsagePoint"
                                 Items="_donutData"
                                 Name="Ruangan"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.NamaRuangan"
                                 YValue="e => e.Jumlah" />
            </ApexChart>
        </div>
    </div>

    @* ── Bagian 4: Recent Requests ── *@
    <div class="tables-row">
        <div class="table-card">
            <div class="table-header">
                <h3>Permintaan Terbaru</h3>
                <a href="/facility-requests" class="table-link">LIHAT SEMUA DI REQUESTS HUB →</a>
            </div>
            <DataTable TItem="RecentRequest" Items="recentRequests" Columns="requestColumns" TotalCount="@recentRequests.Count" PageSize="5" CurrentPage="1" OnRowClick="HandleRequestClick">
                <RowTemplate Context="req">
                    <td>
                        <div class="req-type-cell">
                            <span class="req-type-icon" style="background: @req.TypeColor">@req.TypeIcon</span>
                            <span class="td-primary">@req.Type</span>
                        </div>
                    </td>
                    <td>
                        <div class="user-cell">
                            <UserAvatar Initials="@req.Initials" BgColor="@req.AvatarColor" Size="32px" />
                            <div>
                                <span class="td-primary">@req.RequesterName</span>
                                <span class="td-secondary">@req.Department</span>
                            </div>
                        </div>
                    </td>
                    <td>@req.Summary</td>
                    <td><StatusBadge Status="@req.Status" /></td>
                </RowTemplate>
            </DataTable>
        </div>

        @* ── Bagian 5: History Bookings ── *@
        <div class="table-card">
            <div class="table-header">
                <h3>Riwayat Booking</h3>
                <a href="/booking-management" class="table-link">SEMUA</a>
            </div>
            <DataTable TItem="HistoryBooking" Items="historyBookings" Columns="bookingColumns" TotalCount="@historyBookings.Count" PageSize="5" CurrentPage="1">
                <RowTemplate Context="booking">
                    <td>
                        <div class="user-cell">
                            <UserAvatar Initials="@booking.Initials" BgColor="@booking.AvatarColor" Size="32px" />
                            <div>
                                <span class="td-primary">@booking.UserName</span>
                                <span class="td-secondary">@booking.Department</span>
                            </div>
                        </div>
                    </td>
                    <td><span class="td-primary">@booking.Room</span></td>
                    <td>@booking.Schedule</td>
                    <td><StatusBadge Status="@booking.Status" /></td>
                </RowTemplate>
            </DataTable>
        </div>
    </div>
</div>

@code {
    // ── Chart data ──
    private List<TrendPoint> _trendData = new();
    private ApexChartOptions<TrendPoint> _trendOptions = new();
    private List<RoomUsagePoint> _donutData = new();
    private ApexChartOptions<RoomUsagePoint> _donutOptions = new();

    // ── Request overview data (ActionCard) ──
    private List<RequestItem> facilityRequests = new();
    private List<RequestItem> accountRequests = new();
    private List<RequestItem> itRequests = new();
    private List<RequestItem> bugRequests = new();

    // ── Table data ──
    private List<RecentRequest> recentRequests = new();
    private List<HistoryBooking> historyBookings = new();
    private List<DataTable<RecentRequest>.DataTableColumn> requestColumns = new();
    private List<DataTable<HistoryBooking>.DataTableColumn> bookingColumns = new();

    protected override void OnInitialized()
    {

        InitRequestOverview();
        InitCharts();
        InitTables();
    }

    private void InitRequestOverview()
    {
        facilityRequests = new()
        {
            new("Permintaan Katering", "FAC-2241", "Rapat Direksi — 2 jam lalu", "#F59E0B", "#FEF3C7", "🍽️", "#92400E"),
            new("Peralatan AV", "FAC-2238", "Ruang Rapat A — 5 jam lalu", "#F59E0B", "#FEF3C7", "📺", "#92400E"),
        };
        accountRequests = new()
        {
            new("Sari Wulandari", "ACC-1102", "Karyawan resign — Menunggu", "#EF4444", "#FEE2E2", "👤", "#991B1B"),
            new("Rudi Hartono", "ACC-1099", "Mutasi cabang — Menunggu", "#F59E0B", "#FEF3C7", "👤", "#92400E"),
        };
        itRequests = new()
        {
            new("Server Down", "IT-4421", "Server utama — 4 jam lalu", "#EF4444", "#FEE2E2", "🖥️", "#991B1B"),
            new("Reset Email", "IT-4418", "Belum Ditugaskan", "#F59E0B", "#FEF3C7", "📧", "#92400E"),
        };
        bugRequests = new()
        {
            new("Error 500 Submit Form", "BUG-102", "Form Booking — Kritis", "#EF4444", "#FEE2E2", "🐛", "#991B1B"),
            new("Kalender Tidak Sinkron", "BUG-099", "Modul Calendar — Medium", "#F59E0B", "#FEF3C7", "📅", "#92400E"),
        };
    }

    private void InitCharts()
    {
        _trendData = new()
        {
            new("Mei", 18), new("Jun", 24), new("Jul", 35),
            new("Ags", 28), new("Sep", 42), new("Okt", 88)
        };
        _trendOptions = new()
        {
            Chart = new Chart { Type = ChartType.Area, Height = "260px", Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }, Toolbar = new Toolbar { Show = false }, Zoom = new Zoom { Enabled = false } },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Fill = new Fill { Opacity = 0.15, Type = FillType.Solid },
            DataLabels = new DataLabels { Enabled = false },
            Markers = new Markers { Size = 3, Hover = new MarkersHover { Size = 5 } },
            Xaxis = new XAxis { Categories = _trendData.Select(d => d.Bulan).ToList(), Labels = new XAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "11px", Colors = new List<string> { "#8A97A6" } } } },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "11px", Colors = new List<string> { "#8A97A6" } } } } },
            Grid = new Grid { BorderColor = "#E8EDF2", StrokeDashArray = 4 },
            Colors = new List<string> { "#152F4A" },
            Theme = new Theme { Mode = Mode.Light }
        };

        _donutData = new() { new("Ruangan A", 35), new("Ruangan B", 25), new("Ruangan C", 20) };
        _donutOptions = new()
        {
            Chart = new Chart { Type = ChartType.Donut, Height = "200px", Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 } },
            PlotOptions = new PlotOptions { Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "65%", Labels = new DonutLabels { Show = true, Value = new DonutLabelValue { Show = true, FontSize = "24px", FontWeight = "700", Color = "#1F3B5B" }, Total = new DonutLabelTotal { Show = true, Label = "TOTAL", FontSize = "10px", FontWeight = "600", Color = "#8A97A6", ShowAlways = true } } } } },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend { Position = LegendPosition.Bottom, FontSize = "11px", FontWeight = "500", Markers = new LegendMarkers { Width = 8, Height = 8, Radius = 2 }, ItemMargin = new LegendItemMargin { Horizontal = 8, Vertical = 4 } },
            Colors = new List<string> { "#152F4A", "#2563EB", "#94A3B8" },
            Stroke = new Stroke { Width = 0 },
            Theme = new Theme { Mode = Mode.Light }
        };
    }

    private void InitTables()
    {
        requestColumns = new()
        {
            new() { Header = "JENIS PERMINTAAN", PropertyName = "Type" },
            new() { Header = "PEMOHON", PropertyName = "RequesterName" },
            new() { Header = "RINGKASAN", PropertyName = "Summary" },
            new() { Header = "STATUS", PropertyName = "Status" },
        };

        recentRequests = new()
        {
            new("Facility", "🏢", "#DBEAFE", "Rina Kartika", "RK", "#2563EB", "IT Dept", "Peminjaman proyektor ruang meeting lt 3", "baru"),
            new("Bug", "🐛", "#FEE2E2", "Dimas Prasetyo", "DP", "#EF4444", "Engineering", "Error 500 saat submit form booking", "diproses"),
            new("Account", "👤", "#FED7AA", "Sari Wulandari", "SW", "#F59E0B", "Marketing", "Penghapusan akun karyawan resign", "diproses"),
            new("IT", "🔧", "#D1FAE5", "Budi Santoso", "BS", "#10B981", "HR Dept", "Reset password email korporat", "selesai"),
            new("Facility", "🏢", "#DBEAFE", "Andi Saputra", "AS", "#2563EB", "IT Dept", "Request catering rapat direksi", "baru"),
        };

        bookingColumns = new()
        {
            new() { Header = "PENGGUNA", PropertyName = "UserName" },
            new() { Header = "RUANGAN", PropertyName = "Room" },
            new() { Header = "JADWAL", PropertyName = "Schedule" },
            new() { Header = "STATUS", PropertyName = "Status" },
        };

        historyBookings = new()
        {
            new("Andi Saputra", "AS", "#2563EB", "IT Dept", "R. (B)", "24-10-23, 09:00 - 11:00", "pending"),
            new("Budi Santoso", "BS", "#10B981", "HR Dept", "R. (D)", "24-10-23, 13:00 - 15:00", "confirmed"),
            new("Dian Pertiwi", "DP", "#F59E0B", "Marketing", "R. (C)", "25-10-23, 14:00 - 16:00", "rejected"),
        };
    }

    private void HandleRequestClick(RecentRequest req) { }

    // ── Records ──
    public record TrendPoint(string Bulan, int Jumlah);
    public record RoomUsagePoint(string NamaRuangan, int Jumlah);

    public record RequestItem(string Title, string Id, string Subtitle, string Color, string IconBg, string Icon, string SubColor);

    public record RecentRequest(string Type, string TypeIcon, string TypeColor, string RequesterName, string Initials, string AvatarColor, string Department, string Summary, string Status);

    public record HistoryBooking(string UserName, string Initials, string AvatarColor, string Department, string Room, string Schedule, string Status);
}




