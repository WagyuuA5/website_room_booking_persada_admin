    private void OpenDetailModal(RoomMaster room)
    {
        selectedRoom = room;
        isEditMode = false;
        showAddCustomInput = false;
        editForm = new RoomMaster
        {
            Id = room.Id,
            Name = room.Name,
            Location = room.Location,
            Capacity = room.Capacity,
            Amenities = new List<string>(room.Amenities),
            Description = room.Description,
            PhotoUrl = room.PhotoUrl,
            GalleryPhotos = new List<string>(room.GalleryPhotos),
            PinX = room.PinX,
            PinY = room.PinY,
            IsMaintenance = room.IsMaintenance
        };
        showDetailModal = true;
    }

