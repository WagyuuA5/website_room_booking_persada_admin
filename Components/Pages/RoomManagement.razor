    private void ToggleAmenity(string am)
    {
        if (editForm.Amenities.Contains(am)) editForm.Amenities.Remove(am);
        else editForm.Amenities.Add(am);
    }

    private void ToggleNewAmenity(string am)
    {
        if (newRoomForm.Amenities.Contains(am)) newRoomForm.Amenities.Remove(am);
        else newRoomForm.Amenities.Add(am);
    }

    private void AddCustomAmenityToEdit()
    {
        if (!string.IsNullOrWhiteSpace(newCustomAmenityText))
        {
            var tag = newCustomAmenityText.Trim().ToUpperInvariant();
            if (!allAvailableAmenities.Contains(tag)) allAvailableAmenities.Add(tag);
            if (!editForm.Amenities.Contains(tag)) editForm.Amenities.Add(tag);
            newCustomAmenityText = "";
            showAddCustomInput = false;
            Toast.Success($"Fasilitas '{tag}' berhasil ditambahkan.");
        }
    }

    private void AddCustomAmenityToNew()
    {
        if (!string.IsNullOrWhiteSpace(newCustomAmenityText))
        {
            var tag = newCustomAmenityText.Trim().ToUpperInvariant();
            if (!allAvailableAmenities.Contains(tag)) allAvailableAmenities.Add(tag);
            if (!newRoomForm.Amenities.Contains(tag)) newRoomForm.Amenities.Add(tag);
            newCustomAmenityText = "";
            showAddCustomInputNew = false;
            Toast.Success($"Fasilitas '{tag}' berhasil ditambahkan.");
        }
    }

    private string customAmenityToDelete = "";
    private bool showDeleteCustomAmenityModal = false;

    private void ConfirmDeleteCustomAmenity(string am)
    {
        customAmenityToDelete = am;
        showDeleteCustomAmenityModal = true;
    }

    private void ExecuteDeleteCustomAmenity()
    {
        if (!string.IsNullOrWhiteSpace(customAmenityToDelete))
        {
            allAvailableAmenities.Remove(customAmenityToDelete);
            editForm.Amenities.Remove(customAmenityToDelete);
            newRoomForm.Amenities.Remove(customAmenityToDelete);
            foreach (var r in rooms)
            {
                r.Amenities.Remove(customAmenityToDelete);
            }
            Toast.Success($"Fasilitas kustom '{customAmenityToDelete}' dihapus.");
            showDeleteCustomAmenityModal = false;
            customAmenityToDelete = "";
        }
    }

    private void AddUploadedPhotoToEdit(string url)
    {
        editForm.GalleryPhotos.Add(url);
        editForm.PhotoUrl = url;
        Toast.Success("Foto berhasil ditambahkan ke galeri.");
    }

    private void RemovePhotoFromEdit(string photo)
    {
        editForm.GalleryPhotos.Remove(photo);
        if (editForm.PhotoUrl == photo && editForm.GalleryPhotos.Any())
        {
            editForm.PhotoUrl = editForm.GalleryPhotos.First();
        }
    }

    private void SaveEditRoom()
    {
        if (selectedRoom != null)
        {
            selectedRoom.Name = editForm.Name;
            selectedRoom.Location = editForm.Location;
            selectedRoom.Capacity = editForm.Capacity;
            selectedRoom.Amenities = new List<string>(editForm.Amenities);
            selectedRoom.Description = editForm.Description;
            selectedRoom.PhotoUrl = editForm.PhotoUrl;
            selectedRoom.GalleryPhotos = new List<string>(editForm.GalleryPhotos);
            Toast.Success("Detail ruangan berhasil diperbarui.");
            showDetailModal = false;
        }
    }

    private void CreateNewRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomForm.Name))
        {
            Toast.Error("Nama ruangan wajib diisi.");
            return;
        }

        rooms.Add(new RoomMaster
        {
            Id = rooms.Count + 1,
            Name = newRoomForm.Name,
            Location = string.IsNullOrWhiteSpace(newRoomForm.Location) ? "Lantai 1, Wing Utama" : newRoomForm.Location,
            Capacity = newRoomForm.Capacity,
            Amenities = new List<string>(newRoomForm.Amenities),
            Description = newRoomForm.Description,
            PhotoUrl = string.IsNullOrWhiteSpace(newRoomForm.PhotoUrl) ? "https://images.unsplash.com/photo-1517502884422-41eaead166d4?w=800&auto=format&fit=crop&q=80" : newRoomForm.PhotoUrl,
            GalleryPhotos = new List<string> { string.IsNullOrWhiteSpace(newRoomForm.PhotoUrl) ? "https://images.unsplash.com/photo-1517502884422-41eaead166d4?w=800&auto=format&fit=crop&q=80" : newRoomForm.PhotoUrl },
            PinX = 50.0,
            PinY = 50.0
        });

        Toast.Success($"Ruangan '{newRoomForm.Name}' berhasil ditambahkan.");
        showAddModal = false;
    }

    private void ConfirmDelete(RoomMaster r)
    {
        roomToDelete = r;
        showDeleteModal = true;
    }

    private void ExecuteDelete()
    {
        if (roomToDelete != null)
        {
            rooms.Remove(roomToDelete);
            Toast.Success($"Ruangan '{roomToDelete.Name}' telah dihapus.");
            showDeleteModal = false;
        }
    }
