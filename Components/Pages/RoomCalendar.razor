@page "/room-calendar"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@inject booking_room_admin.Components.Services.LayoutTitleService LayoutTitleService

<div class="room-calendar">
    <div class="rc-header">
        <div class="rc-title-group">
            <span class="rc-title-bullet"></span>
            <h1 class="rc-title">Kalender Ruangan</h1>
        </div>
        <div class="rc-actions">
            <div class="rc-view-toggle">
                <button class="@(isAdminView ? "active" : "")" @onclick="() => SetView(true)">Admin View</button>
                <button class="@(!isAdminView ? "active" : "")" @onclick="() => SetView(false)">User View</button>
            </div>
            @if (isAdminView)
            {
                <button class="btn-primary" @onclick="OpenAddBlock">
                    <img src="icon/plus.svg" alt="Add" class="btn-icon" />
                    <span>+ Add Block</span>
                </button>
            }
        </div>
    </div>

    <div class="rc-toolbar">
        <select class="rc-filter-select">
            <option>All Floors</option>
            <option>Lantai 1</option>
            <option>Lantai 2</option>
        </select>
        
        <div class="rc-date-nav">
            <button class="rc-nav-btn">&lt;</button>
            <span class="rc-current-date">Today, 27 Aug</span>
            <button class="rc-nav-btn">&gt;</button>
        </div>
        
        <div class="rc-legend">
            <div class="legend-item"><span class="box available"></span> Available</div>
            <div class="legend-item"><span class="box booked"></span> Booked</div>
            <div class="legend-item"><span class="box blocked"></span> Blocked</div>
            <div class="legend-item"><span class="box pending"></span> Pending</div>
        </div>
    </div>

    <div class="rc-grid-container">
        <table class="rc-grid">
            <thead>
                <tr>
                    <th class="rc-room-col">Ruangan</th>
                    @for (int i = 8; i <= 19; i++)
                    {
                        <th>@($"{i:D2}:00")</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr class="rc-floor-row">
                    <td colspan="13">Lantai 1</td>
                </tr>
                <tr>
                    <td class="rc-room-name">Ruang Diskusi A</td>
                    @for (int i = 8; i <= 19; i++)
                    {
                        if (i == 10)
                        {
                            <td colspan="2" class="cell-booked">
                                <div class="event-content">Budi (IT)</div>
                            </td>
                            i++; // skip next since colspan=2
                        }
                        else
                        {
                            <td class="cell-available"></td>
                        }
                    }
                </tr>
                <tr>
                    <td class="rc-room-name">Ruang Meeting B</td>
                    @for (int i = 8; i <= 19; i++)
                    {
                        if (i == 13)
                        {
                            <td colspan="3" class="cell-pending">
                                <div class="event-content">Siti (HRD)</div>
                            </td>
                            i += 2; // skip next 2
                        }
                        else if (i == 17)
                        {
                            <td colspan="1" class="cell-blocked">
                                <div class="event-content">Maintenance</div>
                            </td>
                        }
                        else
                        {
                            <td class="cell-available"></td>
                        }
                    }
                </tr>
            </tbody>
        </table>
    </div>

    <div class="rc-summary-panel">
        <div class="summary-item">
            <span class="summary-label">Total Rooms:</span>
            <span class="summary-value">12</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Currently Blocked:</span>
            <span class="summary-value">2</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Pending Overrides:</span>
            <span class="summary-value">1</span>
        </div>
        <div class="summary-link">
            <a href="#">View Audit Log</a>
        </div>
    </div>

    <AddBlockPopup IsOpen="@showAddBlock" IsOpenChanged="@((v) => showAddBlock = v)" />
</div>

@code {
    private bool isAdminView = true;
    private bool showAddBlock = false;

    protected override void OnInitialized()
    {
        LayoutTitleService.Title = "Kalender Ruangan";
    }

    private void SetView(bool isadmin)
    {
        isAdminView = isadmin;
    }

    private void OpenAddBlock()
    {
        showAddBlock = true;
    }
}
