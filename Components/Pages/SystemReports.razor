@page "/reports"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using ApexCharts

<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Laporan Sistem" PageSubtitle="Analisis performa dan penggunaan sistem pemesanan ruangan secara menyeluruh." ShowGlobalSearch="true" ShowGlobalDate="false" />

<div class="system-reports">
    <div class="sr-filters">
        <select class="sr-filter-select">
            <option>Bulan Ini (Okt 2026)</option>
            <option>Bulan Lalu</option>
            <option>3 Bulan Terakhir</option>
            <option>Tahun Ini</option>
        </select>
        <select class="sr-filter-select">
            <option>Semua Departemen</option>
            <option>IT & Digital</option>
            <option>Operasional</option>
            <option>Keuangan</option>
        </select>
        <select class="sr-filter-select">
            <option>Semua Gedung</option>
            <option>Gedung A</option>
            <option>Gedung B</option>
        </select>
        <div style="flex:1"></div>
        <button class="btn-export" @onclick="() => showExport = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export Laporan
        </button>
    </div>

    @if (hasData)
    {
        <div class="sr-kpis">
            <div class="sr-kpi-card">
                <div class="kpi-title">Total Booking Periode Ini</div>
                <div class="kpi-val-row">
                    <div class="kpi-value">1,245</div>
                    <div class="kpi-trend trend-up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg> 12%</div>
                </div>
            </div>
            <div class="sr-kpi-card">
                <div class="kpi-title">Rata-rata Utilisasi</div>
                <div class="kpi-val-row">
                    <div class="kpi-value">68%</div>
                    <div class="kpi-trend trend-up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg> 5%</div>
                </div>
            </div>
            <div class="sr-kpi-card">
                <div class="kpi-title">Tingkat No-Show</div>
                <div class="kpi-val-row">
                    <div class="kpi-value">4.2%</div>
                    <div class="kpi-trend trend-down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg> 1.1%</div>
                </div>
            </div>
            <div class="sr-kpi-card">
                <div class="kpi-title">Rata-rata Durasi Rapat</div>
                <div class="kpi-val-row">
                    <div class="kpi-value">1j 45m</div>
                    <div class="kpi-trend trend-neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg> 0%</div>
                </div>
            </div>
        </div>

        <div class="sr-charts-row">
            <div class="sr-chart-container" style="flex: 2;">
                <h3 class="sr-chart-title">Tren Booking (Harian)</h3>
                <ApexChart TItem="ChartData" Height="300">
                    <ApexPointSeries TItem="ChartData" Items="trendData" Name="Total Booking" SeriesType="SeriesType.Area" XValue="@(_ => _.Label)" YAggregate="@(_ => _.Sum(e => e.Value))" />
                </ApexChart>
            </div>
            <div class="sr-chart-container" style="flex: 1;">
                <h3 class="sr-chart-title">Booking per Departemen</h3>
                <ApexChart TItem="ChartData" Height="300">
                    <ApexPointSeries TItem="ChartData" Items="deptData" Name="Departemen" SeriesType="SeriesType.Donut" XValue="@(_ => _.Label)" YAggregate="@(_ => _.Sum(e => e.Value))" />
                </ApexChart>
            </div>
        </div>

        <div class="sr-charts-row">
            <div class="sr-chart-container" style="flex: 2;">
                <h3 class="sr-chart-title">Peta Jam Sibuk (Heatmap)</h3>
                <ApexChart TItem="HeatmapData" Height="350">
                    <ApexPointSeries TItem="HeatmapData" Items="heatmapMon" Name="Senin" SeriesType="SeriesType.Heatmap" XValue="@(_ => _.Hour)" YAggregate="@(_ => _.Sum(e => e.Intensity))" />
                    <ApexPointSeries TItem="HeatmapData" Items="heatmapTue" Name="Selasa" SeriesType="SeriesType.Heatmap" XValue="@(_ => _.Hour)" YAggregate="@(_ => _.Sum(e => e.Intensity))" />
                    <ApexPointSeries TItem="HeatmapData" Items="heatmapWed" Name="Rabu" SeriesType="SeriesType.Heatmap" XValue="@(_ => _.Hour)" YAggregate="@(_ => _.Sum(e => e.Intensity))" />
                    <ApexPointSeries TItem="HeatmapData" Items="heatmapThu" Name="Kamis" SeriesType="SeriesType.Heatmap" XValue="@(_ => _.Hour)" YAggregate="@(_ => _.Sum(e => e.Intensity))" />
                    <ApexPointSeries TItem="HeatmapData" Items="heatmapFri" Name="Jumat" SeriesType="SeriesType.Heatmap" XValue="@(_ => _.Hour)" YAggregate="@(_ => _.Sum(e => e.Intensity))" />
                </ApexChart>
            </div>
            <div class="sr-chart-container" style="flex: 1;">
                <h3 class="sr-chart-title">Utilisasi per Ruangan (Top 5)</h3>
                <div class="sr-util-list">
                    <div class="sr-util-item">
                        <div class="sr-util-info"><span>Ruang Rapat A</span><span>85%</span></div>
                        <div class="sr-util-bar-bg"><div class="sr-util-bar" style="width:85%; background:#2563EB;"></div></div>
                    </div>
                    <div class="sr-util-item">
                        <div class="sr-util-info"><span>Ruang Rapat Utama</span><span>78%</span></div>
                        <div class="sr-util-bar-bg"><div class="sr-util-bar" style="width:78%; background:#2563EB;"></div></div>
                    </div>
                    <div class="sr-util-item">
                        <div class="sr-util-info"><span>Ruang Diskusi B</span><span>62%</span></div>
                        <div class="sr-util-bar-bg"><div class="sr-util-bar" style="width:62%; background:#2563EB;"></div></div>
                    </div>
                    <div class="sr-util-item">
                        <div class="sr-util-info"><span>Auditorium</span><span>45%</span></div>
                        <div class="sr-util-bar-bg"><div class="sr-util-bar" style="width:45%; background:#F59E0B;"></div></div>
                    </div>
                    <div class="sr-util-item">
                        <div class="sr-util-info"><span>Ruang Interview</span><span>30%</span></div>
                        <div class="sr-util-bar-bg"><div class="sr-util-bar" style="width:30%; background:#EF4444;"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="sr-table-section">
            <h3 class="sr-chart-title">Detail Booking</h3>
            <DataTable TItem="BookingDetail" Items="bookingDetails" Columns="bookingColumns" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">??</div>
            <h3 class="empty-title">Tidak Ada Data</h3>
            <p class="empty-desc">Belum ada aktivitas booking pada rentang waktu atau filter yang Anda pilih.</p>
            <button class="btn-primary" @onclick="ResetFilters">Reset Filter</button>
        </div>
    }
</div>

<ExportModal IsOpen="showExport" IsOpenChanged="v => showExport = v" />

@code {
    private bool hasData = true;
    private bool showExport = false;

    public class ChartData { public string Label { get; set; } = ""; public int Value { get; set; } }
    public class HeatmapData { public string Hour { get; set; } = ""; public int Intensity { get; set; } }

    private List<ChartData> trendData = new()
    {
        new() { Label = "01 Okt", Value = 12 }, new() { Label = "02 Okt", Value = 25 },
        new() { Label = "03 Okt", Value = 18 }, new() { Label = "04 Okt", Value = 30 },
        new() { Label = "05 Okt", Value = 28 }, new() { Label = "06 Okt", Value = 45 },
        new() { Label = "07 Okt", Value = 38 }
    };

    private List<ChartData> deptData = new()
    {
        new() { Label = "IT & Digital", Value = 35 }, new() { Label = "Operasional", Value = 25 },
        new() { Label = "SDM", Value = 20 }, new() { Label = "Keuangan", Value = 15 },
        new() { Label = "Lainnya", Value = 5 }
    };

    private List<HeatmapData> heatmapMon = new();
    private List<HeatmapData> heatmapTue = new();
    private List<HeatmapData> heatmapWed = new();
    private List<HeatmapData> heatmapThu = new();
    private List<HeatmapData> heatmapFri = new();

    protected override void OnInitialized()
    {
        Random r = new Random();
        string[] hours = { "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00" };
        foreach(var h in hours) {
            heatmapMon.Add(new() { Hour = h, Intensity = r.Next(10, 100) });
            heatmapTue.Add(new() { Hour = h, Intensity = r.Next(10, 100) });
            heatmapWed.Add(new() { Hour = h, Intensity = r.Next(10, 100) });
            heatmapThu.Add(new() { Hour = h, Intensity = r.Next(10, 100) });
            heatmapFri.Add(new() { Hour = h, Intensity = r.Next(10, 100) });
        }
    }

    public class BookingDetail {
        public string Id { get; set; } = "";
        public string Dept { get; set; } = "";
        public string Room { get; set; } = "";
        public string Schedule { get; set; } = "";
        public string Duration { get; set; } = "";
        public string Approver { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private List<BookingDetail> bookingDetails = new()
    {
        new() { Id = "B-1001", Dept = "IT & Digital", Room = "Ruang Rapat A", Schedule = "01 Okt 2026 09:00", Duration = "2 Jam", Approver = "Wahyu", Status = "Selesai" },
        new() { Id = "B-1002", Dept = "SDM", Room = "Ruang Interview", Schedule = "01 Okt 2026 10:00", Duration = "1 Jam", Approver = "Sarah", Status = "Selesai" },
        new() { Id = "B-1003", Dept = "Operasional", Room = "Auditorium", Schedule = "02 Okt 2026 13:00", Duration = "4 Jam", Approver = "Wahyu", Status = "Selesai" }
    };

    private List<DataTable<BookingDetail>.DataTableColumn> bookingColumns = new()
    {
        new() { Header = "ID Booking", PropertyName = "Id" },
        new() { Header = "Departemen", PropertyName = "Dept" },
        new() { Header = "Ruangan", PropertyName = "Room" },
        new() { Header = "Jadwal", PropertyName = "Schedule" },
        new() { Header = "Durasi", PropertyName = "Duration" },
        new() { Header = "Disetujui Oleh", PropertyName = "Approver" },
        new() { Header = "Status", PropertyName = "Status" }
    };

    private void ResetFilters()
    {
        hasData = true;
    }
}


