@page "/login"
@layout booking_room_admin.Components.Layout.EmptyLayout
@inject booking_room_admin.Components.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using booking_room_admin.Components.Shared

<div class="login-container @(isSuccess ? "login-success" : "")">
    <div class="login-left">
        <div class="login-hero">
            <div class="hero-overlay"></div>
            <img src="FOTO GEDEUNG PERSADA.png" alt="Gedung Persada" class="hero-bg" />
            <div class="hero-content">
                <img src="logo-persada.png" alt="PT PERSADA" class="hero-logo" />
                <h1 class="hero-title">Sistem Manajemen<br/>Ruangan & Pemesanan</h1>
                <p class="hero-subtitle">Kelola dan jadwalkan fasilitas ruang rapat dengan mudah, efisien, dan terintegrasi penuh untuk seluruh operasional PT PERSADA.</p>
            </div>
        </div>
    </div>
    
    <div class="login-right">
        <div class="login-form-container">
            <div class="login-header">
                <h2>Selamat Datang</h2>
                <p>Silakan masuk ke akun Anda</p>
            </div>

            <form @onsubmit="HandleLogin" class="login-form">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">
                        <Icon Name="alert-circle" Size="18" />
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label for="email">Alamat Email</label>
                    <div class="input-icon-wrap">
                        <Icon Name="mail" Size="18" class="input-icon" />
                        <input type="email" id="email" @bind="email" @bind:event="oninput" placeholder="contoh@ptpersada.co.id" class="form-input @(emailError ? "input-error" : "")" />
                    </div>
                    @if (emailError)
                    {
                        <span class="error-text">Format email tidak valid atau kosong.</span>
                    }
                </div>

                <div class="form-group">
                    <label for="password">Kata Sandi</label>
                    <div class="input-icon-wrap">
                        <Icon Name="lock" Size="18" class="input-icon" />
                        <input type="@(showPassword ? "text" : "password")" id="password" @bind="password" @bind:event="oninput" placeholder="Masukkan kata sandi" class="form-input @(passwordError ? "input-error" : "")" />
                        <button type="button" class="btn-toggle-pass" @onclick="TogglePassword">
                            <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="18" />
                        </button>
                    </div>
                    @if (passwordError)
                    {
                        <span class="error-text">Kata sandi minimal 8 karakter.</span>
                    }
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" @bind="rememberMe" />
                        <span>Ingat saya</span>
                    </label>
                    <a href="#" class="forgot-link">Lupa kata sandi?</a>
                </div>

                <button type="submit" class="btn-login @(isLoading ? "loading" : "")" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Memverifikasi...</span>
                    }
                    else
                    {
                        <span>Masuk ke Sistem</span>
                    }
                </button>
            </form>
            
            <div class="login-footer">
                <p>2026 &copy; PT PERSADA. Seluruh hak cipta dilindungi.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool rememberMe = false;
    private bool showPassword = false;
    
    private bool isLoading = false;
    private bool isSuccess = false;
    
    private bool emailError = false;
    private bool passwordError = false;
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        // Reset errors
        emailError = false;
        passwordError = false;
        errorMessage = "";

        // Client-side validation
        if (string.IsNullOrWhiteSpace(email) || !email.Contains("@"))
        {
            emailError = true;
        }
        if (string.IsNullOrWhiteSpace(password) || password.Length < 8)
        {
            passwordError = true;
        }

        if (emailError || passwordError)
        {
            return;
        }

        isLoading = true;
        
        // Server-side validation simulation
        bool success = await AuthService.LoginAsync(email, password);
        
        isLoading = false;

        if (success)
        {
            isSuccess = true;
            StateHasChanged();
            
            // Wait for transition animation
            await Task.Delay(500); 
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = "Kombinasi email dan kata sandi salah.";
        }
    }
}
