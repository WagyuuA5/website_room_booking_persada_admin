@page "/login"
@layout booking_room_admin.Components.Layout.EmptyLayout
@inject booking_room_admin.Components.Services.AuthService AuthService
@inject booking_room_admin.Components.Services.ToastService Toast
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Services

<div class="login-wrapper @(isSuccess ? "transition-to-dashboard" : "")">
    @* Background Image & Overlay *@
    <div class="login-bg-container @(isSuccess ? "bg-zoom-out" : "")">
        <img src="FOTO GEDEUNG PERSADA.png" alt="Gedung PT PERSADA" class="login-bg-img" />
        <div class="login-bg-overlay"></div>
    </div>

    @* Header: Logo PERSADA (Kiri Atas) *@
    <header class="login-topbar">
        <img src="logo-persada.png" alt="Logo PT PERSADA" class="persada-logo" />
    </header>

    @* Center Content: Login Card *@
    <main class="login-main">
        <div class="login-card @(cardShake ? "card-shake" : "") @(isSuccess ? "card-exit" : "")">
            <div class="card-header">
                <h1 class="card-title">Masuk</h1>
                <p class="card-subtitle">Sistem Manajemen Ruangan & Pemesanan</p>
            </div>

            <form @onsubmit="HandleSubmit" class="login-form" novalidate>
                @* Server-side Error Banner *@
                @if (!string.IsNullOrEmpty(serverErrorMessage))
                {
                    <div class="server-error-banner" role="alert">
                        <Icon Name="alert-circle" Size="18" />
                        <span>@serverErrorMessage</span>
                    </div>
                }

                @* Field 1: Email *@
                <div class="form-group">
                    <label for="email" class="form-label">Email</label>
                    <div class="input-wrap">
                        <Icon Name="mail" Size="18" class="input-icon" />
                        <input type="email"
                               id="email"
                               class="form-input @(emailError != null ? "input-error shake-field" : "")"
                               placeholder="nama@ptpersada.co.id"
                               @bind="email"
                               @bind:event="oninput"
                               @onblur="ValidateEmailOnBlur"
                               autocomplete="username" />
                    </div>
                    @if (emailError != null)
                    {
                        <span class="field-error-text">@emailError</span>
                    }
                </div>

                @* Field 2: Kata Sandi *@
                <div class="form-group">
                    <label for="password" class="form-label">Kata Sandi</label>
                    <div class="input-wrap">
                        <Icon Name="lock" Size="18" class="input-icon" />
                        <input type="@(showPassword ? "text" : "password")"
                               id="password"
                               class="form-input @(passwordError != null ? "input-error shake-field" : "")"
                               placeholder="Masukkan kata sandi"
                               @bind="password"
                               @bind:event="oninput"
                               @onblur="ValidatePasswordOnBlur"
                               autocomplete="current-password" />
                        <button type="button"
                                class="btn-toggle-visibility"
                                @onclick="TogglePasswordVisibility"
                                aria-label="@(showPassword ? "Sembunyikan kata sandi" : "Tampilkan kata sandi")"
                                title="@(showPassword ? "Sembunyikan kata sandi" : "Tampilkan kata sandi")">
                            <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="18" />
                        </button>
                    </div>
                    @if (passwordError != null)
                    {
                        <span class="field-error-text">@passwordError</span>
                    }
                </div>

                @* Options: Ingat Saya & Lupa Kata Sandi *@
                <div class="form-options">
                    <label class="remember-option">
                        <input type="checkbox" @bind="rememberMe" />
                        <span>Ingat saya</span>
                    </label>
                    <a href="javascript:void(0)" @onclick="HandleForgotPassword" class="forgot-link">Lupa Kata Sandi?</a>
                </div>

                @* Submit Button *@
                <button type="submit" class="btn-submit @(isLoading ? "is-loading" : "") @(showSuccessCheck ? "is-success" : "")" disabled="@(isLoading || isSuccess)">
                    @if (showSuccessCheck)
                    {
                        <Icon Name="check" Size="18" />
                        <span>Berhasil</span>
                    }
                    else if (isLoading)
                    {
                        <span class="spinner-sm"></span>
                        <span>Memproses...</span>
                    }
                    else
                    {
                        <span>Masuk</span>
                    }
                </button>
            </form>

            <div class="card-footer">
                <p>2026 &copy; PT PERSADA. Seluruh hak cipta dilindungi.</p>
            </div>
        </div>
    </main>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool rememberMe = false;
    private bool showPassword = false;

    private string? emailError = null;
    private string? passwordError = null;
    private string? serverErrorMessage = null;

    private bool isLoading = false;
    private bool showSuccessCheck = false;
    private bool isSuccess = false;
    private bool cardShake = false;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ValidateEmailOnBlur()
    {
        if (!string.IsNullOrEmpty(email))
        {
            ValidateEmailField();
        }
    }

    private void ValidatePasswordOnBlur()
    {
        if (!string.IsNullOrEmpty(password))
        {
            ValidatePasswordField();
        }
    }

    private bool ValidateEmailField()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            emailError = "Email wajib diisi.";
            return false;
        }

        // Standard email regex format validation
        var emailRegex = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
        if (!emailRegex.IsMatch(email.Trim()))
        {
            emailError = "Format email tidak valid.";
            return false;
        }

        emailError = null;
        return true;
    }

    private bool ValidatePasswordField()
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            passwordError = "Kata sandi wajib diisi.";
            return false;
        }

        if (password.Length < 8)
        {
            passwordError = "Kata sandi minimal 8 karakter.";
            return false;
        }

        passwordError = null;
        return true;
    }

    private async Task HandleSubmit()
    {
        serverErrorMessage = null;

        // 1. Client-side Validation (Bagian 2.1)
        bool isEmailValid = ValidateEmailField();
        bool isPasswordValid = ValidatePasswordField();

        if (!isEmailValid || !isPasswordValid)
        {
            // Trigger quick card shake on validation failure
            TriggerCardShake();
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            // 2. Server-side Authentication (Bagian 2.2)
            var result = await AuthService.AuthenticateAsync(email.Trim(), password);

            if (result.Type == AuthResultType.Success)
            {
                isLoading = false;
                showSuccessCheck = true;
                StateHasChanged();

                // Show checkmark briefly (~300ms)
                await Task.Delay(300);

                // Start transition animation (card fade-out + bg zoom-out)
                isSuccess = true;
                StateHasChanged();

                // Allow 350ms for transition animation before navigating (total ~650ms)
                await Task.Delay(350);
                NavigationManager.NavigateTo("/dashboard");
            }
            else if (result.Type == AuthResultType.ConnectionFailed)
            {
                isLoading = false;
                // Connection failure goes to InfoToast / Toast as per requirement
                Toast.Error(result.ErrorMessage ?? "Tidak dapat terhubung ke server. Periksa koneksi internet Anda.");
                TriggerCardShake();
            }
            else
            {
                isLoading = false;
                // Invalid credentials or Inactive account banner
                serverErrorMessage = result.ErrorMessage ?? "Email atau kata sandi salah.";
                TriggerCardShake();
            }
        }
        catch
        {
            isLoading = false;
            Toast.Error("Tidak dapat terhubung ke server. Periksa koneksi internet Anda.");
            TriggerCardShake();
        }
    }

    private void TriggerCardShake()
    {
        cardShake = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(350);
            await InvokeAsync(() =>
            {
                cardShake = false;
                StateHasChanged();
            });
        });
    }

    private void HandleForgotPassword()
    {
        Toast.Info("Tautan pengaturan ulang kata sandi dapat diminta melalui administrator IT PT PERSADA.");
    }
}
