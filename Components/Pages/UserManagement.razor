    private void GeneratePassword()
    {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%";
        var random = new Random();
        newPasswordInput = new string(Enumerable.Repeat(chars, 10).Select(s => s[random.Next(s.Length)]).ToArray());
    }

    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(newPasswordInput))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", newPasswordInput);
            Toast.Success("Password disalin ke clipboard!");
        }
    }

