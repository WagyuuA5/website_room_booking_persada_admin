        csvPreviewList = new List<User>
        {
            new() { FullName = "Anton Kurniawan", Email = "anton.k@ptpersada.co.id", Department = "Operasional", Role = "Pengguna", EmployeeId = "PSD-2001", Status = "active" },
            new() { FullName = "Rina Susanti", Email = "rina.s@ptpersada.co.id", Department = "Keuangan", Role = "Pengguna", EmployeeId = "PSD-2002", Status = "active" },
            new() { FullName = "Doni Ramadhan", Email = "doni.r@ptpersada.co.id", Department = "IT & Digital", Role = "Admin", EmployeeId = "PSD-2003", Status = "active" }
