@page "/users"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject IUserService UserService


<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Manajemen Pengguna" PageSubtitle="Kelola akses dan peran pengguna aplikasi." />
<div class="user-management">
    <div class="toolbar">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Cari nama atau email..." @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
        </div>
        <div class="filters">
            <select class="filter-select" @bind="roleFilter" @bind:after="LoadUsers">
                <option value="All">Semua Role</option>
                <option value="Admin">Admin</option>
                <option value="Approver">Approver</option>
                <option value="User">User</option>
            </select>
            <button class="btn-primary" @onclick="() => showAddUser = true">+ Tambah Pengguna</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <span>Memuat data pengguna...</span>
        </div>
    }
    else
    {
        <DataTable TItem="User" Items="users" Columns="columns" TotalCount="totalCount" PageSize="pageSize" CurrentPage="currentPage" OnPageChanged="HandlePageChange" ShowCheckbox="true" OnSelectionChanged="HandleSelection">
            <BulkActions>
                <button class="btn-bulk">Set Active</button>
                <button class="btn-bulk btn-danger">Hapus Terpilih</button>
            </BulkActions>
            <RowTemplate Context="user">
                <td>
                    <div class="user-cell">
                        <div class="user-avatar" style="background: @GetAvatarColor(user.FullName)">@user.Initials</div>
                        <div>
                            <span class="td-primary">@user.FullName</span>
                            <span class="td-secondary">@user.Email</span>
                        </div>
                    </div>
                </td>
                <td><span class="td-primary">@user.Department</span></td>
                <td><span class="role-badge @user.Role.ToLower()">@user.Role</span></td>
                <td><StatusBadge Status="@user.Status" /></td>
                <td><span class="td-secondary">@user.TotalBookings Booking</span></td>
                <td>
                    <div class="action-buttons">
                        <button class="btn-icon" title="Edit Role" @onclick="() => OpenRoleModal(user)">✎</button>
                    </div>
                </td>
            </RowTemplate>
        </DataTable>
    }
</div>

@if (showAddUser)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => showAddUser = v)" Title="Tambah Pengguna Baru" Size="medium">
        <ChildContent>
            <p>Fitur penambahan pengguna sinkronisasi dengan Azure AD sedang dikembangkan.</p>
        </ChildContent>
        <FooterContent>
            <button class="btn-primary" @onclick="() => showAddUser = false">Tutup</button>
        </FooterContent>
    </AppModal>
}

@if (showRoleModal && selectedUser != null)
{
    <AppModal IsOpen="true" IsOpenChanged="@((bool v) => showRoleModal = v)" Title="Ubah Role Pengguna" Size="small">
        <ChildContent>
            <div style="margin-bottom: 1rem;">
                <strong>Pengguna:</strong> @selectedUser.FullName
            </div>
            <label style="display: block; margin-bottom: 0.5rem; font-size: 0.85rem; color: #374151;">Pilih Role Baru:</label>
            <select class="filter-select" style="width: 100%;" @bind="newRole">
                <option value="Admin">Admin</option>
                <option value="Approver">Approver</option>
                <option value="User">User</option>
            </select>
        </ChildContent>
        <FooterContent>
            <button class="btn-outline" style="padding: 0.4rem 1rem; border: 1px solid #D1D5DB; border-radius: 8px; background: white; cursor: pointer;" @onclick="() => showRoleModal = false">Batal</button>
            <button class="btn-primary" @onclick="SaveRole">Simpan</button>
        </FooterContent>
    </AppModal>
}

@code {
    private List<User> users = new();
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 15;
    private bool isLoading = true;
    
    private string searchQuery = "";
    private string roleFilter = "All";
    
    private bool showAddUser = false;
    private bool showRoleModal = false;
    private User? selectedUser;
    private string newRole = "";
    
    private List<DataTable<User>.DataTableColumn> columns = new();

    protected override async Task OnInitializedAsync()
    {

        columns = new()
        {
            new() { Header = "PENGGUNA", PropertyName = "FullName" },
            new() { Header = "DEPARTEMEN", PropertyName = "Department" },
            new() { Header = "PERAN", PropertyName = "Role" },
            new() { Header = "STATUS", PropertyName = "Status" },
            new() { Header = "TOTAL BOOKING", PropertyName = "TotalBookings" },
            new() { Header = "AKSI", PropertyName = "" }
        };

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        StateHasChanged();

        var result = await UserService.GetUsersAsync(currentPage, pageSize, searchQuery, roleFilter);
        users = result.Users.ToList();
        totalCount = result.TotalCount;

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandlePageChange(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadUsers();
        }
    }

    private void HandleSelection(List<User> selected) { }

    private void OpenRoleModal(User u)
    {
        selectedUser = u;
        newRole = u.Role;
        showRoleModal = true;
    }

    private async Task SaveRole()
    {
        if (selectedUser != null)
        {
            await UserService.UpdateUserRoleAsync(selectedUser.Id, newRole);
            await LoadUsers();
        }
        showRoleModal = false;
    }

    private string GetAvatarColor(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#2563EB";
        var hash = name.GetHashCode();
        var colors = new[] { "#2563EB", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#EC4899" };
        return colors[Math.Abs(hash) % colors.Length];
    }
}
