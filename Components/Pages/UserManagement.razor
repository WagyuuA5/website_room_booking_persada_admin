    private void OpenDetailModal(User u)
    {
        selectedUserForDetail = u;
        showDetailModal = true;
    }

    private async Task DeactivateUser()
    {
        if (userToDelete != null)
        {
            userToDelete.Status = "inactive";
            Toast.Success($"Pengguna {userToDelete.FullName} berhasil dinonaktifkan.");
