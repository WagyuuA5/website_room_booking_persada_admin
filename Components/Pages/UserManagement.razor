@page "/users"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject IUserService UserService
@inject ToastService Toast
@inject IJSRuntime JS

<TopBar Title="Manajemen Pengguna" Subtitle="Kelola akses, profil, dan hak pengguna sistem pemesanan ruangan." />

<div class="user-management-page">

    @* -- Baris Aksi: search + filter + ekspor + import + CTA -- *@
    <div class="um-toolbar">
        <div class="um-search-box">
            <Icon Name="search" Size="16" CssClass="um-search-icon" />
            <input type="text" placeholder="Cari berdasarkan nama, email, atau ID pengguna..." @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKey" />
        </div>
        <select class="um-filter-select" @bind="departmentFilter" @bind:after="LoadUsers">
            <option value="All">Semua Divisi</option>
            <option value="IT & Digital">IT & Digital</option>
            <option value="Operasional">Operasional</option>
            <option value="Sumber Daya Manusia (SDM)">Sumber Daya Manusia (SDM)</option>
            <option value="Keuangan">Keuangan</option>
            <option value="Marketing & Komunikasi">Marketing & Komunikasi</option>
            <option value="Legal & Kepatuhan">Legal & Kepatuhan</option>
            <option value="General Affairs (GA)">General Affairs (GA)</option>
            <option value="Layanan Keamanan">Layanan Keamanan</option>
            <option value="Call Center & Layanan Pelanggan">Call Center & Layanan Pelanggan</option>
            <option value="Layanan Perkantoran">Layanan Perkantoran</option>
            <option value="Teknikal & Pemeliharaan Telekomunikasi">Teknikal & Pemeliharaan Telekomunikasi</option>
        </select>
        <button type="button" class="btn-export-um" @onclick="OpenExportModal">
            <Icon Name="download" Size="14" />
            <span>Ekspor</span>
        </button>
        <button type="button" class="btn-outline-pill" @onclick="() => showImportModal = true">
            <Icon Name="upload" Size="14" />
            <span>Impor CSV</span>
        </button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Tambah Pengguna</span>
        </button>
    </div>

    @if (hasError)
    {
        <div class="error-state">
            <div class="error-icon"><Icon Name="alert-triangle" Size="36" CssClass="text-danger" /></div>
            <h3 class="error-title">Tidak dapat memuat data user</h3>
            <p class="error-desc">Terjadi kendala saat menghubungkan ke database pengguna. Silakan coba kembali.</p>
            <button class="btn-primary-pill btn-yellow" @onclick="LoadUsers">Coba Lagi</button>
        </div>
    }
    else if (isLoading)
    {
        <div class="skeleton-loader">
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
        </div>
    }
    else if (!users.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="users" Size="36" CssClass="text-muted" /></div>
            <h3 class="empty-title">Tidak ada user ditemukan</h3>
            <p class="empty-desc">Tidak ada akun pengguna yang cocok dengan kriteria pencarian atau filter yang dipilih.</p>
            <button class="btn-primary-pill btn-yellow" @onclick="ResetFilters">Reset Filter</button>
        </div>
    }
    else
    {
        <div class="um-table-container">
            <DataTable TItem="User"
                       Items="users"
                       Columns="columns"
                       TotalCount="totalCount"
                       PageSize="pageSize"
                       CurrentPage="currentPage"
                       OnPageChanged="HandlePageChange"
                       OnRowClick="OpenDetailModal"
                       ShowCheckbox="false">
                <RowTemplate Context="u">
                    <td>
                        <div class="user-row-cell">
                            <div class="user-avatar-circle" style="background: @GetAvatarColor(u.FullName)">
                                @u.Initials
                            </div>
                            <div class="user-name-box">
                                <span class="user-full-name">@u.FullName</span>
                                <span class="user-email-text">@u.Email</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="um-dept-text">@u.Department</span>
                    </td>
                    <td>
                        <span class="um-bookings-text">@u.TotalBookings Booking</span>
                    </td>
                    <td>
                        <span class="um-status-pill @(u.Status.ToLower() == "active" ? "status-active" : "status-inactive")">
                            <span class="status-dot"></span>
                            @(u.Status.ToLower() == "active" ? "Aktif" : "Tidak Aktif")
                        </span>
                    </td>
                    <td>
                        <div class="um-actions" @onclick:stopPropagation="true">
                            <button type="button" class="btn-action-edit" title="Edit Pengguna" @onclick="() => OpenEditModal(u)">
                                <Icon Name="edit" Size="16" />
                            </button>
                            <button type="button" class="btn-action-delete" title="Hapus User" @onclick="() => OpenDeleteModal(u)">
                                <Icon Name="trash-2" Size="16" />
                            </button>
                        </div>
                    </td>
                </RowTemplate>
            </DataTable>
        </div>
    }
</div>

@* -- Modal 1: Tambah User -- *@
<AppModal IsOpen="showAddModal" IsOpenChanged="v => showAddModal = v" Title="Tambah User" Size="medium">
    <ChildContent>
        <p class="modal-subtitle-text">Tambahkan pengguna baru ke sistem booking ruangan.</p>
        
        <div class="um-form">
            <div class="form-group">
                <label class="form-label">Nama Lengkap <span class="req">*</span></label>
                <input type="text" class="form-input @(hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.FullName) ? "is-invalid" : "")" placeholder="Contoh: Budi Santoso" @bind="formModel.FullName" />
                @if (hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.FullName))
                {
                    <span class="field-error">Nama lengkap wajib diisi.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Email Perusahaan <span class="req">*</span></label>
                <input type="email" class="form-input @(hasAddSubmitted && !IsValidEmail(formModel.Email) ? "is-invalid" : "")" placeholder="Contoh: budi.santoso@ptpersada.co.id" @bind="formModel.Email" />
                @if (hasAddSubmitted)
                {
                    if (string.IsNullOrWhiteSpace(formModel.Email))
                    {
                        <span class="field-error">Email wajib diisi.</span>
                    }
                    else if (!IsValidEmail(formModel.Email))
                    {
                        <span class="field-error">Format email tidak valid.</span>
                    }
                }
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">User ID / NIK <span class="req">*</span></label>
                    <input type="text" class="form-input @(hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.EmployeeId) ? "is-invalid" : "")" placeholder="Contoh: EMP-1045" @bind="formModel.EmployeeId" />
                    @if (hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.EmployeeId))
                    {
                        <span class="field-error">User ID wajib diisi.</span>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Departemen <span class="req">*</span></label>
                    <select class="form-input" @bind="formModel.Department">
                        <option value="IT & Digital">IT & Digital</option>
                        <option value="Operasional">Operasional</option>
                        <option value="Sumber Daya Manusia (SDM)">Sumber Daya Manusia (SDM)</option>
                        <option value="Keuangan">Keuangan</option>
                        <option value="Marketing & Komunikasi">Marketing & Komunikasi</option>
                        <option value="Legal & Kepatuhan">Legal & Kepatuhan</option>
                        <option value="General Affairs (GA)">General Affairs (GA)</option>
                        <option value="Layanan Keamanan">Layanan Keamanan</option>
                        <option value="Call Center & Layanan Pelanggan">Call Center & Layanan Pelanggan</option>
                        <option value="Layanan Perkantoran">Layanan Perkantoran</option>
                        <option value="Teknikal & Pemeliharaan Telekomunikasi">Teknikal & Pemeliharaan Telekomunikasi</option>
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Nomor Telepon</label>
                    <input type="text" class="form-input" placeholder="+62 812-xxxx-xxxx" @bind="formModel.Phone" />
                </div>

                <div class="form-group">
                    <label class="form-label">Role Akses <span class="req">*</span></label>
                    <select class="form-input" @bind="formModel.Role">
                        <option value="Administrator">Administrator</option>
                        <option value="Manager">Manager</option>
                        <option value="Approver">Approver</option>
                        <option value="User">User</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Password Sementara <span class="req">*</span></label>
                    <div class="rm-photo-add-row" style="margin-bottom: 0.5rem;">
                        <div class="password-wrapper" style="position: relative; flex-grow: 1;">
                            <input type="@(showPassword ? "text" : "password")" class="form-input" placeholder="Buat password..." @bind="newPasswordInput" />
                            <button type="button" class="btn-password-toggle" @onclick="() => showPassword = !showPassword" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-ink-500);" title="Lihat/Sembunyikan">
                                <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="16" />
                            </button>
                        </div>
                        <button type="button" class="btn-outline-pill btn-sm" @onclick="GeneratePassword" title="Buat Password Otomatis">
                            <Icon Name="refresh-cw" Size="14" />
                        </button>
                        <button type="button" class="btn-outline-pill btn-sm" @onclick="CopyPassword" title="Salin Password">
                            <Icon Name="copy" Size="14" />
                        </button>
                    </div>
                    <label class="rm-checkbox-label" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-ink-600); cursor: pointer;">
                        <input type="checkbox" @bind="forceChangePassword" />
                        <span>User wajib mengganti password saat login pertama</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="form-label">Status Akun</label>
                    <select class="form-input" @bind="formModel.Status">
                        <option value="active">Aktif</option>
                        <option value="inactive">Tidak Aktif</option>
                    </select>
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showAddModal = false" disabled="@isFormSubmitting">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveNewUser" disabled="@isFormSubmitting">
            @if (isFormSubmitting)
            {
                <span class="spinner-sm"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan User</span>
            }
        </button>
    </FooterContent>
</AppModal>

@* -- Modal 2: Edit User -- *@
<AppModal IsOpen="showEditModal" IsOpenChanged="v => showEditModal = v" Title="Edit Pengguna" Size="medium">
    <ChildContent>
        <p class="modal-subtitle-text">Perbarui data dan hak akses pengguna sistem.</p>

        <div class="um-form">
            <div class="form-group">
                <label class="form-label">Nama Lengkap <span class="req">*</span></label>
                <input type="text" class="form-input" @bind="editModel.FullName" />
            </div>

            <div class="form-group">
                <label class="form-label">Email Perusahaan <span class="req">*</span></label>
                <input type="email" class="form-input" @bind="editModel.Email" />
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">User ID / NIK</label>
                    <input type="text" class="form-input" @bind="editModel.EmployeeId" />
                </div>

                <div class="form-group">
                    <label class="form-label">Departemen</label>
                        <select class="form-input" @bind="editModel.Department">
                            <option value="IT & Digital">IT & Digital</option>
                            <option value="Operasional">Operasional</option>
                            <option value="Sumber Daya Manusia (SDM)">Sumber Daya Manusia (SDM)</option>
                            <option value="Keuangan">Keuangan</option>
                            <option value="Marketing & Komunikasi">Marketing & Komunikasi</option>
                            <option value="Legal & Kepatuhan">Legal & Kepatuhan</option>
                            <option value="General Affairs (GA)">General Affairs (GA)</option>
                            <option value="Layanan Keamanan">Layanan Keamanan</option>
                            <option value="Call Center & Layanan Pelanggan">Call Center & Layanan Pelanggan</option>
                            <option value="Layanan Perkantoran">Layanan Perkantoran</option>
                            <option value="Teknikal & Pemeliharaan Telekomunikasi">Teknikal & Pemeliharaan Telekomunikasi</option>
                        </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Nomor Telepon</label>
                    <input type="text" class="form-input" @bind="editModel.Phone" />
                </div>

                <div class="form-group">
                    <label class="form-label">Role Akses</label>
                    <select class="form-input" @bind="editModel.Role">
                        <option value="Administrator">Administrator</option>
                        <option value="Manager">Manager</option>
                        <option value="Approver">Approver</option>
                        <option value="User">User</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Status Akun</label>
                <select class="form-input" @bind="editModel.Status">
                    <option value="active">Aktif</option>
                    <option value="inactive">Tidak Aktif</option>
                </select>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="OpenResetPasswordModal" style="margin-right: auto;">
            <Icon Name="key" Size="14" /> Reset Password
        </button>
        <button type="button" class="btn-outline-pill" @onclick="() => showEditModal = false" disabled="@isFormSubmitting">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveEditUser" disabled="@isFormSubmitting">
            @if (isFormSubmitting)
            {
                <span class="spinner-sm"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan Perubahan</span>
            }
        </button>
    </FooterContent>
</AppModal>

@* -- Modal 3: Hapus User -- *@
<AppModal IsOpen="showDeleteModal" IsOpenChanged="v => showDeleteModal = v" Title="Hapus Pengguna" Size="small">
    <ChildContent>
        @if (userToDelete != null)
        {
            <div class="delete-confirm-box" style="text-align: center;">
                <div class="delete-icon-wrapper" style="margin-bottom: 1rem;">
                    <Icon Name="alert-triangle" Size="48" CssClass="text-danger" />
                </div>
                <p>Apakah Anda yakin ingin menghapus pengguna <strong>@userToDelete.FullName</strong> (@userToDelete.Email)?</p>
                <div class="warning-text" style="color: #d97706; font-size: 0.85rem; margin: 1rem 0; padding: 0.5rem; background: #fffbeb; border-radius: 6px;">Tindakan ini tidak dapat dibatalkan. Pengguna ini memiliki <strong>@userToDelete.TotalBookings booking aktif</strong>.</div>
                
                <div class="delete-options" style="margin-top: 1rem; text-align: left;">
                    <div class="rm-field">
                        <label class="rm-label">KETIK NAMA UNTUK MENGHAPUS PERMANEN:</label>
                        <input type="text" class="rm-input" placeholder="@userToDelete.FullName" @bind="confirmDeleteName" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showDeleteModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-warning" @onclick="DeactivateUser">Nonaktifkan Saja</button>
        <button type="button" class="btn-primary-pill btn-danger" @onclick="ConfirmDeleteUser" disabled="@(confirmDeleteName != userToDelete?.FullName)">Hapus Permanen</button>
    </FooterContent>
</AppModal>

@* -- Modal Detail Pengguna -- *@
<AppModal IsOpen="showDetailModal" IsOpenChanged="v => showDetailModal = v" Title="Detail Pengguna" Size="medium">
    <ChildContent>
        @if (selectedUserForDetail != null)
        {
            <div class="um-detail-wrapper">
                <div class="um-detail-header" style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
                    <ProfileAvatarUploader Initials="@selectedUserForDetail.Initials" BgColor="@GetAvatarColor(selectedUserForDetail.FullName)" Size="64px" CameraIconSize="14" />
                    <div>
                        <h3 style="margin: 0; font-size: 1.2rem; color: var(--color-ink-900);">@selectedUserForDetail.FullName</h3>
                        <div style="color: var(--color-ink-500); font-size: 0.9rem;">@selectedUserForDetail.Email</div>
                        <span class="um-status-pill @(selectedUserForDetail.Status.ToLower() == "active" ? "status-active" : "status-inactive")" style="margin-top: 0.5rem; display: inline-block;">
                            <span class="status-dot"></span>
                            @(selectedUserForDetail.Status.ToLower() == "active" ? "Aktif" : "Tidak Aktif")
                        </span>
                    </div>
                </div>
                <div class="rm-row-2col">
                    <div class="rm-field">
                        <label class="rm-label">DEPARTEMEN</label>
                        <strong>@selectedUserForDetail.Department</strong>
                    </div>
                    <div class="rm-field">
                        <label class="rm-label">ROLE</label>
                        <strong>@selectedUserForDetail.Role</strong>
                    </div>
                    <div class="rm-field">
                        <label class="rm-label">TOTAL BOOKING</label>
                        <strong>@selectedUserForDetail.TotalBookings Booking</strong>
                    </div>
                    <div class="rm-field">
                        <label class="rm-label">BERGABUNG SEJAK</label>
                        <strong>12 Jan 2026</strong>
                    </div>
                </div>
                <div style="margin-top: 1rem;">
                    <label class="rm-label">LOG AKTIVITAS TERAKHIR</label>
                    <div style="font-size: 0.85rem; color: var(--color-ink-700); padding: 0.75rem; background: var(--color-surface-1); border-radius: 8px;">
                        Booking "Ruang Alpha" pada 15 Okt 2026, 09:00 WIB
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showDetailModal = false">Tutup</button>
        <button type="button" class="btn-primary-pill btn-navy" @onclick="() => { showDetailModal = false; OpenEditModal(selectedUserForDetail!); }">Edit Pengguna</button>
    </FooterContent>
</AppModal>

@* -- Modal Reset Password -- *@
<AppModal IsOpen="showResetPasswordModal" IsOpenChanged="v => showResetPasswordModal = v" Title="Reset Password" Size="small">
    <ChildContent>
        <p class="modal-subtitle-text">Reset password untuk pengguna <strong>@userToReset?.FullName</strong>.</p>
        <div class="um-form" style="margin-top: 1rem;">
            <div class="form-group">
                <label class="form-label">Password Baru <span class="req">*</span></label>
                <div class="rm-photo-add-row" style="margin-bottom: 0.5rem;">
                    <div class="password-wrapper" style="position: relative; flex-grow: 1;">
                        <input type="@(showPassword ? "text" : "password")" class="form-input" placeholder="Buat password..." @bind="newPasswordInput" />
                        <button type="button" class="btn-password-toggle" @onclick="() => showPassword = !showPassword" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--color-ink-500);" title="Lihat/Sembunyikan">
                            <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="16" />
                        </button>
                    </div>
                    <button type="button" class="btn-outline-pill btn-sm" @onclick="GeneratePassword" title="Buat Password Otomatis">
                        <Icon Name="refresh-cw" Size="14" />
                    </button>
                    <button type="button" class="btn-outline-pill btn-sm" @onclick="CopyPassword" title="Salin Password">
                        <Icon Name="copy" Size="14" />
                    </button>
                </div>
                <label class="rm-checkbox-label" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--color-ink-600); cursor: pointer;">
                    <input type="checkbox" @bind="forceChangePassword" />
                    <span>User wajib mengganti password saat login pertama</span>
                </label>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showResetPasswordModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="SubmitResetPassword" disabled="@string.IsNullOrWhiteSpace(newPasswordInput)">Simpan Password</button>
    </FooterContent>
</AppModal>

@* -- Modal 4: Import CSV -- *@
<AppModal IsOpen="showImportModal" IsOpenChanged="v => showImportModal = v" Title="Import Pengguna" Size="large">
    <ChildContent>
        <p class="modal-subtitle-text">Upload file CSV untuk menambahkan beberapa user sekaligus.</p>

        <div class="csv-drop-zone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="csv-upload-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
            <div class="csv-drop-text">Upload CSV - Drag & Drop atau <label class="csv-browse"><input type="file" style="display:none" @onchange="SimulateCsvLoad" accept=".csv" />pilih file</label></div>
            <span class="csv-hint">Format kolom: Nama, Email, Department, Role, User ID</span>
        </div>

        @if (csvPreviewList.Any())
        {
            <div class="csv-summary-bar">
                <span class="csv-valid-badge"><Icon Name="check" Size="14" /> @csvPreviewList.Count data valid siap diimpor</span>
            </div>

            <div class="csv-preview-table-wrap">
                <table class="csv-preview-table">
                    <thead>
                        <tr>
                            <th>NAMA</th>
                            <th>EMAIL</th>
                            <th>DEPARTEMEN</th>
                            <th>ROLE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in csvPreviewList)
                        {
                            <tr>
                                <td>@c.FullName</td>
                                <td>@c.Email</td>
                                <td>@c.Department</td>
                                <td>@c.Role</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showImportModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmCsvImport" disabled="@(!csvPreviewList.Any())">Import User</button>
    </FooterContent>
</AppModal>

@* -- Modal 5: Export Modal -- *@
<ExportModal IsOpen="showExportModal"
             IsOpenChanged="v => showExportModal = v"
             ExportTitle="Data Pengguna Sistem Booking"
             Columns="exportColumns"
             CurrentViewRows="users.Cast<object>()"
             AllRows="allUsersExport.Cast<object>()" />

@code {
    private List<User> users = new();
    private List<User> allUsersExport = new();
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool isLoading = true;
    private bool hasError = false;

    private string searchQuery = "";
