    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        return email.Contains('@') && email.Contains('.');
    }

    private void OpenResetPasswordModal()
    {
        userToReset = editModel ?? selectedUserForDetail;
        newPasswordInput = "";
        showPassword = false;
        forceChangePassword = true;
        showResetPasswordModal = true;
    }

    private void GeneratePassword()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%";
        var random = new Random();
        newPasswordInput = new string(Enumerable.Repeat(chars, 10).Select(s => s[random.Next(s.Length)]).ToArray());
        showPassword = true;
    }

    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(newPasswordInput))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", newPasswordInput);
            Toast.Success("Password berhasil disalin ke clipboard.");
        }
    }

    private async Task SubmitResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPasswordInput)) return;
        
        Toast.Success($"Password untuk '{(userToReset?.FullName ?? "Pengguna")}' berhasil diperbarui.");
        showResetPasswordModal = false;
        newPasswordInput = "";
        await Task.CompletedTask;
    }

    private int GetPasswordStrength(string pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        int score = 0;
        if (pwd.Length >= 6) score++;
        if (pwd.Length >= 8 && (pwd.Any(char.IsDigit) || pwd.Any(char.IsPunctuation) || pwd.Any(char.IsSymbol))) score++;
        if (pwd.Length >= 10 && pwd.Any(char.IsUpper) && pwd.Any(char.IsDigit) && (pwd.Any(char.IsPunctuation) || pwd.Any(char.IsSymbol))) score++;
        return Math.Max(1, Math.Min(score, 3));
    }

    private string GetPasswordStrengthLabel(int score) => score switch
    {
        1 => "Lemah",
        2 => "Sedang",
        3 => "Kuat",
        _ => "Lemah"
    };

    private string GetAvatarColor(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#2563EB";
        var hash = name.GetHashCode();
        var colors = new[] { "#1E3A8A", "#0D9488", "#0284C7", "#7C3AED", "#D97706", "#DC2626" };
        return colors[Math.Abs(hash) % colors.Length];
    }
