@page "/users"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject IUserService UserService
@inject ToastService Toast

<TopBar Title="Manajemen User" Subtitle="Kelola akses, profil, dan hak pengguna sistem booking ruangan." ShowGlobalSearch="false" ShowDateFilter="false" />

<div class="user-management-page">

    @* -- Baris Aksi: search + filter + ekspor + import + CTA -- *@
    <div class="um-toolbar">
        <div class="um-search-box">
            <Icon Name="search" Size="16" CssClass="um-search-icon" />
            <input type="text" placeholder="Cari berdasarkan nama, email, atau ID user..." @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchKey" />
        </div>
        <select class="um-filter-select" @bind="departmentFilter" @bind:after="LoadUsers">
            <option value="All">Semua Departemen</option>
            <option value="IT & Digital">IT & Digital</option>
            <option value="Human Resources">Human Resources</option>
            <option value="Finance">Finance</option>
            <option value="Marketing">Marketing</option>
            <option value="Operations">Operations</option>
            <option value="Legal">Legal</option>
            <option value="General Affairs">General Affairs</option>
        </select>
        <button type="button" class="btn-export-um" @onclick="OpenExportModal">
            <Icon Name="download" Size="14" />
            <span>Ekspor</span>
        </button>
        <button type="button" class="btn-outline-pill" @onclick="() => showImportModal = true">
            <Icon Name="upload" Size="14" />
            <span>Import CSV</span>
        </button>
        <button type="button" class="btn-primary-pill btn-yellow" style="white-space:nowrap;" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Tambah User</span>
        </button>
    </div>

    @if (hasError)
    {
        <div class="error-state">
            <div class="error-icon"><Icon Name="alert-triangle" Size="36" CssClass="text-danger" /></div>
            <h3 class="error-title">Tidak dapat memuat data user</h3>
            <p class="error-desc">Terjadi kendala saat menghubungkan ke database pengguna. Silakan coba kembali.</p>
            <button class="btn-primary-pill btn-yellow" @onclick="LoadUsers">Coba Lagi</button>
        </div>
    }
    else if (isLoading)
    {
        <div class="skeleton-loader">
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
        </div>
    }
    else if (!users.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><Icon Name="users" Size="36" CssClass="text-muted" /></div>
            <h3 class="empty-title">Tidak ada user ditemukan</h3>
            <p class="empty-desc">Tidak ada akun pengguna yang cocok dengan kriteria pencarian atau filter yang dipilih.</p>
            <button class="btn-primary-pill btn-yellow" @onclick="ResetFilters">Reset Filter</button>
        </div>
    }
    else
    {
        <div class="um-table-container">
            <DataTable TItem="User"
                       Items="users"
                       Columns="columns"
                       TotalCount="totalCount"
                       PageSize="pageSize"
                       CurrentPage="currentPage"
                       OnPageChanged="HandlePageChange"
                       ShowCheckbox="false">
                <RowTemplate Context="u">
                    <td>
                        <div class="user-row-cell">
                            <div class="user-avatar-circle" style="background: @GetAvatarColor(u.FullName)">
                                @u.Initials
                            </div>
                            <div class="user-name-box">
                                <span class="user-full-name">@u.FullName</span>
                                <span class="user-email-text">@u.Email</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="um-dept-text">@u.Department</span>
                    </td>
                    <td>
                        <span class="um-bookings-text">@u.TotalBookings Rooms</span>
                    </td>
                    <td>
                        <span class="um-status-pill @(u.Status.ToLower() == "active" ? "status-active" : "status-inactive")">
                            <span class="status-dot"></span>
                            @(u.Status.ToLower() == "active" ? "Aktif" : "Tidak Aktif")
                        </span>
                    </td>
                    <td>
                        <div class="um-actions">
                            <button type="button" class="btn-action-edit" title="Edit User" @onclick="() => OpenEditModal(u)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button type="button" class="btn-action-delete" title="Hapus User" @onclick="() => OpenDeleteModal(u)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                            </button>
                        </div>
                    </td>
                </RowTemplate>
            </DataTable>
        </div>
    }
</div>

@* -- Modal 1: Tambah User -- *@
<AppModal IsOpen="showAddModal" IsOpenChanged="v => showAddModal = v" Title="Tambah User" Size="medium">
    <ChildContent>
        <p class="modal-subtitle-text">Tambahkan pengguna baru ke sistem booking ruangan.</p>
        
        <div class="um-form">
            <div class="form-group">
                <label class="form-label">Nama Lengkap <span class="req">*</span></label>
                <input type="text" class="form-input @(hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.FullName) ? "is-invalid" : "")" placeholder="Contoh: Budi Santoso" @bind="formModel.FullName" />
                @if (hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.FullName))
                {
                    <span class="field-error">Nama lengkap wajib diisi.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Email Perusahaan <span class="req">*</span></label>
                <input type="email" class="form-input @(hasAddSubmitted && !IsValidEmail(formModel.Email) ? "is-invalid" : "")" placeholder="Contoh: budi.santoso@ptpersada.co.id" @bind="formModel.Email" />
                @if (hasAddSubmitted)
                {
                    if (string.IsNullOrWhiteSpace(formModel.Email))
                    {
                        <span class="field-error">Email wajib diisi.</span>
                    }
                    else if (!IsValidEmail(formModel.Email))
                    {
                        <span class="field-error">Format email tidak valid.</span>
                    }
                }
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">User ID / NIK <span class="req">*</span></label>
                    <input type="text" class="form-input @(hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.EmployeeId) ? "is-invalid" : "")" placeholder="Contoh: EMP-1045" @bind="formModel.EmployeeId" />
                    @if (hasAddSubmitted && string.IsNullOrWhiteSpace(formModel.EmployeeId))
                    {
                        <span class="field-error">User ID wajib diisi.</span>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Departemen <span class="req">*</span></label>
                    <select class="form-input" @bind="formModel.Department">
                        <option value="IT & Digital">IT & Digital</option>
                        <option value="Human Resources">Human Resources</option>
                        <option value="Finance">Finance</option>
                        <option value="Marketing">Marketing</option>
                        <option value="Operations">Operations</option>
                        <option value="Legal">Legal</option>
                        <option value="General Affairs">General Affairs</option>
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Nomor Telepon</label>
                    <input type="text" class="form-input" placeholder="+62 812-xxxx-xxxx" @bind="formModel.Phone" />
                </div>

                <div class="form-group">
                    <label class="form-label">Role Akses <span class="req">*</span></label>
                    <select class="form-input" @bind="formModel.Role">
                        <option value="Administrator">Administrator</option>
                        <option value="Manager">Manager</option>
                        <option value="Approver">Approver</option>
                        <option value="User">User</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Status Akun</label>
                <select class="form-input" @bind="formModel.Status">
                    <option value="active">Aktif</option>
                    <option value="inactive">Tidak Aktif</option>
                </select>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showAddModal = false" disabled="@isFormSubmitting">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveNewUser" disabled="@isFormSubmitting">
            @if (isFormSubmitting)
            {
                <span class="spinner-sm"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan User</span>
            }
        </button>
    </FooterContent>
</AppModal>

@* -- Modal 2: Edit User -- *@
<AppModal IsOpen="showEditModal" IsOpenChanged="v => showEditModal = v" Title="Edit User" Size="medium">
    <ChildContent>
        <p class="modal-subtitle-text">Perbarui data dan hak akses pengguna sistem.</p>

        <div class="um-form">
            <div class="form-group">
                <label class="form-label">Nama Lengkap <span class="req">*</span></label>
                <input type="text" class="form-input" @bind="editModel.FullName" />
            </div>

            <div class="form-group">
                <label class="form-label">Email Perusahaan <span class="req">*</span></label>
                <input type="email" class="form-input" @bind="editModel.Email" />
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">User ID / NIK</label>
                    <input type="text" class="form-input" @bind="editModel.EmployeeId" />
                </div>

                <div class="form-group">
                    <label class="form-label">Departemen</label>
                    <select class="form-input" @bind="editModel.Department">
                        <option value="IT & Digital">IT & Digital</option>
                        <option value="Human Resources">Human Resources</option>
                        <option value="Finance">Finance</option>
                        <option value="Marketing">Marketing</option>
                        <option value="Operations">Operations</option>
                        <option value="Legal">Legal</option>
                        <option value="General Affairs">General Affairs</option>
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label class="form-label">Nomor Telepon</label>
                    <input type="text" class="form-input" @bind="editModel.Phone" />
                </div>

                <div class="form-group">
                    <label class="form-label">Role Akses</label>
                    <select class="form-input" @bind="editModel.Role">
                        <option value="Administrator">Administrator</option>
                        <option value="Manager">Manager</option>
                        <option value="Approver">Approver</option>
                        <option value="User">User</option>
                        <option value="Viewer">Viewer</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Status Akun</label>
                <select class="form-input" @bind="editModel.Status">
                    <option value="active">Aktif</option>
                    <option value="inactive">Tidak Aktif</option>
                </select>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showEditModal = false" disabled="@isFormSubmitting">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveEditUser" disabled="@isFormSubmitting">
            @if (isFormSubmitting)
            {
                <span class="spinner-sm"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan Perubahan</span>
            }
        </button>
    </FooterContent>
</AppModal>

@* -- Modal 3: Hapus User -- *@
<AppModal IsOpen="showDeleteModal" IsOpenChanged="v => showDeleteModal = v" Title="Hapus User?" Size="small">
    <ChildContent>
        <div class="delete-user-content">
            <p>Apakah Anda yakin ingin menghapus user <strong>@userToDelete?.FullName</strong>?</p>
            <p class="text-muted text-sm">Tindakan ini tidak dapat dibatalkan dan akan menghapus riwayat akses pengguna.</p>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showDeleteModal = false">Batal</button>
        <button type="button" class="btn-danger-pill" @onclick="ConfirmDeleteUser">Hapus User</button>
    </FooterContent>
</AppModal>

@* -- Modal 4: Import CSV -- *@
<AppModal IsOpen="showImportModal" IsOpenChanged="v => showImportModal = v" Title="Import User" Size="large">
    <ChildContent>
        <p class="modal-subtitle-text">Upload file CSV untuk menambahkan beberapa user sekaligus.</p>

        <div class="csv-drop-zone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="csv-upload-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
            <div class="csv-drop-text">Upload CSV - Drag & Drop atau <label class="csv-browse"><input type="file" style="display:none" @onchange="SimulateCsvLoad" accept=".csv" />pilih file</label></div>
            <span class="csv-hint">Format kolom: Nama, Email, Department, Role, User ID</span>
        </div>

        @if (csvPreviewList.Any())
        {
            <div class="csv-summary-bar">
                <span class="csv-valid-badge">? @csvPreviewList.Count data valid siap diimpor</span>
            </div>

            <div class="csv-preview-table-wrap">
                <table class="csv-preview-table">
                    <thead>
                        <tr>
                            <th>NAMA</th>
                            <th>EMAIL</th>
                            <th>DEPARTEMEN</th>
                            <th>ROLE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in csvPreviewList)
                        {
                            <tr>
                                <td>@c.FullName</td>
                                <td>@c.Email</td>
                                <td>@c.Department</td>
                                <td>@c.Role</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showImportModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmCsvImport" disabled="@(!csvPreviewList.Any())">Import User</button>
    </FooterContent>
</AppModal>

@* -- Modal 5: Export Modal -- *@
<ExportModal IsOpen="showExportModal"
             IsOpenChanged="v => showExportModal = v"
             ExportTitle="Data Pengguna Sistem Booking"
             Columns="exportColumns"
             CurrentViewRows="users.Cast<object>()"
             AllRows="allUsersExport.Cast<object>()" />

@code {
    private List<User> users = new();
    private List<User> allUsersExport = new();
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool isLoading = true;
    private bool hasError = false;

    private string searchQuery = "";
    private string departmentFilter = "All";

    // Modals
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool showImportModal = false;
    private bool showExportModal = false;

    private bool hasAddSubmitted = false;
    private bool isFormSubmitting = false;

    private User formModel = new() { Department = "IT & Digital", Role = "User", Status = "active" };
    private User editModel = new();
    private User? userToDelete;

    private List<User> csvPreviewList = new();

    private List<DataTable<User>.DataTableColumn> columns = new()
    {
        new() { Header = "PENGGUNA", PropertyName = "FullName", Sortable = true },
        new() { Header = "DEPARTEMEN", PropertyName = "Department", Sortable = true },
        new() { Header = "TOTAL BOOKING", PropertyName = "TotalBookings", Sortable = true },
        new() { Header = "STATUS", PropertyName = "Status", Sortable = true },
        new() { Header = "AKSI", PropertyName = "" }
    };

    private List<ExportColumn> exportColumns = new()
    {
        new() { Header = "ID User", PropertyName = "EmployeeId" },
        new() { Header = "Nama Lengkap", PropertyName = "FullName" },
        new() { Header = "Email", PropertyName = "Email" },
        new() { Header = "Departemen", PropertyName = "Department" },
        new() { Header = "Role", PropertyName = "Role" },
        new() { Header = "Status", PropertyName = "Status" },
        new() { Header = "Total Booking", PropertyName = "TotalBookings" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            var result = await UserService.GetUsersFilteredAsync(currentPage, pageSize, searchQuery, departmentFilter);
            users = result.Users.ToList();
            totalCount = result.TotalCount;
        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandlePageChange(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadUsers();
        }
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        departmentFilter = "All";
        currentPage = 1;
        await LoadUsers();
    }

    private void OpenAddModal()
    {
        formModel = new User
        {
            Department = "IT & Digital",
            Role = "User",
            Status = "active",
            EmployeeId = $"EMP-{new Random().Next(1050, 9999)}"
        };
        hasAddSubmitted = false;
        isFormSubmitting = false;
        showAddModal = true;
    }

    private async Task SaveNewUser()
    {
        hasAddSubmitted = true;
        if (string.IsNullOrWhiteSpace(formModel.FullName) || !IsValidEmail(formModel.Email) || string.IsNullOrWhiteSpace(formModel.EmployeeId))
        {
            return;
        }

        isFormSubmitting = true;
        StateHasChanged();

        var success = await UserService.AddUserAsync(formModel);
        isFormSubmitting = false;
        showAddModal = false;

        if (success)
        {
            Toast.Success($"User '{formModel.FullName}' berhasil ditambahkan.");
            currentPage = 1;
            await LoadUsers();
        }
        else
        {
            Toast.Error("Gagal menambahkan user. NIK atau Email sudah terdaftar.");
        }
    }

    private void OpenEditModal(User u)
    {
        editModel = new User
        {
            Id = u.Id,
            FullName = u.FullName,
            Email = u.Email,
            Department = u.Department,
            EmployeeId = u.EmployeeId,
            Phone = u.Phone,
            Role = u.Role,
            Status = u.Status,
            TotalBookings = u.TotalBookings
        };
        showEditModal = true;
    }

    private async Task SaveEditUser()
    {
        isFormSubmitting = true;
        StateHasChanged();

        var success = await UserService.UpdateUserAsync(editModel);
        isFormSubmitting = false;
        showEditModal = false;

        if (success)
        {
            Toast.Success("Data user berhasil diperbarui.");
            await LoadUsers();
        }
        else
        {
            Toast.Error("Gagal memperbarui data user.");
        }
    }

    private void OpenDeleteModal(User u)
    {
        userToDelete = u;
        showDeleteModal = true;
    }

    private async Task ConfirmDeleteUser()
    {
        if (userToDelete != null)
        {
            await UserService.DeleteUserAsync(userToDelete.Id);
            Toast.Success("User berhasil dihapus.");
            showDeleteModal = false;
            await LoadUsers();
        }
    }

    private async Task OpenExportModal()
    {
        allUsersExport = await UserService.GetAllUsersAsync();
        showExportModal = true;
    }

    private void SimulateCsvLoad(ChangeEventArgs e)
    {
        csvPreviewList = new List<User>
        {
            new() { FullName = "Anton Kurniawan", Email = "anton.k@ptpersada.co.id", Department = "Operations", Role = "User", EmployeeId = "EMP-2001", Status = "active" },
            new() { FullName = "Rina Susanti", Email = "rina.s@ptpersada.co.id", Department = "Finance", Role = "Approver", EmployeeId = "EMP-2002", Status = "active" },
            new() { FullName = "Doni Ramadhan", Email = "doni.r@ptpersada.co.id", Department = "IT & Digital", Role = "Administrator", EmployeeId = "EMP-2003", Status = "active" }
        };
    }

    private async Task ConfirmCsvImport()
    {
        if (csvPreviewList.Any())
        {
            var count = await UserService.ImportUsersAsync(csvPreviewList);
            Toast.Success($"{count} user baru berhasil diimpor dari CSV.");
            csvPreviewList.Clear();
            showImportModal = false;
            await LoadUsers();
        }
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        return email.Contains('@') && email.Contains('.');
    }

    private string GetAvatarColor(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#2563EB";
        var hash = name.GetHashCode();
        var colors = new[] { "#1E3A8A", "#0D9488", "#0284C7", "#7C3AED", "#D97706", "#DC2626" };
        return colors[Math.Abs(hash) % colors.Length];
    }
}
