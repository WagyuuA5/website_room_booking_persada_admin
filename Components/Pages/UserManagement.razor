    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        return email.Contains('@') && email.Contains('.');
    }

    private void OpenResetPasswordModal()
    {
        userToReset = editModel ?? selectedUserForDetail;
        GeneratePassword();
        showResetPasswordModal = true;
    }

    private void GeneratePassword()
    {
        string pwd;
        do
        {
            pwd = GenerateRandomCandidate(14);
        } while (!IsPasswordStrongEnough(pwd));

        newPasswordInput = pwd;
        showPassword = true;
    }

    private static string GenerateRandomCandidate(int length)
    {
        const string uppers = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lowers = "abcdefghijkmnopqrstuvwxyz";
        const string digits = "23456789";
        const string symbols = "!@#$%^&*";
        const string all = uppers + lowers + digits + symbols;
        var random = new Random();
        
        var chars = new List<char>
        {
            uppers[random.Next(uppers.Length)],
            uppers[random.Next(uppers.Length)],
            lowers[random.Next(lowers.Length)],
            lowers[random.Next(lowers.Length)],
            digits[random.Next(digits.Length)],
            digits[random.Next(digits.Length)],
            symbols[random.Next(symbols.Length)],
            symbols[random.Next(symbols.Length)]
        };
        while (chars.Count < length)
        {
            chars.Add(all[random.Next(all.Length)]);
        }
        return new string(chars.OrderBy(_ => random.Next()).ToArray());
    }

    private static bool IsPasswordStrongEnough(string pwd)
    {
        if (string.IsNullOrEmpty(pwd) || pwd.Length < 14) return false;
        bool hasUpper = pwd.Any(char.IsUpper);
        bool hasLower = pwd.Any(char.IsLower);
        bool hasDigit = pwd.Any(char.IsDigit);
        bool hasSymbol = pwd.Any(ch => !char.IsLetterOrDigit(ch));
        if (!hasUpper || !hasLower || !hasDigit || !hasSymbol) return false;

        // No 3+ sequential (e.g. abc, 123)
        for (int i = 0; i < pwd.Length - 2; i++)
        {
            if (pwd[i+1] == pwd[i] + 1 && pwd[i+2] == pwd[i] + 2) return false;
            if (pwd[i+1] == pwd[i] - 1 && pwd[i+2] == pwd[i] - 2) return false;
        }
        // No 3+ repeated (e.g. aaa, 111)
        for (int i = 0; i < pwd.Length - 2; i++)
        {
            if (pwd[i] == pwd[i+1] && pwd[i] == pwd[i+2]) return false;
        }
        return true;
    }

    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(newPasswordInput))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", newPasswordInput);
            Toast.Success("Password berhasil disalin ke clipboard.");
        }
    }

    private async Task SubmitResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPasswordInput)) return;
        if (GetPasswordStrength(newPasswordInput) < 3)
        {
            Toast.Error("Password belum memenuhi syarat kekuatan 'Kuat'.");
            return;
        }
        
        Toast.Success($"Password untuk '{(userToReset?.FullName ?? "Pengguna")}' berhasil diperbarui.");
        showResetPasswordModal = false;
        newPasswordInput = "";
        await Task.CompletedTask;
    }

    private int GetPasswordStrength(string pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        if (IsPasswordStrongEnough(pwd)) return 3; // Kuat
        if (pwd.Length >= 8 && (pwd.Any(char.IsDigit) || pwd.Any(ch => !char.IsLetterOrDigit(ch)))) return 2; // Sedang
        return 1; // Lemah
    }

    private string GetPasswordStrengthLabel(int score) => score switch
    {
        1 => "Lemah",
        2 => "Sedang",
        3 => "Kuat",
        _ => "Lemah"
    };

    private string GetAvatarColor(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#2563EB";
        var hash = name.GetHashCode();
        var colors = new[] { "#1E3A8A", "#0D9488", "#0284C7", "#7C3AED", "#D97706", "#DC2626" };
        return colors[Math.Abs(hash) % colors.Length];
    }
