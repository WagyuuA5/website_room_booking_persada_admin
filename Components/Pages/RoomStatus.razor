@page "/rooms/status"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast
@implements IDisposable

<TopBar Title="Status Ruangan" Subtitle="Pantau dan kelola ketersediaan serta status operasional ruangan." ShowGlobalSearch="false" ShowDateFilter="false" />

<div class="room-status-page">
    @* -- Baris Aksi: Ringkasan Status + Search Lokal -- *@
    <div style="display:flex; align-items:center; gap:16px; padding:12px 0; flex-wrap:wrap;">
        <div class="rs-header-summary">
            <span class="rs-sum-dot dot-active"><span class="status-dot bg-success"></span> Aktif (@GetCount("active"))</span>
            <span class="rs-sum-dot dot-maint"><span class="status-dot bg-warning"></span> Maintenance (@GetCount("maintenance"))</span>
            <span class="rs-sum-dot dot-inactive"><span class="status-dot bg-muted"></span> Tidak Aktif (@GetCount("inactive"))</span>
        </div>
    </div>

    @* -- Cards Grid -- *@
    @if (isLoading)
    {
        <div class="rs-cards-grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="rs-card">
                    <SkeletonBlock Height="160px" Width="100%" CssClass="mb-3" />
                    <div style="padding: 1rem;">
                        <SkeletonBlock Width="70%" Height="18px" CssClass="mb-2" />
                        <SkeletonBlock Width="50%" Height="14px" CssClass="mb-2" />
                        <SkeletonBlock Width="40%" Height="14px" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rs-cards-grid">
            @foreach (var room in statusRooms)
            {
                <div class="rs-card card-@room.Status.ToLower() @(room.Status == "inactive" ? "card-ghost" : "")">
                    @* Photo Wrap *@
                    <div class="rs-photo-wrap @(room.Status != "active" ? "photo-grayscale" : "")">
                        @if (!room.ImageFailed)
                        {
                            <img src="@room.PhotoUrl" alt="@room.Name" class="rs-photo"
                                 @onerror="() => { room.ImageFailed = true; InvokeAsync(StateHasChanged); }" />
                        }
                        else
                        {
                            <div class="room-photo-fallback">
                                <Icon Name="image-off" Size="32" CssClass="text-muted" />
                                <span>Foto tidak tersedia</span>
                            </div>
                        }

                        @if (room.Status != "inactive")
                        {
                            <span class="rs-cap-badge"><Icon Name="users" Size="14" /> @room.Capacity Orang</span>
                        }

                        @if (room.Status == "maintenance")
                        {
                            <div class="rs-maint-overlay">
                                <span class="rs-maint-icon"><Icon Name="wrench" Size="24" CssClass="text-white" /></span>
                                <span class="rs-maint-timer">Maintenance (@FormatTime(room.RemainingSeconds))</span>
                            </div>

                            @if (room.QueueCount > 0)
                            {
                                <span class="rs-queue-badge"><Icon Name="clock" Size="12" /> @room.QueueCount Dalam Antrian</span>
                            }
                        }
                    </div>

                    @* Card Body *@
                    <div class="rs-card-body">
                        <div class="rs-top-header-row">
                            <div class="rs-title-wrap">
                                <h4 class="rs-room-title">@room.Name</h4>
                                <span class="rs-room-loc"><Icon Name="map-pin" Size="14" /> @room.Location</span>
                            </div>
                            <div class="rs-toggle-block">
                                <label class="rs-switch">
                                    <input type="checkbox" checked="@(room.Status == "active")" @onchange="@((ChangeEventArgs e) => ToggleRoomStatus(room, (bool)(e.Value ?? false)))" />
                                    <span class="rs-slider"></span>
                                </label>
                                <span class="rs-status-tag tag-@room.Status.ToLower()">
                                    @GetStatusLabel(room.Status)
                                </span>
                            </div>
                        </div>

                        @if (room.Status == "inactive")
                        {
                            <p class="rs-placeholder-text">Menunggu setup & konfigurasi admin...</p>
                        }
                        else if (room.Status == "maintenance")
                        {
                            <div class="rs-schedule-box">
                                <span class="rs-sched-label">Jadwal Maintenance</span>
                                <div class="rs-duration-chips">
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 20 ? "active" : "")" @onclick="() => SetDuration(room, 20)">20 Menit</button>
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 30 ? "active" : "")" @onclick="() => SetDuration(room, 30)">30 Menit</button>
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 60 ? "active" : "")" @onclick="() => SetDuration(room, 60)">1 Jam</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="rs-amenities-row">
                                @foreach (var am in room.Amenities)
                                {
                                    <span class="rs-amenity-chip">@am</span>
                                }
                            </div>
                        }

                        <div class="rs-card-bottom-row">
                            @if (room.JustFinished)
                            {
                                <span class="rs-badge-just-finished">BARU SELESAI</span>
                            }
                            <div style="flex:1;"></div>
                            <button type="button" class="btn-rs-trash" @onclick="() => ConfirmDelete(room)" title="Hapus Ruangan">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="rs-trash-svg"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        </div>
                    </div>

                    @* Full-width Yellow Warning Bar for Maintenance *@
                    @if (room.Status == "maintenance")
                    {
                        <div class="rs-yellow-bar">
                            <span><Icon Name="alert-triangle" Size="14" /> Maintenance</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@* -- Modal Set Maintenance -- *@
@if (activeMaintenanceRoom != null)
{
    <AppModal IsOpen="@showMaintModal" IsOpenChanged="@((bool v) => showMaintModal = v)" Size="medium">
        <HeaderContent>
            <div class="rs-modal-maint-header">
                <h3 class="rs-maint-modal-title"><Icon Name="wrench" Size="20" /> MAINTENANCE</h3>
                <span class="rs-maint-room-pill"><Icon Name="building" Size="14" /> @activeMaintenanceRoom.Name &middot; @activeMaintenanceRoom.Location</span>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="rs-maint-form">
                <div class="rs-row-2col">
                    <div class="rs-field">
                        <label class="rs-label">Kategori Maintenance</label>
                        <select class="rs-select" @bind="maintForm.Category">
                            <option value="HVAC">HVAC</option>
                            <option value="Perbaikan Peralatan">Perbaikan Peralatan</option>
                            <option value="Instalasi Fasilitas">Instalasi Fasilitas</option>
                            <option value="Pembersihan Rutin">Pembersihan Rutin</option>
                            <option value="Pemulihan Sistem">Pemulihan Sistem</option>
                        </select>
                    </div>
                    <div class="rs-field">
                        <label class="rs-label">Tingkat Prioritas</label>
                        <select class="rs-select" @bind="maintForm.Priority">
                            <option value="Rendah">Rendah</option>
                            <option value="Sedang">Sedang</option>
                            <option value="Tinggi">Tinggi</option>
                            <option value="Kritis">Kritis</option>
                        </select>
                    </div>
                </div>

                <div class="rs-field">
                    <label class="rs-label">Fasilitas yang Diservis</label>
                    <div class="rs-chips-row">
                        @foreach (var f in availableServiceFacilities)
                        {
                            <button type="button" class="rs-serv-chip @(maintForm.ServicedFacilities.Contains(f) ? "selected" : "")"
                                    @onclick="() => ToggleServicedFacility(f)">
                                @if (maintForm.ServicedFacilities.Contains(f))
                                {
                                    <Icon Name="check" Size="12" />
                                }
                                else
                                {
                                    @("+ ")
                                }
                                @f
                            </button>
                        }
                    </div>
                </div>

                <div class="rs-field">
                    <label class="rs-label">Dokumentasi</label>
                    <div class="rs-dropzone">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="rs-up-svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <strong>Klik untuk unggah atau seret & lepas</strong>
                        <span>SVG, PNG, JPG atau GIF (maks. 5MB)</span>
                    </div>
                </div>

                <div class="rs-field">
                    <label class="rs-label">Deskripsi</label>
                    <textarea class="rs-textarea" rows="2" placeholder="Masukkan catatan detail di sini..." @bind="maintForm.Description"></textarea>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="CancelMaintenanceModal">Batal</button>
            <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmSetMaintenance">Konfirmasi Maintenance</button>
        </FooterContent>
    </AppModal>
}

@* -- Delete Modal -- *@
@if (roomToDelete != null)
{
    <AppModal IsOpen="@showDeleteModal" IsOpenChanged="@((bool v) => showDeleteModal = v)" Size="small">
        <HeaderContent>
            <h3 style="margin:0; font-size:1.125rem; font-weight:600;">Hapus Ruangan</h3>
        </HeaderContent>
        <ChildContent>
            <p style="margin:0; font-size:0.875rem; color:#6E6E73;">
                Apakah Anda yakin ingin menghapus ruangan <strong>@roomToDelete.Name</strong>? Aksi ini tidak dapat dibatalkan.
            </p>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => showDeleteModal = false">Batal</button>
            <button type="button" class="btn-primary-pill" style="background:#DC2626; color:#fff;" @onclick="ExecuteDelete">Hapus</button>
        </FooterContent>
    </AppModal>
}

@code {
    public class RoomStatusItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public int Capacity { get; set; }
        public string Status { get; set; } = "active"; // active, maintenance, inactive
        public int RemainingSeconds { get; set; }
        public int SelectedDurationMinutes { get; set; } = 30;
        public int QueueCount { get; set; }
        public bool JustFinished { get; set; }
        public List<string> Amenities { get; set; } = new();
        public string PhotoUrl { get; set; } = "images/room1.jpg";
        public bool ImageFailed { get; set; }
    }

    public class MaintenanceFormModel
    {
        public string Category { get; set; } = "HVAC";
        public string Priority { get; set; } = "Tinggi";
        public List<string> ServicedFacilities { get; set; } = new() { "AC Unit" };
        public string Description { get; set; } = "";
    }

    private bool isLoading = true;
    private List<RoomStatusItem> statusRooms = new();
    private RoomStatusItem? activeMaintenanceRoom;
    private RoomStatusItem? roomToDelete;
    private MaintenanceFormModel maintForm = new();

    private bool showMaintModal = false;
    private bool showDeleteModal = false;
    private System.Threading.Timer? _countdownTimer;

    private List<string> availableServiceFacilities = new() { "AC Unit", "Lighting/Pencahayaan", "Furniture/Perabotan", "Sound System", "Proyektor" };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();
        await Task.Delay(1); // yield to render skeleton
        InitStatusRooms();
        StartCountdownTimer();
        isLoading = false;
    }

    private void InitStatusRooms()
    {
        statusRooms = new List<RoomStatusItem>
        {
            new()
            {
                Id = 1,
                Name = "Gamma Room",
                Location = "Lantai 3, VIP Wing",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 0,
                Amenities = new() { "Dual Projector", "Smart Board" },
                PhotoUrl = "images/room3.jpg"
            },
            new()
            {
                Id = 2,
                Name = "Delta Room",
                Location = "Lantai 1, Wing Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Webcam" },
                PhotoUrl = "images/room4.jpg"
            },
            new()
            {
                Id = 3,
                Name = "Ghost Room (Placeholder)",
                Location = "Lantai 3, VIP Wing",
                Capacity = 0,
                Status = "inactive",
                Amenities = new(),
                PhotoUrl = "images/room2.jpg"
            },
            new()
            {
                Id = 4,
                Name = "Dry Room",
                Location = "Lantai 1, Wing Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Webcam", "Soundproof" },
                PhotoUrl = "images/room1.jpg"
            },
            new()
            {
                Id = 5,
                Name = "Hut Room",
                Location = "Lantai 1, Wing Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Projector 4K", "Webcam", "AC Central" },
                PhotoUrl = "images/room5.jpg"
            },
            new()
            {
                Id = 6,
                Name = "Beta Room",
                Location = "Lantai 2, Wing B",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 5,
                Amenities = new() { "TV 65\"", "AC Split" },
                PhotoUrl = "images/room2.jpg"
            },
            new()
            {
                Id = 7,
                Name = "Angsa Room",
                Location = "Lantai 1, Wing Timur",
                Capacity = 6,
                Status = "active",
                JustFinished = true,
                Amenities = new() { "Projector 4K", "Webcam", "AC Central", "Video Conf" },
                PhotoUrl = "images/room4.jpg"
            },
            new()
            {
                Id = 8,
                Name = "Alpha Room",
                Location = "Lantai 3, VIP Wing",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 2,
                Amenities = new() { "Dual Screen", "Polycom" },
                PhotoUrl = "images/room1.jpg"
            }
        };
    }

    private void StartCountdownTimer()
    {
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            bool hasChanged = false;
            foreach (var r in statusRooms.Where(r => r.Status == "maintenance"))
            {
                if (r.RemainingSeconds > 0)
                {
                    r.RemainingSeconds--;
                    hasChanged = true;
                }
                else
                {
                    // Transition to active
                    r.Status = "active";
                    r.JustFinished = true;
                    hasChanged = true;
                }
            }

            if (hasChanged)
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private string FormatTime(int seconds)
    {
        int mm = seconds / 60;
        int ss = seconds % 60;
        return $"{mm:D2}:{ss:D2}";
    }

    private int GetCount(string status) => statusRooms.Count(r => r.Status.Equals(status, StringComparison.OrdinalIgnoreCase));

    private void ToggleRoomStatus(RoomStatusItem room, bool toActive)
    {
        if (toActive)
        {
            room.Status = "active";
            room.JustFinished = true;
            Toast.Success($"Ruangan '{room.Name}' kini aktif.");
        }
        else
        {
            activeMaintenanceRoom = room;
            maintForm = new MaintenanceFormModel();
            showMaintModal = true;
        }
    }

    private void SetDuration(RoomStatusItem room, int mins)
    {
        room.SelectedDurationMinutes = mins;
        room.RemainingSeconds = mins * 60;
        Toast.Info("Durasi maintenance diperbarui.");
        StateHasChanged();
    }

    private void ToggleServicedFacility(string f)
    {
        if (maintForm.ServicedFacilities.Contains(f)) maintForm.ServicedFacilities.Remove(f);
        else maintForm.ServicedFacilities.Add(f);
    }

    private void ConfirmSetMaintenance()
    {
        if (activeMaintenanceRoom != null)
        {
            activeMaintenanceRoom.Status = "maintenance";
            activeMaintenanceRoom.RemainingSeconds = 30 * 60;
            activeMaintenanceRoom.SelectedDurationMinutes = 30;
            activeMaintenanceRoom.JustFinished = false;
            Toast.Success("Ruangan berhasil ditandai maintenance.");
            showMaintModal = false;
        }
    }

    private void CancelMaintenanceModal()
    {
        showMaintModal = false;
    }

    private void ConfirmDelete(RoomStatusItem r)
    {
        roomToDelete = r;
        showDeleteModal = true;
    }

    private void ExecuteDelete()
    {
        if (roomToDelete != null)
        {
            statusRooms.Remove(roomToDelete);
            Toast.Success($"Ruangan '{roomToDelete.Name}' telah dihapus.");
            showDeleteModal = false;
        }
    }

    private string GetStatusLabel(string status) => status switch
    {
        "active" => "AKTIF",
        "maintenance" => "MAINTENANCE",
        "inactive" => "TIDAK AKTIF",
        _ => status.ToUpperInvariant()
    };

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
