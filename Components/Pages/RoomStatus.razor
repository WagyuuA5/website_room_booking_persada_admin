@page "/rooms/status"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@inject booking_room_admin.Components.Services.IRoomService RoomService


<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Status Ruangan" PageSubtitle="Pantau status operasional dan maintenance ruangan." />
<div class="room-status">
    <div class="rs-breadcrumb">ADMINISTRASI</div>
    <PageHeader Title="Status Ruangan" Subtitle="Pantau dan kelola ketersediaan ruangan secara real-time.">
        <div class="rs-legend">
            <span class="rs-legend-item"><span class="rs-dot rs-dot-active"></span>Aktif</span>
            <span class="rs-legend-item"><span class="rs-dot rs-dot-maintenance"></span>Perawatan</span>
            <span class="rs-legend-item"><span class="rs-dot rs-dot-inactive"></span>Nonaktif</span>
        </div>
    </PageHeader>

    <div class="rs-toolbar">
        <div class="rs-search">
            <img src="icon/search.svg" alt="Cari" class="rs-search-icon" />
            <input type="text" placeholder="Cari nama ruangan..." @bind="searchQuery" @bind:event="oninput" />
        </div>
        <select class="rs-select" @bind="selectedFloor">
            <option value="">Semua Lantai</option>
            @foreach (var floor in floors)
            {
                <option value="@floor">@floor</option>
            }
        </select>
        <select class="rs-select" @bind="selectedStatus">
            <option value="">Semua Status</option>
            <option value="active">Aktif</option>
            <option value="maintenance">Perawatan</option>
            <option value="inactive">Nonaktif</option>
        </select>
    </div>

    <div class="rs-grid">
        @foreach (var room in filteredRooms)
        {
            <div class="rs-card @(room.Status == "inactive" ? "rs-card-inactive" : "")">
                <div class="rs-card-photo-container">
                    <div class="rs-card-photo">
                        <!-- Placeholder photo -->
                        <div class="rs-photo-placeholder">
                            <img src="icon/icon_1_admin.svg" alt="Ruangan" />
                        </div>
                    </div>
                    
                    @if (room.Status == "maintenance")
                    {
                        <div class="rs-photo-overlay">
                            @if (room.MaintenanceEnd != null)
                            {
                                <span class="rs-countdown-large">
                                    <img src="icon/clock.svg" alt="Sisa" style="width:1.25rem; height:1.25rem; filter:invert(1);" />
                                    @FormatCountdown(room.MaintenanceEnd.Value)
                                </span>
                            }
                        </div>
                    }

                    <div class="rs-card-badge-top-left">
                        @if (room.Status == "active")
                        {
                            <StatusBadge Text="Aktif" Type="StatusBadge.BadgeType.Green" />
                        }
                        else if (room.Status == "maintenance")
                        {
                            <StatusBadge Text="Perawatan" Type="StatusBadge.BadgeType.Amber" />
                        }
                        else
                        {
                            <StatusBadge Text="Nonaktif" Type="StatusBadge.BadgeType.Indigo" />
                        }
                    </div>

                    <div class="rs-card-badge-top-right">
                        @if (room.Id % 3 == 0)
                        {
                            <StatusBadge Text="3 Dalam Antrian" Type="StatusBadge.BadgeType.Indigo" />
                        }
                        else if (room.Id % 2 == 0 && room.Status == "active")
                        {
                            <StatusBadge Text="Baru Selesai" Type="StatusBadge.BadgeType.Green" />
                        }
                    </div>
                </div>

                @if (room.Status == "maintenance")
                {
                    <div class="rs-warning-bar">
                        ⚠ Perawatan sedang berlangsung
                    </div>
                }

                <div class="rs-card-content">
                    <h3 class="rs-card-name">@room.Name</h3>
                    <div class="rs-card-location">
                        <img src="icon/icon_6_admin.svg" alt="Lantai" class="rs-meta-icon" />
                        @room.Floor
                    </div>

                    <div class="rs-meta-row">
                        <span class="rs-meta-item">
                            <img src="icon/people.svg" alt="Kapasitas" class="rs-meta-icon" />
                            @room.Capacity Orang
                        </span>
                        <span class="rs-meta-item">
                            <img src="icon/calendar.svg" alt="Booking" class="rs-meta-icon" />
                            @room.TotalBookings Booking
                        </span>
                    </div>

                    <div class="rs-card-actions">
                        <div class="rs-toggle-group">
                            <label class="rs-toggle-label">Maintenance</label>
                            <button class="rs-toggle-switch @(room.Status == "maintenance" ? "on" : "off")"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleMaintenanceStatus(room)">
                                <span class="rs-toggle-slider"></span>
                            </button>
                        </div>
                        <button class="btn-primary-pill btn-yellow btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenMaintenance(room)">
                            <img src="icon/icon_10_admin.svg" alt="Jadwal" class="btn-icon" />
                            Jadwal
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <MaintenancePopup IsOpen="@showMaintenance" IsOpenChanged="@((bool v) => showMaintenance = v)" Room="@selectedRoomForMaintenance" OnMaintenanceScheduled="OnMaintenanceScheduled" />
</div>

@code {
    private bool showMaintenance = false;
    private Room? selectedRoomForMaintenance = null;

    private string searchQuery = "";
    private string selectedFloor = "";
    private string selectedStatus = "";

    private List<string> floors = new() { "Lantai 1", "Lantai 2", "Lantai 3", "Lantai 4", "Lantai 14" };

    private List<Room> allRooms = new();

    private List<Room> filteredRooms => FilterRooms();

    protected override async Task OnInitializedAsync()
    {

        await LoadRooms();

        _ = StartCountdownLoop();
    }

    private async Task LoadRooms()
    {
        allRooms = await RoomService.GetAllRoomsAsync();
    }

    private List<Room> FilterRooms()
    {
        var query = allRooms.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.ToLowerInvariant();
            query = query.Where(r => r.Name.ToLowerInvariant().Contains(q) || r.Type.ToLowerInvariant().Contains(q));
        }

        if (!string.IsNullOrWhiteSpace(selectedFloor))
        {
            query = query.Where(r => r.Floor == selectedFloor);
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            query = query.Where(r => r.Status == selectedStatus);
        }

        return query.ToList();
    }

    private string FormatCountdown(DateTime end)
    {
        var remaining = end - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "Selesai";
        return $"{(int)remaining.TotalHours:D2}:{remaining.Minutes:D2}:{remaining.Seconds:D2}";
    }

    private async Task StartCountdownLoop()
    {
        while (true)
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1000);
        }
    }

    private async Task ToggleMaintenanceStatus(Room room)
    {
        if (room.Status == "maintenance")
        {
            room.Status = "active";
            room.MaintenanceEnd = null;
        }
        else
        {
            room.Status = "maintenance";
            // Default 30 Menit if toggled directly
            room.MaintenanceEnd = DateTime.UtcNow.AddMinutes(30);
        }
        await RoomService.UpdateRoomAsync(room);
        await LoadRooms();
    }

    private void OpenMaintenance(Room room)
    {
        selectedRoomForMaintenance = room;
        showMaintenance = true;
    }

    private async Task OnMaintenanceScheduled(Room room)
    {
        await RoomService.UpdateRoomAsync(room);
        await LoadRooms();
        showMaintenance = false;
        selectedRoomForMaintenance = null;
    }
}



