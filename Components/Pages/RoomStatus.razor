@page "/rooms/status"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast
@implements IDisposable

<TopBar Title="Status Ruangan" Subtitle="Pantau dan kelola ketersediaan serta status operasional ruangan." />

<div class="room-status-page">
    @* -- Baris Aksi: Ringkasan Status + Search Lokal -- *@
    <div class="action-row" style="justify-content: space-between; width: 100%;">
        <div class="rs-header-summary">
            <span class="rs-sum-dot dot-active"><span class="status-dot bg-success"></span> Aktif (@GetCount("active"))</span>
            <span class="rs-sum-dot dot-maint"><span class="status-dot bg-warning"></span> Dalam Perawatan (@GetCount("maintenance"))</span>
            <span class="rs-sum-dot dot-inactive"><span class="status-dot bg-muted"></span> Tidak Aktif (@GetCount("inactive"))</span>
        </div>
        <DateFilter OnDateSelectedCallback="HandleDateChanged" />
    </div>

    @* -- Cards Grid -- *@
    @if (isLoading)
    {
        <div class="rs-cards-grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="rs-card">
                    <SkeletonBlock Height="160px" Width="100%" CssClass="mb-3" />
                    <div style="padding: 1rem;">
                        <SkeletonBlock Width="70%" Height="18px" CssClass="mb-2" />
                        <SkeletonBlock Width="50%" Height="14px" CssClass="mb-2" />
                        <SkeletonBlock Width="40%" Height="14px" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rs-cards-grid">
            @foreach (var room in statusRooms)
            {
                <div class="rs-card card-@room.Status.ToLower() @(room.Status == "inactive" ? "card-ghost" : "")"
                     @onclick="() => OpenDetailModal(room)">
                    @* Photo Wrap *@
                    <div class="rs-photo-wrap @(room.Status != "active" ? "photo-grayscale" : "")">
                        @if (!room.ImageFailed)
                        {
                            <img src="@room.PhotoUrl" alt="@room.Name" class="rs-photo"
                                 @onerror="() => { room.ImageFailed = true; InvokeAsync(StateHasChanged); }" />
                        }
                        else
                        {
                            <div class="room-photo-fallback">
                                <Icon Name="image-off" Size="32" CssClass="text-muted" />
                                <span>Foto tidak tersedia</span>
                            </div>
                        }

                        @if (room.Status != "inactive")
                        {
                            <span class="rs-cap-badge"><Icon Name="users" Size="14" /> @room.Capacity Orang</span>
                        }

                        @if (room.Status == "maintenance")
                        {
                            <div class="rs-maint-overlay">
                                <span class="rs-maint-icon"><Icon Name="tool" Size="24" CssClass="text-white" /></span>
                                <span class="rs-maint-timer">Perawatan (@FormatTime(room.RemainingSeconds))</span>
                            </div>

                            @if (room.QueueCount > 0)
                            {
                                <span class="rs-queue-badge"><Icon Name="clock" Size="12" /> @room.QueueCount Dalam Antrian</span>
                            }
                        }
                    </div>

                    @* Card Body *@
                    <div class="rs-card-body">
                        <div class="rs-top-header-row">
                            <div class="rs-title-wrap">
                                <h4 class="rs-room-title" title="@room.Name">@room.Name</h4>
                                <span class="rs-room-loc"><Icon Name="map-pin" Size="14" /> @room.Location</span>
                            </div>
                            <div class="rs-status-pill-wrap">
                                <span class="rs-status-tag tag-@room.Status.ToLower()">
                                    @GetStatusLabel(room.Status)
                                </span>
                            </div>
                        </div>

                        @if (room.Status == "inactive")
                        {
                            <p class="rs-placeholder-text">
                                <span style="display:inline-block; padding:2px 6px; background:#F3F4F6; color:#4B5563; font-size:0.7rem; font-weight:700; border-radius:4px; margin-bottom:8px;">BELUM DIKONFIGURASI</span><br>
                                Menunggu setup & konfigurasi admin...
                            </p>
                        }
                        else if (room.Status == "maintenance")
                        {
                            <div class="rs-schedule-box" @onclick:stopPropagation="true">
                                <span class="rs-sched-label">Jadwal Perawatan</span>
                                <div class="rs-duration-chips">
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 20 ? "active" : "")" @onclick="() => SetDuration(room, 20)">20 Menit</button>
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 30 ? "active" : "")" @onclick="() => SetDuration(room, 30)">30 Menit</button>
                                    <button type="button" class="rs-dur-chip @(room.SelectedDurationMinutes == 60 ? "active" : "")" @onclick="() => SetDuration(room, 60)">1 Jam</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="rs-amenities-row">
                                @foreach (var am in room.Amenities)
                                {
                                    <span class="rs-amenity-chip">
                                        <Icon Name="@IconHelper.GetFacilityIcon(am)" Size="12" />
                                        @am
                                    </span>
                                }
                            </div>
                        }

                        <div class="rs-card-bottom-row" @onclick:stopPropagation="true">
                            @if (room.JustFinished)
                            {
                                <span class="rs-badge-just-finished">BARU SELESAI</span>
                            }
                            <div style="flex:1;"></div>
                            <button type="button" class="btn-rs-trash" @onclick="() => ConfirmDelete(room)" title="Hapus Ruangan">
                                <Icon Name="trash-2" Size="16" />
                            </button>
                        </div>
                    </div>

                    @* Full-width Yellow Warning Bar for Maintenance *@
                    @if (room.Status == "maintenance")
                    {
                        <div class="rs-yellow-bar">
                            <span><Icon Name="alert-triangle" Size="14" /> Dalam Perawatan</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@* -- Modal 1: Detail Ruangan (Case F) -- *@
@if (selectedRoomForDetail != null)
{
    <AppModal IsOpen="@showDetailModal" IsOpenChanged="@((bool v) => showDetailModal = v)" Title="Detail Ruangan" Size="medium">
        <ChildContent>
            <div class="rs-detail-modal-body">
                @* 16:9 Photo *@
                <div class="rs-detail-photo-wrap">
                    <img src="@selectedRoomForDetail.PhotoUrl" alt="@selectedRoomForDetail.Name" class="rs-detail-photo" />
                    <div class="rs-detail-badge-overlay">
                        <span class="rs-status-tag tag-@selectedRoomForDetail.Status.ToLower()">
                            @GetStatusLabel(selectedRoomForDetail.Status)
                        </span>
                    </div>
                </div>

                <div class="rs-detail-header-info">
                    <h3 class="rs-detail-title">@selectedRoomForDetail.Name</h3>
                    <div class="rs-detail-loc">
                        <Icon Name="map-pin" Size="14" />
                        <span>@selectedRoomForDetail.Location</span>
                    </div>
                </div>

                @* Grid Info *@
                <div class="rs-detail-grid">
                    <div class="rs-dgrid-item">
                        <span class="rs-dgrid-label">Kapasitas</span>
                        <strong class="rs-dgrid-val">@selectedRoomForDetail.Capacity Orang</strong>
                    </div>
                    <div class="rs-dgrid-item">
                        <span class="rs-dgrid-label">Status Operasional</span>
                        <div class="rs-toggle-block" style="margin-top: 4px;">
                            <label class="rs-switch">
                                <input type="checkbox" checked="@(selectedRoomForDetail.Status == "active")" 
                                       @onchange="@((ChangeEventArgs e) => ToggleDetailStatus((bool)(e.Value ?? false)))" />
                                <span class="rs-slider"></span>
                            </label>
                            <span class="rs-toggle-text">@(selectedRoomForDetail.Status == "active" ? "Aktif (Siap Booking)" : "Nonaktif")</span>
                        </div>
                    </div>
                </div>

                @* Facilities *@
                <div class="rs-detail-section">
                    <span class="rs-section-label">Fasilitas Termasuk</span>
                    <div class="rs-amenities-chips-wrap">
                        @if (selectedRoomForDetail.Amenities.Any())
                        {
                            @foreach (var am in selectedRoomForDetail.Amenities)
                            {
                                <div class="rs-amenity-chip-lg">
                                    <Icon Name="@IconHelper.GetFacilityIcon(am)" Size="14" />
                                    <span>@am</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 0.8rem;">Tidak ada fasilitas terdaftar.</span>
                        }
                    </div>
                </div>

                @* Maintenance History *@
                <div class="rs-detail-section">
                    <div class="rs-section-header-row">
                        <span class="rs-section-label">Riwayat Pemeliharaan Terakhir</span>
                        <button type="button" class="btn-primary-pill btn-sm btn-yellow" @onclick="OpenMaintenanceFromDetail">
                            <Icon Name="wrench" Size="13" />
                            <span>Atur Pemeliharaan</span>
                        </button>
                    </div>

                    <div class="rs-maint-history-list">
                        <div class="rs-maint-history-item">
                            <div class="rmh-dot"></div>
                            <div class="rmh-content">
                                <div class="rmh-top">
                                    <strong>Pembersihan Rutin & Service AC</strong>
                                    <span>18 Okt 2026</span>
                                </div>
                                <span class="rmh-tech">Ditangani oleh: Teknisi Budi (GA & Maintenance) &middot; Selesai</span>
                            </div>
                        </div>
                        <div class="rs-maint-history-item">
                            <div class="rmh-dot"></div>
                            <div class="rmh-content">
                                <div class="rmh-top">
                                    <strong>Penggantian Kabel Proyektor HDMI</strong>
                                    <span>04 Okt 2026</span>
                                </div>
                                <span class="rmh-tech">Ditangani oleh: Hendra (IT Support) &middot; Selesai</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => showDetailModal = false">Tutup</button>
            <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveDetailChanges">Simpan Perubahan</button>
        </FooterContent>
    </AppModal>
}

@* -- Modal Set Maintenance -- *@
@if (activeMaintenanceRoom != null)
{
    <AppModal IsOpen="@showMaintModal" IsOpenChanged="@((bool v) => showMaintModal = v)" Size="medium">
        <HeaderContent>
            <div class="rs-modal-maint-header">
                <h3 class="rs-maint-modal-title"><Icon Name="wrench" Size="20" /> Atur Pemeliharaan Ruangan</h3>
                <span class="rs-maint-room-pill"><Icon Name="building" Size="14" /> @activeMaintenanceRoom.Name &middot; @activeMaintenanceRoom.Location</span>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="rs-maint-form">
                <div class="rs-row-2col">
                    <div class="rs-field">
                        <label class="rs-label">Kategori Perawatan</label>
                        @if (isAddingNewCategory)
                        {
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <input type="text" class="rs-select" style="flex: 1;" placeholder="Nama kategori..." @bind="newCategoryText" @bind:event="oninput" />
                                <button type="button" class="btn-primary-pill btn-sm" @onclick="ConfirmAddNewCategory" title="Simpan">
                                    <Icon Name="check" Size="14" />
                                </button>
                                <button type="button" class="btn-outline-pill btn-sm" @onclick="() => isAddingNewCategory = false" title="Batal">
                                    <Icon Name="x" Size="14" />
                                </button>
                            </div>
                        }
                        else
                        {
                            <select class="rs-select" @bind="maintForm.Category" @bind:after="OnCategoryDropdownChanged">
                                @foreach (var cat in maintenanceCategories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                                <option value="__NEW__" style="color: #2563EB; font-weight: 600;">+ Tambah Kategori Baru...</option>
                            </select>
                        }
                    </div>
                    <div class="rs-field">
                        <label class="rs-label">Tingkat Prioritas</label>
                        <select class="rs-select" @bind="maintForm.Priority">
                            <option value="Rendah">Rendah</option>
                            <option value="Sedang">Sedang</option>
                            <option value="Tinggi">Tinggi</option>
                            <option value="Kritis">Kritis</option>
                        </select>
                    </div>
                </div>

                <div class="rs-field">
                    <label class="rs-label">Fasilitas yang Diservis</label>
                    <div class="rs-chips-row" style="align-items: center;">
                        @foreach (var f in availableServiceFacilities)
                        {
                            var isSelected = maintForm.ServicedFacilities.Contains(f);
                            <button type="button" class="rs-serv-chip @(isSelected ? "selected" : "")"
                                    @onclick="() => ToggleServicedFacility(f)">
                                <Icon Name="@(isSelected ? "check" : IconHelper.GetFacilityIcon(f))" Size="13" />
                                <span>@f</span>
                            </button>
                        }
                        <button type="button" class="btn-outline-pill btn-sm" @onclick="() => showAddFacilityInput = !showAddFacilityInput">
                            <Icon Name="plus" Size="13" /> Tambah
                        </button>
                    </div>

                    @if (showAddFacilityInput)
                    {
                        <div style="margin-top: 0.6rem; display: flex; gap: 0.5rem; align-items: center;">
                            <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 6px; background: #F3F4F6; color: var(--color-primary, #0B1E39); border: 1px solid #D1D5DB;">
                                <Icon Name="@(string.IsNullOrWhiteSpace(newFacilityText) ? "tag" : IconHelper.GetFacilityIcon(newFacilityText))" Size="16" />
                            </div>
                            <input type="text" class="rs-select" style="flex: 1;" placeholder="Nama fasilitas diservis..." @bind="newFacilityText" @bind:event="oninput" />
                            <button type="button" class="btn-primary-pill btn-yellow btn-sm" @onclick="ConfirmAddCustomFacility">Tambah</button>
                        </div>
                    }
                </div>

                <div class="rs-field">
                    <label class="rs-label">Dokumentasi Foto</label>
                    <ImageUploadBox OnImageUploaded="(url) => maintForm.PhotoUrl = url" />
                </div>

                <div class="rs-field">
                    <label class="rs-label">Deskripsi / Catatan Perawatan</label>
                    <textarea class="rs-textarea" rows="2" placeholder="Masukkan catatan detail perbaikan di sini..." @bind="maintForm.Description"></textarea>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="CancelMaintenanceModal">Batal</button>
            <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmSetMaintenance">Konfirmasi Pemeliharaan</button>
        </FooterContent>
    </AppModal>
}

@* -- Delete Modal -- *@
@if (roomToDelete != null)
{
    <AppModal IsOpen="@showDeleteModal" IsOpenChanged="@((bool v) => showDeleteModal = v)" Size="small">
        <HeaderContent>
            <h3 class="rm-modal-title text-danger">Hapus Ruangan</h3>
        </HeaderContent>
        <ChildContent>
            <p class="text-muted text-sm">Apakah Anda yakin ingin menghapus ruangan <strong>@roomToDelete.Name</strong>? Aksi ini tidak dapat dibatalkan.</p>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="() => showDeleteModal = false">Batal</button>
            <button type="button" class="btn-primary-pill btn-danger" @onclick="ExecuteDelete">Hapus</button>
        </FooterContent>
    </AppModal>
}

@code {
    public class RoomStatusItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public int Capacity { get; set; }
        public string Status { get; set; } = "active"; // active, maintenance, inactive
        public int RemainingSeconds { get; set; }
        public int SelectedDurationMinutes { get; set; } = 30;
        public int QueueCount { get; set; }
        public bool JustFinished { get; set; }
        public List<string> Amenities { get; set; } = new();
        public string PhotoUrl { get; set; } = "images/room1.jpg";
        public bool ImageFailed { get; set; }
    }

    public class MaintenanceFormModel
    {
        public string Category { get; set; } = "HVAC";
        public string Priority { get; set; } = "Tinggi";
        public List<string> ServicedFacilities { get; set; } = new() { "AC Unit" };
        public string Description { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
    }

    private bool isLoading = true;
    private List<RoomStatusItem> statusRooms = new();
    private RoomStatusItem? activeMaintenanceRoom;
    private RoomStatusItem? roomToDelete;
    private MaintenanceFormModel maintForm = new();

    private bool showMaintModal = false;
    private bool showDeleteModal = false;
    private System.Threading.Timer? _countdownTimer;

    private List<string> maintenanceCategories = new() { "HVAC", "Perbaikan Peralatan", "Instalasi Fasilitas", "Pembersihan Rutin", "Pemulihan Sistem Audio/Visual" };
    private bool isAddingNewCategory = false;
    private string newCategoryText = "";

    private List<string> availableServiceFacilities = new() { "AC Unit", "Lighting/Pencahayaan", "Furniture/Perabotan", "Sound System", "Proyektor" };
    private bool showAddFacilityInput = false;
    private string newFacilityText = "";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();
        await Task.Delay(1); // yield to render skeleton
        InitStatusRooms();
        StartCountdownTimer();
        isLoading = false;
    }

    private void InitStatusRooms()
    {
        statusRooms = new List<RoomStatusItem>
        {
            new()
            {
                Id = 1,
                Name = "Ruang Gamma",
                Location = "Lantai 3, Sayap VIP",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 0,
                Amenities = new() { "Dual Proyektor", "Smart Board" },
                PhotoUrl = "images/room3.jpg"
            },
            new()
            {
                Id = 2,
                Name = "Ruang Delta",
                Location = "Lantai 1, Sayap Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Webcam" },
                PhotoUrl = "images/room4.jpg"
            },
            new()
            {
                Id = 3,
                Name = "Ruang Cadangan (Placeholder)",
                Location = "Lantai 3, Sayap VIP",
                Capacity = 0,
                Status = "inactive",
                Amenities = new(),
                PhotoUrl = "images/room2.jpg"
            },
            new()
            {
                Id = 4,
                Name = "Ruang Diskusi C",
                Location = "Lantai 1, Sayap Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Webcam", "Soundproof" },
                PhotoUrl = "images/room1.jpg"
            },
            new()
            {
                Id = 5,
                Name = "Ruang Epsilon",
                Location = "Lantai 1, Sayap Timur",
                Capacity = 6,
                Status = "active",
                Amenities = new() { "Proyektor 4K", "Webcam", "AC Central" },
                PhotoUrl = "images/room5.jpg"
            },
            new()
            {
                Id = 6,
                Name = "Ruang Beta",
                Location = "Lantai 2, Sayap B",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 5,
                Amenities = new() { "TV 65 Inci", "AC Split" },
                PhotoUrl = "images/room2.jpg"
            },
            new()
            {
                Id = 7,
                Name = "Ruang Dirantara",
                Location = "Lantai 1, Sayap Timur",
                Capacity = 6,
                Status = "active",
                JustFinished = true,
                Amenities = new() { "Proyektor 4K", "Webcam", "AC Central", "Konferensi Video" },
                PhotoUrl = "images/room4.jpg"
            },
            new()
            {
                Id = 8,
                Name = "Ruang Alpha",
                Location = "Lantai 3, Sayap VIP",
                Capacity = 20,
                Status = "maintenance",
                RemainingSeconds = 45 * 60,
                SelectedDurationMinutes = 30,
                QueueCount = 2,
                Amenities = new() { "Dual Screen", "Konferensi Video" },
                PhotoUrl = "images/room1.jpg"
            }
        };
    }

    private void HandleDateChanged(DateTime? date)
    {
        StateHasChanged();
    }

    private void StartCountdownTimer()
    {
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            bool hasChanged = false;
            foreach (var r in statusRooms.Where(r => r.Status == "maintenance"))
            {
                if (r.RemainingSeconds > 0)
                {
                    r.RemainingSeconds--;
                    hasChanged = true;
                }
                else
                {
                    // Transition to active
                    r.Status = "active";
                    r.JustFinished = true;
                    hasChanged = true;
                }
            }

            if (hasChanged)
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private string FormatTime(int seconds)
    {
        int mm = seconds / 60;
        int ss = seconds % 60;
        return $"{mm:D2}:{ss:D2}";
    }

    private int GetCount(string status) => statusRooms.Count(r => r.Status.Equals(status, StringComparison.OrdinalIgnoreCase));

    private void ToggleRoomStatus(RoomStatusItem room, bool toActive)
    {
        if (toActive)
        {
            room.Status = "active";
            room.JustFinished = true;
            Toast.Success($"Ruangan '{room.Name}' kini aktif.");
        }
        else
        {
            activeMaintenanceRoom = room;
            maintForm = new MaintenanceFormModel();
            showMaintModal = true;
        }
    }

    private void SetDuration(RoomStatusItem room, int mins)
    {
        room.SelectedDurationMinutes = mins;
        room.RemainingSeconds = mins * 60;
        Toast.Info("Durasi maintenance diperbarui.");
        StateHasChanged();
    }

    private void OnCategoryDropdownChanged()
    {
        if (maintForm.Category == "__NEW__")
        {
            isAddingNewCategory = true;
            newCategoryText = "";
            maintForm.Category = "";
        }
    }

    private void ConfirmAddNewCategory()
    {
        if (!string.IsNullOrWhiteSpace(newCategoryText))
        {
            var trimmed = newCategoryText.Trim();
            if (!maintenanceCategories.Contains(trimmed))
            {
                maintenanceCategories.Add(trimmed);
            }
            maintForm.Category = trimmed;
        }
        isAddingNewCategory = false;
        newCategoryText = "";
    }

    private void ToggleServicedFacility(string f)
    {
        if (maintForm.ServicedFacilities.Contains(f)) maintForm.ServicedFacilities.Remove(f);
        else maintForm.ServicedFacilities.Add(f);
    }

    private void ConfirmAddCustomFacility()
    {
        if (!string.IsNullOrWhiteSpace(newFacilityText))
        {
            var trimmed = newFacilityText.Trim();
            if (!availableServiceFacilities.Contains(trimmed))
            {
                availableServiceFacilities.Add(trimmed);
            }
            if (!maintForm.ServicedFacilities.Contains(trimmed))
            {
                maintForm.ServicedFacilities.Add(trimmed);
            }
        }
        newFacilityText = "";
        showAddFacilityInput = false;
    }

    private void ConfirmSetMaintenance()
    {
        if (activeMaintenanceRoom != null)
        {
            activeMaintenanceRoom.Status = "maintenance";
            activeMaintenanceRoom.RemainingSeconds = 30 * 60;
            activeMaintenanceRoom.SelectedDurationMinutes = 30;
            activeMaintenanceRoom.JustFinished = false;
            Toast.Success("Ruangan berhasil ditandai dalam perawatan.");
            showMaintModal = false;
        }
    }

    private void CancelMaintenanceModal()
    {
        showMaintModal = false;
    }

    private RoomStatusItem? selectedRoomForDetail;
    private bool showDetailModal = false;

    private void OpenDetailModal(RoomStatusItem room)
    {
        selectedRoomForDetail = room;
        showDetailModal = true;
    }

    private void ToggleDetailStatus(bool toActive)
    {
        if (selectedRoomForDetail == null) return;
        selectedRoomForDetail.Status = toActive ? "active" : "inactive";
        if (toActive) selectedRoomForDetail.JustFinished = true;
    }

    private void OpenMaintenanceFromDetail()
    {
        if (selectedRoomForDetail != null)
        {
            activeMaintenanceRoom = selectedRoomForDetail;
            maintForm = new MaintenanceFormModel();
            showDetailModal = false;
            showMaintModal = true;
        }
    }

    private void SaveDetailChanges()
    {
        if (selectedRoomForDetail != null)
        {
            Toast.Success($"Perubahan status untuk '{selectedRoomForDetail.Name}' berhasil disimpan.");
            showDetailModal = false;
        }
    }

    private void ConfirmDelete(RoomStatusItem r)
    {
        roomToDelete = r;
        showDeleteModal = true;
    }

    private void ExecuteDelete()
    {
        if (roomToDelete != null)
        {
            statusRooms.Remove(roomToDelete);
            Toast.Success($"Ruangan '{roomToDelete.Name}' telah dihapus.");
            showDeleteModal = false;
        }
    }

    private string GetStatusLabel(string status) => status switch
    {
        "active" => "AKTIF",
        "maintenance" => "PERAWATAN",
        "inactive" => "TIDAK AKTIF",
        _ => status.ToUpperInvariant()
    };

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
