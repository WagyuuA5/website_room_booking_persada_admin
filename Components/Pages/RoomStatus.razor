@page "/rooms/status"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@inject booking_room_admin.Components.Services.IRoomService RoomService

<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Status Ruangan" PageSubtitle="Pantau status operasional dan maintenance ruangan." ShowGlobalSearch="false" ShowGlobalDate="true">
    <HeaderActions>
        <div class="rs-legend">
            <span class="rs-legend-item"><span class="rs-dot rs-dot-active"></span>Aktif</span>
            <span class="rs-legend-item"><span class="rs-dot rs-dot-maintenance"></span>Maintenance</span>
            <span class="rs-legend-item"><span class="rs-dot rs-dot-inactive"></span>Tidak Aktif</span>
        </div>
    </HeaderActions>
</booking_room_admin.Components.Shared.AdminTopBar>

<div class="room-status">
    <div class="rs-toolbar">
        <div class="rs-search">
            <img src="icon/search.svg" alt="Cari" class="rs-search-icon" />
            <input type="text" placeholder="Cari nama ruangan..." />
        </div>
        <select class="rs-filter"><option>Semua Lantai</option></select>
        <select class="rs-filter"><option>Semua Status</option></select>
    </div>

    <div class="rs-grid">
        <!-- 1. Kondisi Aktif Normal -->
        <div class="rs-card">
            <div class="rs-photo-wrapper">
                <img src="images/room1.jpg" class="rs-photo" onerror="this.src='https://placehold.co/400x200/e2e8f0/64748b?text=Ruang+Aktif'" />
                <div class="rs-badge-top-left badge-dark">20 Orang</div>
            </div>
            <div class="rs-card-body">
                <div class="rs-card-header">
                    <h3 class="rs-room-name">Ruang Rapat Utama</h3>
                    <div class="rs-toggle-group">
                        <label class="rs-switch">
                            <input type="checkbox" checked @onchange="() => OpenMaintenanceModal()" />
                            <span class="rs-slider round"></span>
                        </label>
                        <span class="rs-status-text text-active">AKTIF</span>
                    </div>
                </div>
                <div class="rs-location"><img src="icon/icon_8_admin.svg" /> Gedung A - Lantai 2</div>
                <div class="rs-facilities">
                    <span class="rs-chip">Projector 4K</span>
                    <span class="rs-chip">Webcam</span>
                    <span class="rs-chip">AC Central</span>
                </div>
            </div>
            <button class="btn-delete-room"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
        </div>

        <!-- 2. Kondisi Maintenance -->
        <div class="rs-card card-maintenance">
            <div class="rs-photo-wrapper">
                <img src="images/room2.jpg" class="rs-photo photo-grayscale" onerror="this.src='https://placehold.co/400x200/e2e8f0/64748b?text=Ruang+Maintenance'" />
                <div class="rs-badge-top-left badge-green">2 Dalam Antrian</div>
                <div class="rs-overlay-center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    <span>Maintenance (45:00)</span>
                </div>
            </div>
            <div class="rs-card-body">
                <div class="rs-card-header">
                    <h3 class="rs-room-name">Ruang Diskusi B</h3>
                    <div class="rs-toggle-group">
                        <label class="rs-switch">
                            <input type="checkbox" />
                            <span class="rs-slider round"></span>
                        </label>
                        <span class="rs-status-text text-maintenance">MAINTENANCE</span>
                    </div>
                </div>
                <div class="rs-location"><img src="icon/icon_8_admin.svg" /> Gedung B - Lantai 1</div>
                <div class="rs-schedule-row">
                    <div class="rs-schedule-label">Jadwal Maintenance:</div>
                    <div class="rs-duration-chips">
                        <button class="rs-dur-chip">20 Menit</button>
                        <button class="rs-dur-chip active">30 Menit</button>
                        <button class="rs-dur-chip">1 Jam</button>
                    </div>
                </div>
            </div>
            <div class="rs-maintenance-bar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Maintenance</span>
            </div>
            <button class="btn-delete-room"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
        </div>

        <!-- 3. Kondisi Tidak Aktif / Ghost Room -->
        <div class="rs-card card-ghost">
            <div class="rs-photo-wrapper">
                <img src="images/room3.jpg" class="rs-photo photo-grayscale" onerror="this.src='https://placehold.co/400x200/e2e8f0/64748b?text=Ruang+Placeholder'" />
            </div>
            <div class="rs-card-body">
                <div class="rs-card-header">
                    <h3 class="rs-room-name">Ruang Belum Dikonfigurasi</h3>
                    <div class="rs-toggle-group">
                        <label class="rs-switch">
                            <input type="checkbox" disabled />
                            <span class="rs-slider round"></span>
                        </label>
                        <span class="rs-status-text text-inactive">TIDAK AKTIF</span>
                    </div>
                </div>
                <div class="rs-location"><img src="icon/icon_8_admin.svg" /> Belum ada lokasi</div>
                <div class="rs-facilities text-muted text-sm">Menunggu setup admin...</div>
            </div>
        </div>
    </div>
</div>

<AppModal IsOpen="showMaintenanceModal" IsOpenChanged="v => showMaintenanceModal = v" Title="Set Maintenance">
    <div class="form-group">
        <label>Kategori Maintenance</label>
        <select class="form-input">
            <option>Preventive</option>
            <option>Corrective</option>
            <option>Routine Cleaning</option>
        </select>
    </div>
    <div class="form-group">
        <label>Prioritas</label>
        <select class="form-input">
            <option>Normal</option>
            <option>High</option>
            <option>Urgent</option>
        </select>
    </div>
    <div class="form-group">
        <label>Fasilitas yang Diservis</label>
        <input type="text" class="form-input" placeholder="Contoh: AC, Proyektor..." />
    </div>
    <div class="form-group">
        <label>Upload Dokumentasi (Opsional)</label>
        <input type="file" class="form-input" />
    </div>
    <div class="form-group">
        <label>Deskripsi</label>
        <textarea class="form-input" rows="3" placeholder="Detail kerusakan atau perawatan..."></textarea>
    </div>
    <div class="modal-actions">
        <button class="btn-outline" @onclick="() => showMaintenanceModal = false">Batal</button>
        <button class="btn-primary" @onclick="() => showMaintenanceModal = false">Simpan</button>
    </div>
</AppModal>

@code {
    private bool showMaintenanceModal = false;

    private void OpenMaintenanceModal()
    {
        showMaintenanceModal = true;
    }
}
