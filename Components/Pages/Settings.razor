@page "/settings"
@page "/pengaturan"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@inject booking_room_admin.Components.Services.ToastService Toast
@inject NavigationManager Navigation

<TopBar Title="Pengaturan" Subtitle="Kelola keamanan, preferensi, dan konfigurasi sistem." />

<div class="settings-page-wrapper">
    @if (isPageLoading)
    {
        <SkeletonPage Variant="settings" />
    }
    else
    {
        <div class="settings-layout">
            @* --- 1. LEFT SIDEBAR NAVIGATION MENU (4 GRUPS + FOOTER) --- *@
            <aside class="settings-nav-sidebar">
                @* Group 1: KEAMANAN *@
                <div class="settings-nav-group">
                    <span class="settings-nav-group-title">KEAMANAN</span>
                    <button type="button" class="settings-nav-item" @onclick="OpenPasswordModal">
                        <Icon Name="lock" Size="16" />
                        <span>Ubah Kata Sandi</span>
                    </button>
                    <button type="button" class="settings-nav-item" @onclick="OpenTwoFactorModal">
                        <Icon Name="shield" Size="16" />
                        <span>PIN / Verifikasi 2 Langkah</span>
                    </button>
                    <button type="button" class="settings-nav-item" @onclick="OpenSessionsModal">
                        <Icon Name="smartphone" Size="16" />
                        <span>Sesi & Perangkat Aktif</span>
                    </button>
                </div>

                @* Group 2: PREFERENSI *@
                <div class="settings-nav-group">
                    <span class="settings-nav-group-title">PREFERENSI</span>
                    <button type="button" class="settings-nav-item @(activeSection == "notifications" ? "active" : "")" @onclick='() => SetSection("notifications")'>
                        <Icon Name="bell" Size="16" />
                        <span>Notifikasi</span>
                    </button>
                    <button type="button" class="settings-nav-item @(activeSection == "language" ? "active" : "")" @onclick='() => SetSection("language")'>
                        <Icon Name="globe" Size="16" />
                        <span>Bahasa & Zona Waktu</span>
                    </button>
                </div>

                @* Group 3: SISTEM PEMESANAN *@
                <div class="settings-nav-group">
                    <span class="settings-nav-group-title">SISTEM PEMESANAN</span>
                    <button type="button" class="settings-nav-item @(activeSection == "booking-rules" ? "active" : "")" @onclick='() => SetSection("booking-rules")'>
                        <Icon Name="clock" Size="16" />
                        <span>Jam Operasional & Aturan Pemesanan</span>
                    </button>
                    <button type="button" class="settings-nav-item @(activeSection == "roles" ? "active" : "")" @onclick='() => SetSection("roles")'>
                        <Icon Name="users" Size="16" />
                        <span>Manajemen Peran & Hak Akses</span>
                    </button>
                    <button type="button" class="settings-nav-item @(activeSection == "integration" ? "active" : "")" @onclick='() => SetSection("integration")'>
                        <Icon Name="mail" Size="16" />
                        <span>Integrasi Kalender & Email</span>
                    </button>
                </div>

                @* Group 4: TAMPILAN *@
                <div class="settings-nav-group">
                    <span class="settings-nav-group-title">TAMPILAN</span>
                    <button type="button" class="settings-nav-item @(activeSection == "brand" ? "active" : "")" @onclick='() => SetSection("brand")'>
                        <Icon Name="palette" Size="16" />
                        <span>Logo & Warna Brand</span>
                    </button>
                </div>
            </aside>

            @* --- 2. RIGHT CONTENT PANEL --- *@
            <main class="settings-content-panel">
                @if (activeSection == "notifications")
                {
                    <div class="settings-panel-card">
                        <div class="panel-header">
                            <h2 class="panel-title">Pengaturan Notifikasi</h2>
                            <p class="panel-desc">Kelola preferensi komunikasi dan pemberitahuan sistem Anda.</p>
                        </div>

                        <div class="panel-body-sections">
                            @* Section 1: Notifikasi Email *@
                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Notifikasi Email</h3>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Konfirmasi Pemesanan</strong>
                                        <span>Terima email saat pemesanan dikonfirmasi.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="emailBookingConfirm" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pengingat Jadwal (H-1)</strong>
                                        <span>Dapatkan pengingat satu hari sebelum jadwal pemesanan.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="emailReminderD1" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pembatalan / Penolakan</strong>
                                        <span>Beri tahu saya segera jika pemesanan dibatalkan.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="emailCancellation" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pembatalan Terlambat / Tidak Hadir</strong>
                                        <span>Terima pengingat jika Anda belum check-in untuk pemesanan Anda.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="emailNoShow" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* Section 2: Notifikasi Dalam Aplikasi *@
                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Notifikasi Dalam Aplikasi</h3>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pembaruan Pemesanan Real-time</strong>
                                        <span>Tampilkan notifikasi pop-up atau lencana untuk perubahan pemesanan aktif.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="inAppRealTime" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Perubahan Status Ruangan</strong>
                                        <span>Peringatan saat ruangan tersedia atau tidak tersedia.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="inAppRoomStatus" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pemeliharaan Ruangan Selesai</strong>
                                        <span>Peringatan saat ruangan kembali tersedia setelah pemeliharaan.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="inAppMaintenanceDone" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* Section 3: Pemberitahuan Admin *@
                            <div class="settings-subgroup">
                                <div class="subgroup-header-badge">
                                    <h3 class="subgroup-title">Pemberitahuan Admin</h3>
                                    <span class="admin-badge-pill">Hanya terlihat untuk peran Admin</span>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pelacakan Pembatalan Terlambat / Tidak Hadir</strong>
                                        <span>Pantau pola pengguna yang sering membatalkan mendadak atau tidak check-in.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminNoShowTrack" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Konflik Pemesanan Terdeteksi</strong>
                                        <span>Beri tahu saat dua atau lebih pemesanan bertabrakan untuk ruangan yang sama.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminConflictDetect" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pemesanan Baru Menunggu Persetujuan</strong>
                                        <span>Memerlukan peninjauan manual untuk permintaan ruangan tertentu.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminPendingApproval" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Aktivitas Login Tidak Biasa</strong>
                                        <span>Peringatan keamanan untuk login dari perangkat atau lokasi tak dikenal.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminUnusualLogin" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Laporan Mingguan Otomatis</strong>
                                        <span>Terima ringkasan penggunaan sistem setiap hari Senin.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminWeeklyReport" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Pengguna Baru Terdaftar</strong>
                                        <span>Beri tahu saat akun karyawan baru dibuat dan memerlukan penetapan peran.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminNewUser" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Utilisasi Ruangan Rendah</strong>
                                        <span>Wawasan bulanan untuk ruangan dengan penggunaan di bawah 20% kapasitas.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="adminLowUtilization" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="panel-footer">
                            <button type="button" class="btn-outline-pill" @onclick="ResetNotificationPreferences">Batal</button>
                            <button type="button" class="btn-primary-pill btn-navy" @onclick="SaveNotificationPreferences">Simpan Preferensi</button>
                        </div>
                    </div>
                }
                else if (activeSection == "language")
                {
                    <div class="settings-panel-card">
                        <div class="panel-header">
                            <h2 class="panel-title">Bahasa & Zona Waktu</h2>
                            <p class="panel-desc">Kelola bagaimana informasi ditampilkan berdasarkan wilayah dan preferensi Anda.</p>
                        </div>

                        <div class="panel-body-sections">
                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Pengaturan Bahasa</h3>
                                <div class="form-grid-2col">
                                    <div class="form-group">
                                        <label class="form-label">BAHASA UTAMA</label>
                                        <select class="form-input" @bind="primaryLanguage">
                                            <option value="id-ID">Bahasa Indonesia</option>
                                        </select>
                                        <span class="form-help">Bahasa sistem tunggal resmi PT PERSADA.</span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">FORMAT TANGGAL</label>
                                        <select class="form-input" @bind="dateFormat">
                                            <option value="dd/MM/yyyy">DD/MM/YYYY (31/12/2026)</option>
                                            <option value="yyyy-MM-dd">YYYY-MM-DD (2026-12-31)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group" style="max-width: 480px; margin-top: 1rem;">
                                    <label class="form-label">FORMAT ANGKA</label>
                                    <select class="form-input" @bind="numberFormat">
                                        <option value="id">1.234,56 (Format Standar Indonesia)</option>
                                        <option value="us">1,234.56 (Format Standar Internasional)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Pengaturan Zona Waktu</h3>
                                <div class="form-group" style="max-width: 480px;">
                                    <label class="form-label">ZONA WAKTU SAAT INI</label>
                                    <select class="form-input" @bind="currentTimeZone">
                                        <option value="WIB">(GMT+07:00) WIB - Jakarta</option>
                                        <option value="WITA">(GMT+08:00) WITA - Makassar / Denpasar</option>
                                        <option value="WIT">(GMT+09:00) WIT - Jayapura</option>
                                    </select>
                                </div>

                                <div class="toggle-row" style="margin-top: 1rem;">
                                    <div class="toggle-info">
                                        <strong>Atur zona waktu otomatis</strong>
                                        <span>Gunakan lokasi Anda untuk mengatur zona waktu.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="autoTimeZone" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Format Waktu 24 Jam</strong>
                                        <span>Tampilkan waktu sebagai 13:00, bukan 1:00 PM.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="is24HourFormat" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="form-group" style="max-width: 480px; margin-top: 1rem;">
                                    <label class="form-label">HARI PERTAMA DALAM SEMINGGU</label>
                                    <select class="form-input" @bind="firstDayOfWeek">
                                        <option value="Senin">Senin</option>
                                        <option value="Minggu">Minggu</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="panel-footer">
                            <button type="button" class="btn-outline-pill" @onclick="CancelChanges">Batalkan Perubahan</button>
                            <button type="button" class="btn-primary-pill btn-navy" @onclick="SaveLanguageSettings">Simpan Perubahan</button>
                        </div>
                    </div>
                }
                else if (activeSection == "booking-rules")
                {
                    <div class="settings-panel-card">
                        <div class="panel-header">
                            <h2 class="panel-title">Jam Operasional & Aturan Pemesanan</h2>
                            <p class="panel-desc">Atur waktu ketersediaan ruangan, kebijakan reservasi, dan mekanisme persetujuan bertingkat.</p>
                        </div>

                        <div class="panel-body-sections">
                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Jam Operasional Ruangan</h3>
                                <div class="form-grid-2col">
                                    <div class="form-group">
                                        <label class="form-label">Jam Buka Operasional</label>
                                        <input type="time" class="form-input" @bind="openTime" />
                                        <span class="form-help">Waktu paling awal ruangan dapat mulai dipesan.</span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Jam Tutup Operasional</label>
                                        <input type="time" class="form-input" @bind="closeTime" />
                                        <span class="form-help">Batas akhir pemakaian ruangan setiap hari kerja.</span>
                                    </div>
                                </div>
                                <div class="form-grid-2col" style="margin-top: 1rem;">
                                    <div class="form-group">
                                        <label class="form-label">Durasi Maksimal Per Sesi (Jam)</label>
                                        <input type="number" min="1" max="12" class="form-input" @bind="maxDurationHours" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Batas Pemesanan di Muka (Hari)</label>
                                        <input type="number" min="1" max="60" class="form-input" @bind="advanceBookingDays" />
                                    </div>
                                </div>
                                <div class="toggle-row" style="margin-top: 1rem;">
                                    <div class="toggle-info">
                                        <strong>Izinkan Pemesanan di Akhir Pekan / Luar Jam Kerja</strong>
                                        <span>Memerlukan persetujuan khusus dari admin divisi GA.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="allowWeekendBooking" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            <div class="settings-subgroup">
                                <h3 class="subgroup-title">Konfigurasi Persetujuan Bertingkat</h3>
                                <div class="toggle-row">
                                    <div class="toggle-info">
                                        <strong>Persetujuan Otomatis untuk Ruangan Reguler</strong>
                                        <span>Setujui otomatis pemesanan ruangan standar berdasarkan ketersediaan kapasitas.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="autoApprovalRegular" @bind:after="OnApprovalRuleChanged" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="form-group" style="max-width: 480px; margin-top: 1rem;">
                                    <label class="form-label">Ambang Batas Persetujuan Bertingkat</label>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <span style="font-size: 0.85rem; font-weight: 500; color: var(--color-text-secondary);">KAPASITAS &gt;=</span>
                                        <input type="number" min="5" max="200" class="form-input" style="width: 100px;" @bind="approvalThresholdCapacity" @bind:after="OnApprovalRuleChanged" />
                                        <span style="font-size: 0.85rem; color: var(--color-text-secondary);">Orang</span>
                                    </div>
                                    <span class="form-help">Perlukan persetujuan tambahan saat kapasitas ruangan mencapai atau melebihi nilai ini.</span>
                                </div>

                                <div class="toggle-row" style="margin-top: 1rem;">
                                    <div class="toggle-info">
                                        <strong>Persetujuan 2 Tingkat untuk Kategori VIP</strong>
                                        <span>Selalu perlukan dua tingkat persetujuan administratif untuk pemesanan ruangan VIP.</span>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="twoLevelApprovalVIP" @bind:after="OnApprovalRuleChanged" />
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="panel-footer">
                            <button type="button" class="btn-outline-pill" @onclick="CancelChanges">Batalkan Perubahan</button>
                            <button type="button" class="btn-primary-pill btn-navy" @onclick="SaveBookingRules">Simpan Perubahan</button>
                        </div>
                    </div>
                }
                else if (activeSection == "roles")
                {
                    <div class="settings-panel-card">
                        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                            <div>
                                <h2 class="panel-title">Manajemen Peran & Hak Akses</h2>
                                <p class="panel-desc">Konfigurasikan matriks hak akses dan wewenang untuk setiap tingkatan pengguna sistem.</p>
                            </div>
                            <button type="button" class="btn-primary-pill btn-yellow" @onclick="OpenAddCustomRole">
                                <Icon Name="plus" Size="14" />
                                <span>Tambah Role Kustom</span>
                            </button>
                        </div>

                        <div class="panel-body-sections">
                            <div class="role-matrix-table-wrap">
                                <table class="role-matrix-table">
                                    <thead>
                                        <tr>
                                            <th>HAK AKSES</th>
                                            <th class="th-center">Admin</th>
                                            <th class="th-center">Staf</th>
                                            <th class="th-center">Karyawan</th>
                                            @foreach(var cr in customRolesList) {
                                                <th class="th-center">@cr.Name</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>Buat Pemesanan</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            @foreach(var cr in customRolesList) {
                                                <td class="td-center">
                                                    @if (cr.CanCreateBooking) { <span class="perm-check checked"><Icon Name="check" Size="16" /></span> }
                                                    else { <span class="perm-check unchecked"><Icon Name="x" Size="14" /></span> }
                                                </td>
                                            }
                                        </tr>
                                        <tr>
                                            <td><strong>Setujui / Tolak Pemesanan</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            @foreach(var cr in customRolesList) {
                                                <td class="td-center">
                                                    @if (cr.CanApproveBooking) { <span class="perm-check checked"><Icon Name="check" Size="16" /></span> }
                                                    else { <span class="perm-check unchecked"><Icon Name="x" Size="14" /></span> }
                                                </td>
                                            }
                                        </tr>
                                        <tr>
                                            <td><strong>Kelola Ruangan</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            @foreach(var cr in customRolesList) {
                                                <td class="td-center">
                                                    @if (cr.CanManageRooms) { <span class="perm-check checked"><Icon Name="check" Size="16" /></span> }
                                                    else { <span class="perm-check unchecked"><Icon Name="x" Size="14" /></span> }
                                                </td>
                                            }
                                        </tr>
                                        <tr>
                                            <td><strong>Kelola Pengguna & Peran</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            @foreach(var cr in customRolesList) {
                                                <td class="td-center">
                                                    @if (cr.CanManageUsers) { <span class="perm-check checked"><Icon Name="check" Size="16" /></span> }
                                                    else { <span class="perm-check unchecked"><Icon Name="x" Size="14" /></span> }
                                                </td>
                                            }
                                        </tr>
                                        <tr>
                                            <td><strong>Lihat Laporan</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
                                            @foreach(var cr in customRolesList) {
                                                <td class="td-center">
                                                    @if (cr.CanViewReports) { <span class="perm-check checked"><Icon Name="check" Size="16" /></span> }
                                                    else { <span class="perm-check unchecked"><Icon Name="x" Size="14" /></span> }
                                                </td>
                                            }
                                        </tr>
                                        <tr>
                                            <td><strong>Ubah Pengaturan Sistem</strong></td>
                                            <td class="td-center"><span class="perm-check checked"><Icon Name="check" Size="16" /></span></td>
                                            <td class="td-center"><span class="perm-check unchecked"><Icon Name="x" Size="14" /></span></td>
