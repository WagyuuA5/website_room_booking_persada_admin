@* --- 3. MODAL 1: UBAH KATA SANDI (CASE 3.2.1) --- *@
<AppModal IsOpen="@showPasswordModal" IsOpenChanged="@((bool v) => showPasswordModal = v)" Title="Ubah Kata Sandi" Size="medium">
    <ChildContent>
        <p class="modal-desc-sub">Perbarui keamanan akun Anda dengan memilih kata sandi yang kuat.</p>
        
        <div class="um-form" style="margin-top: 1rem;">
            <div class="form-group">
                <label class="form-label">KATA SANDI SAAT INI</label>
                <input type="password" class="form-input" placeholder="Masukkan kata sandi saat ini" @bind="currentPassword" />
            </div>

            <div class="form-group">
                <label class="form-label">KATA SANDI BARU</label>
                <input type="password" class="form-input" placeholder="Masukkan kata sandi baru" @bind="newPassword" @bind:event="oninput" />
                
                @if (!string.IsNullOrEmpty(newPassword))
                {
                    var strength = GetStrengthScore(newPassword);
                    <div class="password-strength-box" style="margin-top: 6px;">
                        <div class="strength-bar-track">
                            <div class="strength-bar-fill @GetStrengthClass(strength)" style="width: @(strength * 33.3)%;"></div>
                        </div>
                        <span class="strength-status-text">Kekuatan kata sandi: <strong>@GetStrengthText(strength)</strong></span>
                    </div>
                }
            </div>

            <div class="form-group">
                <label class="form-label">KONFIRMASI KATA SANDI BARU</label>
                <input type="password" class="form-input" placeholder="Konfirmasi kata sandi baru" @bind="confirmNewPassword" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showPasswordModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-navy" @onclick="SubmitChangePassword">Perbarui Kata Sandi</button>
    </FooterContent>
</AppModal>

@* --- 4. MODAL 2: VERIFIKASI 2 LANGKAH / PIN (CASE 3.2.2) --- *@
<AppModal IsOpen="@showTwoFactorModal" IsOpenChanged="@((bool v) => showTwoFactorModal = v)" Title="Verifikasi 2 Langkah" Size="small">
    <ChildContent>
        <p class="modal-desc-sub">Masukkan 6 digit kode yang dikirim ke email/nomor Anda: <br /><strong style="color: var(--color-text-primary);">w****u@ptpersada.co.id</strong></p>

        <div style="margin: 1.5rem 0; display: flex; justify-content: center; gap: 8px;">
            <input type="text" maxlength="6" class="form-input" style="width: 200px; text-align: center; font-size: 1.4rem; letter-spacing: 6px; font-weight: 600;" placeholder="000000" @bind="twoFactorCode" />
        </div>

        <div style="text-align: center; font-size: 0.82rem; color: var(--color-text-secondary);">
            <span>Belum menerima kode? </span>
            <button type="button" class="btn-link-action" @onclick="ResendTwoFactorCode">Kirim ulang</button>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showTwoFactorModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-navy" @onclick="SubmitTwoFactorVerify">Verifikasi</button>
    </FooterContent>
</AppModal>

@* --- 5. MODAL 3: SESI & PERANGKAT AKTIF (CASE 3.2.3) --- *@
<AppModal IsOpen="@showSessionsModal" IsOpenChanged="@((bool v) => showSessionsModal = v)" Title="Sesi & Perangkat Aktif" Size="medium">
    <ChildContent>
        <p class="modal-desc-sub">Kelola sesi login aktif Anda di berbagai perangkat dan peramban.</p>

        <div class="sessions-list-wrapper" style="margin-top: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
            @* Sesi Saat Ini *@
            <div class="session-section">
                <span class="session-section-title">SESI SAAT INI</span>
                <div class="session-card current-session">
                    <div class="session-icon-wrap" style="background: var(--color-success-soft); color: var(--color-success);">
                        <Icon Name="monitor" Size="20" />
                    </div>
                    <div class="session-info-wrap">
                        <div class="session-title-row">
                            <strong>MacBook Pro – Chrome</strong>
                            <span class="badge-active-now">Aktif Sekarang</span>
                        </div>
                        <span class="session-meta">Jakarta, Indonesia &middot; IP: 192.168.1.10</span>
                    </div>
                </div>
            </div>

            @* Sesi Lainnya *@
            <div class="session-section">
                <span class="session-section-title">SESI LAINNYA</span>
                <div class="session-items-list">
                    @foreach (var s in activeSessionsList)
                    {
                        <div class="session-card">
                            <div class="session-icon-wrap" style="background: var(--color-surface-alt); color: var(--color-text-secondary);">
                                <Icon Name="@s.Icon" Size="20" />
                            </div>
                            <div class="session-info-wrap">
                                <strong>@s.DeviceName</strong>
                                <span class="session-meta">@s.Location &middot; IP: @s.IpAddress &middot; @s.LastActiveText</span>
                            </div>
                            <button type="button" class="btn-revoke-session" @onclick="() => RevokeSession(s.Id)">Cabut Akses</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showSessionsModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-danger" @onclick="RevokeAllOtherSessions">Keluar dari Semua Sesi Lain</button>
    </FooterContent>
</AppModal>

<AppModal IsOpen="@showCustomRoleModal" IsOpenChanged="@((bool v) => showCustomRoleModal = v)" Size="medium">
    <HeaderContent>
        <h4 class="modal-title">Tambah Role Kustom</h4>
        <button type="button" class="btn-icon" @onclick="() => showCustomRoleModal = false" style="background:transparent; border:none; cursor:pointer; color:var(--color-text-secondary, #64748B); display:flex; align-items:center; justify-content:center; padding: 4px; border-radius: 50%;" aria-label="Tutup">
            <Icon Name="x" Size="20" />
