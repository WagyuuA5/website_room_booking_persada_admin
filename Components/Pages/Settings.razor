@page "/settings"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@inject booking_room_admin.Components.Services.ToastService Toast

<TopBar Title="Pengaturan Sistem" Subtitle="Konfigurasi preferensi, jam operasional, dan kebijakan aplikasi pemesanan ruangan." />

<div class="settings-page">
    @* -- Segmented Tab Nav -- *@
    <div class="settings-tabs-row">
        <button type="button" class="settings-tab-btn @(activeTab == "general" ? "active" : "")" @onclick='() => activeTab = "general"'>
            <Icon Name="sliders" Size="15" />
            <span>Sistem & Operasional</span>
        </button>
        <button type="button" class="settings-tab-btn @(activeTab == "security" ? "active" : "")" @onclick='() => activeTab = "security"'>
            <Icon Name="shield" Size="15" />
            <span>Keamanan & Kata Sandi</span>
        </button>
        <button type="button" class="settings-tab-btn @(activeTab == "notifications" ? "active" : "")" @onclick='() => activeTab = "notifications"'>
            <Icon Name="bell" Size="15" />
            <span>Preferensi & Notifikasi</span>
        </button>
        <button type="button" class="settings-tab-btn @(activeTab == "appearance" ? "active" : "")" @onclick='() => activeTab = "appearance"'>
            <Icon Name="palette" Size="15" />
            <span>Tampilan & Brand</span>
        </button>
    </div>

    @* -- Tab 1: Sistem & Operasional -- *@
    @if (activeTab == "general")
    {
        <div class="settings-card">
            <div class="card-header-clean">
                <div>
                    <h3 class="card-title"><Icon Name="clock" Size="18" /> Jam Operasional & Aturan Pemesanan</h3>
                    <p class="card-desc">Tentukan batas waktu pemesanan ruangan dan durasi maksimal per sesi.</p>
                </div>
            </div>
            <div class="card-form-grid">
                <div class="form-group">
                    <label class="form-label">Jam Buka Operasional</label>
                    <input type="time" class="form-input" @bind="openTime" />
                    <span class="form-help">Waktu paling awal ruangan dapat mulai dipesan.</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Jam Tutup Operasional</label>
                    <input type="time" class="form-input" @bind="closeTime" />
                    <span class="form-help">Batas akhir penggunaan ruangan setiap hari kerja.</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Durasi Maksimal Per Sesi (Jam)</label>
                    <input type="number" class="form-input" min="1" max="12" @bind="maxDurationHours" />
                    <span class="form-help">Mencegah monopoli ruangan oleh satu divisi.</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Batas Pemesanan di Muka (Hari)</label>
                    <input type="number" class="form-input" min="1" max="60" @bind="advanceBookingDays" />
                    <span class="form-help">Berapa hari sebelumnya user diizinkan reservasi.</span>
                </div>
            </div>

            <div class="settings-divider"></div>

            <div class="toggle-group-row">
                <div class="toggle-text">
                    <strong>Izinkan Pemesanan di Luar Jam Kerja</strong>
                    <span>Memerlukan persetujuan khusus dari admin divisi.</span>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="allowAfterHours" />
                    <span class="slider round"></span>
                </label>
            </div>

            <div class="card-footer-action">
                <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveSettings">
                    <Icon Name="check" Size="14" />
                    <span>Simpan Perubahan</span>
                </button>
            </div>
        </div>
    }
    else if (activeTab == "security")
    {
        <div class="settings-card">
            <div class="card-header-clean">
                <div>
                    <h3 class="card-title"><Icon Name="lock" Size="18" /> Ubah Kata Sandi Akun</h3>
                    <p class="card-desc">Perbarui kata sandi secara berkala untuk menjaga keamanan akun Anda.</p>
                </div>
            </div>
            <div class="card-form-grid" style="grid-template-columns: 1fr;">
                <div class="form-group" style="max-width: 480px;">
                    <label class="form-label">Kata Sandi Saat Ini</label>
                    <input type="password" class="form-input" placeholder="Masukkan kata sandi lama" @bind="oldPassword" />
                </div>
                <div class="form-group" style="max-width: 480px;">
                    <label class="form-label">Kata Sandi Baru</label>
                    <input type="password" class="form-input" placeholder="Minimal 8 karakter dengan kombinasi angka" @bind="newPassword" />
                </div>
                <div class="form-group" style="max-width: 480px;">
                    <label class="form-label">Konfirmasi Kata Sandi Baru</label>
                    <input type="password" class="form-input" placeholder="Ulangi kata sandi baru" @bind="confirmPassword" />
                </div>
            </div>

            <div class="settings-divider"></div>

            <div class="toggle-group-row">
                <div class="toggle-text">
                    <strong>Verifikasi 2 Langkah (PIN Keamanan)</strong>
                    <span>Wajibkan kode otentikasi saat login dari perangkat baru.</span>
                </div>
                <label class="switch">
                    <input type="checkbox" @bind="enable2FA" />
                    <span class="slider round"></span>
                </label>
            </div>

            <div class="card-footer-action">
                <button type="button" class="btn-primary-pill btn-yellow" @onclick="SavePassword">
                    <Icon Name="check" Size="14" />
                    <span>Perbarui Kata Sandi</span>
                </button>
            </div>
        </div>
    }
    else if (activeTab == "notifications")
    {
        <div class="settings-card">
            <div class="card-header-clean">
                <div>
                    <h3 class="card-title"><Icon Name="bell" Size="18" /> Preferensi Notifikasi & Email</h3>
                    <p class="card-desc">Atur jenis pemberitahuan yang dikirimkan ke email dan lonceng aplikasi.</p>
                </div>
            </div>
            <div class="notification-options-list">
                <div class="toggle-group-row">
                    <div class="toggle-text">
                        <strong>Notifikasi Persetujuan Pemesanan</strong>
                        <span>Kirim pemberitahuan instan saat pengajuan disetujui atau ditolak.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="toggle-group-row">
                    <div class="toggle-text">
                        <strong>Pengingat Jadwal Rapat</strong>
                        <span>Kirim pengingat 15 menit sebelum waktu pemesanan ruangan dimulai.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="toggle-group-row">
                    <div class="toggle-text">
                        <strong>Laporan Mingguan Otomatis</strong>
                        <span>Terima rekap penggunaan ruangan mingguan di email admin.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>

            <div class="card-footer-action">
                <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveSettings">
                    <Icon Name="check" Size="14" />
                    <span>Simpan Preferensi</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="settings-card">
            <div class="card-header-clean">
                <div>
                    <h3 class="card-title"><Icon Name="image" Size="18" /> Identitas & Warna Brand</h3>
                    <p class="card-desc">Sesuaikan logo instansi dan palet warna antarmuka sistem.</p>
                </div>
            </div>
            <div class="card-form-grid">
                <div class="form-group">
                    <label class="form-label">Nama Perusahaan / Organisasi</label>
                    <input type="text" class="form-input" value="PT PERSADA KARYA UTAMA" />
                </div>
                <div class="form-group">
                    <label class="form-label">Format Zona Waktu</label>
                    <select class="sr-pill-select" style="width:100%;">
                        <option>Waktu Indonesia Barat (WIB, UTC+7)</option>
                        <option>Waktu Indonesia Tengah (WITA, UTC+8)</option>
                        <option>Waktu Indonesia Timur (WIT, UTC+9)</option>
                    </select>
                </div>
            </div>

            <div class="card-footer-action">
                <button type="button" class="btn-primary-pill btn-yellow" @onclick="SaveSettings">
                    <Icon Name="check" Size="14" />
                    <span>Simpan Perubahan</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "general";

    private TimeOnly openTime = new TimeOnly(8, 0);
    private TimeOnly closeTime = new TimeOnly(18, 0);
    private int maxDurationHours = 4;
    private int advanceBookingDays = 14;
    private bool allowAfterHours = false;

    private string oldPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool enable2FA = true;

    private void SaveSettings()
    {
        Toast.Success("Pengaturan sistem berhasil disimpan.");
    }

    private void SavePassword()
    {
        if (string.IsNullOrWhiteSpace(oldPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            Toast.Error("Mohon lengkapi seluruh kolom kata sandi.");
            return;
        }
        if (newPassword != confirmPassword)
        {
            Toast.Error("Konfirmasi kata sandi baru tidak cocok.");
            return;
        }

        Toast.Success("Kata sandi akun berhasil diperbarui.");
        oldPassword = "";
        newPassword = "";
        confirmPassword = "";
    }
}







