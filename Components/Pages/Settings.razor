            <div class="form-group" style="display:flex; flex-direction:column; gap:1rem;">
                <label style="font-weight:600; color:var(--color-ink-900, #14171F);">Hak Akses Modul</label>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permCreateBooking" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Buat Pemesanan
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permApproveBooking" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Setujui / Tolak Pemesanan
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permManageRooms" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Kelola Ruangan
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permManageUsers" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Kelola Pengguna & Peran
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permViewReports" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Lihat Laporan
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer; color:var(--color-text-primary, #0F172A);">
                        <input type="checkbox" @bind="permChangeSettings" style="width:1.125rem; height:1.125rem; cursor:pointer;" />
                        Ubah Pengaturan Sistem
                    </label>
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="() => showCustomRoleModal = false">Batal</button>
        <button type="button" class="btn-primary-pill btn-navy" @onclick="SaveNewCustomRole">Simpan Role</button>
    </FooterContent>
</AppModal>

@code {
    private bool isPageLoading = true;
    private string activeSection = "notifications";

    // Modals
    private bool showPasswordModal = false;
    private bool showTwoFactorModal = false;
    private bool showSessionsModal = false;
    private bool showCustomRoleModal = false;

    // Tambah Role Kustom
    private string newRoleName = "";
    private string newRoleDesc = "";
    private bool permCreateBooking = false;
    private bool permApproveBooking = false;
    private bool permManageRooms = false;
    private bool permManageUsers = false;
    private bool permViewReports = false;
    private bool permChangeSettings = false;

    public class RoleMatrixItem
    {
        public string Name { get; set; } = "";
        public bool CanCreateBooking { get; set; }
        public bool CanApproveBooking { get; set; }
        public bool CanManageRooms { get; set; }
        public bool CanManageUsers { get; set; }
        public bool CanViewReports { get; set; }
        public bool CanChangeSettings { get; set; }
    }

    private List<RoleMatrixItem> customRolesList = new();

    // Ubah Kata Sandi
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmNewPassword = "";

    // 2FA
    private string twoFactorCode = "";

    // Sesi model
    public class DeviceSession
    {
        public int Id { get; set; }
        public string DeviceName { get; set; } = "";
        public string Location { get; set; } = "";
        public string IpAddress { get; set; } = "";
        public string LastActiveText { get; set; } = "";
        public string Icon { get; set; } = "smartphone";
    }

    private List<DeviceSession> activeSessionsList = new()
    {
        new() { Id = 1, DeviceName = "iPhone 15 Pro – Safari", Location = "Jakarta, Indonesia", IpAddress = "192.168.1.42", LastActiveText = "Aktif 2 jam lalu", Icon = "smartphone" },
        new() { Id = 2, DeviceName = "Windows 11 – Edge", Location = "Bandung, Indonesia", IpAddress = "182.253.4.12", LastActiveText = "Aktif 1 hari lalu", Icon = "monitor" },
        new() { Id = 3, DeviceName = "iPad Air – Safari", Location = "Jakarta, Indonesia", IpAddress = "192.168.1.88", LastActiveText = "Aktif 3 hari lalu", Icon = "tablet" }
    };

    // Preferensi Notifikasi
    private bool emailBookingConfirm = true;
    private bool emailReminderD1 = true;
    private bool emailCancellation = true;
    private bool emailNoShow = false;

    private bool inAppRealTime = true;
    private bool inAppRoomStatus = true;
    private bool inAppMaintenanceDone = true;

    private bool adminNoShowTrack = true;
    private bool adminConflictDetect = true;
    private bool adminPendingApproval = true;
    private bool adminUnusualLogin = true;
    private bool adminWeeklyReport = false;
    private bool adminNewUser = true;
    private bool adminLowUtilization = false;

    // Bahasa & Zona Waktu
    private string primaryLanguage = "id-ID";
    private string dateFormat = "dd/MM/yyyy";
    private string numberFormat = "id";
    private string currentTimeZone = "WIB";
    private bool autoTimeZone = true;
    private bool is24HourFormat = true;
    private string firstDayOfWeek = "Senin";

    // Jam Operasional & Booking Rules
    private TimeOnly openTime = new TimeOnly(8, 0);
    private TimeOnly closeTime = new TimeOnly(18, 0);
    private int maxDurationHours = 4;
    private int advanceBookingDays = 14;
    private bool allowWeekendBooking = false;
    private bool autoApprovalRegular = true;
    private int approvalThresholdCapacity = 20;
    private bool twoLevelApprovalVIP = true;

    // Integrasi
    private string smtpSender = "noreply-booking@ptpersada.co.id";
    private string smtpHost = "smtp.office365.com";
    private int smtpPort = 587;
    private string smtpSecurity = "STARTTLS";

    protected override async Task OnInitializedAsync()
    {
        // Smooth skeleton loading simulation
        await Task.Delay(260);
        isPageLoading = false;
    }

    private void SetSection(string section)
    {
        activeSection = section;
    }

    private void OpenPasswordModal()
    {
        currentPassword = "";
        newPassword = "";
        confirmNewPassword = "";
        showPasswordModal = true;
    }

    private void OpenTwoFactorModal()
    {
        twoFactorCode = "";
        showTwoFactorModal = true;
        Toast.Info("Kode verifikasi sedang dikirim ke email/nomor Anda.");
    }

    private void OpenSessionsModal()
    {
        showSessionsModal = true;
    }

    private int GetStrengthScore(string pass)
    {
        if (string.IsNullOrEmpty(pass)) return 0;
        int score = 1;
        if (pass.Length >= 8) score++;
        if (pass.Any(char.IsDigit) && pass.Any(char.IsLetter)) score++;
        return score;
    }

    private string GetStrengthClass(int score) => score switch
    {
        1 => "strength-weak",
        2 => "strength-fair",
        3 => "strength-strong",
        _ => "strength-weak"
    };

    private string GetStrengthText(int score) => score switch
    {
        1 => "Lemah",
        2 => "Cukup",
        3 => "Kuat",
        _ => "Lemah"
    };

    private void SubmitChangePassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            Toast.Error("Mohon lengkapi seluruh kolom kata sandi.");
            return;
        }
        if (newPassword != confirmNewPassword)
        {
            Toast.Error("Konfirmasi kata sandi baru tidak cocok.");
            return;
        }
        if (newPassword.Length < 8)
        {
            Toast.Error("Kata sandi baru minimal 8 karakter.");
            return;
        }

        Toast.Success("Kata sandi akun Anda berhasil diperbarui.");
        showPasswordModal = false;
    }

    private void SubmitTwoFactorVerify()
    {
        if (string.IsNullOrWhiteSpace(twoFactorCode) || twoFactorCode.Length < 6)
        {
            Toast.Error("Mohon masukkan 6 digit kode verifikasi yang valid.");
            return;
        }

        Toast.Success("Verifikasi 2 Langkah berhasil dikonfirmasi.");
        showTwoFactorModal = false;
    }

    private void ResendTwoFactorCode()
    {
        Toast.Info("Kode verifikasi sedang dikirim ke email/nomor Anda.");
    }

    private void RevokeSession(int id)
    {
        activeSessionsList.RemoveAll(s => s.Id == id);
        Toast.Info("Sesi perangkat berhasil dicabut.");
    }

    private void RevokeAllOtherSessions()
    {
        activeSessionsList.Clear();
        Toast.Info("Semua sesi lain telah dikeluarkan.");
        showSessionsModal = false;
    }

