    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:1.5rem;">
            <div class="form-group" style="display:flex; flex-direction:column; gap:0.5rem;">
                <label style="font-weight:600; color:var(--color-ink-900, #14171F);">Nama Role <span style="color:var(--color-danger, #DC2626);">*</span></label>
                <input type="text" @bind="newRoleName" class="form-input" placeholder="Contoh: Supervisor Gedung" style="padding:0.75rem 1rem; border-radius:var(--radius-md, 12px); border:1px solid var(--color-border, #E3E6EC); width:100%; transition:all 0.2s ease;" />
