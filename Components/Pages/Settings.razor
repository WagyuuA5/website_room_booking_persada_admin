    private void OpenAddCustomRole()
    {
        newRoleName = "";
        newRoleDesc = "";
        permCreateBooking = false;
        permApproveBooking = false;
        permManageRooms = false;
        permManageUsers = false;
        permViewReports = false;
        permChangeSettings = false;
        showCustomRoleModal = true;
        Toast.Info("Formulir penambahan role kustom dibuka.");
    }

    private void SaveNewCustomRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            Toast.Error("Nama role tidak boleh kosong.");
            return;
        }

        customRolesList.Add(new RoleMatrixItem
        {
            Name = newRoleName,
            CanCreateBooking = permCreateBooking,
            CanApproveBooking = permApproveBooking,
            CanManageRooms = permManageRooms,
            CanManageUsers = permManageUsers,
            CanViewReports = permViewReports,
            CanChangeSettings = permChangeSettings
        });

        showCustomRoleModal = false;
        Toast.Success("Role kustom berhasil ditambahkan.");
    }

