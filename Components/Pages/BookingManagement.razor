            }
        };
    }

    private IEnumerable<BookingExtendedItem> FilteredBookings
    {
        get
        {
            var q = allBookings.AsEnumerable();
            if (selectedTab != "all") q = q.Where(b => b.Status.Equals(selectedTab, StringComparison.OrdinalIgnoreCase));
            if (selectedDateFilter.HasValue) q = q.Where(b => b.Date.Date == selectedDateFilter.Value.Date);
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.ToLowerInvariant();
                q = q.Where(b => b.Title.ToLowerInvariant().Contains(query) ||
                                 b.RequesterName.ToLowerInvariant().Contains(query) ||
                                 b.RequesterDivision.ToLowerInvariant().Contains(query) ||
                                 b.Room.ToLowerInvariant().Contains(query));
            }
            return q;
        }
    }

    private int currentPage = 1;
    private int pageSize = 4;

    private IEnumerable<IGrouping<DateTime, BookingExtendedItem>> GroupedBookings =>
        FilteredBookings.OrderBy(b => b.Date).ThenBy(b => b.StartTime).GroupBy(b => b.Date.Date);

    private IEnumerable<IGrouping<DateTime, BookingExtendedItem>> PagedGroupedBookings =>
        FilteredBookings.OrderBy(b => b.Date).ThenBy(b => b.StartTime)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .GroupBy(b => b.Date.Date);

    private int GetCount(string status) => allBookings.Count(b => b.Status.Equals(status, StringComparison.OrdinalIgnoreCase));

    private void HandlePageChanged(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private void SelectTab(string tab)
    {
        selectedTab = tab;
        currentPage = 1;
    }

    private void HandleDateChanged(DateTime? d)
    {
        selectedDateFilter = d;
        currentPage = 1;
        StateHasChanged();
    }

    private void OnDatePicked(DateTime? d)
    {
        selectedDateFilter = d;
        currentPage = 1;
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchQuery = "";
        selectedTab = "all";
        selectedDateFilter = null;
    }

    private void OpenDetail(BookingExtendedItem b)
    {
        selectedBooking = b;
        showDetailModal = true;
    }

    private void QuickApprove(BookingExtendedItem b)
    {
        b.Status = "approved";
        b.HasConflict = false;
        b.ProcessedBy = "Disetujui oleh Admin Wahyu";
        b.ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm");
        Toast.Success($"Booking '{b.Title}' berhasil disetujui.");
        StateHasChanged();
    }

    private void QuickReject(BookingExtendedItem b)
    {
        b.Status = "rejected";
        b.ProcessedBy = "Ditolak oleh Admin Wahyu";
        b.ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm");
        Toast.Error($"Booking '{b.Title}' telah ditolak.");
        StateHasChanged();
    }

    private void ApproveBooking(BookingExtendedItem b)
    {
        QuickApprove(b);
        showDetailModal = false;
    }

    private void RejectBooking(BookingExtendedItem b)
    {
        QuickReject(b);
        showDetailModal = false;
    }

    private void HandleBookingCreated(Booking b)
    {
        allBookings.Insert(0, new BookingExtendedItem
        {
            Id = b.Id,
            Title = b.Title,
            Room = b.Room,
            Date = b.Date,
            StartTime = b.StartTime,
            EndTime = b.EndTime,
            Duration = b.Duration,
            RequesterName = b.RequesterName,
            RequesterDivision = b.RequesterDivision,
            RequesterInitials = b.RequesterInitials,
            ParticipantsCount = b.ParticipantsCount,
            Status = "approved",
            ProcessedBy = "Dibuat Manual oleh Admin Wahyu",
            ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm")
        });
        StateHasChanged();
    }

    private string GetStatusLabel(string status) => status switch
    {
        "pending" => "Menunggu",
        "approved" => "Disetujui",
        "rejected" => "Ditolak",
        "cancelled" => "Dibatalkan",
        _ => status
    };

    private string GetRoomPhoto(string room) => room switch
    {
        "Ruang Dirantara" => "https://images.unsplash.com/photo-1517502884422-41eaead166d4?w=800&auto=format&fit=crop&q=80",
        "Ruang Rapat A" => "https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&auto=format&fit=crop&q=80",
        "Ruang Boardroom" => "https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&auto=format&fit=crop&q=80",
        "Ruang Training" => "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&auto=format&fit=crop&q=80",
        "Ruang Diskusi C" => "https://images.unsplash.com/photo-1577495508048-b635879837f1?w=800&auto=format&fit=crop&q=80",
        _ => "https://images.unsplash.com/photo-1431540015161-0bf868a2d407?w=800&auto=format&fit=crop&q=80"
    };

    private string GetRoomLocationText(string room) => room switch
    {
        "Ruang Dirantara" => "Lantai 3, Sayap Utama — dekat lift eksekutif",
        "Ruang Rapat A" => "Lantai 2, Sayap Barat — samping area pantry",
        "Ruang Boardroom" => "Lantai 14, Area Direksi — akses kartu khusus",
