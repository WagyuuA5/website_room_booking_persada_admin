                HasConflict = false
            },
            new()
            {
                Id = 102,
                Title = "Koordinasi Implementasi Core System",
                Room = "Ruang Dirantara",
                Date = DateTime.Today,
                StartTime = "10:30",
                EndTime = "12:30",
                Duration = "2 Jam",
                RequesterName = "Budi Santoso",
                RequesterDivision = "Operasional",
                RequesterInitials = "BS",
                AvatarBg = "#16A34A",
                ParticipantsCount = 8,
                Status = "pending",
                HasConflict = true
            },
            new()
            {
                Id = 103,
                Title = "Sesi Wawancara Kandidat Tech Lead",
                Room = "Ruang Diskusi B",
                Date = DateTime.Today,
                StartTime = "13:30",
                EndTime = "15:00",
                Duration = "1.5 Jam",
                RequesterName = "Siti Rahma",
                RequesterDivision = "Human Resources",
                RequesterInitials = "SR",
                AvatarBg = "#9333EA",
                ParticipantsCount = 4,
                Status = "approved",
                HasConflict = false,
                ProcessedBy = "Disetujui oleh Admin Wahyu",
                ProcessedAt = DateTime.Today.ToString("dd MMM yyyy, 08:30")
            },
            new()
            {
                Id = 104,
                Title = "Presentasi Pitching Client Partnership",
                Room = "Auditorium Serbaguna",
                Date = DateTime.Today.AddDays(1),
                StartTime = "14:00",
                EndTime = "17:00",
                Duration = "3 Jam",
                RequesterName = "Eko Prasetyo",
                RequesterDivision = "Marketing",
                RequesterInitials = "EP",
                AvatarBg = "#F59E0B",
                ParticipantsCount = 30,
                Status = "approved",
                HasConflict = false,
                ProcessedBy = "Disetujui oleh Admin Wahyu",
                ProcessedAt = DateTime.Today.ToString("dd MMM yyyy, 09:00")
            },
            new()
            {
                Id = 105,
                Title = "Audit Finansial Internal Tahunan",
                Room = "Ruang Rapat Utama",
                Date = DateTime.Today.AddDays(1),
                StartTime = "09:00",
                EndTime = "12:00",
                Duration = "3 Jam",
                RequesterName = "Dewi Lestari",
                RequesterDivision = "Finance",
                RequesterInitials = "DL",
                AvatarBg = "#2563EB",
                ParticipantsCount = 10,
                Status = "rejected",
                HasConflict = false,
                ProcessedBy = "Ditolak oleh Admin Sarah",
                ProcessedAt = DateTime.Today.ToString("dd MMM yyyy, 09:15")
            },
            new()
            {
                Id = 106,
                Title = "Sesi Brainstorming Desain Aplikasi",
                Room = "Ruang Diskusi B",
                Date = DateTime.Today.AddDays(2),
                StartTime = "10:00",
                EndTime = "11:30",
                Duration = "1.5 Jam",
                RequesterName = "Mega Utami",
                RequesterDivision = "Marketing",
                RequesterInitials = "MU",
                AvatarBg = "#EC4899",
                ParticipantsCount = 6,
                Status = "cancelled",
                HasConflict = false,
                ProcessedBy = "Dibatalkan oleh Pengguna",
                ProcessedAt = DateTime.Today.ToString("dd MMM yyyy, 10:00")
            }
        };
    }

    private IEnumerable<BookingExtendedItem> FilteredBookings
    {
        get
        {
            var q = allBookings.AsEnumerable();
            if (selectedTab != "all") q = q.Where(b => b.Status.Equals(selectedTab, StringComparison.OrdinalIgnoreCase));
            if (selectedDateFilter.HasValue) q = q.Where(b => b.Date.Date == selectedDateFilter.Value.Date);
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.ToLowerInvariant();
                q = q.Where(b => b.Title.ToLowerInvariant().Contains(query) ||
                                 b.RequesterName.ToLowerInvariant().Contains(query) ||
                                 b.RequesterDivision.ToLowerInvariant().Contains(query) ||
                                 b.Room.ToLowerInvariant().Contains(query));
            }
            return q;
        }
    }

    private IEnumerable<IGrouping<DateTime, BookingExtendedItem>> GroupedBookings =>
        FilteredBookings.OrderBy(b => b.Date).ThenBy(b => b.StartTime).GroupBy(b => b.Date.Date);

    private int GetCount(string status) => allBookings.Count(b => b.Status.Equals(status, StringComparison.OrdinalIgnoreCase));

    private void SelectTab(string tab)
    {
        selectedTab = tab;
    }

    private void OnDatePicked(DateTime? d)
    {
        selectedDateFilter = d;
        filterDateLabel = d.HasValue ? d.Value.ToString("dd MMM yyyy") : "Semua Tanggal";
    }

    private void ResetFilters()
    {
        searchQuery = "";
        selectedTab = "all";
        selectedDateFilter = null;
        filterDateLabel = "Semua Tanggal";
    }

    private void OpenDetail(BookingExtendedItem b)
    {
        selectedBooking = b;
        showDetailModal = true;
    }

    private void QuickApprove(BookingExtendedItem b)
    {
        b.Status = "approved";
        b.HasConflict = false;
        b.ProcessedBy = "Disetujui oleh Admin Wahyu";
        b.ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm");
        Toast.Success($"Booking '{b.Title}' berhasil disetujui.");
        StateHasChanged();
    }

    private void QuickReject(BookingExtendedItem b)
    {
        b.Status = "rejected";
        b.ProcessedBy = "Ditolak oleh Admin Wahyu";
        b.ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm");
        Toast.Error($"Booking '{b.Title}' telah ditolak.");
        StateHasChanged();
    }

    private void ApproveBooking(BookingExtendedItem b)
    {
        QuickApprove(b);
        showDetailModal = false;
    }

    private void RejectBooking(BookingExtendedItem b)
    {
        QuickReject(b);
        showDetailModal = false;
    }

    private void HandleBookingCreated(Booking b)
    {
        allBookings.Insert(0, new BookingExtendedItem
        {
            Id = b.Id,
            Title = b.Title,
            Room = b.Room,
            Date = b.Date,
            StartTime = b.StartTime,
            EndTime = b.EndTime,
            Duration = b.Duration,
            RequesterName = b.RequesterName,
            RequesterDivision = b.RequesterDivision,
            RequesterInitials = b.RequesterInitials,
            ParticipantsCount = b.ParticipantsCount,
            Status = "approved",
            ProcessedBy = "Dibuat Manual oleh Admin Wahyu",
            ProcessedAt = DateTime.Now.ToString("dd MMM yyyy, HH:mm")
        });
        StateHasChanged();
    }

    private string GetStatusLabel(string status) => status switch
    {
        "pending" => "Menunggu",
        "approved" => "Disetujui",
        "rejected" => "Ditolak",
        "cancelled" => "Dibatalkan",
        _ => status
    };
}
