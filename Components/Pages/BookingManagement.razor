@page "/booking-management"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast

<TopBar Title="Manajemen Booking" Subtitle="Kelola seluruh pemesanan ruangan perusahaan." ShowGlobalSearch="false" ShowDateFilter="false">
    <RightSlot>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="() => showManualBooking = true">
            <Icon Name="plus" Size="14" />
            <span>+ Buat Booking Manual</span>
        </button>
    </RightSlot>
</TopBar>

<div class="booking-management-page">
    @* -- Eyebrow -- *@
    <div class="bm-eyebrow-row">
        <span class="bm-bullet" style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--color-brand-yellow,#F2B705);vertical-align:middle;"></span>
        <span class="bm-eyebrow">MANAJEMEN BOOKING</span>
    </div>

    @* -- Search and Date Filter -- *@
    <div class="bm-search-row">
        <div class="bm-search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="bm-search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" class="bm-search-input" placeholder="Cari berdasarkan nama, divisi, atau ruangan..." @bind="searchQuery" @bind:event="oninput" />
        </div>
        <button type="button" class="bm-date-pill" @onclick="() => showDatePicker = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon-sm"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>@filterDateLabel</span>
        </button>
    </div>

    @* -- Status Tabs -- *@
    <div class="bm-status-toolbar">
        <div class="bm-pills-list">
            <button type="button" class="bm-pill @(selectedTab == "all" ? "active" : "")" @onclick='() => SelectTab("all")'>
                <span>Semua</span>
                <span class="bm-count count-all">@allBookings.Count</span>
            </button>
            <button type="button" class="bm-pill @(selectedTab == "pending" ? "active" : "")" @onclick='() => SelectTab("pending")'>
                <span>Menunggu</span>
                <span class="bm-count count-pending">@GetCount("pending")</span>
            </button>
            <button type="button" class="bm-pill @(selectedTab == "approved" ? "active" : "")" @onclick='() => SelectTab("approved")'>
                <span>Disetujui</span>
                <span class="bm-count count-approved">@GetCount("approved")</span>
            </button>
            <button type="button" class="bm-pill @(selectedTab == "rejected" ? "active" : "")" @onclick='() => SelectTab("rejected")'>
                <span>Ditolak</span>
                <span class="bm-count count-rejected">@GetCount("rejected")</span>
            </button>
            <button type="button" class="bm-pill @(selectedTab == "cancelled" ? "active" : "")" @onclick='() => SelectTab("cancelled")'>
                <span>Dibatalkan</span>
                <span class="bm-count count-cancelled">@GetCount("cancelled")</span>
            </button>
        </div>
    </div>

    @* -- Booking Card List Grouped by Date -- *@
    <div class="bm-cards-container">
        @if (!GroupedBookings.Any())
        {
            <EmptyState Title="Tidak Ada Booking Ditemukan" Description="Tidak ada jadwal booking yang cocok dengan filter dan kata kunci pencarian Anda." ActionLabel="Reset Filter" OnAction="ResetFilters" />
        }
        else
        {
            @foreach (var group in GroupedBookings)
            {
                <div class="bm-date-group">
                    <div class="bm-date-header">
                        <span class="bm-group-title">@group.Key.ToString("dd MMMM").ToUpper()</span>
                        <div class="bm-group-line"></div>
                    </div>

                    <div class="bm-date-cards">
                        @foreach (var b in group)
                        {
                            <div class="bm-booking-card @(b.HasConflict ? "card-conflict" : "")" @onclick="() => OpenDetail(b)">
                                <div class="bm-left-strip strip-@b.Status.ToLower() @(b.HasConflict ? "strip-conflict" : "")"></div>

                                @* Col 1: Time *@
                                <div class="bm-col-time">
                                    <span class="bm-start-time">@b.StartTime</span>
                                    <span class="bm-end-time">@b.EndTime</span>
                                    <span class="bm-duration-badge">@b.Duration.ToUpper()</span>
                                </div>

                                @* Col 2: Info *@
                                <div class="bm-col-info">
                                    <h4 class="bm-meeting-title">@b.Title</h4>
                                    <div class="bm-meeting-meta">
                                        <span class="bm-meta-room"><Icon Name="map-pin" Size="13" /> @b.Room</span>
                                        <span class="bm-meta-participants"><Icon Name="users" Size="13" /> @b.ParticipantsCount Peserta</span>
                                    </div>
                                </div>

                                @* Col 3: Requester *@
                                <div class="bm-col-requester">
                                    <div class="bm-avatar" style="background: @b.AvatarBg;">@b.RequesterInitials</div>
                                    <div class="bm-req-info">
                                        <strong class="bm-req-name">@b.RequesterName</strong>
                                        <span class="bm-req-dept">@b.RequesterDivision</span>
                                    </div>
                                </div>

                                @* Col 4: Status & Quick Actions *@
                                <div class="bm-col-actions" @onclick:stopPropagation="true">
                                    <StatusBadge Status="@b.Status" CustomLabel="@GetStatusLabel(b.Status)" />
                                    @if (b.Status == "pending")
                                    {
                                        <div class="bm-quick-actions">
                                            <button type="button" class="btn-quick-reject" @onclick="() => QuickReject(b)" title="Tolak Cepat"><Icon Name="x" Size="14" /></button>
                                            <button type="button" class="btn-quick-approve" @onclick="() => QuickApprove(b)" title="Setujui Cepat"><Icon Name="check" Size="14" /></button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="bm-list-footer">
                <span class="bm-footer-count">Menampilkan @FilteredBookings.Count() dari @allBookings.Count booking</span>
            </div>
        }
    </div>
</div>

@* -- Detail Modal -- *@
@if (selectedBooking != null)
{
    <AppModal IsOpen="@showDetailModal" IsOpenChanged="@((bool v) => showDetailModal = v)" Size="medium">
        <HeaderContent>
            <div class="bm-modal-header">
                <div>
                    <h3 class="bm-modal-title">@selectedBooking.Room</h3>
                    <StatusBadge Status="@selectedBooking.Status" CustomLabel="@GetStatusLabel(selectedBooking.Status)" />
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="bm-modal-body">
                <p class="bm-room-desc">Ruang meeting eksekutif premium untuk sesi strategi, koordinasi tim, dan presentasi tingkat tinggi.</p>

                <div class="bm-chips-row">
                    <span class="bm-spec-chip">?? @selectedBooking.ParticipantsCount Peserta</span>
                    <span class="bm-spec-chip">?? Gedung Pusat, Lantai 14</span>
                </div>

                <div class="bm-section">
                    <h5 class="bm-section-title">FASILITAS RUANGAN</h5>
                    <div class="bm-amenities-grid">
                        <span class="bm-amenity-item">?? Wi-Fi Cepat</span>
                        <span class="bm-amenity-item">??? Layar 85 Inci</span>
                        <span class="bm-amenity-item">?? Video Konferensi</span>
                        <span class="bm-amenity-item">? Katering / Minuman</span>
                    </div>
                </div>

                <div class="bm-detail-box">
                    <div class="bm-box-row">
                        <span class="bm-box-label">PEMOHON:</span>
                        <div class="bm-box-user">
                            <div class="bm-avatar-sm" style="background: @selectedBooking.AvatarBg;">@selectedBooking.RequesterInitials</div>
                            <strong>@selectedBooking.RequesterName (@selectedBooking.RequesterDivision)</strong>
                        </div>
                    </div>
                    <div class="bm-box-row">
                        <span class="bm-box-label">JADWAL:</span>
                        <strong>@selectedBooking.Date.ToString("dd MMMM yyyy"), @selectedBooking.StartTime - @selectedBooking.EndTime (@selectedBooking.Duration)</strong>
                    </div>
                    <div class="bm-box-row">
                        <span class="bm-box-label">JUDUL RAPAT:</span>
                        <strong>@selectedBooking.Title</strong>
                    </div>
                    <div class="bm-box-row">
                        <span class="bm-box-label">JUMLAH PESERTA:</span>
                        <strong>@selectedBooking.ParticipantsCount Peserta</strong>
                    </div>
                </div>

                @if (selectedBooking.Status != "pending" && !string.IsNullOrEmpty(selectedBooking.ProcessedBy))
                {
                    <div class="bm-processed-info">
                        <span>?? @selectedBooking.ProcessedBy, @selectedBooking.ProcessedAt</span>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (selectedBooking.Status == "pending")
            {
                <button type="button" class="btn-outline-pill" @onclick="() => RejectBooking(selectedBooking)">Tolak</button>
                <button type="button" class="btn-primary-pill" style="background:#0B1E39; color:#fff;" @onclick="() => ApproveBooking(selectedBooking)">Setujui</button>
            }
            else
            {
                <button type="button" class="btn-outline-pill" @onclick="() => showDetailModal = false">Tutup</button>
            }
        </FooterContent>
    </AppModal>
}

<DatePickerPopup IsOpen="@showDatePicker" IsOpenChanged="@((bool v) => showDatePicker = v)" IsRangeMode="false" OnDateSelected="OnDatePicked" />
<ManualBookingPopup @bind-IsOpen="showManualBooking" OnBookingCreated="HandleBookingCreated" />

@code {
    private string searchQuery = "";
    private string selectedTab = "all";
    private string filterDateLabel = "Semua Tanggal";
    private DateTime? selectedDateFilter;
    private bool showDatePicker = false;
    private bool showDetailModal = false;
    private bool showManualBooking = false;

    public class BookingExtendedItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Room { get; set; } = "";
        public DateTime Date { get; set; }
        public string StartTime { get; set; } = "";
        public string EndTime { get; set; } = "";
        public string Duration { get; set; } = "";
        public string RequesterName { get; set; } = "";
        public string RequesterDivision { get; set; } = "";
        public string RequesterInitials { get; set; } = "";
        public string AvatarBg { get; set; } = "#0B1E39";
        public int ParticipantsCount { get; set; }
        public string Status { get; set; } = "pending";
        public bool HasConflict { get; set; }
        public string ProcessedBy { get; set; } = "";
        public string ProcessedAt { get; set; } = "";
    }

    private BookingExtendedItem? selectedBooking;
    private List<BookingExtendedItem> allBookings = new();

    protected override void OnInitialized()
    {
        InitBookings();
    }

    private void InitBookings()
    {
        allBookings = new List<BookingExtendedItem>
        {
            new()
            {
