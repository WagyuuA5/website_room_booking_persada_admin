    private double GetRoomPinX(string room) => room switch
    {
        "Ruang Dirantara" => 35.0,
        "Ruang Rapat A" => 65.0,
        "Ruang Boardroom" => 50.0,
        "Ruang Training" => 25.0,
        "Ruang Diskusi C" => 75.0,
        _ => 60.0
    };

    private double GetRoomPinY(string room) => room switch
    {
        "Ruang Dirantara" => 40.0,
        "Ruang Rapat A" => 30.0,
        "Ruang Boardroom" => 55.0,
        "Ruang Training" => 70.0,
        "Ruang Diskusi C" => 60.0,
        _ => 45.0
    };
}
