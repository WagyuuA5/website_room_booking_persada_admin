@page "/booking-management"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@inject booking_room_admin.Components.Services.IBookingService BookingService


<booking_room_admin.Components.Shared.AdminTopBar PageTitle="Manajemen Booking" PageSubtitle="Kelola seluruh pemesanan ruangan perusahaan." />
<div class="booking-management">
    <PageHeader Title="Manajemen Booking" Subtitle="Kelola seluruh pemesanan ruangan perusahaan.">
        <button class="btn-primary bm-create-btn" @onclick="OpenManualBooking">
            <img src="icon/plus.svg" alt="Tambah" class="btn-icon" />
            <span>Buat Booking Manual</span>
        </button>
    </PageHeader>

    <div class="bm-toolbar">
        <div class="bm-search">
            <img src="icon/search.svg" alt="Cari" class="bm-search-icon" />
            <input type="text" placeholder="Cari berdasarkan nama, divisi, atau ruangan..." @bind="searchQuery" @bind:event="oninput" />
        </div>
        <div class="bm-date-filter" @onclick="ToggleDatePicker">
            <img src="icon/calendar.svg" alt="Kalender" class="bm-filter-icon" />
            <span>@selectedDateLabel</span>
        </div>
    </div>

    <div class="bm-tabs">
        @foreach (var tab in statusTabs)
        {
            <button class="bm-tab @(selectedStatus == tab.Key ? "active" : "") @(tab.Key)" @onclick="() => SelectStatus(tab.Key)">
                <span>@tab.Label</span>
                <span class="bm-tab-badge">@tab.Count</span>
            </button>
        }
    </div>

    <div class="bm-booking-list">
        @foreach (var group in groupedBookings)
        {
            <div class="bm-date-group">
                <div class="bm-date-label">@group.Date.ToString("dd MMMM yyyy").ToUpper()</div>
                @foreach (var booking in group.Bookings)
                {
                    <div class="bm-card @GetCardAccentClass(booking)" @onclick="() => OpenDetail(booking)">
                        <div class="bm-card-accent"></div>
                        <div class="bm-card-time">
                            <span class="bm-time-start">@booking.StartTime</span>
                            <span class="bm-time-sep">—</span>
                            <span class="bm-time-end">@booking.EndTime</span>
                            <span class="bm-time-duration">@booking.Duration</span>
                        </div>
                        <div class="bm-card-info">
                            <div class="bm-card-title-row">
                                <span class="bm-card-title">@booking.Title</span>
                                @if (booking.IsRecurring)
                                {
                                    <span class="bm-recurring-badge">
                                        <img src="icon/repeat.svg" alt="Berulang" class="bm-recurring-icon" />
                                        Berulang
                                    </span>
                                }
                            </div>
                            <div class="bm-card-meta">
                                <span class="bm-card-room">@booking.Room</span>
                                <span class="bm-card-sep">•</span>
                                <span class="bm-card-participants">@booking.ParticipantsCount peserta</span>
                            </div>
                        </div>
                        <div class="bm-card-user">
                            <UserAvatar Initials="@booking.RequesterInitials" BgColor="@booking.AccentColor" Size="40px" />
                            <div class="bm-user-info">
                                <span class="bm-user-name">@booking.RequesterName</span>
                                <span class="bm-user-division">@booking.RequesterDivision</span>
                            </div>
                        </div>
                        <div class="bm-card-actions">
                            <span class="bm-status-badge @GetStatusClass(booking.Status)">@GetStatusLabel(booking.Status)</span>
                            <div class="bm-action-btns">
                                <button class="bm-action-btn reject" @onclick:stopPropagation="true" @onclick="() => RejectBooking(booking)">
                                    <img src="icon/x.svg" alt="Tolak" />
                                </button>
                                <button class="bm-action-btn approve" @onclick:stopPropagation="true" @onclick="() => ApproveBooking(booking)">
                                    <img src="icon/check.svg" alt="Setujui" />
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="bm-footer">
        <span class="bm-footer-text">Menampilkan 1–@filteredBookings.Count dari @totalBookings booking</span>
        <div class="bm-pagination">
            <button class="bm-page-btn" disabled>&lsaquo;</button>
            <button class="bm-page-btn active">1</button>
            <button class="bm-page-btn">2</button>
            <button class="bm-page-btn">&rsaquo;</button>
        </div>
    </div>

    <DatePickerPopup IsOpen="@showDatePicker" IsOpenChanged="@((bool v) => showDatePicker = v)" OnDateSelected="OnDateSelected" />
    <BookingDetailPopup IsOpen="@showDetail" IsOpenChanged="@((bool v) => showDetail = v)" Booking="@selectedBooking" OnApprove="ApproveBooking" OnReject="RejectBooking" />
    <ManualBookingPopup IsOpen="@showManual" IsOpenChanged="@((bool v) => showManual = v)" OnBookingCreated="OnBookingCreated" />
    <NotificationPopup IsOpen="@showNotification" IsOpenChanged="@((bool v) => showNotification = v)" />
</div>

@code {
    private bool showDatePicker = false;
    private bool showDetail = false;
    private bool showManual = false;
    private bool showNotification = false;

    private string searchQuery = "";
    private string selectedDateLabel = "12 Okt 2026";
    private string selectedStatus = "all";

    private List<StatusTab> statusTabs = new();

    private List<Booking> allBookings = new();
    private List<Booking> filteredBookings => FilterBookings();
    private Booking? selectedBooking = null;
    private int totalBookings => allBookings.Count;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        allBookings = BookingService.GetAllBookings();
        statusTabs = new List<StatusTab>
        {
            new("all", "Semua", allBookings.Count),
            new("pending", "Menunggu", allBookings.Count(b => b.Status == "pending")),
            new("approved", "Disetujui", allBookings.Count(b => b.Status == "approved")),
            new("rejected_system", "Ditolak Sistem", allBookings.Count(b => b.Status == "rejected_system")),
            new("rejected_admin", "Ditolak Admin", allBookings.Count(b => b.Status == "rejected_admin"))
        };
    }

    private List<BookingGroup> groupedBookings => filteredBookings
        .OrderBy(b => b.Date)
        .ThenBy(b => b.StartTime)
        .GroupBy(b => b.Date)
        .Select(g => new BookingGroup
        {
            Date = g.Key,
            Bookings = g.ToList()
        })
        .ToList();

    private List<Booking> FilterBookings()
    {
        var query = allBookings.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.ToLowerInvariant();
            query = query.Where(b =>
                b.RequesterName.ToLowerInvariant().Contains(q) ||
                b.RequesterDivision.ToLowerInvariant().Contains(q) ||
                b.Room.ToLowerInvariant().Contains(q) ||
                b.Title.ToLowerInvariant().Contains(q));
        }

        if (selectedStatus != "all")
        {
            query = query.Where(b => b.Status == selectedStatus);
        }

        return query.ToList();
    }

    private string GetCardAccentClass(Booking b) => b.AccentColor switch
    {
        "warning" => "accent-warning",
        "danger" => "accent-danger",
        "info" => "accent-info",
        _ => "accent-warning"
    };

    private string GetStatusClass(string status) => status switch
    {
        "pending" => "status-pending",
        "approved" => "status-approved",
        "rejected_system" => "status-rejected-system",
        "rejected_admin" => "status-rejected-admin",
        _ => "status-pending"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "pending" => "Menunggu",
        "approved" => "Disetujui",
        "rejected_system" => "Ditolak Sistem",
        "rejected_admin" => "Ditolak Admin",
        _ => status
    };

    private void SelectStatus(string key)
    {
        selectedStatus = key;
    }

    private void ToggleDatePicker()
    {
        showDatePicker = !showDatePicker;
    }

    private void OnDateSelected(DateTime? date)
    {
        if (date.HasValue)
        {
            selectedDateLabel = date.Value.ToString("dd MMM yyyy");
        }
        showDatePicker = false;
    }

    private void OpenDetail(Booking booking)
    {
        selectedBooking = booking;
        showDetail = true;
    }

    private void OpenManualBooking()
    {
        showManual = true;
    }

    private void ApproveBooking(Booking booking)
    {
        booking.Status = "approved";
        BookingService.UpdateBooking(booking);
        LoadData();
        showDetail = false;
        selectedBooking = null;
    }

    private void RejectBooking(Booking booking)
    {
        booking.Status = "rejected_admin";
        BookingService.UpdateBooking(booking);
        LoadData();
        showDetail = false;
        selectedBooking = null;
    }

    private void OnBookingCreated(Booking booking)
    {
        BookingService.AddBooking(booking);
        LoadData();
        showManual = false;
    }

    private class StatusTab
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public int Count { get; set; }
        public StatusTab(string key, string label, int count) => (Key, Label, Count) = (key, label, count);
    }

    private class BookingGroup
    {
        public DateTime Date { get; set; }
        public List<Booking> Bookings { get; set; } = new();
    }
}

