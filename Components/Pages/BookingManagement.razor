                ProcessedAt = DateTime.Today.ToString("dd MMM yyyy, 08:30")
            },
            new()
            {
                Id = 104,
                Title = "Presentasi Pitching Client Partnership",
                Room = "Auditorium Serbaguna",
                Date = DateTime.Today.AddDays(1),
