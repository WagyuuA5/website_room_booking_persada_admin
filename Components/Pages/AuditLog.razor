@page "/audit-log"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast

<TopBar Title="Audit Log" Subtitle="Riwayat seluruh aktivitas admin pada sistem - permanen dan tidak dapat diubah." ShowGlobalSearch="false" ShowDateFilter="false">
    <RightSlot>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="@(() => showExportModal = true)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon-sm"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Ekspor CSV</span>
        </button>
    </RightSlot>
</TopBar>

<div class="audit-log-page">`r`n    
    @* -- Filter Island Toolbar -- *@
    <div class="audit-island-toolbar">
        <span class="audit-filter-label">Filter:</span>

        @* 1. Actor Island Trigger *@
        <div class="island-trigger-container">
            <button type="button" class="btn-island-trigger @(openIsland == "actor" ? "active" : "")" @onclick='() => ToggleIsland("actor")'>
                <span>@(string.IsNullOrEmpty(selectedActor) ? "Semua Aktor" : selectedActor)</span>
                <span class="island-caret"><Icon Name="chevron-down" Size="14" /></span>
            </button>

            @if (openIsland == "actor")
            {
                <div class="island-popup-card actor-island">
                    <div class="island-header">
                        <span class="island-title">Filter berdasarkan Aktor</span>
                        <button type="button" class="island-close" @onclick='() => ToggleIsland("")'><Icon Name="x" Size="16" /></button>
                    </div>
                    <div class="island-search">
                        <input type="text" placeholder="Cari aktor..." class="island-input" @bind="actorSearchQuery" @bind:event="oninput" />
                    </div>
                    <div class="island-actor-list scroll-area">
                        @foreach (var act in FilteredActorList)
                        {
                            <label class="island-actor-item">
                                <input type="checkbox" checked="@(selectedActor == act.Name)" @onchange="@((ChangeEventArgs e) => SelectActor(act.Name, (bool)(e.Value ?? false)))" />
                                <div class="actor-mini-avatar" style="background: @act.AvatarBg;">@act.Initials</div>
                                <div class="actor-info">
                                    <strong class="actor-name">@act.Name</strong>
                                    <span class="actor-role">@act.Role</span>
                                </div>
                            </label>
                        }
                    </div>
                    <div class="island-footer">
                        <button type="button" class="island-link-clear" @onclick="ClearActorFilter">Hapus Semua</button>
                        <button type="button" class="island-btn-apply" @onclick='() => ToggleIsland("")'>Terapkan Filter</button>
                    </div>
                </div>
            }
        </div>

        @* 2. Action Type Island Trigger *@
        <div class="island-trigger-container">
            <button type="button" class="btn-island-trigger @(openIsland == "action" ? "active" : "")" @onclick='() => ToggleIsland("action")'>
                <span>@(selectedActions.Any() ? $"{selectedActions.Count} Aksi Terpilih" : "Jenis Aksi")</span>
                <span class="island-caret"><Icon Name="chevron-down" Size="14" /></span>
            </button>

            @if (openIsland == "action")
            {
                <div class="island-popup-card action-island">
                    <div class="island-header">
                        <span class="island-title">Filter berdasarkan Jenis Aksi</span>
                        <button type="button" class="island-close" @onclick='() => ToggleIsland("")'><Icon Name="x" Size="16" /></button>
                    </div>
                    <div class="island-categories-list scroll-area">
                        @* Group: Booking *@
                        <div class="action-group">
                            <div class="action-group-header" @onclick="() => isBookingGroupOpen = !isBookingGroupOpen">
                                <span>@if (isBookingGroupOpen) { <Icon Name="chevron-down" Size="14" /> } else { <Icon Name="chevron-right" Size="14" /> } Booking</span>
                            </div>
                            @if (isBookingGroupOpen)
                            {
                                <div class="action-group-items">
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Setujui Booking")" @onchange='e => ToggleAction("Setujui Booking", (bool)(e.Value ?? false))' /> Setujui Booking</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Tolak Booking")" @onchange='e => ToggleAction("Tolak Booking", (bool)(e.Value ?? false))' /> Tolak Booking</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Batalkan Booking")" @onchange='e => ToggleAction("Batalkan Booking", (bool)(e.Value ?? false))' /> Batalkan Booking</label>
                                </div>
                            }
                        </div>

                        @* Group: Room *@
                        <div class="action-group">
                            <div class="action-group-header" @onclick="() => isRoomGroupOpen = !isRoomGroupOpen">
                                <span>@if (isRoomGroupOpen) { <Icon Name="chevron-down" Size="14" /> } else { <Icon Name="chevron-right" Size="14" /> } Ruangan</span>
                            </div>
                            @if (isRoomGroupOpen)
                            {
                                <div class="action-group-items">
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Tambah Ruangan")" @onchange='e => ToggleAction("Tambah Ruangan", (bool)(e.Value ?? false))' /> Tambah Ruangan</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Edit Ruangan")" @onchange='e => ToggleAction("Edit Ruangan", (bool)(e.Value ?? false))' /> Edit Ruangan</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Atur Maintenance")" @onchange='e => ToggleAction("Atur Maintenance", (bool)(e.Value ?? false))' /> Atur Maintenance</label>
                                </div>
                            }
                        </div>

                        @* Group: User *@
                        <div class="action-group">
                            <div class="action-group-header" @onclick="() => isUserGroupOpen = !isUserGroupOpen">
                                <span>@if (isUserGroupOpen) { <Icon Name="chevron-down" Size="14" /> } else { <Icon Name="chevron-right" Size="14" /> } User</span>
                            </div>
                            @if (isUserGroupOpen)
                            {
                                <div class="action-group-items">
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Tambah User")" @onchange='e => ToggleAction("Tambah User", (bool)(e.Value ?? false))' /> Tambah User</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Edit User")" @onchange='e => ToggleAction("Edit User", (bool)(e.Value ?? false))' /> Edit User</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Nonaktifkan User")" @onchange='e => ToggleAction("Nonaktifkan User", (bool)(e.Value ?? false))' /> Nonaktifkan User</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Reset Password")" @onchange='e => ToggleAction("Reset Password", (bool)(e.Value ?? false))' /> Reset Password</label>
                                </div>
                            }
                        </div>

                        @* Group: System *@
                        <div class="action-group">
                            <div class="action-group-header" @onclick="() => isSystemGroupOpen = !isSystemGroupOpen">
                                <span>@if (isSystemGroupOpen) { <Icon Name="chevron-down" Size="14" /> } else { <Icon Name="chevron-right" Size="14" /> } Sistem</span>
                            </div>
                            @if (isSystemGroupOpen)
                            {
                                <div class="action-group-items">
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Ubah Pengaturan")" @onchange='e => ToggleAction("Ubah Pengaturan", (bool)(e.Value ?? false))' /> Ubah Pengaturan</label>
                                    <label><input type="checkbox" checked="@selectedActions.Contains("Export Data")" @onchange='e => ToggleAction("Export Data", (bool)(e.Value ?? false))' /> Export Data</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="island-footer">
                        <button type="button" class="island-link-clear" @onclick="ClearActionFilter">Hapus Semua</button>
                        <button type="button" class="island-btn-apply" @onclick='() => ToggleIsland("")'>Terapkan Filter ?</button>
                    </div>
                </div>
            }
        </div>

        @* 3. Date Range Preset Trigger *@
        <select class="audit-date-preset-select" @bind="selectedDateRange">
            <option value="7">7 Hari Terakhir</option>
            <option value="30">30 Hari Terakhir</option>
            <option value="90">90 Hari Terakhir</option>
            <option value="0">Semua Waktu</option>
        </select>

        @if (!string.IsNullOrEmpty(selectedActor) || selectedActions.Any() || selectedDateRange != "7")
        {
            <button type="button" class="btn-clear-island-filters" @onclick="ResetAllFilters" title="Reset Semua Filter">? Reset Filter</button>
        }
    </div>

    @* -- Audit Log DataTable -- *@
    <div class="audit-table-panel">
                @if (isLoading)
        {
            @for (int i = 0; i < 8; i++)
            {
                <div style="display:flex; gap:0.75rem; padding:0.75rem; border-bottom:1px solid var(--color-border);">
                    <SkeletonBlock Width="32px" Height="32px" CssClass="rounded-circle" />
                    <SkeletonBlock Width="20%" Height="16px" />
                    <SkeletonBlock Width="15%" Height="16px" />
                    <SkeletonBlock Width="25%" Height="16px" />
                    <SkeletonBlock Width="15%" Height="16px" />
                </div>
            }
        }
        else
        {
            <DataTable TItem="AuditLogEntry" Items="PagedLogs" Columns="columns" TotalCount="@FilteredLogs.Count()" PageSize="@pageSize" CurrentPage="@currentPage" OnPageChanged="HandlePageChange">
                <RowTemplate Context="log">
                    <td class="col-time">
                        <span class="log-date">@log.Timestamp.ToString("dd MMM yyyy")</span>
                        <span class="log-time">@log.Timestamp.ToString("HH:mm:ss")</span>
                    </td>
                    <td>
                        <div class="actor-cell">
                            <div class="actor-avatar" style="background: @log.ActorBg;">@log.ActorInitials</div>
                            <span class="actor-name">@log.ActorName</span>
                        </div>
                    </td>
                    <td>
                        <StatusBadge Status="@GetActionStatus(log.ActionType)" CustomLabel="@log.ActionType" />
                    </td>
                    <td><span class="log-target">@log.TargetName</span></td>
                    <td><span class="log-detail">@log.Detail</span></td>
                </RowTemplate>
            </DataTable>
        }
    </div>
</div>

<ExportModal IsOpen="@showExportModal" IsOpenChanged="@((bool v) => showExportModal = v)" ExportTitle="Audit Log" Columns="exportColumns" CurrentViewRows="FilteredLogs.Cast<object>()" AllRows="allLogs.Cast<object>()" />

@code {
    private string openIsland = "";
    private string selectedActor = "";
    private string actorSearchQuery = "";
    private HashSet<string> selectedActions = new();
    private string selectedDateRange = "7";
    private int currentPage = 1;
    private int pageSize = 10;
    private bool showExportModal = false;
    private bool isLoading = false;

    private bool isBookingGroupOpen = true;
    private bool isRoomGroupOpen = true;
    private bool isUserGroupOpen = false;
    private bool isSystemGroupOpen = false;

    public class ActorItem { public string Name { get; set; } = ""; public string Role { get; set; } = ""; public string Initials { get; set; } = ""; public string AvatarBg { get; set; } = "#0B1E39"; }

    private List<ActorItem> actorDirectory = new()
    {
        new() { Name = "Admin Wahyu", Role = "Superadmin", Initials = "AW", AvatarBg = "#0B1E39" },
        new() { Name = "Sarah Jenkins", Role = "Admin Facility", Initials = "SJ", AvatarBg = "#2563EB" },
        new() { Name = "Budi Santoso", Role = "Admin Operasional", Initials = "BS", AvatarBg = "#16A34A" },
        new() { Name = "Dewi Lestari", Role = "Admin Finance", Initials = "DL", AvatarBg = "#F59E0B" }
    };

    private List<AuditLogEntry> allLogs = new();

    private List<DataTable<AuditLogEntry>.DataTableColumn> columns = new()
    {
        new() { Header = "WAKTU", PropertyName = "Timestamp" },
        new() { Header = "AKTOR", PropertyName = "ActorName" },
        new() { Header = "AKSI", PropertyName = "ActionType" },
        new() { Header = "TARGET", PropertyName = "TargetName" },
        new() { Header = "DETAIL", PropertyName = "Detail" }
    };

    private List<ExportColumn> exportColumns = new()
    {
        new() { Header = "Waktu", PropertyName = "Timestamp" },
        new() { Header = "Aktor", PropertyName = "ActorName" },
        new() { Header = "Aksi", PropertyName = "ActionType" },
        new() { Header = "Target", PropertyName = "TargetName" },
        new() { Header = "Detail", PropertyName = "Detail" }
    };

    protected override void OnInitialized()
    {
        InitLogs();
    }

    private void InitLogs()
    {
        allLogs = new List<AuditLogEntry>
        {
            new() { Id = 1, Timestamp = DateTime.Now.AddMinutes(-12), ActorName = "Admin Wahyu", ActorInitials = "AW", ActorBg = "#0B1E39", ActionType = "Setujui Booking", TargetName = "Ruang Rapat Utama (#BK-1042)", Detail = "Pemesanan disetujui untuk Divisi IT & Digital" },
            new() { Id = 2, Timestamp = DateTime.Now.AddHours(-1), ActorName = "Sarah Jenkins", ActorInitials = "SJ", ActorBg = "#2563EB", ActionType = "Atur Maintenance", TargetName = "Ruang Dirantara VIP", Detail = "Pemeliharaan AC & Sound System (60 Menit)" },
            new() { Id = 3, Timestamp = DateTime.Now.AddHours(-2), ActorName = "Admin Wahyu", ActorInitials = "AW", ActorBg = "#0B1E39", ActionType = "Tambah User", TargetName = "Eko Prasetyo (Marketing)", Detail = "User baru ditambahkan dengan role User" },
            new() { Id = 4, Timestamp = DateTime.Now.AddHours(-4), ActorName = "Budi Santoso", ActorInitials = "BS", ActorBg = "#16A34A", ActionType = "Tolak Booking", TargetName = "Auditorium Serbaguna (#BK-1035)", Detail = "Jadwal bentrok dengan Townhall Perusahaan" },
            new() { Id = 5, Timestamp = DateTime.Now.AddDays(-1), ActorName = "Sarah Jenkins", ActorInitials = "SJ", ActorBg = "#2563EB", ActionType = "Edit Ruangan", TargetName = "Ruang Diskusi B", Detail = "Kapasitas ruangan diperbarui dari 6 menjadi 8 orang" },
            new() { Id = 6, Timestamp = DateTime.Now.AddDays(-2), ActorName = "Admin Wahyu", ActorInitials = "AW", ActorBg = "#0B1E39", ActionType = "Reset Password", TargetName = "Ahmad Fauzi (IT)", Detail = "Reset password dikirimkan via email" },
            new() { Id = 7, Timestamp = DateTime.Now.AddDays(-3), ActorName = "Dewi Lestari", ActorInitials = "DL", ActorBg = "#F59E0B", ActionType = "Export Data", TargetName = "Laporan Keuangan Q3", Detail = "Export laporan format XLSX" }
        };
    }

    private IEnumerable<ActorItem> FilteredActorList =>
        string.IsNullOrWhiteSpace(actorSearchQuery)
            ? actorDirectory
            : actorDirectory.Where(a => a.Name.ToLowerInvariant().Contains(actorSearchQuery.ToLowerInvariant()));

    private IEnumerable<AuditLogEntry> FilteredLogs
    {
        get
        {
            var q = allLogs.AsEnumerable();
            if (!string.IsNullOrEmpty(selectedActor)) q = q.Where(l => l.ActorName.Equals(selectedActor, StringComparison.OrdinalIgnoreCase));
            if (selectedActions.Any()) q = q.Where(l => selectedActions.Contains(l.ActionType));
            if (selectedDateRange == "7") q = q.Where(l => l.Timestamp >= DateTime.Now.AddDays(-7));
            else if (selectedDateRange == "30") q = q.Where(l => l.Timestamp >= DateTime.Now.AddDays(-30));
            else if (selectedDateRange == "90") q = q.Where(l => l.Timestamp >= DateTime.Now.AddDays(-90));
            return q;
        }
    }

    private IEnumerable<AuditLogEntry> PagedLogs =>
        FilteredLogs.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ToggleIsland(string name)
    {
        openIsland = openIsland == name ? "" : name;
    }

    private void SelectActor(string name, bool isChecked)
    {
        selectedActor = isChecked ? name : "";
    }

    private void ClearActorFilter()
    {
        selectedActor = "";
        actorSearchQuery = "";
    }

    private void ToggleAction(string action, bool isChecked)
    {
        if (isChecked) selectedActions.Add(action);
        else selectedActions.Remove(action);
    }

    private void ClearActionFilter()
    {
        selectedActions.Clear();
    }

    private void ResetAllFilters()
    {
        selectedActor = "";
        selectedActions.Clear();
        selectedDateRange = "7";
        actorSearchQuery = "";
        openIsland = "";
    }

    private void HandlePageChange(int page)
    {
        currentPage = page;
    }

    private string GetActionStatus(string action)
    {
        if (action.Contains("Setujui") || action.Contains("Tambah")) return "approved";
        if (action.Contains("Tolak") || action.Contains("Hapus") || action.Contains("Nonaktifkan")) return "rejected";
        if (action.Contains("Maintenance") || action.Contains("Reset") || action.Contains("Atur")) return "pending";
        return "neutral";
    }
}



