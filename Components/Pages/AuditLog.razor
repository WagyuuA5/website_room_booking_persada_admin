    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        !string.IsNullOrWhiteSpace(selectedActor) ||
        !string.IsNullOrWhiteSpace(selectedActionType) ||
        selectedDateRange != "7";

    private void ResetAllFilters()
    {
        searchQuery = "";
        selectedActor = "";
        selectedActionType = "";
        selectedDateRange = "7";
        currentPage = 1;
    }

    private IEnumerable<DetailedAuditLogEntry> FilteredLogs
    {
        get
        {
            var q = allLogs.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var lower = searchQuery.ToLowerInvariant().Trim();
                q = q.Where(l => l.ActorName.ToLowerInvariant().Contains(lower) ||
                                 l.TargetName.ToLowerInvariant().Contains(lower) ||
                                 l.ActionType.ToLowerInvariant().Contains(lower) ||
                                 l.Detail.ToLowerInvariant().Contains(lower));
            }

            if (!string.IsNullOrWhiteSpace(selectedActor))
            {
                q = q.Where(l => l.ActorName.Equals(selectedActor, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedActionType))
            {
                q = q.Where(l => l.ActionType.Contains(selectedActionType, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedDateRange == "1")
            {
                q = q.Where(l => l.Timestamp >= DateTime.Today);
            }
            else if (selectedDateRange == "7")
            {
                q = q.Where(l => l.Timestamp >= DateTime.Now.AddDays(-7));
            }
            else if (selectedDateRange == "30")
            {
                q = q.Where(l => l.Timestamp >= DateTime.Now.AddDays(-30));
            }

            return q.OrderByDescending(l => l.Timestamp);
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredLogs.Count() / pageSize));

    private IEnumerable<DetailedAuditLogEntry> PagedLogs =>
        FilteredLogs.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private int CurrentStartRow => FilteredLogs.Any() ? ((currentPage - 1) * pageSize) + 1 : 0;
    private int CurrentEndRow => Math.Min(currentPage * pageSize, FilteredLogs.Count());

    private (string Name, int Count) TopActionSummary
    {
        get
        {
            var list = FilteredLogs.ToList();
            if (!list.Any()) return ("-", 0);
            var top = list.GroupBy(l => l.ActionType).OrderByDescending(g => g.Count()).FirstOrDefault();
            return top != null ? (top.Key, top.Count()) : ("-", 0);
        }
    }

    private (string Name, int Count) TopActorSummary
    {
        get
        {
            var list = FilteredLogs.ToList();
            if (!list.Any()) return ("-", 0);
            var top = list.GroupBy(l => l.ActorName).OrderByDescending(g => g.Count()).FirstOrDefault();
            return top != null ? (top.Key, top.Count()) : ("-", 0);
        }
    }

    private void OpenDetailModal(DetailedAuditLogEntry log)
    {
        selectedLogForDetail = log;
        showTechnicalMeta = false;
        showDetailModal = true;
    }

    private void ExportData()
    {
        Toast.Success($"Berhasil mengekspor {FilteredLogs.Count()} data audit log ke file CSV.");
    }

    // --- Palet Warna Semantik Soft Sesuai Token V11/V12 ---
    private string GetActionBadgeBg(string action)
    {
        if (action.Contains("Setujui") || action.Contains("Konfirmasi")) return "var(--color-success-soft, #DCFCE7)";
        if (action.Contains("Tolak") || action.Contains("Hapus") || action.Contains("Batalkan") || action.Contains("Nonaktifkan")) return "var(--color-danger-soft, #FEE2E2)";
        if (action.Contains("Tambah") || action.Contains("Buat") || action.Contains("Ekspor")) return "var(--color-accent-soft, #DBEAFE)";
        if (action.Contains("Edit") || action.Contains("Ubah")) return "var(--color-info-soft, #EDE9FE)";
        if (action.Contains("Pemeliharaan") || action.Contains("Maintenance") || action.Contains("Perawatan") || action.Contains("Reset") || action.Contains("Atur")) return "var(--color-warning-soft, #FEF3C7)";
        return "var(--color-surface-alt, #F3F4F6)";
    }

    private string GetActionBadgeColor(string action)
    {
        if (action.Contains("Setujui") || action.Contains("Konfirmasi")) return "var(--color-success, #16A34A)";
        if (action.Contains("Tolak") || action.Contains("Hapus") || action.Contains("Batalkan") || action.Contains("Nonaktifkan")) return "var(--color-danger, #DC2626)";
        if (action.Contains("Tambah") || action.Contains("Buat") || action.Contains("Ekspor")) return "var(--color-accent, #2563EB)";
        if (action.Contains("Edit") || action.Contains("Ubah")) return "var(--color-info, #0284C7)";
        if (action.Contains("Pemeliharaan") || action.Contains("Maintenance") || action.Contains("Perawatan") || action.Contains("Reset") || action.Contains("Atur")) return "var(--color-warning, #D97706)";
        return "var(--color-text-secondary, #4B5563)";
    }
