@page "/audit-log"
@layout booking_room_admin.Components.Layout.MainLayout
@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast

<div class="audit-log-container" style="padding: 1.75rem 2rem; display: flex; flex-direction: column; gap: 1.5rem; max-width: 1600px; margin: 0 auto;">
    
    @* --- HEADER HALAMAN --- *@
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <h1 style="font-size: 1.75rem; font-weight: 600; color: var(--color-text-primary, #0B1E39); margin: 0; letter-spacing: -0.02em;">Audit Log</h1>
                <span style="background: var(--color-surface-alt, #F1F5F9); color: var(--color-text-secondary, #64748B); font-size: 0.72rem; font-weight: 600; padding: 3px 8px; border-radius: var(--radius-pill, 999px); border: 1px solid var(--color-border, #E2E8F0); letter-spacing: 0.05em;">HANYA BACA</span>
            </div>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary, #64748B); margin: 4px 0 0 0;">Riwayat seluruh aktivitas admin pada sistem — permanen, terenkripsi, dan tidak dapat diubah.</p>
        </div>
        <button type="button" class="btn-outline-pill" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; padding: 0.55rem 1.25rem;" @onclick="ExportData">
            <Icon Name="download" Size="15" />
            <span>Ekspor CSV</span>
        </button>
    </div>

    @* --- CARD FILTER --- *@
    <div style="background: var(--color-surface, #FFFFFF); border-radius: var(--radius-md, 12px); box-shadow: var(--shadow-sm); padding: 18px 22px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; border: 1px solid var(--color-border, #E2E8F0);">
        @* Search box *@
        <div style="flex: 1; min-width: 260px; position: relative;">
            <Icon Name="search" Size="16" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--color-text-muted, #94A3B8);" />
            <input type="text"
                   class="form-input"
                   style="width: 100%; height: 40px; padding-left: 38px; border-radius: 8px; border: 1px solid var(--color-border, #E2E8F0); background: var(--color-surface, #FFFFFF); color: var(--color-text-primary, #0F172A); font-size: 0.85rem;"
                   placeholder="Cari berdasarkan nama aktor atau target..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>

        @* Dropdown Aktor *@
        <select class="form-input" style="width: 180px; height: 40px; border-radius: 8px; border: 1px solid var(--color-border, #E2E8F0); background: var(--color-surface, #FFFFFF); color: var(--color-text-primary, #0F172A); font-size: 0.85rem;" @bind="selectedActor">
            <option value="">Semua Aktor</option>
            @foreach (var actor in allActors)
            {
                <option value="@actor">@actor</option>
            }
        </select>

        @* Dropdown Jenis Aksi / Modul *@
        <select class="form-input" style="width: 180px; height: 40px; border-radius: 8px; border: 1px solid var(--color-border, #E2E8F0); background: var(--color-surface, #FFFFFF); color: var(--color-text-primary, #0F172A); font-size: 0.85rem;" @bind="selectedActionType">
            <option value="">Semua Jenis Aksi</option>
            <option value="Setujui">Setujui / Konfirmasi</option>
            <option value="Tolak">Tolak / Batalkan</option>
            <option value="Tambah">Tambah / Buat</option>
            <option value="Ubah">Edit / Ubah</option>
            <option value="Pemeliharaan">Atur Pemeliharaan / Reset</option>
            <option value="Ekspor">Ekspor / Laporan</option>
        </select>

        @* Dropdown Rentang Tanggal *@
        <select class="form-input" style="width: 170px; height: 40px; border-radius: 8px; border: 1px solid var(--color-border, #E2E8F0); background: var(--color-surface, #FFFFFF); color: var(--color-text-primary, #0F172A); font-size: 0.85rem;" @bind="selectedDateRange">
            <option value="1">Hari Ini</option>
            <option value="7">7 Hari Terakhir</option>
            <option value="30">30 Hari Terakhir</option>
            <option value="all">Semua Waktu</option>
        </select>

        @* Reset Filter Button *@
        @if (HasActiveFilter)
        {
            <button type="button"
                    style="background: transparent; border: none; color: var(--color-danger, #DC2626); font-size: 0.82rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; padding: 6px 10px; border-radius: 6px;"
                    @onclick="ResetAllFilters">
                <Icon Name="x" Size="14" />
                <span>Reset Filter</span>
            </button>
        }
    </div>

    @* --- CARD RINGKASAN STATISTIK (Dihitung dari dataset aktif via StatCard) --- *@
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
        <StatCard Label="Aktivitas Periode Ini"
                  Value="@($"{FilteredLogs.Count()} Log")"
                  Type="StatCardType.TodayActivity" />

        <StatCard Label="Aksi Terbanyak"
                  Value="@TopActionSummary.Name"
                  Type="StatCardType.ConfigChanges"
                  Subtitle="@($"({TopActionSummary.Count} kali dilakukan)")" />

        <StatCard Label="Aktor Teraktif"
                  Value="@TopActorSummary.Name"
                  Type="StatCardType.ActiveUsers"
                  Subtitle="@($"({TopActorSummary.Count} aktivitas)")" />
    </div>

    @* --- CARD TABEL DATA --- *@
    <div style="background: var(--color-surface, #FFFFFF); border-radius: var(--radius-md, 12px); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border, #E2E8F0); overflow: hidden; display: flex; flex-direction: column;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; table-layout: fixed; min-width: 900px; text-align: left;">
                <colgroup>
                    <col style="width: 14%;" />
                    <col style="width: 20%;" />
                    <col style="width: 18%;" />
                    <col style="width: 24%;" />
                    <col style="width: 24%;" />
                </colgroup>
                <thead style="background: var(--color-surface-alt, #F1F5F9); border-bottom: 1px solid var(--color-border, #E2E8F0); position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th style="padding: 14px 20px; font-size: 11px; font-weight: 500; color: var(--color-text-secondary, #64748B); text-transform: uppercase; letter-spacing: 0.05em;">WAKTU</th>
                        <th style="padding: 14px 20px; font-size: 11px; font-weight: 500; color: var(--color-text-secondary, #64748B); text-transform: uppercase; letter-spacing: 0.05em;">AKTOR</th>
                        <th style="padding: 14px 20px; font-size: 11px; font-weight: 500; color: var(--color-text-secondary, #64748B); text-transform: uppercase; letter-spacing: 0.05em;">AKSI</th>
                        <th style="padding: 14px 20px; font-size: 11px; font-weight: 500; color: var(--color-text-secondary, #64748B); text-transform: uppercase; letter-spacing: 0.05em;">TARGET</th>
                        <th style="padding: 14px 20px; font-size: 11px; font-weight: 500; color: var(--color-text-secondary, #64748B); text-transform: uppercase; letter-spacing: 0.05em;">DETAIL</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        @for (int i = 0; i < 6; i++)
                        {
                            <tr style="height: 64px; border-bottom: 1px solid #F3F4F6;">
                                <td style="padding: 14px 20px;"><div style="height: 14px; background: #E5E7EB; border-radius: 4px; width: 80%; animation: pulse 1.5s infinite;"></div></td>
                                <td style="padding: 14px 20px;"><div style="display: flex; align-items: center; gap: 10px;"><div style="width: 32px; height: 32px; border-radius: 50%; background: #E5E7EB;"></div><div style="height: 14px; background: #E5E7EB; border-radius: 4px; width: 60%;"></div></div></td>
                                <td style="padding: 14px 20px;"><div style="height: 24px; background: #E5E7EB; border-radius: 6px; width: 70%;"></div></td>
                                <td style="padding: 14px 20px;"><div style="height: 14px; background: #E5E7EB; border-radius: 4px; width: 85%;"></div></td>
                                <td style="padding: 14px 20px;"><div style="height: 14px; background: #E5E7EB; border-radius: 4px; width: 90%;"></div></td>
                            </tr>
                        }
                    }
                    else if (PagedLogs.Any())
                    {
                        @foreach (var log in PagedLogs)
                        {
                            <tr class="audit-table-row" style="height: 64px; border-bottom: 1px solid var(--color-border, #F3F4F6); cursor: pointer; transition: background 0.15s ease;"
                                @onclick="() => OpenDetailModal(log)">
                                
                                @* Kolom 1: WAKTU (2 baris: Tanggal semi-bold + Jam regular tanpa detik) *@
                                <td style="padding: 14px 20px; vertical-align: middle;">
                                    <div style="font-size: 13px; font-weight: 500; color: var(--color-text-primary, #111827); line-height: 1.2;">@log.Timestamp.ToString("dd MMM yyyy")</div>
                                    <div style="font-size: 12px; color: var(--color-text-secondary, #6B7280); margin-top: 3px;">@log.Timestamp.ToString("HH:mm") WIB</div>
                                </td>

                                @* Kolom 2: AKTOR (Avatar 32px + Nama bold) *@
                                <td style="padding: 14px 20px; vertical-align: middle;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 32px; height: 32px; border-radius: 50%; background: @log.ActorBg; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; flex-shrink: 0;">
                                            @log.ActorInitials
                                        </div>
                                        <span style="font-size: 14px; font-weight: 500; color: var(--color-text-primary, #111827); text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@log.ActorName</span>
                                    </div>
                                </td>

                                @* Kolom 3: AKSI (Badge warna semantik soft + margin-right 24px) *@
                                <td style="padding: 14px 20px; vertical-align: middle;">
                                    <div style="display: inline-block; margin-right: 24px;">
                                        <span style="display: inline-block; padding: 5px 12px; border-radius: var(--radius-pill, 999px); font-size: 12px; font-weight: 500; text-transform: uppercase; white-space: nowrap; background: @GetActionBadgeBg(log.ActionType); color: @GetActionBadgeColor(log.ActionType);">
                                            @log.ActionType
                                        </span>
                                    </div>
                                </td>

                                @* Kolom 4: TARGET (Nama bold 14px + ID referensi highlight) *@
                                <td style="padding: 14px 20px; vertical-align: middle;">
                                    <div style="font-size: 14px; font-weight: 500; color: var(--color-text-primary, #111827); text-overflow: ellipsis; white-space: nowrap; overflow: hidden;" title="@log.TargetName">
                                        @if (log.TargetName.Contains("(#"))
                                        {
                                            var split = log.TargetName.Split(new[] { "(#" }, StringSplitOptions.None);
                                            <span>@split[0]</span>
                                            <span style="color: var(--color-accent, #2563EB); font-size: 13px; font-weight: 500;">(#@split[1]</span>
                                        }
                                        else
                                        {
                                            @log.TargetName
                                        }
                                    </div>
                                </td>

                                @* Kolom 5: DETAIL (Reguler 13px, ellipsis + tooltip) *@
                                <td style="padding: 14px 20px; vertical-align: middle;">
                                    <div style="font-size: 13px; color: var(--color-text-secondary, #6B7280); text-overflow: ellipsis; white-space: nowrap; overflow: hidden;" title="@log.Detail">
                                        @log.Detail
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @* --- EMPTY STATE --- *@
                        <tr>
                            <td colspan="5" style="padding: 60px 20px; text-align: center;">
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
                                    <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--color-surface-alt, #F3F4F6); display: flex; align-items: center; justify-content: center; color: var(--color-text-muted, #9CA3AF);">
                                        <Icon Name="inbox" Size="28" />
                                    </div>
                                    <span style="font-size: 1rem; font-weight: 600; color: var(--color-text-primary, #111827); margin-top: 4px;">Tidak ada aktivitas yang ditemukan</span>
                                    <span style="font-size: 0.85rem; color: var(--color-text-secondary, #6B7280); max-width: 360px;">Coba ubah kata kunci pencarian atau filter yang digunakan.</span>
                                    <button type="button" class="btn-outline-pill" style="margin-top: 8px; font-size: 0.82rem; padding: 6px 16px;" @onclick="ResetAllFilters">
                                        Reset Filter
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- PAGINATION (Footer Card Tabel) --- *@
        <div style="padding: 16px 24px; border-top: 1px solid var(--color-border, #F3F4F6); background: var(--color-surface, #FFFFFF); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--color-text-secondary, #6B7280);">
                    <span>Baris per halaman:</span>
                    <select style="padding: 4px 8px; border-radius: 6px; border: 1px solid var(--color-border, #E5E7EB); font-size: 0.82rem; background: var(--color-surface, #FFFFFF); color: var(--color-text-primary, #111827);"
                            @bind="pageSize"
                            @bind:after="() => currentPage = 1">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <span style="font-size: 0.82rem; color: var(--color-text-secondary, #6B7280);">
                    Menampilkan <strong>@CurrentStartRow - @CurrentEndRow</strong> dari <strong>@FilteredLogs.Count()</strong> data
                </span>
            </div>

            @if (TotalPages > 1)
            {
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button type="button"
                            class="btn-outline-pill"
                            style="padding: 4px 10px; font-size: 0.8rem; height: 32px;"
                            disabled="@(currentPage == 1)"
                            @onclick="() => currentPage--">
                        <Icon Name="chevron-left" Size="14" />
                    </button>
                    
                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        var pageNum = p;
                        if (pageNum == 1 || pageNum == TotalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                        {
                            <button type="button"
                                    style="width: 32px; height: 32px; border-radius: 6px; font-size: 0.82rem; font-weight: 500; border: 1px solid @(currentPage == pageNum ? "var(--color-accent, #2563EB)" : "var(--color-border, #E5E7EB)"); background: @(currentPage == pageNum ? "var(--color-accent, #2563EB)" : "var(--color-surface, #FFFFFF)"); color: @(currentPage == pageNum ? "#FFFFFF" : "var(--color-text-primary, #374151)"); cursor: pointer; transition: all 0.15s ease;"
                                    @onclick="() => currentPage = pageNum">
                                @pageNum
                            </button>
                        }
                        else if (pageNum == currentPage - 2 || pageNum == currentPage + 2)
                        {
                            <span style="color: var(--color-text-muted, #9CA3AF); padding: 0 4px;">...</span>
                        }
                    }

                    <button type="button"
                            class="btn-outline-pill"
                            style="padding: 4px 10px; font-size: 0.8rem; height: 32px;"
                            disabled="@(currentPage >= TotalPages)"
                            @onclick="() => currentPage++">
                        <Icon Name="chevron-right" Size="14" />
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@* --- POP-UP DETAIL AKTIVITAS (9.6 Redesign Presisi) --- *@
@if (selectedLogForDetail != null)
{
    <AppModal IsOpen="@showDetailModal" IsOpenChanged="@((bool v) => showDetailModal = v)" Title="Detail Aktivitas" Size="medium">
        <ChildContent>
            <div class="audit-detail-wrapper" style="display: flex; flex-direction: column; gap: 16px;">
                
                @* 1. Info Waktu Lengkap (Presisi Detik) *@
                <div style="background: var(--color-surface-alt, #F8FAFC); border: 1px solid var(--color-border, #E2E8F0); border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: var(--color-text-primary, #334155);">
                    <Icon Name="calendar" Size="16" style="color: var(--color-text-secondary, #64748B);" />
                    <span><strong>Waktu:</strong> @selectedLogForDetail.Timestamp.ToString("dd MMMM yyyy, 'pukul' HH:mm:ss") WIB</span>
                </div>

                @* 2. Card Identitas Aktor (Avatar 48px + Nama bold + Role) *@
                <div style="display: flex; align-items: center; gap: 14px; background: var(--color-surface-alt, #F3F4F6); padding: 14px 16px; border-radius: 10px;">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: @selectedLogForDetail.ActorBg; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; flex-shrink: 0;">
                        @selectedLogForDetail.ActorInitials
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 2px;">
                        <span style="font-size: 15px; font-weight: 600; color: var(--color-text-primary, #0B1E39);">@selectedLogForDetail.ActorName</span>
                        <span style="font-size: 12px; color: var(--color-text-secondary, #6B7280);">Admin Sistem &middot; Hak Akses Penuh</span>
                    </div>
                </div>

                @* 3. Badge Aksi (Versi lebih besar 13px font) & Target *@
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div style="background: var(--color-surface, #FFFFFF); border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 6px;">
                        <span style="font-size: 0.72rem; font-weight: 500; color: var(--color-text-secondary, #6B7280); text-transform: uppercase;">JENIS AKSI</span>
                        <div>
                            <span style="display: inline-block; padding: 6px 14px; border-radius: var(--radius-pill, 999px); font-size: 13px; font-weight: 500; text-transform: uppercase; background: @GetActionBadgeBg(selectedLogForDetail.ActionType); color: @GetActionBadgeColor(selectedLogForDetail.ActionType);">
                                @selectedLogForDetail.ActionType
                            </span>
                        </div>
                    </div>
                    <div style="background: var(--color-surface, #FFFFFF); border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 4px;">
                        <span style="font-size: 0.72rem; font-weight: 500; color: var(--color-text-secondary, #6B7280); text-transform: uppercase;">TARGET / ENTITAS</span>
                        <strong style="font-size: 14px; font-weight: 600; color: var(--color-text-primary, #111827); margin-top: 2px;">@selectedLogForDetail.TargetName</strong>
                    </div>
                </div>

                @* 4. Detail Lengkap (Paragraf penuh) *@
                <div style="background: var(--color-surface, #FFFFFF); border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; padding: 14px; display: flex; flex-direction: column; gap: 6px;">
                    <span style="font-size: 0.72rem; font-weight: 500; color: var(--color-text-secondary, #6B7280); text-transform: uppercase;">DETAIL LENGKAP</span>
                    <p style="margin: 0; font-size: 0.88rem; color: var(--color-text-primary, #374151); line-height: 1.6;">@selectedLogForDetail.Detail</p>
                </div>

                @* 5. Metadata Teknis (Collapsible) *@
                <div style="border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; overflow: hidden;">
                    <div style="padding: 10px 14px; background: var(--color-surface-alt, #F9FAFB); display: flex; align-items: center; justify-content: space-between; cursor: pointer;"
                         @onclick="() => showTechnicalMeta = !showTechnicalMeta">
                        <span style="font-size: 0.78rem; font-weight: 500; color: var(--color-text-primary, #4B5563); text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                            <Icon Name="terminal" Size="14" /> Metadata Teknis
                        </span>
                        <Icon Name="@(showTechnicalMeta ? "chevron-up" : "chevron-down")" Size="14" style="color: var(--color-text-secondary, #6B7280);" />
                    </div>
                    @if (showTechnicalMeta)
                    {
                        <div style="padding: 12px 14px; background: var(--color-surface, #FFFFFF); font-size: 0.8rem; color: var(--color-text-secondary, #64748B); display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--color-border, #E5E7EB);">
                            <div><strong>IP Address:</strong> @selectedLogForDetail.IpAddress</div>
                            <div><strong>Perangkat / User Agent:</strong> @selectedLogForDetail.UserAgent</div>
                            <div><strong>Status Eksekusi:</strong> <span style="color: var(--color-success, #16A34A); font-weight: 600;">200 OK (Berhasil)</span></div>
                        </div>
                    }
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" style="padding: 0.5rem 1.5rem;" @onclick="() => showDetailModal = false">Tutup</button>
        </FooterContent>
    </AppModal>
}

@code {
    private string searchQuery = "";
    private string selectedActor = "";
    private string selectedActionType = "";
    private string selectedDateRange = "7";
    private int currentPage = 1;
    private int pageSize = 10;
    private bool showDetailModal = false;
    private bool showTechnicalMeta = false;
    private bool isLoading = false;
    private DetailedAuditLogEntry? selectedLogForDetail;

    public class DetailedAuditLogEntry
    {
        public int Id { get; set; }
        public DateTime Timestamp { get; set; }
        public string ActorName { get; set; } = "";
        public string ActorInitials { get; set; } = "";
        public string ActorBg { get; set; } = "#0B1E39";
        public string ActionType { get; set; } = "";
        public string TargetName { get; set; } = "";
        public string Detail { get; set; } = "";
        public string IpAddress { get; set; } = "192.168.1.45";
        public string UserAgent { get; set; } = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/128.0";
    }

    private List<string> allActors = new() { "Admin Wahyu", "Sarah Jenkins", "Budi Santoso", "Dewi Lestari", "Rian Hidayat" };
    private List<DetailedAuditLogEntry> allLogs = new();

    protected override void OnInitialized()
    {
        GenerateComprehensiveLogDataset();
    }

    private void GenerateComprehensiveLogDataset()
    {
        var baseDate = DateTime.Now;
        allLogs = new List<DetailedAuditLogEntry>
        {
