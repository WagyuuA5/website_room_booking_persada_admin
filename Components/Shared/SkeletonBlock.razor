@namespace booking_room_admin.Components.Shared

<div class="skeleton-block @CssClass" style="width:@Width; height:@Height; border-radius:@Radius;" @attributes="AdditionalAttributes"></div>

@code {
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "16px";
    [Parameter] public string Radius { get; set; } = "6px";
    [Parameter] public string CssClass { get; set; } = "";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
