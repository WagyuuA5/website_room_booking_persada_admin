@namespace booking_room_admin.Components.Shared

<div class="pagination-bar">
    <div class="pagination-info">
        Menampilkan @(TotalData == 0 ? 0 : StartIndex) - @EndIndex dari @TotalData data
    </div>
    <div class="pagination-controls">
        <button type="button" class="btn-page-nav" @onclick="GoToPrevious" disabled="@(CurrentPage <= 1)" title="Halaman Sebelumnya">
            <Icon Name="chevron-left" Size="16" />
        </button>

        @foreach (var item in GetPaginationItems())
        {
            if (item.IsEllipsis)
            {
                <span class="pagination-ellipsis">&hellip;</span>
            }
            else
            {
                var p = item.PageNumber;
                <button type="button" class="btn-page-num @(CurrentPage == p ? "active" : "")" @onclick="() => GoToPage(p)">
                    @p
                </button>
            }
        }

        <button type="button" class="btn-page-nav" @onclick="GoToNext" disabled="@(CurrentPage >= TotalPages || TotalPages == 0)" title="Halaman Berikutnya">
            <Icon Name="chevron-right" Size="16" />
        </button>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int TotalData { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;

    public int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalData / Math.Max(1, PageSize)));

    private int StartIndex => TotalData == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndIndex => Math.Min(CurrentPage * PageSize, TotalData);

    public struct PageItem
    {
        public int PageNumber { get; set; }
        public bool IsEllipsis { get; set; }
    }

    protected override void OnParametersSet()
    {
        // Clamp current page if it exceeds total pages
        if (CurrentPage > TotalPages && TotalPages > 0)
        {
            CurrentPage = TotalPages;
            CurrentPageChanged.InvokeAsync(CurrentPage);
        }
        else if (CurrentPage < 1)
        {
            CurrentPage = 1;
            CurrentPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page != CurrentPage && page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            await CurrentPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task GoToPrevious() => await GoToPage(CurrentPage - 1);
    private async Task GoToNext() => await GoToPage(CurrentPage + 1);

    private List<PageItem> GetPaginationItems()
    {
        var items = new List<PageItem>();
        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++)
            {
                items.Add(new PageItem { PageNumber = i, IsEllipsis = false });
            }
            return items;
        }

        // Page 1
        items.Add(new PageItem { PageNumber = 1, IsEllipsis = false });

        if (CurrentPage <= 4)
        {
            for (int i = 2; i <= 5; i++)
            {
                items.Add(new PageItem { PageNumber = i, IsEllipsis = false });
            }
            items.Add(new PageItem { IsEllipsis = true });
            items.Add(new PageItem { PageNumber = TotalPages, IsEllipsis = false });
        }
        else if (CurrentPage >= TotalPages - 3)
        {
            items.Add(new PageItem { IsEllipsis = true });
            for (int i = TotalPages - 4; i <= TotalPages; i++)
            {
                items.Add(new PageItem { PageNumber = i, IsEllipsis = false });
            }
        }
        else
        {
            items.Add(new PageItem { IsEllipsis = true });
            items.Add(new PageItem { PageNumber = CurrentPage - 1, IsEllipsis = false });
            items.Add(new PageItem { PageNumber = CurrentPage, IsEllipsis = false });
            items.Add(new PageItem { PageNumber = CurrentPage + 1, IsEllipsis = false });
            items.Add(new PageItem { IsEllipsis = true });
            items.Add(new PageItem { PageNumber = TotalPages, IsEllipsis = false });
        }

        return items;
    }
}
