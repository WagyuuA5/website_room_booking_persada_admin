@namespace booking_room_admin.Components.Shared

<div class="pagination-bar">
    <div class="pagination-info">
        Menampilkan @(TotalData == 0 ? 0 : StartIndex) - @EndIndex dari @TotalData data
    </div>
    <div class="pagination-controls">
        <button type="button" class="btn-page-nav" @onclick="GoToPrevious" disabled="@(CurrentPage <= 1)">
            <Icon Name="chevron-left" Size="16" />
        </button>

        @for (int i = 1; i <= TotalPages; i++)
        {
            var pageNum = i;
            if (ShouldShowPage(pageNum))
            {
                <button type="button" class="btn-page-num @(CurrentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                    @pageNum
                </button>
            }
            else if (ShouldShowEllipsis(pageNum))
            {
                <span class="pagination-ellipsis">...</span>
            }
        }

        <button type="button" class="btn-page-nav" @onclick="GoToNext" disabled="@(CurrentPage >= TotalPages || TotalPages == 0)">
            <Icon Name="chevron-right" Size="16" />
        </button>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int TotalData { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;

    public int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalData / Math.Max(1, PageSize)));

    private int StartIndex => TotalData == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndIndex => Math.Min(CurrentPage * PageSize, TotalData);

    protected override void OnParametersSet()
    {
        // Clamp current page if it exceeds total pages
        if (CurrentPage > TotalPages && TotalPages > 0)
        {
            CurrentPage = TotalPages;
            CurrentPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page != CurrentPage && page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            await CurrentPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task GoToPrevious() => await GoToPage(CurrentPage - 1);
    private async Task GoToNext() => await GoToPage(CurrentPage + 1);

    private bool ShouldShowPage(int pageNum)
    {
        if (TotalPages <= 5) return true;
        if (pageNum == 1 || pageNum == TotalPages) return true;
        if (Math.Abs(pageNum - CurrentPage) <= 1) return true;
        return false;
    }

    private bool ShouldShowEllipsis(int pageNum)
    {
        if (TotalPages <= 5) return false;
        if (pageNum == 2 && CurrentPage > 3) return true;
        if (pageNum == TotalPages - 1 && CurrentPage < TotalPages - 2) return true;
        return false;
    }
}
