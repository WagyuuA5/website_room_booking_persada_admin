@using booking_room_admin.Components.Models

<AppModal IsOpen="@IsOpen" IsOpenChanged="IsOpenChanged" Title="MAINTENANCE" Size="medium" OnClose="Close">
    <ChildContent>
        <div class="m-body">
            <p class="m-subtitle" style="font-weight:600; margin-bottom: 1rem;">@Room?.Name (@Room?.Floor)</p>
            
            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Kategori</label>
                <select class="m-input" style="width:100%; padding:0.5rem; border:1px solid #ccc; border-radius:4px;" @bind="selectedCategory">
                    <option value="">Pilih Kategori</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            
            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Prioritas</label>
                <select class="m-input" style="width:100%; padding:0.5rem; border:1px solid #ccc; border-radius:4px;" @bind="selectedPriority">
                    <option value="Rendah">Rendah</option>
                    <option value="Sedang">Sedang</option>
                    <option value="Tinggi">Tinggi</option>
                    <option value="Kritis">Kritis</option>
                </select>
            </div>

            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Fasilitas yang Diperbaiki</label>
                <div class="m-facilities-chips" style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                    @foreach (var fac in facilitiesServiced)
                    {
                        <span style="padding:0.25rem 0.5rem; background:#f3f4f6; border-radius:1rem; font-size:0.85rem; cursor:pointer; display:inline-flex; align-items:center; gap:0.25rem;" @onclick="() => facilitiesServiced.Remove(fac)">@fac <Icon Name="x" Size="12" /></span>
                    }
                    <button class="btn-outline-pill btn-sm" @onclick="AddCustomFacility"><Icon Name="plus" Size="14" /> Tambah</button>
                </div>
                @if(showAddFacility)
                {
                    <div style="margin-top:0.5rem; display:flex; gap:0.5rem;">
                        <input type="text" @bind="newFacility" placeholder="Nama fasilitas..." style="flex:1; padding:0.25rem; border:1px solid #ccc; border-radius:4px;" />
                        <button @onclick="ConfirmAddFacility" style="padding:0.25rem 0.5rem; background:#2563eb; color:white; border:none; border-radius:4px; cursor:pointer;">Tambah</button>
                    </div>
                }
            </div>
            
            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Durasi (Cepat)</label>
                <div style="display:flex; gap:0.5rem;">
                    <button style="padding:0.25rem 0.75rem; border:1px solid #ccc; border-radius:1rem; background:@(selectedDuration=="20"?"#2563eb":"#fff"); color:@(selectedDuration=="20"?"#fff":"#333"); cursor:pointer;" @onclick="@(() => selectedDuration = "20")">20 Menit</button>
                    <button style="padding:0.25rem 0.75rem; border:1px solid #ccc; border-radius:1rem; background:@(selectedDuration=="30"?"#2563eb":"#fff"); color:@(selectedDuration=="30"?"#fff":"#333"); cursor:pointer;" @onclick="@(() => selectedDuration = "30")">30 Menit</button>
                    <button style="padding:0.25rem 0.75rem; border:1px solid #ccc; border-radius:1rem; background:@(selectedDuration=="60"?"#2563eb":"#fff"); color:@(selectedDuration=="60"?"#fff":"#333"); cursor:pointer;" @onclick="@(() => selectedDuration = "60")">1 Jam</button>
                </div>
            </div>

            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Deskripsi</label>
                <textarea style="width:100%; padding:0.5rem; border:1px solid #ccc; border-radius:4px; min-height:80px;" @bind="description"></textarea>
            </div>

            <div class="m-field" style="margin-bottom: 1rem;">
                <label class="m-label" style="display:block; margin-bottom:0.5rem; font-weight:600;">Unggah Dokumentasi</label>
                <div style="width:100%; padding:2rem; border:2px dashed #ccc; border-radius:4px; text-align:center; background:#f9fafb; color:#6b7280; font-size:0.9rem;">
                    Seret & lepas file di sini (maks. 5MB)
                </div>
            </div>

        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-outline-pill" @onclick="Close">Batal</button>
        <button class="btn-primary-pill btn-yellow" @onclick="ConfirmMaintenance">Konfirmasi Maintenance</button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<Room> OnMaintenanceScheduled { get; set; }
    [Parameter] public Room? Room { get; set; }

    private string selectedCategory = string.Empty;
    private string selectedPriority = "Medium";
    private string selectedDuration = "30";
    private string description = string.Empty;
    
    private List<string> facilitiesServiced = new() { "AC", "Proyektor" };
    private bool showAddFacility = false;
    private string newFacility = string.Empty;

    private List<string> categories = new() { "HVAC", "Perbaikan Peralatan", "Plambing", "Kelistrikan", "Kebersihan" };

    private void AddCustomFacility()
    {
        showAddFacility = true;
    }

    private void ConfirmAddFacility()
    {
        if (!string.IsNullOrWhiteSpace(newFacility) && !facilitiesServiced.Contains(newFacility))
        {
            facilitiesServiced.Add(newFacility);
        }
        newFacility = string.Empty;
        showAddFacility = false;
    }

    private void ConfirmMaintenance()
    {
        if (Room == null) return;

        Room.Status = "maintenance";
        Room.MaintenanceEnd = DateTime.UtcNow.AddMinutes(int.Parse(selectedDuration));
        // You could update Room description or something here if needed.

        OnMaintenanceScheduled.InvokeAsync(Room);
        Close();
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
        Reset();
    }

    private void Reset()
    {
        selectedCategory = string.Empty;
        selectedPriority = "Medium";
        selectedDuration = "30";
        description = string.Empty;
        facilitiesServiced = new() { "AC", "Proyektor" };
        showAddFacility = false;
    }
}