@namespace booking_room_admin.Components.Shared
@inject booking_room_admin.Components.Services.ToastService Toast

<div class="avatar-uploader-wrapper @CssClass" style="width: @Size; height: @Size;">
    @if (!string.IsNullOrEmpty(AvatarUrl))
    {
        <img class="avatar-uploader-img" src="@AvatarUrl" alt="Foto Profil" />
    }
    else
    {
        <div class="avatar-uploader-fallback" style="background: @BgColor; font-size: calc(@Size * 0.38);">
            @Initials
        </div>
    }

    <label for="@inputId" class="avatar-camera-btn" title="Ubah Foto Profil">
        <Icon Name="camera" Size="@CameraIconSize" />
    </label>

    <InputFile id="@inputId" 
               accept="image/png, image/jpeg, image/jpg, image/webp" 
               OnChange="HandleFileSelected" 
               class="avatar-hidden-file-input"
               style="display: none !important;" />
</div>

@code {
    private readonly string inputId = "avatar-upload-" + Guid.NewGuid().ToString("N");

    [Parameter] public string AvatarUrl { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> AvatarUrlChanged { get; set; }
    [Parameter] public EventCallback<string> OnImageUploaded { get; set; }
    [Parameter] public string Initials { get; set; } = "WA";
    [Parameter] public string BgColor { get; set; } = "#0B1E39";
    [Parameter] public string Size { get; set; } = "72px";
    [Parameter] public int CameraIconSize { get; set; } = 16;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Max 5MB
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                AvatarUrl = $"data:{file.ContentType};base64,{base64}";
                await AvatarUrlChanged.InvokeAsync(AvatarUrl);
                await OnImageUploaded.InvokeAsync(AvatarUrl);
                Toast.Success("Foto profil berhasil diperbarui.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Gagal mengunggah foto: " + ex.Message);
        }
    }
}
