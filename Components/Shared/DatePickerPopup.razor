@namespace booking_room_admin.Components.Shared

@if (IsOpen)
{
    <div class="dp-overlay" @onclick="Close"></div>
    <div class="date-picker-card">
        <div class="dp-header">
            <button type="button" class="dp-nav-arrow" @onclick="PrevMonth" title="Bulan Sebelumnya"><Icon Name="chevron-left" Size="14" /></button>
            <span class="dp-month-title">@MonthNames[currentMonth.Month - 1] @currentMonth.Year</span>
            <button type="button" class="dp-nav-arrow" @onclick="NextMonth" title="Bulan Berikutnya"><Icon Name="chevron-right" Size="14" /></button>
        </div>

        <div class="dp-weekdays">
            <span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
        </div>

        <div class="dp-days-grid">
            @foreach (var d in days)
            {
                <button type="button"
                        class="dp-day-cell @(d.IsCurrentMonth ? "" : "dp-day--muted") @(IsSelected(d.Date) ? "dp-day--selected" : "") @(IsInRange(d.Date) ? "dp-day--in-range" : "") @(IsToday(d.Date) ? "dp-day--today" : "")"
                        @onclick="() => SelectDate(d.Date)">
                    @d.Date.Day
                </button>
            }
        </div>

        @if (IsRangeMode && (rangeStart.HasValue || rangeEnd.HasValue))
        {
            <div class="dp-range-label">
                <span>Terpilih: @(rangeStart?.ToString("dd MMM") ?? "...") - @(rangeEnd?.ToString("dd MMM yyyy") ?? "...")</span>
            </div>
        }

        <div class="dp-footer">
            <button type="button" class="dp-btn-cancel" @onclick="Close">Batal</button>
            <button type="button" class="dp-btn-select" @onclick="Apply">Pilih Tanggal</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsRangeMode { get; set; } = false;
    [Parameter] public EventCallback<DateTime?> OnDateSelected { get; set; }
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnRangeSelected { get; set; }

    private DateTime currentMonth = DateTime.Today;
    private DateTime? selectedDate = DateTime.Today;
    private DateTime? rangeStart;
    private DateTime? rangeEnd;

    private class DayInfo { public DateTime Date { get; set; } public bool IsCurrentMonth { get; set; } }
    private List<DayInfo> days = new();

    private string[] MonthNames = new[] { "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember" };

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            BuildCalendar();
        }
    }

    private void BuildCalendar()
    {
        days.Clear();
        var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        int dayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday

        // Days from prev month
        var prevMonth = firstDayOfMonth.AddMonths(-1);
        int daysInPrevMonth = DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        for (int i = dayOfWeek - 1; i >= 0; i--)
        {
            days.Add(new DayInfo { Date = new DateTime(prevMonth.Year, prevMonth.Month, daysInPrevMonth - i), IsCurrentMonth = false });
        }

        // Days of current month
        int daysInCurrentMonth = DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
        for (int i = 1; i <= daysInCurrentMonth; i++)
        {
            days.Add(new DayInfo { Date = new DateTime(currentMonth.Year, currentMonth.Month, i), IsCurrentMonth = true });
        }

        // Fill remaining cells for 6 rows (42 days)
        int nextDays = 42 - days.Count;
        var nextMonth = firstDayOfMonth.AddMonths(1);
        for (int i = 1; i <= nextDays; i++)
        {
            days.Add(new DayInfo { Date = new DateTime(nextMonth.Year, nextMonth.Month, i), IsCurrentMonth = false });
        }
    }

    private void PrevMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        BuildCalendar();
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        BuildCalendar();
    }

    private void SelectDate(DateTime d)
    {
        if (IsRangeMode)
        {
            if (!rangeStart.HasValue || (rangeStart.HasValue && rangeEnd.HasValue))
            {
                rangeStart = d;
                rangeEnd = null;
            }
            else if (rangeStart.HasValue && !rangeEnd.HasValue)
            {
                if (d < rangeStart.Value)
                {
                    rangeEnd = rangeStart;
                    rangeStart = d;
                }
                else
                {
                    rangeEnd = d;
                }
            }
        }
        else
        {
            selectedDate = d;
        }
    }

    private bool IsSelected(DateTime d)
    {
        if (IsRangeMode) return (rangeStart.HasValue && rangeStart.Value.Date == d.Date) || (rangeEnd.HasValue && rangeEnd.Value.Date == d.Date);
        return selectedDate.HasValue && selectedDate.Value.Date == d.Date;
    }

    private bool IsInRange(DateTime d)
    {
        if (!IsRangeMode || !rangeStart.HasValue || !rangeEnd.HasValue) return false;
        return d.Date > rangeStart.Value.Date && d.Date < rangeEnd.Value.Date;
    }

    private bool IsToday(DateTime d)
    {
        return d.Date == DateTime.Today.Date;
    }

    private async Task Apply()
    {
        if (IsRangeMode)
        {
            if (rangeStart.HasValue && rangeEnd.HasValue)
            {
                await OnRangeSelected.InvokeAsync((rangeStart.Value, rangeEnd.Value));
            }
            else if (rangeStart.HasValue)
            {
                await OnRangeSelected.InvokeAsync((rangeStart.Value, rangeStart.Value));
            }
        }
        else
        {
            await OnDateSelected.InvokeAsync(selectedDate);
        }
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
