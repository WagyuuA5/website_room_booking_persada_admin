@namespace booking_room_admin.Components.Shared

<div class="app-error-state">
    <div class="error-icon-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="error-svg">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            <line x1="12" y1="9" x2="12" y2="13" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
    </div>
    <h3 class="error-state-title">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="error-state-desc">@Description</p>
    }
    @if (OnRetry.HasDelegate)
    {
        <button type="button" class="btn-error-retry" @onclick="OnRetry">
            @RetryLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Terjadi Kesalahan";
    [Parameter] public string Description { get; set; } = "Tidak dapat memuat data. Periksa koneksi Anda atau coba lagi nanti.";
    [Parameter] public string RetryLabel { get; set; } = "Coba Lagi";
    [Parameter] public EventCallback OnRetry { get; set; }
}
