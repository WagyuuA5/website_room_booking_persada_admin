<div class="error-state">
    <div class="error-icon">
        <img src="icon/icon_9_admin.svg" alt="Kesalahan" class="error-main-icon" />
    </div>
    <h3 class="error-title">TERJADI KESALAHAN</h3>
    <p class="error-desc">Data analitik tidak dapat dimuat. Periksa koneksi Anda atau coba lagi nanti.</p>
    <button class="btn-primary-pill" @onclick="OnRetry">
        <img src="icon/icon_5_admin.svg" alt="Coba Lagi" class="btn-icon" />
        Coba Lagi
    </button>
</div>

@code {
    [Parameter] public EventCallback OnRetry { get; set; }
}