@namespace booking_room_admin.Components.Shared
@inject booking_room_admin.Components.Services.LayoutStateService LayoutState
@inject NavigationManager Navigation

<header class="topbar-glass-nav">
    <div class="topbar-nav-left"></div>
    <div class="topbar-controls">
        @if (LocalSearchSlot != null)
        {
            @LocalSearchSlot
        }
        else if (ShowGlobalSearch)
        {
            <div class="topbar-search" title="Cari menu, ruangan, atau pengguna">
                <Icon Name="search" Size="15" CssClass="search-icon" />
                <input type="text" placeholder="@SearchPlaceholder" />
            </div>
        }

        @if (ShowDateFilter)
        {
            <button type="button" class="topbar-date-btn" @onclick="ToggleDatePicker" title="Pilih rentang tanggal">
                <Icon Name="calendar" Size="15" />
                <span>@dateRangeLabel</span>
            </button>
        }

        @if (RightSlot != null)
        {
            <div class="topbar-right-slot">
                @RightSlot
            </div>
        }

        <div class="topbar-utility-group">
            <button type="button" class="topbar-icon-btn theme-toggle" @onclick="ToggleTheme" title="@(LayoutState.IsDarkMode ? "Ganti ke Mode Terang" : "Ganti ke Mode Gelap")">
                @if (LayoutState.IsDarkMode)
                {
                    <Icon Name="sun" Size="18" />
                }
                else
                {
                    <Icon Name="moon" Size="18" />
                }
            </button>

            <button type="button" class="topbar-icon-btn notification-btn" @onclick="ToggleNotification" title="@($"Notifikasi ({unreadCount} belum dibaca)")">
                <Icon Name="bell" Size="18" />
                @if (unreadCount > 0)
                {
                    <span class="notification-badge">@unreadCount</span>
                }
            </button>

            <button type="button" class="admin-profile-btn" @onclick="ToggleProfilePopup" title="Buka menu akun">
                <UserAvatar Initials="WA" BgColor="#0B1E39" Size="36px" />
                <div class="admin-info">
                    <span class="admin-name">Admin Wahyu</span>
                    <span class="admin-role">PENGONTROL SISTEM</span>
                </div>
            </button>
        </div>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Title))
{
    <div class="topbar-page-header">
        <h1 class="topbar-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="topbar-page-subtitle">@Subtitle</p>
        }
    </div>
}

<DatePickerPopup IsOpen="@showDatePicker" IsOpenChanged="@((bool v) => { showDatePicker = v; StateHasChanged(); })" OnDateSelected="OnDateSelected" />
<NotificationPopup IsOpen="@showNotification" IsOpenChanged="@((bool v) => { showNotification = v; StateHasChanged(); })" />

@if (showProfilePopup)
{
    <div class="profile-popup-overlay" @onclick="() => showProfilePopup = false">
        <div class="profile-popup" @onclick:stopPropagation="true">
            <div class="profile-header">
                <div class="profile-avatar-container">
                    <UserAvatar Initials="WA" BgColor="#0B1E39" Size="48px" />
                    <label class="avatar-upload-btn" title="Ubah Foto Profil">
                        <Icon Name="camera" Size="12" />
                        <InputFile class="avatar-upload-input" OnChange="HandleAvatarUpload" accept="image/png, image/jpeg" />
                    </label>
                </div>
                <div>
                    <strong>Admin Wahyu</strong>
                    <div class="text-sm text-gray">wahyu.admin@persada.co.id</div>
                </div>
            </div>
            <hr />
            <div class="profile-details">
                <div class="pd-row"><span>Jabatan:</span> <strong>Pengontrol Sistem</strong></div>
                <div class="pd-row"><span>Divisi:</span> <strong>IT & Infrastruktur</strong></div>
                <div class="pd-row"><span>Lokasi:</span> <strong>Kantor Pusat, Lt. 14</strong></div>
                <div class="pd-row"><span>Terakhir Login:</span> <strong>Hari ini, 08:30 WIB</strong></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public bool ShowGlobalSearch { get; set; } = true;
    [Parameter] public bool ShowDateFilter { get; set; } = true;
    [Parameter] public string SearchPlaceholder { get; set; } = "Cari...";
    [Parameter] public RenderFragment? LocalSearchSlot { get; set; }
    [Parameter] public RenderFragment? RightSlot { get; set; }

    [Parameter] public EventCallback<DateTime?> OnDateSelectedCallback { get; set; }

    private bool showDatePicker = false;
    private bool showNotification = false;
    private bool showProfilePopup = false;
    private string dateRangeLabel = "01 Okt - 31 Okt 2026";
    private int unreadCount = 3;

    private void ToggleTheme()
    {
        LayoutState.ToggleTheme();
        StateHasChanged();
    }

    private void ToggleDatePicker()
    {
        showDatePicker = !showDatePicker;
        if (showDatePicker) { showNotification = false; showProfilePopup = false; }
    }

    private void ToggleNotification()
    {
        showNotification = !showNotification;
        if (showNotification) { showDatePicker = false; showProfilePopup = false; }
    }

    private void ToggleProfilePopup()
    {
        showProfilePopup = !showProfilePopup;
        if (showProfilePopup) { showDatePicker = false; showNotification = false; }
    }

    private void OnDateSelected(DateTime? date)
    {
        if (date.HasValue)
        {
            dateRangeLabel = date.Value.ToString("dd MMM yyyy");
            OnDateSelectedCallback.InvokeAsync(date.Value);
        }
}
    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && file.Size <= 5242880 && (file.ContentType == "image/jpeg" || file.ContentType == "image/png"))
        {
            await Task.Delay(500);
        }
    }
}