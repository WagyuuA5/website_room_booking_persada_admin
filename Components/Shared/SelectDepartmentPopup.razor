<div class="popup-overlay @(IsOpen ? "open" : "")" @onclick="Close">
    <div class="popup-card select-dept-card" @onclick:stopPropagation="true">
        <div class="sd-header">
            <div>
                <h2 class="sd-title">Pilih Departemen</h2>
                <p class="sd-subtitle">PT PERSADA - Manajemen Personalia</p>
            </div>
        </div>

        <div class="sd-search">
            <Icon Name="search" Size="16" />
            <input type="text" placeholder="Cari departemen..." @bind="searchQuery" @bind:event="oninput" />
        </div>

        <div class="sd-list">
            @foreach (var dept in FilteredDepartments)
            {
                <button class="sd-item @(selectedDepartment == dept.Name ? "selected" : "")" @onclick="() => Select(dept.Name)">
                    <div class="sd-item-icon">@((MarkupString)dept.Icon)</div>
                    <div class="sd-item-info">
                        <div class="sd-item-name">@dept.Name</div>
                        <div class="sd-item-desc">@dept.Description</div>
                    </div>
                </button>
            }
        </div>

        <div class="sd-footer">
            <button class="btn-primary-pill btn-yellow" @onclick="Close">Batal</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnDepartmentSelected { get; set; }

    private string searchQuery = "";
    private string selectedDepartment = "";

    private List<DepartmentItem> allDepartments = new()
    {
        new DepartmentItem { Name = "IT & Digital", Description = "Infrastruktur & Dukungan TI", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg>" },
        new DepartmentItem { Name = "Operasional", Description = "Manajemen Lapangan & Logistik", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>" },
        new DepartmentItem { Name = "Sumber Daya Manusia (SDM)", Description = "Rekrutmen & Pengembangan Talenta", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>" },
        new DepartmentItem { Name = "Keuangan", Description = "Akuntansi, Pajak & Penganggaran", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>" },
        new DepartmentItem { Name = "Marketing & Komunikasi", Description = "Branding & Hubungan Publik", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><path d=\"M3 3v18h18\"/><path d=\"M18.7 8l-5.1 5.2-2.8-2.7L7 14.3\"/></svg>" },
        new DepartmentItem { Name = "Legal & Kepatuhan", Description = "Tata Kelola Hukum & Regulasi", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>" },
        new DepartmentItem { Name = "General Affairs (GA)", Description = "Fasilitas, Aset & Pengadaan Kantor", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>" },
        new DepartmentItem { Name = "Layanan Keamanan", Description = "Sistem Pengamanan & Ketertiban", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>" },
        new DepartmentItem { Name = "Call Center & Layanan Pelanggan", Description = "Layanan Contact Center & CRM", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><path d=\"M3 18v-6a9 9 0 0 1 18 0v6\"/><path d=\"M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z\"/></svg>" },
        new DepartmentItem { Name = "Layanan Perkantoran", Description = "Tata Graha & Front Office", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" ry=\"2\"/><path d=\"M9 22v-4h6v4\"/><path d=\"M8 6h.01\"/><path d=\"M16 6h.01\"/><path d=\"M8 10h.01\"/><path d=\"M16 10h.01\"/><path d=\"M8 14h.01\"/><path d=\"M16 14h.01\"/></svg>" },
        new DepartmentItem { Name = "Teknikal & Pemeliharaan Telekomunikasi", Description = "Pemeliharaan Tower, CME & Jaringan", Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"cat-svg\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>" }
    };

    private IEnumerable<DepartmentItem> FilteredDepartments
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery)) return allDepartments;
            var q = searchQuery.ToLowerInvariant();
            return allDepartments.Where(d => d.Name.ToLowerInvariant().Contains(q) || d.Description.ToLowerInvariant().Contains(q));
        }
    }

    private void Select(string dept)
    {
        selectedDepartment = dept;
        OnDepartmentSelected.InvokeAsync(dept);
        Close();
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
    }

    private class DepartmentItem
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }
}
