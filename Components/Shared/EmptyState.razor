@namespace booking_room_admin.Components.Shared

<div class="app-empty-state">
    <div class="empty-illustration">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-svg">
            <rect x="8" y="12" width="48" height="40" rx="8" stroke="#94A3B8" stroke-dasharray="4 4" />
            <line x1="18" y1="40" x2="26" y2="32" stroke="#94A3B8" />
            <line x1="26" y1="32" x2="34" y2="36" stroke="#94A3B8" />
            <line x1="34" y1="36" x2="46" y2="24" stroke="#94A3B8" />
            <circle cx="42" cy="42" r="10" fill="var(--color-surface, #fff)" stroke="#64748B" stroke-width="2" />
            <line x1="49" y1="49" x2="56" y2="56" stroke="#64748B" stroke-width="2" stroke-linecap="round" />
            <line x1="39" y1="39" x2="45" y2="45" stroke="#EF4444" stroke-width="1.5" stroke-linecap="round" />
            <line x1="45" y1="39" x2="39" y2="45" stroke="#EF4444" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    </div>
    <h3 class="empty-state-title">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="empty-state-desc">@Description</p>
    }
    @if (OnAction.HasDelegate && !string.IsNullOrWhiteSpace(ActionLabel))
    {
        <button type="button" class="btn-primary-pill btn-empty-action" @onclick="OnAction">
            @ActionLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Tidak ada data ditemukan";
    [Parameter] public string Description { get; set; } = "Tidak ada aktivitas data untuk periode atau filter yang dipilih.";
    [Parameter] public string ActionLabel { get; set; } = "Reset Filter";
    [Parameter] public EventCallback OnAction { get; set; }
}
