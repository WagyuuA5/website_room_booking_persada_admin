@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using ApexCharts

<div class="tab-content">
    <StatsRow Stats="_stats" />

    <div class="tab-charts">
        <div class="tab-chart-card">
            <div class="tab-chart-header">
                <h3>Volume Laporan Bug Mingguan</h3>
            </div>
            <ApexChart TItem="ChartPoint" Options="_chartOptions" Height="280">
                <ApexPointSeries TItem="ChartPoint"
                                 Items="_chartData"
                                 Name="Laporan"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
        <div class="tab-breakdown">
            <h3 class="tab-breakdown-title">Modul Terdampak</h3>
            <div class="tab-breakdown-list">
                @foreach (var item in _breakdown)
                {
                    <div class="tab-breakdown-item">
                        <div class="tab-breakdown-info">
                            <span class="tab-breakdown-name">@item.Name</span>
                            <span class="tab-breakdown-value">@item.Value%</span>
                        </div>
                        <div class="tab-breakdown-bar">
                            <div class="tab-breakdown-fill" style="width: @($"{item.Value}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-table-section">
        <div class="tab-table-header">
            <h3>Laporan Bug Terbaru</h3>
            <a href="#" class="tab-table-link">Lihat Semua</a>
        </div>
        <div class="tab-table-wrapper">
            <table class="tab-table">
                <thead>
                    <tr>
                        <th>ID Bug</th>
                        <th>Pelapor</th>
                        <th>Modul</th>
                        <th>Tingkat Keparahan</th>
                        <th>Ditugaskan ke</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _tableData)
                    {
                        <tr>
                            <td><span class="td-primary">@row.Id</span></td>
                            <td><span class="td-primary">@row.Name</span></td>
                            <td>@row.Module</td>
                            <td><span class="badge @GetSeverityClass(row.Severity)">@GetSeverityLabel(row.Severity)</span></td>
                            <td>@row.Assigned</td>
                            <td><span class="badge @GetStatusClass(row.Status)">@GetStatusLabel(row.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<StatItem> _stats = new()
    {
        new StatItem { Label = "Total Laporan", Value = "142", Icon = "icon/icon_10_admin.svg" },
        new StatItem { Label = "Kritis/Tinggi", Value = "24", Icon = "icon/icon_10_admin.svg" },
        new StatItem { Label = "Terselesaikan (Bulan Ini)", Value = "98", Icon = "icon/check.svg" },
        new StatItem { Label = "Rata-rata Penyelesaian", Value = "4.2h", Icon = "icon/clock.svg" }
    };

    private List<ChartPoint> _chartData = new()
    {
        new("Sen", 18), new("Sel", 25), new("Rab", 15), new("Kam", 30), new("Jum", 22), new("Sab", 10), new("Min", 8)
    };

    private ApexChartOptions<ChartPoint> _chartOptions = new();

    protected override void OnInitialized()
    {
        _chartOptions = new ApexChartOptions<ChartPoint>
        {
            Chart = new Chart { Type = ChartType.Bar, Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }, Toolbar = new Toolbar { Show = false } },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { ColumnWidth = "55%", BorderRadius = 4 } },
            Xaxis = new XAxis { Categories = _chartData.Select(d => d.Label).ToList(), Labels = new XAxisLabels { Style = new AxisLabelStyle { FontWeight = "600" } } },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { FontWeight = "600" } } } },
            Grid = new Grid { BorderColor = "#e5e7eb", StrokeDashArray = 4 },
            Theme = new Theme { Mode = Mode.Light, Palette = PaletteType.Palette1 }
        };
    }

    private List<BreakdownItem> _breakdown = new()
    {
        new BreakdownItem { Name = "Halaman Booking", Value = 32 },
        new BreakdownItem { Name = "Login/Autentikasi", Value = 18 },
        new BreakdownItem { Name = "Profil Pengguna", Value = 15 },
        new BreakdownItem { Name = "Mesin Laporan", Value = 12 },
        new BreakdownItem { Name = "Lainnya", Value = 23 }
    };

    private List<TableRow> _tableData = new()
    {
        new TableRow { Id = "BUG-001", Name = "Dewi Kartika", Module = "Halaman Booking", Severity = "critical", Assigned = "Ahmad Fauzi", Status = "open" },
        new TableRow { Id = "BUG-002", Name = "Budi Santoso", Module = "Login/Autentikasi", Severity = "high", Assigned = "Siti Nurhaliza", Status = "in_progress" },
        new TableRow { Id = "BUG-003", Name = "Rizky Hidayat", Module = "Profil Pengguna", Severity = "medium", Assigned = "Maya Putri", Status = "resolved" }
    };

    private string GetSeverityClass(string severity) => severity switch
    {
        "critical" => "badge-rejected",
        "high" => "badge-forwarded",
        "medium" => "badge-pending",
        _ => "badge-pending"
    };

    private string GetSeverityLabel(string severity) => severity switch
    {
        "critical" => "Kritis",
        "high" => "Tinggi",
        "medium" => "Sedang",
        _ => severity
    };

    private string GetStatusClass(string status) => status switch
    {
        "open" => "badge-rejected",
        "in_progress" => "badge-progress",
        "resolved" => "badge-approved",
        _ => "badge-pending"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "open" => "Terbuka",
        "in_progress" => "Dikerjakan",
        "resolved" => "Selesai",
        _ => status
    };

    public class ChartPoint
    {
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
        public ChartPoint(string label, int value) => (Label, Value) = (label, value);
    }

    private class BreakdownItem
    {
        public string Name { get; set; } = string.Empty;
        public int Value { get; set; }
    }

    private class TableRow
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Module { get; set; } = string.Empty;
        public string Severity { get; set; } = string.Empty;
        public string Assigned { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}