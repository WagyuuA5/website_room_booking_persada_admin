@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using ApexCharts

<div class="tab-content">
    <StatsRow Stats="_stats" />

    <div class="tab-charts">
        <div class="tab-chart-card">
            <div class="tab-chart-header">
                <h3>Volume Tiket Mingguan</h3>
            </div>
            <ApexChart TItem="ChartPoint" Options="_chartOptions" Height="280">
                <ApexPointSeries TItem="ChartPoint"
                                 Items="_chartData"
                                 Name="Tiket"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
        <div class="tab-breakdown">
            <h3 class="tab-breakdown-title">Rincian Kategori Masalah</h3>
            <div class="tab-breakdown-list">
                @foreach (var item in _breakdown)
                {
                    <div class="tab-breakdown-item">
                        <div class="tab-breakdown-info">
                            <span class="tab-breakdown-name">@item.Name</span>
                            <span class="tab-breakdown-value">@item.Value%</span>
                        </div>
                        <div class="tab-breakdown-bar">
                            <div class="tab-breakdown-fill" style="width: @($"{item.Value}%"); background: var(--color-accent, #2563EB);"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-table-section">
        <div class="tab-table-header">
            <h3>Tiket Dukungan IT Terbaru</h3>
            <a href="#" class="tab-table-link">Lihat Semua</a>
        </div>
        <div class="tab-table-wrapper">
            <table class="tab-table">
                <thead>
                    <tr>
                        <th>ID Tiket</th>
                        <th>Pelapor</th>
                        <th>Departemen</th>
                        <th>Kategori</th>
                        <th>Ditugaskan ke</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _tableData)
                    {
                        <tr>
                            <td><span class="td-primary" style="font-family: monospace; font-weight: 500;">#@row.Id</span></td>
                            <td><span class="td-primary">@row.Name</span></td>
                            <td><span class="td-secondary">@row.Department</span></td>
                            <td><span class="td-primary">@row.Category</span></td>
                            <td><span class="td-secondary">@row.Assigned</span></td>
                            <td><StatusBadge Status="@row.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<StatItem> _stats = new()
    {
        new StatItem { Label = "Total Tiket", Value = "482", Icon = "icon/icon_9_admin.svg" },
        new StatItem { Label = "Rata-rata Penyelesaian", Value = "2.4j", Icon = "icon/clock.svg" },
        new StatItem { Label = "Tiket Terbuka", Value = "12", Subtitle = "+2 sejak kemarin", Icon = "icon/icon_1_admin.svg" },
        new StatItem { Label = "Kategori Teratas", Value = "Reset Kata Sandi", Subtitle = "32% dari total volume", Icon = "icon/icon_14_admin.svg" }
    };

    private List<ChartPoint> _chartData = new()
    {
        new("Sen", 28), new("Sel", 35), new("Rab", 22), new("Kam", 40), new("Jum", 48), new("Sab", 15), new("Min", 10)
    };

    private ApexChartOptions<ChartPoint> _chartOptions = new();

    protected override void OnInitialized()
    {
        _chartOptions = new ApexChartOptions<ChartPoint>
        {
            Chart = new Chart { Type = ChartType.Bar, Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }, Toolbar = new Toolbar { Show = false } },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { ColumnWidth = "48%", BorderRadius = 6 } },
            Colors = new List<string> { "#2563EB" },
            Xaxis = new XAxis { Categories = _chartData.Select(d => d.Label).ToList(), Labels = new XAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "12px" } } },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "12px" } } } },
            Grid = new Grid { BorderColor = "rgba(226, 232, 240, 0.6)", StrokeDashArray = 3 }
        };
    }

    private List<BreakdownItem> _breakdown = new()
    {
        new BreakdownItem { Name = "Perangkat Lunak", Value = 42 },
        new BreakdownItem { Name = "Perangkat Keras", Value = 28 },
        new BreakdownItem { Name = "Jaringan & Internet", Value = 18 },
        new BreakdownItem { Name = "Akses Akun", Value = 12 }
    };

    private List<TableRow> _tableData = new()
    {
        new TableRow { Id = "IT-001", Name = "Ahmad Fauzi", Department = "Eksekutif", Category = "Reset Kata Sandi", Assigned = "Dewi Kartika", Status = "dikerjakan" },
        new TableRow { Id = "IT-002", Name = "Budi Santoso", Department = "Human Resources", Category = "Perangkat Keras", Assigned = "Rizky Hidayat", Status = "selesai" },
        new TableRow { Id = "IT-003", Name = "Maya Putri", Department = "Marketing", Category = "Jaringan", Assigned = "Belum Ditugaskan", Status = "menunggu" }
    };

    public class ChartPoint
    {
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
        public ChartPoint(string label, int value) => (Label, Value) = (label, value);
    }

    private class BreakdownItem
    {
        public string Name { get; set; } = string.Empty;
        public int Value { get; set; }
    }

    private class TableRow
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Assigned { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}