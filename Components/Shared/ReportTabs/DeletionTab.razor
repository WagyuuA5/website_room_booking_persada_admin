@using booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using ApexCharts

<div class="tab-content">
    <StatsRow Stats="_stats" />

    <div class="tab-charts">
        <div class="tab-chart-card">
            <div class="tab-chart-header">
                <h3>Tren Permintaan Penghapusan Mingguan</h3>
            </div>
            <ApexChart TItem="ChartPoint" Options="_chartOptions" Height="280">
                <ApexPointSeries TItem="ChartPoint"
                                 Items="_chartData"
                                 Name="Permintaan"
                                 SeriesType="SeriesType.Area"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
        <div class="tab-breakdown">
            <h3 class="tab-breakdown-title">Permintaan per Departemen</h3>
            <div class="tab-breakdown-list">
                @foreach (var item in _breakdown)
                {
                    <div class="tab-breakdown-item">
                        <div class="tab-breakdown-info">
                            <span class="tab-breakdown-name">@item.Name</span>
                            <span class="tab-breakdown-value">@item.Value</span>
                        </div>
                        <div class="tab-breakdown-bar">
                            <div class="tab-breakdown-fill" style="width: @($"{item.Percent}%"); background: var(--color-accent, #2563EB);"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-table-section">
        <div class="tab-table-header">
            <h3>Permintaan Penghapusan Akun</h3>
            <a href="user-management" class="tab-table-link">Lihat Semua</a>
        </div>
        <div class="tab-table-wrapper">
            <table class="tab-table">
                <thead>
                    <tr>
                        <th>ID Permintaan</th>
                        <th>Pengguna</th>
                        <th>Departemen</th>
                        <th>Alasan</th>
                        <th>Penyetuju</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _tableData)
                    {
                        <tr>
                            <td><span class="td-primary" style="font-family: monospace; font-weight: 500;">#@row.Id</span></td>
                            <td><span class="td-primary">@row.Name</span></td>
                            <td><span class="td-secondary">@row.Department</span></td>
                            <td><span class="td-secondary">@row.Reason</span></td>
                            <td><span class="td-secondary">@row.Approver</span></td>
                            <td><StatusBadge Status="@row.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<StatItem> _stats = new()
    {
        new StatItem { Label = "Total Permintaan", Value = "142", Icon = "icon/icon_1_admin.svg" },
        new StatItem { Label = "Disetujui", Value = "118", Icon = "icon/check.svg" },
        new StatItem { Label = "Ditolak", Value = "15", Icon = "icon/x.svg" },
        new StatItem { Label = "Menunggu Peninjauan", Value = "09", Icon = "icon/clock.svg" }
    };

    private List<ChartPoint> _chartData = new()
    {
        new("Sen", 8), new("Sel", 12), new("Rab", 6), new("Kam", 15), new("Jum", 10), new("Sab", 4), new("Min", 3)
    };

    private ApexChartOptions<ChartPoint> _chartOptions = new();

    protected override void OnInitialized()
    {
        _chartOptions = new ApexChartOptions<ChartPoint>
        {
            Chart = new Chart { Type = ChartType.Area, Animations = new Animations { Enabled = true, Easing = Easing.Easeinout, Speed = 800 }, Toolbar = new Toolbar { Show = false } },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2.5 },
            Colors = new List<string> { "#2563EB" },
            Fill = new Fill { Type = new List<FillType> { FillType.Gradient }, Gradient = new FillGradient { ShadeIntensity = 1, OpacityFrom = 0.35, OpacityTo = 0.05, Stops = new List<double> { 0, 90, 100 } } },
            Xaxis = new XAxis { Categories = _chartData.Select(d => d.Label).ToList(), Labels = new XAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "12px" } } },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { FontWeight = "500", FontSize = "12px" } } } },
            Grid = new Grid { BorderColor = "rgba(226, 232, 240, 0.6)", StrokeDashArray = 3 }
        };
    }

    private List<BreakdownItem> _breakdown = new()
    {
        new BreakdownItem { Name = "Divisi IT & Digital", Value = 42, Percent = 55 },
        new BreakdownItem { Name = "Divisi Human Resources", Value = 28, Percent = 36 },
        new BreakdownItem { Name = "Divisi Finance", Value = 15, Percent = 20 },
        new BreakdownItem { Name = "Divisi Marketing", Value = 12, Percent = 15 }
    };

    private List<TableRow> _tableData = new()
    {
        new TableRow { Id = "AD-001", Name = "Budi Santoso", Department = "Human Resources", Reason = "Pengunduran Diri", Approver = "Siti Nurhaliza", Status = "disetujui" },
        new TableRow { Id = "AD-002", Name = "Maya Putri", Department = "Marketing", Reason = "Kontrak Berakhir", Approver = "Ahmad Fauzi", Status = "menunggu" },
        new TableRow { Id = "AD-003", Name = "Rizky Hidayat", Department = "Operasional", Reason = "Akun Duplikat", Approver = "Dewi Kartika", Status = "ditolak" }
    };

    public class ChartPoint
    {
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
        public ChartPoint(string label, int value) => (Label, Value) = (label, value);
    }

    private class BreakdownItem
    {
        public string Name { get; set; } = string.Empty;
        public int Value { get; set; }
        public int Percent { get; set; }
    }

    private class TableRow
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
        public string Approver { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}