@namespace booking_room_admin.Components.Shared
@implements IDisposable
@inject booking_room_admin.Components.Services.ToastService ToastSvc

<div class="toast-stack">
    @foreach (var t in _toasts)
    {
        <div class="toast @t.Type">
            <span class="toast-icon">
                @if (t.Type == "success") { <Icon Name="check-circle" Size="16" /> }
                else if (t.Type == "error") { <Icon Name="x-circle" Size="16" /> }
                else { <Icon Name="bell" Size="16" /> }
            </span>
            <span class="toast-message">@t.Message</span>
            <button type="button" class="toast-close" @onclick="() => DismissToast(t)" title="Tutup notifikasi">
                <Icon Name="x" Size="12" />
            </button>
            <div class="toast-progress"></div>
        </div>
    }
</div>

@code {
    private List<(string Message, string Type)> _toasts = new();
    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        ToastSvc.OnToast += HandleToast;
    }

    private void HandleToast(string message, string type)
    {
        _toasts.Add((message, type));
        if (_toasts.Count > 4) _toasts.RemoveAt(0);
        InvokeAsync(StateHasChanged);

        _timer = new System.Timers.Timer(4000);
        _timer.Elapsed += (s, e) =>
        {
            _timer?.Stop();
            if (_toasts.Any()) { _toasts.RemoveAt(0); InvokeAsync(StateHasChanged); }
        };
        _timer.AutoReset = false;
        _timer.Start();
    }

    private void DismissToast((string Message, string Type) t)
    {
        _toasts.Remove(t);
        StateHasChanged();
    }

    public void Dispose()
    {
        ToastSvc.OnToast -= HandleToast;
        _timer?.Dispose();
    }
}
