@namespace booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject ToastService Toast

<AppModal IsOpen="@IsOpen" IsOpenChanged="@IsOpenChanged" Size="large">
    <HeaderContent>
        <div class="mb-popup-header">
            <h3 class="mb-popup-title">Booking Manual</h3>
            <p class="mb-popup-subtitle">Jadwalkan sumber daya atau ruangan baru</p>
        </div>
    </HeaderContent>
    <ChildContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-form-grid">
            @* 1. Nama Pemesan & Divisi *@
            <div class="mb-row-2col">
                <div class="mb-field">
                    <label class="mb-label">Nama Pemesan (Lengkap) <span class="req">*</span></label>
                    <input type="text" class="mb-input" placeholder="Masukkan nama lengkap" @bind="form.FullName" />
                </div>
                <div class="mb-field">
                    <label class="mb-label">Divisi <span class="req">*</span></label>
                    <select class="mb-select" @bind="form.Division">
                        <option value="">Pilih divisi</option>
                        @foreach (var div in divisions)
                        {
                            <option value="@div">@div</option>
                        }
                    </select>
                </div>
            </div>

            @* 2. Pilih Ruangan (Interactive Cards) *@
            <div class="mb-field">
                <label class="mb-label">Pilih Ruangan <span class="req">*</span></label>
                <div class="mb-rooms-cards-grid">
                    @foreach (var r in availableRooms)
                    {
                        <div class="mb-room-card @(form.SelectedRoomId == r.Id ? "selected" : "") @(r.IsBooked ? "disabled" : "")"
                             @onclick="() => SelectRoom(r)">
                            <div class="mb-rc-top">
                                <strong class="mb-rc-name">@r.Name</strong>
                                <span class="mb-rc-badge @(r.IsBooked ? "badge-booked" : "badge-avail")">
                                    @(r.IsBooked ? "TERPESAN" : "TERSEDIA")
                                </span>
                            </div>
                            <div class="mb-rc-meta">
                                <span>?? Kap: @r.Capacity Pax</span>
                                <span>?? @r.Location</span>
                            </div>
                            <div class="mb-rc-amenities">
                                <span>@r.AmenitiesSummary</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 3. Tanggal dan Waktu *@
            <div class="mb-row-3col">
                <div class="mb-field">
                    <label class="mb-label">Tanggal <span class="req">*</span></label>
                    <input type="date" class="mb-input" @bind="form.Date" />
                </div>
                <div class="mb-field">
                    <label class="mb-label">Waktu Mulai <span class="req">*</span></label>
                    <input type="time" class="mb-input" @bind="form.StartTime" />
                </div>
                <div class="mb-field">
                    <label class="mb-label">Waktu Selesai <span class="req">*</span></label>
                    <input type="time" class="mb-input" @bind="form.EndTime" />
                </div>
            </div>

            @* 4. Undang Peserta & Capacity Bar *@
            <div class="mb-field">
                <div class="mb-attendee-header-row">
                    <label class="mb-label">Undang Peserta</label>
                    @if (selectedRoom != null)
                    {
                        <span class="mb-cap-text @(form.Attendees.Count > selectedRoom.Capacity ? "text-danger" : "")">
                            @form.Attendees.Count dari @selectedRoom.Capacity Kapasitas Ruangan
                        </span>
                    }
                </div>

                @if (selectedRoom != null)
                {
                    <div class="mb-progress-track">
                        <div class="mb-progress-bar @(form.Attendees.Count > selectedRoom.Capacity ? "bar-over" : "")"
                             style="width: @Math.Min(100, selectedRoom.Capacity > 0 ? (form.Attendees.Count * 100 / selectedRoom.Capacity) : 0)%"></div>
                    </div>
                }

                <div class="mb-attendee-input-wrap">
                    <input type="text" class="mb-input" placeholder="Cari nama karyawan untuk ditambahkan..."
                           @bind="attendeeQuery" @bind:event="oninput" @bind:after="SearchAttendees" />

                    @if (attendeeSuggestions.Any())
                    {
                        <div class="mb-suggestions-drop">
                            @foreach (var s in attendeeSuggestions)
                            {
                                <div class="mb-suggestion-item" @onclick="() => AddAttendee(s)">
                                    <div class="mb-sug-avatar">@s.Initials</div>
                                    <div class="mb-sug-info">
                                        <strong>@s.Name</strong>
                                        <span>@s.Division</span>
                                    </div>
                                    @if (s.HasConflict)
                                    {
                                        <span class="badge-conflict-sm">? Berpotensi bentrok jadwal</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (form.Attendees.Any())
                {
                    <div class="mb-attendee-chips-row">
                        @foreach (var att in form.Attendees)
                        {
                            <div class="mb-att-pill @(att.HasConflict ? "pill-conflict" : "")">
                                <span class="mb-att-av">@att.Initials</span>
                                <span class="mb-att-name">@att.Name</span>
                                @if (att.HasConflict)
                                {
                                    <span class="att-warn" title="Berpotensi bentrok jadwal">?</span>
                                }
                                <button type="button" class="mb-att-del" @onclick="() => RemoveAttendee(att)"><Icon Name="x" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
            </div>

            @* 5. Toggle External Guest *@
            <div class="mb-field mb-toggle-row">
                <label class="mb-toggle-switch">
                    <input type="checkbox" @bind="form.InviteExternal" />
                    <span class="mb-slider"></span>
                </label>
                <span class="mb-toggle-label">Undang tamu eksternal</span>
            </div>

            @if (form.InviteExternal)
            {
                <div class="mb-field">
                    <label class="mb-label">Email Tamu (Pisahkan dengan koma jika lebih dari 1)</label>
                    <input type="text" class="mb-input" placeholder="email@perusahaan.com, client@partner.id" @bind="form.ExternalGuests" />
                </div>
            }

            @* 6. Catatan / Permintaan Khusus *@
            <div class="mb-field">
                <label class="mb-label">Catatan / Permintaan Khusus</label>
                <textarea class="mb-textarea" rows="2" placeholder="Kebutuhan alat, catering, susunan meja, dll..." @bind="form.Notes"></textarea>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="Close" disabled="@isSubmitting">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmBooking" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Konfirmasi Booking</span>
            }
        </button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<Booking> OnBookingCreated { get; set; }

    public class ManualBookingForm
    {
        public string FullName { get; set; } = "";
        public string Division { get; set; } = "";
        public int? SelectedRoomId { get; set; }
        public DateTime? Date { get; set; }
        public TimeOnly? StartTime { get; set; }
        public TimeOnly? EndTime { get; set; }
        public List<AttendeeSuggestion> Attendees { get; set; } = new();
        public bool InviteExternal { get; set; }
        public string ExternalGuests { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    public class RoomOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int Capacity { get; set; }
        public string Location { get; set; } = "";
        public string AmenitiesSummary { get; set; } = "";
        public bool IsBooked { get; set; }
    }

    public class AttendeeSuggestion
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Division { get; set; } = "";
        public string Initials { get; set; } = "";
        public bool HasConflict { get; set; }
    }

    private ManualBookingForm form = new() { Date = DateTime.Today, StartTime = new TimeOnly(9, 0), EndTime = new TimeOnly(11, 0) };
    private string attendeeQuery = "";
    private List<AttendeeSuggestion> attendeeSuggestions = new();
    private bool isSubmitting = false;
    private string errorMessage = "";

    private List<string> divisions = new() { "IT & Digital", "Operasional", "Human Resources", "Finance", "Marketing", "Legal", "General Affairs" };

    private List<RoomOption> availableRooms = new()
    {
        new() { Id = 1, Name = "Ruang Dirantara", Capacity = 12, Location = "Lantai 14, Wing Utara", AmenitiesSummary = "Proyektor 4K, Video Conf, Wi-Fi 6", IsBooked = false },
        new() { Id = 2, Name = "Ruang Rapat Utama", Capacity = 20, Location = "Lantai 2, Wing A", AmenitiesSummary = "Dual Screen, Smart Board, AC Central", IsBooked = false },
        new() { Id = 3, Name = "Ruang Diskusi B", Capacity = 6, Location = "Lantai 2, Wing B", AmenitiesSummary = "TV 65\", Whiteboard, Sound System", IsBooked = false },
        new() { Id = 4, Name = "Auditorium Serbaguna", Capacity = 50, Location = "Lantai 1, Sayap Timur", AmenitiesSummary = "Stage Sound, 4K Live Cam, Stage Light", IsBooked = true }
    };

    private RoomOption? selectedRoom => availableRooms.FirstOrDefault(r => r.Id == form.SelectedRoomId);

    private void SelectRoom(RoomOption room)
    {
        if (room.IsBooked) return;
        form.SelectedRoomId = room.Id;
    }

    private void SearchAttendees()
    {
        if (string.IsNullOrWhiteSpace(attendeeQuery))
        {
            attendeeSuggestions.Clear();
            return;
        }
        var q = attendeeQuery.ToLowerInvariant();
        attendeeSuggestions = FakeAttendees
            .Where(a => a.Name.ToLowerInvariant().Contains(q) && !form.Attendees.Any(f => f.Id == a.Id))
            .ToList();
    }

    private void AddAttendee(AttendeeSuggestion suggestion)
    {
        form.Attendees.Add(suggestion);
        attendeeSuggestions.Remove(suggestion);
        attendeeQuery = string.Empty;
    }

    private void RemoveAttendee(AttendeeSuggestion suggestion)
    {
        form.Attendees.Remove(suggestion);
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
        form = new ManualBookingForm { Date = DateTime.Today, StartTime = new TimeOnly(9, 0), EndTime = new TimeOnly(11, 0) };
        isSubmitting = false;
        errorMessage = "";
    }

    private async Task ConfirmBooking()
    {
        errorMessage = "";

        if (selectedRoom == null || string.IsNullOrWhiteSpace(form.FullName) || string.IsNullOrWhiteSpace(form.Division) || !form.Date.HasValue || !form.StartTime.HasValue || !form.EndTime.HasValue)
        {
            errorMessage = "Mohon lengkapi Nama Pemesan, Divisi, Ruangan, Tanggal, dan Jam Mulai/Selesai.";
            return;
        }

        if (form.EndTime.Value <= form.StartTime.Value)
        {
            errorMessage = "Jam selesai harus lebih besar dari jam mulai.";
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        await Task.Delay(300);

        var booking = new Booking
        {
            Id = new Random().Next(1000, 9999),
            Title = string.IsNullOrWhiteSpace(form.Notes) ? $"Pertemuan {form.Division}" : form.Notes.Substring(0, Math.Min(35, form.Notes.Length)),
            Room = selectedRoom.Name,
            Date = form.Date.Value,
            StartTime = form.StartTime.Value.ToString("HH:mm"),
            EndTime = form.EndTime.Value.ToString("HH:mm"),
            Duration = $"{Math.Round((form.EndTime.Value - form.StartTime.Value).TotalHours, 1)} Jam",
            RequesterName = form.FullName,
            RequesterDivision = form.Division,
            RequesterInitials = form.FullName.Length >= 2 ? form.FullName.Substring(0, 2).ToUpper() : "WA",
            ParticipantsCount = Math.Max(1, form.Attendees.Count),
            Status = "approved"
        };

        Toast.Success("Booking berhasil dibuat.");
        await OnBookingCreated.InvokeAsync(booking);
        Close();
    }

    private static readonly List<AttendeeSuggestion> FakeAttendees = new()
    {
        new() { Id = 1, Name = "Ahmad Fauzi", Division = "IT & Digital", Initials = "AF", HasConflict = false },
        new() { Id = 2, Name = "Siti Rahma", Division = "Human Resources", Initials = "SR", HasConflict = false },
        new() { Id = 3, Name = "Budi Santoso", Division = "Operasional", Initials = "BS", HasConflict = true },
        new() { Id = 4, Name = "Dewi Lestari", Division = "Finance", Initials = "DL", HasConflict = false },
        new() { Id = 5, Name = "Eko Prasetyo", Division = "Marketing", Initials = "EP", HasConflict = true }
    };
}
