@using booking_room_admin.Components.Models

<div class="popup-overlay @(IsOpen ? "open" : "")" @onclick="Close">
    <div class="popup-card detail-room-card" @onclick:stopPropagation="true">
        <div class="dr-header">
            <div>
                <h2 class="dr-title">@Room?.Name</h2>
                <p class="dr-subtitle">@Room?.Floor · @Room?.Type</p>
            </div>
            <button class="popup-close" @onclick="Close">&times;</button>
        </div>

        <div class="dr-body">
            <div class="dr-status-row">
                <span class="dr-badge @(Room?.Status == "active" ? "badge-active" : "badge-maintenance")">
                    @(Room?.Status == "active" ? "Aktif" : "Perawatan")
                </span>
                <span class="dr-capacity">
                    <img src="icon/people.svg" alt="Kapasitas" class="dr-meta-icon" />
                    @Room?.Capacity Orang
                </span>
            </div>

            <p class="dr-desc">@Room?.Description</p>

            <div class="dr-section">
                <div class="dr-section-title">Fasilitas</div>
                <div class="dr-tags">
                    @foreach (var tag in Room?.Facilities ?? new())
                    {
                        <span class="dr-tag">@tag</span>
                    }
                </div>
            </div>

            <div class="dr-section">
                <div class="dr-section-title">Statistik</div>
                <div class="dr-stats">
                    <div class="dr-stat">
                        <span class="dr-stat-value">@Room?.TotalBookings</span>
                        <span class="dr-stat-label">Total Booking</span>
                    </div>
                    <div class="dr-stat">
                        <span class="dr-stat-value">4.8</span>
                        <span class="dr-stat-label">Rating</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="dr-footer">
            <button class="btn-outline-pill" @onclick="Close">Tutup</button>
            <button class="btn-primary-pill btn-yellow" @onclick="EditRoom">
                <img src="icon/icon_14_admin.svg" alt="Ubah" class="btn-icon" />
                Ubah Ruangan
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<Room> OnEdit { get; set; }
    [Parameter] public Room? Room { get; set; }

    private void EditRoom()
    {
        if (Room != null)
        {
            OnEdit.InvokeAsync(Room);
        }
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
    }
}