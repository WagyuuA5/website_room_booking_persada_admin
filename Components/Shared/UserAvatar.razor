<div class="user-avatar avatar-circle @CssClass" style="@StyleString">
    @if (!string.IsNullOrEmpty(PhotoUrl))
    {
        <img src="@PhotoUrl" alt="Avatar" />
    }
    else
    {
        <span>@Initials</span>
    }
</div>

@code {
    [Parameter] public string Initials { get; set; } = "U";
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public string BgColor { get; set; } = "#1e3a8a";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Size { get; set; } = "36px";

    private string StyleString
    {
        get
        {
            if (!string.IsNullOrEmpty(PhotoUrl))
            {
                return $"width: {Size}; height: {Size};";
            }
            return $"width: {Size}; height: {Size}; background-color: {BgColor}; color: white;";
        }
    }
}
