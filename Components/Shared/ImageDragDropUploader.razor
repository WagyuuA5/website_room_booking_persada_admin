@namespace booking_room_admin.Components.Shared
@inject booking_room_admin.Components.Services.ToastService Toast

<div class="drag-drop-uploader @CssClass @(isDragging ? "dragging" : "")" 
     @ondragenter="OnDragEnter" 
     @ondragleave="OnDragLeave" 
     @ondragover:preventDefault 
     @ondrop="OnDrop">
    
    <InputFile id="@inputId" 
               accept=".svg,.png,.jpg,.jpeg,.gif" 
               OnChange="HandleFileSelected" 
               class="hidden-file-input" />
               
    <label for="@inputId" class="upload-area">
        <Icon Name="cloud-upload" Size="32" CssClass="upload-icon" />
        <div class="upload-text">
            <strong>Klik untuk unggah</strong> atau seret & lepas
        </div>
        <div class="upload-hint">SVG, PNG, JPG, GIF (Maks. 5MB)</div>
    </label>
</div>

@code {
    private readonly string inputId = "dragdrop-" + Guid.NewGuid().ToString("N");
    private bool isDragging = false;

    [Parameter] public EventCallback<string> OnImageUploaded { get; set; }
    [Parameter] public string CssClass { get; set; } = "";

    private void OnDragEnter(DragEventArgs e) => isDragging = true;
    private void OnDragLeave(DragEventArgs e) => isDragging = false;

    private async Task OnDrop(DragEventArgs e)
    {
        isDragging = false;
        // In Blazor Server/WebAssembly, native drag and drop of files to custom div 
        // doesn't automatically map to InputFile without JS interop. 
        // Since we are using standard <InputFile>, we rely on the click label for full compatibility,
        // or just let Blazor 8 native file drop handle it if attached to InputFile directly.
        // Actually, to make InputFile cover the whole area for drop:
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isDragging = false;
        try
        {
            var file = e.File;
            if (file != null)
            {
                if (file.Size > 5 * 1024 * 1024)
                {
                    Toast.Error("Ukuran file melebihi 5MB.");
                    return;
                }
                
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                var url = $"data:{file.ContentType};base64,{base64}";
                await OnImageUploaded.InvokeAsync(url);
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Gagal mengunggah foto: " + ex.Message);
        }
    }
}
