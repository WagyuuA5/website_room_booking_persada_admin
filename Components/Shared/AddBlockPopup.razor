@namespace booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject IRoomService RoomService
@inject ToastService Toast

<AppModal IsOpen="@IsOpen" IsOpenChanged="IsOpenChanged" Title="Tambah Blokir Jadwal Ruangan" Size="medium">
    <ChildContent>
        <div class="ab-form" style="display: flex; flex-direction: column; gap: 1rem;">
            @* 1. Ruangan Dinamis (CASE 16) *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Pilih Ruangan <span style="color: #DC2626;">*</span></label>
                <select class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="selectedRoomId">
                    @foreach (var room in availableRooms)
                    {
                        <option value="@room.Id">@room.Name (@room.Floor - @room.Capacity Orang)</option>
                    }
                </select>
            </div>

            @* 2. Tanggal & Rentang Waktu *@
            <div class="ab-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                    <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Tanggal Blokir <span style="color: #DC2626;">*</span></label>
                    <input type="date" class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="blockDate" />
                </div>
                <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                    <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Rentang Waktu <span style="color: #DC2626;">*</span></label>
                    <div class="ab-time-range" style="display: flex; align-items: center; gap: 6px;">
                        <input type="time" class="ab-input" style="flex: 1; padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="startTime" />
                        <span>-</span>
                        <input type="time" class="ab-input" style="flex: 1; padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="endTime" />
                    </div>
                </div>
            </div>

            @* 3. Alasan Blokir & Bantuan "Lainnya" (CASE 15) *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Alasan Pemblokiran <span style="color: #DC2626;">*</span></label>
                <select class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="selectedReason">
                    <option value="Pemeliharaan">Pemeliharaan / Perawatan Rutin</option>
                    <option value="Acara Internal">Acara Internal Perusahaan (Townhall / Rapat Direksi)</option>
                    <option value="Renovasi">Renovasi / Pengecatan</option>
                    <option value="Lainnya">Lainnya</option>
                </select>

                @if (selectedReason == "Lainnya")
                {
                    <div class="ab-helper-text" style="font-size: 0.78rem; color: #854D0E; background: #FEF9C3; border-left: 3px solid #EAB308; padding: 6px 10px; border-radius: 4px; margin-top: 4px; line-height: 1.4;">
                        Pilih 'Lainnya' jika alasan pemblokiran tidak tercakup dalam kategori standar (Perbaikan, Acara Internal, dll). Jelaskan alasan spesifik pada kolom Catatan di bawah.
                    </div>
                }
            </div>

            @* 4. Catatan (Wajib jika "Lainnya") *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">
                    Catatan Detail
                    @if (selectedReason == "Lainnya")
                    {
                        <span style="color: #DC2626;">* (Wajib diisi untuk opsi 'Lainnya')</span>
                    }
                    else
                    {
                        <span style="color: #6E6E73; font-weight: normal;">(Opsional)</span>
                    }
                </label>
                <textarea class="ab-textarea" rows="3" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid @(hasSubmitted && selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes) ? "#DC2626" : "#D1D5DB"); border-radius: 8px; font-size: 0.85rem;" placeholder="Masukkan detail alasan pemblokiran..." @bind="notes"></textarea>
                @if (hasSubmitted && selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes))
                {
                    <span style="color: #DC2626; font-size: 0.75rem;">Catatan wajib diisi saat memilih opsi 'Lainnya'.</span>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="Close">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmBlock">Blokir Jadwal</button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnBlockCreated { get; set; }

    private List<Room> availableRooms = new();
    private int selectedRoomId = 1;
    private DateTime blockDate = DateTime.Today;
    private TimeOnly startTime = new(9, 0);
    private TimeOnly endTime = new(17, 0);
    private string selectedReason = "Pemeliharaan";
    private string notes = "";
    private bool hasSubmitted = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRooms();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !availableRooms.Any())
        {
            await LoadRooms();
        }
    }

    private async Task LoadRooms()
    {
        availableRooms = await RoomService.GetAllRoomsAsync();
        if (availableRooms.Any() && !availableRooms.Any(r => r.Id == selectedRoomId))
        {
            selectedRoomId = availableRooms.First().Id;
        }
    }

    private async Task ConfirmBlock()
    {
        hasSubmitted = true;
        if (selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes))
        {
            Toast.Error("Kolom catatan wajib diisi ketika memilih alasan 'Lainnya'.");
            return;
        }

        var room = availableRooms.FirstOrDefault(r => r.Id == selectedRoomId);
        var roomName = room?.Name ?? "Ruangan";
        Toast.Success($"Jadwal {roomName} berhasil diblokir untuk {selectedReason}.");
        
        await OnBlockCreated.InvokeAsync();
        await Close();
    }

    private async Task Close()
    {
        hasSubmitted = false;
        notes = "";
        selectedReason = "Pemeliharaan";
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
