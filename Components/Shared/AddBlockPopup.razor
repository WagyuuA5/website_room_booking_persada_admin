@namespace booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@using booking_room_admin.Components.Services
@inject IRoomService RoomService
@inject ToastService Toast

<AppModal IsOpen="@IsOpen" IsOpenChanged="IsOpenChanged" Title="Blokir Ketersediaan Ruangan" Size="medium">
    <ChildContent>
        <div class="ab-form" style="display: flex; flex-direction: column; gap: 1rem;">
            @* 1. Pilih Ruangan *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Pilih Ruangan <span style="color: #DC2626;">*</span></label>
                <select class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="selectedRoomId">
                    @foreach (var room in availableRooms)
                    {
                        <option value="@room.Id">@room.Name (@room.Floor - @room.Capacity Orang)</option>
                    }
                </select>
            </div>

            @* Room Info Summary Card *@
            @if (currentSelectedRoom != null)
            {
                <div class="ab-room-summary" style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: #0B1E39; color: #fff; display: flex; align-items: center; justify-content: center;">
                            <Icon Name="building" Size="18" />
                        </div>
                        <div>
                            <strong style="color: #0B1E39; display: block;">@currentSelectedRoom.Name</strong>
                            <span style="color: #6E6E73;">@currentSelectedRoom.Floor &middot; Kapasitas @currentSelectedRoom.Capacity Orang</span>
                        </div>
                    </div>
                    <span style="color: #059669; font-weight: 600; background: #ECFDF5; padding: 2px 8px; border-radius: 999px; font-size: 0.75rem;">
                        Tersedia
                    </span>
                </div>
            }

            @* 2. Tanggal & Rentang Waktu *@
            <div class="ab-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                    <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Tanggal Blokir <span style="color: #DC2626;">*</span></label>
                    <input type="date" class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="blockDate" />
                </div>
                <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                    <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Rentang Waktu <span style="color: #DC2626;">*</span></label>
                    <div class="ab-time-range" style="display: flex; align-items: center; gap: 6px;">
                        <input type="time" class="ab-input" style="flex: 1; padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="startTime" />
                        <span>-</span>
                        <input type="time" class="ab-input" style="flex: 1; padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="endTime" />
                    </div>
                </div>
            </div>

            @* 3. Jadwalkan Blokir Berulang *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="chkRepeatBlock" @bind="isRecurring" @bind:after="StateHasChanged" style="width: 16px; height: 16px; accent-color: #0B1E39; cursor: pointer;" />
                    <label for="chkRepeatBlock" style="font-size: 0.85rem; font-weight: 600; color: #1D1D1F; cursor: pointer;">
                        Jadwalkan Blokir Berulang
                    </label>
                </div>
                @if (!isRecurring)
                {
                    <span style="font-size: 0.78rem; color: #6B7280; margin-left: 24px;">Terapkan blokir ini secara otomatis pada jadwal mendatang.</span>
                }
            </div>

            @if (isRecurring)
            {
                <div class="ab-recurring-settings" style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                            <label style="font-size: 0.8rem; font-weight: 600; color: #1D1D1F;">Ulangi Setiap</label>
                            <select class="ab-input" style="padding: 0.4rem 0.6rem; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 0.82rem;" @bind="recurringPattern" @bind:after="StateHasChanged">
                                <option value="Hari">Hari (setiap hari)</option>
                                <option value="Minggu">Minggu (hari yang sama)</option>
                                <option value="Bulan">Bulan (tanggal yang sama)</option>
                            </select>
                        </div>
                        <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                            <label style="font-size: 0.8rem; font-weight: 600; color: #1D1D1F;">Berakhir</label>
                            @if (endMode == "count")
                            {
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <input type="number" class="ab-input" style="width: 70px; padding: 0.4rem; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 0.82rem;" min="1" max="24" @bind="repeatCount" @bind:event="oninput" @bind:after="StateHasChanged" />
                                    <span style="font-size: 0.82rem; color: #4B5563;">@GetRepeatUnitLabel() ke depan</span>
                                </div>
                            }
                            else
                            {
                                <input type="date" class="ab-input" style="padding: 0.4rem 0.6rem; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 0.82rem;" @bind="endDate" @bind:after="StateHasChanged" />
                            }
                        </div>
                    </div>

                    <div style="display: flex; gap: 16px; font-size: 0.8rem;">
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #374151;">
                            <input type="radio" name="endMode" value="count" checked="@(endMode == "count")" @onchange='() => { endMode = "count"; StateHasChanged(); }' style="accent-color: #0B1E39;" />
                            Setelah jumlah tertentu
                        </label>
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #374151;">
                            <input type="radio" name="endMode" value="date" checked="@(endMode == "date")" @onchange='() => { endMode = "date"; StateHasChanged(); }' style="accent-color: #0B1E39;" />
                            Pada tanggal tertentu
                        </label>
                    </div>
                    
                    <div style="font-size: 0.78rem; color: #0369A1; background: #E0F2FE; padding: 10px 12px; border-radius: 6px; border-left: 4px solid #0284C7; display: flex; align-items: flex-start; gap: 8px; line-height: 1.5;">
                        <Icon Name="refresh-cw" Size="14" CssClass="flex-shrink-0" style="margin-top: 2px;" />
                        <span>Ruangan ini akan diblokir setiap <strong>@recurringPattern.ToLower()</strong>, dimulai <strong>@blockDate.ToString("dd MMMM yyyy")</strong> hingga <strong>@GetEndDateDisplay()</strong> (total <strong>@GetTotalSessions() sesi</strong>).</span>
                    </div>
                </div>
            }

            @* 4. Alasan Blokir & Bantuan "Lainnya" *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">Alasan Pemblokiran <span style="color: #DC2626;">*</span></label>
                <select class="ab-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem;" @bind="selectedReason">
                    <option value="Pemeliharaan">Pemeliharaan / Perawatan Rutin</option>
                    <option value="Acara Internal">Acara Internal Perusahaan (Townhall / Rapat Direksi)</option>
                    <option value="Renovasi">Renovasi / Pengecatan</option>
                    <option value="Lainnya">Lainnya</option>
                </select>

                @if (selectedReason == "Lainnya")
                {
                    <div class="ab-helper-text" style="font-size: 0.78rem; color: #854D0E; background: #FEF9C3; border-left: 3px solid #EAB308; padding: 6px 10px; border-radius: 4px; margin-top: 4px; line-height: 1.4;">
                        Pilih 'Lainnya' jika alasan pemblokiran tidak tercakup dalam kategori standar. Jelaskan alasan spesifik pada kolom Catatan di bawah.
                    </div>
                }
            </div>

            @* 5. Catatan (Wajib jika "Lainnya") *@
            <div class="ab-field" style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 0.82rem; font-weight: 600; color: #1D1D1F;">
                    Catatan Detail
                    @if (selectedReason == "Lainnya")
                    {
                        <span style="color: #DC2626;">* (Wajib diisi untuk opsi 'Lainnya')</span>
                    }
                    else
                    {
                        <span style="color: #6E6E73; font-weight: normal;">(Opsional)</span>
                    }
                </label>
                <textarea class="ab-textarea" rows="3" style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid @(hasSubmitted && selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes) ? "#DC2626" : "#D1D5DB"); border-radius: 8px; font-size: 0.85rem;" placeholder="Masukkan detail alasan pemblokiran..." @bind="notes"></textarea>
                @if (hasSubmitted && selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes))
                {
                    <span style="color: #DC2626; font-size: 0.75rem;">Catatan wajib diisi saat memilih opsi 'Lainnya'.</span>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-outline-pill" @onclick="Close">Batal</button>
        <button type="button" class="btn-primary-pill btn-yellow" @onclick="ConfirmBlock">Konfirmasi & Blokir Ruangan</button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnBlockCreated { get; set; }

    private List<Room> availableRooms = new();
    private int selectedRoomId = 1;
    private DateTime blockDate = DateTime.Today;
    private TimeOnly startTime = new(9, 0);
    private TimeOnly endTime = new(17, 0);
    private string selectedReason = "Pemeliharaan";
    private string notes = "";
    private bool hasSubmitted = false;

    private bool isRecurring = false;
    private string recurringPattern = "Minggu";
    private int repeatCount = 3;
    private string endMode = "count";
    private DateTime endDate = DateTime.Today.AddDays(21);

    private string GetRepeatUnitLabel() => recurringPattern switch
    {
        "Hari" => "hari",
        "Minggu" => "minggu",
        "Bulan" => "bulan",
        _ => "kali"
    };

    private int GetTotalSessions()
    {
        if (endMode == "count")
        {
            return repeatCount + 1;
        }
        else
        {
            if (endDate <= blockDate) return 1;
            var diffDays = (endDate.Date - blockDate.Date).Days;
            return recurringPattern switch
            {
                "Hari" => diffDays + 1,
                "Minggu" => (diffDays / 7) + 1,
                "Bulan" => Math.Max(1, ((endDate.Year - blockDate.Year) * 12 + endDate.Month - blockDate.Month) + 1),
                _ => 1
            };
        }
    }

    private string GetEndDateDisplay()
    {
        if (endMode == "date")
        {
            return endDate.ToString("dd MMMM yyyy");
        }
        else
        {
            var calculatedEnd = recurringPattern switch
            {
                "Hari" => blockDate.AddDays(repeatCount),
                "Minggu" => blockDate.AddDays(repeatCount * 7),
                "Bulan" => blockDate.AddMonths(repeatCount),
                _ => blockDate.AddDays(repeatCount * 7)
            };
            return calculatedEnd.ToString("dd MMMM yyyy");
        }
    }

    private Room? currentSelectedRoom => availableRooms.FirstOrDefault(r => r.Id == selectedRoomId);

    protected override async Task OnInitializedAsync()
    {
        await LoadRooms();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !availableRooms.Any())
        {
            await LoadRooms();
        }
    }

    private async Task LoadRooms()
    {
        availableRooms = await RoomService.GetAllRoomsAsync();
        if (availableRooms.Any() && !availableRooms.Any(r => r.Id == selectedRoomId))
        {
            selectedRoomId = availableRooms.First().Id;
        }
    }

    private async Task ConfirmBlock()
    {
        hasSubmitted = true;
        if (selectedReason == "Lainnya" && string.IsNullOrWhiteSpace(notes))
        {
            Toast.Error("Kolom catatan wajib diisi ketika memilih alasan 'Lainnya'.");
            return;
        }

        var room = availableRooms.FirstOrDefault(r => r.Id == selectedRoomId);
        var roomName = room?.Name ?? "Ruangan";
        var totalSessions = GetTotalSessions();

        if (isRecurring)
        {
            Toast.Success($"Jadwal {roomName} berhasil diblokir sebanyak {totalSessions} sesi untuk {selectedReason}.");
        }
        else
        {
            Toast.Success($"Jadwal {roomName} berhasil diblokir untuk {selectedReason}.");
        }
        
        await OnBlockCreated.InvokeAsync();
        await Close();
    }

    private async Task Close()
    {
        hasSubmitted = false;
        notes = "";
        selectedReason = "Pemeliharaan";
        isRecurring = false;
        endMode = "count";
        repeatCount = 3;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
