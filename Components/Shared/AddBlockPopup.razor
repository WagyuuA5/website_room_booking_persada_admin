@namespace booking_room_admin.Components.Shared

<AppModal IsOpen="@IsOpen" IsOpenChanged="IsOpenChanged" Title="Tambah Blokir" Size="medium">
    <ChildContent>
        <div class="ab-form">
            <div class="ab-field">
                <label>Ruangan</label>
                <select class="ab-input">
                    <option>Ruang Diskusi A</option>
                    <option>Ruang Meeting B</option>
                </select>
            </div>
            <div class="ab-row">
                <div class="ab-field">
                    <label>Tanggal</label>
                    <input type="date" class="ab-input" />
                </div>
                <div class="ab-field">
                    <label>Rentang Waktu</label>
                    <div class="ab-time-range">
                        <input type="time" class="ab-input" />
                        <span>-</span>
                        <input type="time" class="ab-input" />
                    </div>
                </div>
            </div>
            <div class="ab-field">
                <label>Alasan</label>
                <select class="ab-input">
                    <option>Pemeliharaan</option>
                    <option>Acara Internal</option>
                    <option>Lainnya</option>
                </select>
            </div>
            <div class="ab-field">
                <label>Catatan</label>
                <textarea class="ab-textarea" rows="3" placeholder="Masukkan detail alasan..."></textarea>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn-outline" @onclick="Close">Batal</button>
        <button class="btn-primary" @onclick="Close">Blokir Jadwal</button>
    </FooterContent>
</AppModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
