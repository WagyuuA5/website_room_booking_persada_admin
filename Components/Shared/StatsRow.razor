@using booking_room_admin.Components.Models

<div class="stats-row">
    @foreach (var stat in Stats)
    {
        var variant = GetVariant(stat);
        <StatCard Label="@stat.Label"
                  Value="@stat.Value"
                  Icon="@GetIconName(stat.Icon)"
                  Variant="@variant"
                  Trend="@FormatTrend(stat)"
                  IsPositiveTrend="@stat.IsPositiveTrend"
                  Subtitle="@stat.Subtitle" />
    }
</div>

@code {
    [Parameter] public List<StatItem> Stats { get; set; } = new();

    private string GetVariant(StatItem stat)
    {
        var label = stat.Label.ToLowerInvariant();
        var icon = stat.Icon.ToLowerInvariant();

        if (label.Contains("setuju") || label.Contains("selesai") || icon.Contains("check"))
            return "success";
        if (label.Contains("tolak") || label.Contains("kritis") || label.Contains("bug") || label.Contains("belum") || icon.Contains("x.svg") || icon.Contains("alert"))
            return "danger";
        if (label.Contains("tunggu") || label.Contains("durasi") || label.Contains("waktu") || icon.Contains("clock"))
            return "info";
        if (label.Contains("katering") || label.Contains("terpopuler") || icon.Contains("coffee"))
            return "warning";
        
        return "accent";
    }

    private string? FormatTrend(StatItem stat)
    {
        if (string.IsNullOrWhiteSpace(stat.Trend)) return null;
        var prefix = stat.IsPositiveTrend == true ? "↑ " : stat.IsPositiveTrend == false ? "↓ " : "";
        return $"{prefix}{stat.Trend}";
    }

    private string GetIconName(string iconPath) => iconPath switch
    {
        var s when s.Contains("check") => "check",
        var s when s.Contains("clock") => "clock",
        var s when s.Contains("x.svg") => "x",
        var s when s.Contains("coffee") => "coffee",
        var s when s.Contains("icon_1_admin") => "layers",
        var s when s.Contains("icon_2_admin") => "users",
        var s when s.Contains("icon_3_admin") => "activity",
        var s when s.Contains("icon_4_admin") => "calendar",
        var s when s.Contains("icon_9_admin") => "help-circle",
        var s when s.Contains("icon_10_admin") => "alert-circle",
        var s when s.Contains("icon_14_admin") => "tool",
        _ => "bar-chart-2"
    };
}