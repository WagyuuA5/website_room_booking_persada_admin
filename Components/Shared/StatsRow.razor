@using booking_room_admin.Components.Models

<div class="stats-row">
    @foreach (var stat in Stats)
    {
        <div class="stat-card">
            <div class="stat-icon">
                <Icon Name="@GetIconName(stat.Icon)" Size="22" />
            </div>
            <div class="stat-info">
                <span class="stat-label">@stat.Label</span>
                <div class="stat-val-row" style="display: flex; align-items: baseline; gap: 8px;">
                    <span class="stat-value">@stat.Value</span>
                    @if (!string.IsNullOrEmpty(stat.Trend))
                    {
                        <span class="stat-trend @(stat.IsPositiveTrend == true ? "trend-up" : stat.IsPositiveTrend == false ? "trend-down" : "")" style="font-size: 0.72rem; font-weight: 700; color: @(stat.IsPositiveTrend == true ? "#16A34A" : "#DC2626");">
                            @(stat.IsPositiveTrend == true ? "↑ " : stat.IsPositiveTrend == false ? "↓ " : "")@stat.Trend
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(stat.Subtitle))
                {
                    <span class="stat-subtitle">@stat.Subtitle</span>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<StatItem> Stats { get; set; } = new();

    private string GetIconName(string iconPath) => iconPath switch
    {
        var s when s.Contains("check") => "check",
        var s when s.Contains("clock") => "clock",
        var s when s.Contains("x.svg") => "x",
        var s when s.Contains("coffee") => "coffee",
        var s when s.Contains("icon_1_admin") => "building",
        var s when s.Contains("icon_2_admin") => "users",
        var s when s.Contains("icon_3_admin") => "activity",
        var s when s.Contains("icon_4_admin") => "calendar",
        var s when s.Contains("icon_9_admin") => "key",
        var s when s.Contains("icon_10_admin") => "alert-triangle",
        var s when s.Contains("icon_14_admin") => "edit",
        _ => "bar-chart"
    };
}