@using booking_room_admin.Components.Models

<div class="popup-overlay @(IsOpen ? "open" : "")" @onclick="Close">
    <div class="popup-card reset-pw-card" @onclick:stopPropagation="true">
        <div class="rp-header">
            <div>
                <h2 class="rp-title">Reset Kata Sandi User</h2>
                <p class="rp-subtitle">Perbarui kredensial untuk akun user yang dipilih.</p>
            </div>
        </div>

        @if (User != null)
        {
            <div class="rp-user-card">
                <div class="rp-user-avatar">@User.Initials</div>
                <div class="rp-user-info">
                    <div class="rp-user-name">@User.FullName</div>
                    <div class="rp-user-email">@User.Email</div>
                </div>
                <Icon Name="key" Size="18" />
            </div>
        }

        <div class="rp-body">
            <div class="rp-field">
                <label class="rp-label">Kata Sandi Baru</label>
                <div class="rp-password-row">
                    <input type="@(showPassword ? "text" : "password")" class="rp-input" @bind="newPassword" />
                    <button class="rp-toggle" @onclick="TogglePassword">
                        <Icon Name="eye" Size="16" />
                    </button>
                </div>
            </div>
            <div class="rp-field">
                <label class="rp-label">Konfirmasi Kata Sandi Baru</label>
                <div class="rp-password-row">
                    <input type="@(showConfirmPassword ? "text" : "password")" class="rp-input" @bind="confirmPassword" />
                    <button class="rp-toggle" @onclick="ToggleConfirmPassword">
                        <Icon Name="eye" Size="16" />
                    </button>
                </div>
            </div>
            <label class="rp-checkbox-label">
                <input type="checkbox" @bind="generateRandom" />
                <span class="rp-checkbox-text">Buat Kata Sandi Acak</span>
            </label>
            <label class="rp-checkbox-label">
                <input type="checkbox" @bind="forceChange" />
                <span class="rp-checkbox-text">Paksa user ganti kata sandi di login berikutnya</span>
            </label>
        </div>

        <div class="rp-footer">
            <button class="btn-outline-pill" @onclick="Close">Batal</button>
            <button class="btn-primary-pill btn-yellow" disabled="@(!IsValid())" @onclick="UpdatePassword">Perbarui Kata Sandi</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public User? User { get; set; }
    [Parameter] public EventCallback<User> OnPasswordUpdated { get; set; }

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool generateRandom = false;
    private bool forceChange = true;

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(newPassword) && newPassword == confirmPassword;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPassword()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    protected override void OnInitialized()
    {
        if (generateRandom)
        {
            newPassword = GenerateRandomPassword(10);
            confirmPassword = newPassword;
        }
    }

    private void UpdatePassword()
    {
        if (User != null && IsValid())
        {
            OnPasswordUpdated.InvokeAsync(User);
            Close();
        }
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        generateRandom = false;
        forceChange = true;
    }

    private string GenerateRandomPassword(int length)
    {
        const string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, length).Select(s => s[random.Next(s.Length)]).ToArray());
    }
}