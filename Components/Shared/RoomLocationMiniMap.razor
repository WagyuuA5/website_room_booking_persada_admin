@namespace booking_room_admin.Components.Shared
@using booking_room_admin.Components.Models
@inject IJSRuntime JS

<div class="mini-map-container @CssClass">
    <div class="mini-map-header">
        <div class="mini-map-title">
            <Icon Name="map-pin" Size="14" />
            <span>@LocationText</span>
        </div>
        @if (ShowZoomButton)
        {
            <button type="button" class="mini-map-zoom-btn" @onclick="OpenLightbox" title="Perbesar Denah Lokasi">
                <Icon Name="eye" Size="13" />
                <span>Lihat Denah Penuh</span>
            </button>
        }
    </div>

    <div class="mini-map-canvas" id="@canvasId" @onclick="HandleMapClick">
        <div class="floorplan-layout-bg">
            <div class="layout-zone zone-left"><span>Sayap Barat</span></div>
            <div class="layout-zone zone-center"><span>Lobby & Lift Utama</span></div>
            <div class="layout-zone zone-right"><span>Sayap Timur</span></div>
            
            @* Highlighted Active Pin *@
            <div class="active-room-marker" style="left: @($"{PinX}%"); top: @($"{PinY}%");">
                <div class="marker-pulse"></div>
                <div class="marker-pin">
                    <Icon Name="map-pin" Size="14" />
                </div>
                <span class="marker-label">@RoomName</span>
            </div>
        </div>
    </div>
</div>

@* Lightbox Modal Denah Penuh *@
@if (showLightbox)
{
    <AppModal IsOpen="true" IsOpenChanged="@(async (bool v) => { if (!v) await CloseLightbox(); })" Title="@($"Denah Lokasi Multi-Lantai")" Size="large">
        <ChildContent>
            <div class="lightbox-map-content">
                <div class="lightbox-map-header-info">
                    <div class="lbm-meta">
                        <strong>@RoomName</strong>
                        <span>@LocationText</span>
                    </div>
                    <span class="lbm-hint">Transisi antar lantai (Overlapping Sections & Velocity Scroll)</span>
                </div>
                <div id="lightbox-map-view" class="lightbox-map-view">
                    <div class="scroll-content-wrapper anim-velocity-skew">
                        
                        @* Lantai 1 *@
                        <div class="anim-overlap-section">
                            <div class="anim-overlap-inner">
                                <div class="floor-badge">Lantai 1</div>
                                <div class="floorplan-layout-bg large">
                                    <div class="layout-zone zone-left"><span>Resepsionis</span></div>
                                    <div class="layout-zone zone-center"><span>Lobby Utama</span></div>
                                    <div class="layout-zone zone-right"><span>Auditorium</span></div>
                                </div>
                            </div>
                        </div>

                        @* Lantai 2 (Active Floor) *@
                        <div class="anim-overlap-section">
                            <div class="anim-overlap-inner">
                                <div class="floor-badge">Lantai 2 (Lokasi Ruangan)</div>
                                <div class="floorplan-layout-bg large">
                                    <div class="layout-zone zone-left"><span>Sayap Barat (Meeting)</span></div>
                                    <div class="layout-zone zone-center"><span>Lobby Tengah</span></div>
                                    <div class="layout-zone zone-right"><span>Sayap Timur (VIP)</span></div>
                                    
                                    <div class="active-room-marker large" style="left: @($"{PinX}%"); top: @($"{PinY}%");">
                                        <div class="marker-pulse"></div>
                                        <div class="marker-pin">
                                            <Icon Name="map-pin" Size="18" />
                                        </div>
                                        <span class="marker-label">@RoomName</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Lantai 3 *@
                        <div class="anim-overlap-section">
                            <div class="anim-overlap-inner">
                                <div class="floor-badge">Lantai 3</div>
                                <div class="floorplan-layout-bg large">
                                    <div class="layout-zone zone-left"><span>Area Direksi</span></div>
                                    <div class="layout-zone zone-center"><span>Lobby Eksekutif</span></div>
                                    <div class="layout-zone zone-right"><span>Ruang Rapat Tertutup</span></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn-outline-pill" @onclick="CloseLightbox">Tutup</button>
        </FooterContent>
    </AppModal>
}

@code {
    private readonly string canvasId = "minimap-" + Guid.NewGuid().ToString("N");

    [Parameter] public string RoomName { get; set; } = "Ruang Rapat";
    [Parameter] public string LocationText { get; set; } = "Lantai 2, Gedung Pusat";
    [Parameter] public double PinX { get; set; } = 50.0;
    [Parameter] public EventCallback<double> PinXChanged { get; set; }
    [Parameter] public double PinY { get; set; } = 50.0;
    [Parameter] public EventCallback<double> PinYChanged { get; set; }
    [Parameter] public bool ShowZoomButton { get; set; } = true;
    [Parameter] public bool IsEditable { get; set; } = false;
    [Parameter] public EventCallback<string> OnLocationAutoGenerated { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool showLightbox = false;

    private async Task HandleMapClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (IsEditable)
        {
            var coords = await JS.InvokeAsync<double[]>("getClickPercentage", canvasId, e.ClientX, e.ClientY);
            if (coords != null && coords.Length == 2)
            {
                PinX = coords[0];
                PinY = coords[1];
                await PinXChanged.InvokeAsync(PinX);
                await PinYChanged.InvokeAsync(PinY);
                
                string newLoc = GenerateLocationText(PinX, PinY);
                await OnLocationAutoGenerated.InvokeAsync(newLoc);
            }
        }
        else if (ShowZoomButton)
        {
            await OpenLightbox();
        }
    }

    private string GenerateLocationText(double x, double y)
    {
        string wing = "Lobby Utama";
        if (x < 33) wing = "Sayap Barat";
        else if (x > 66) wing = "Sayap Timur";
        
        string area = "Tengah";
        if (y < 33) area = "Utara";
        else if (y > 66) area = "Selatan";
        
        return $"Lantai 1, {wing} ({area})";
    }

    private async Task OpenLightbox()
    {
        showLightbox = true;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("window.ScrollAnimations.init", "#lightbox-map-view");
    }

    private async Task CloseLightbox()
    {
        await JS.InvokeVoidAsync("window.ScrollAnimations.destroy");
        showLightbox = false;
    }
}
