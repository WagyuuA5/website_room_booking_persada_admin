@namespace booking_room_admin.Components.Shared

<span class="status-badge @GetBadgeClass()" @attributes="AdditionalAttributes">@GetLabel()</span>

@code {
    /// <summary>Status key: pending, approved, confirmed, rejected, preparing, fulfilled, ready, active, inactive, baru, diproses, selesai, cancelled, declined, maintenance</summary>
    [Parameter] public string Status { get; set; } = "";

    /// <summary>Override label teks (jika null, pakai default mapping)</summary>
    [Parameter] public string? CustomLabel { get; set; }

    /// <summary>Alias untuk CustomLabel / Status</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Alias untuk Status / Type</summary>
    [Parameter] public string? Type { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectiveStatus => !string.IsNullOrEmpty(Status) ? Status : (!string.IsNullOrEmpty(Type) ? Type : (!string.IsNullOrEmpty(Text) ? Text : ""));

    private string GetLabel()
    {
        if (!string.IsNullOrEmpty(CustomLabel)) return CustomLabel;
        if (!string.IsNullOrEmpty(Text)) return Text;

        return EffectiveStatus.ToLowerInvariant() switch
        {
            "pending" or "menunggu" => "Menunggu",
            "approved" or "confirmed" or "disetujui" => "Disetujui",
            "rejected" or "rejected_admin" or "ditolak" => "Ditolak",
            "rejected_system" => "Ditolak Sistem",
            "declined" => "Ditolak",
            "preparing" or "diproses" => "Diproses",
            "fulfilled" or "selesai" => "Selesai",
            "ready" or "siap" => "Siap",
            "active" or "aktif" => "Aktif",
            "inactive" or "tidak aktif" => "Tidak Aktif",
            "baru" or "new" => "Baru",
            "cancelled" or "dibatalkan" => "Dibatalkan",
            "maintenance" or "perawatan" => "Dalam Perawatan",
            "overdue" or "terlambat" => "Terlambat",
            "tersedia" or "available" => "Tersedia",
            "diblokir" or "blocked" => "Diblokir",
            _ => EffectiveStatus
        };
    }

    private string GetBadgeClass()
    {
        return EffectiveStatus.ToLowerInvariant() switch
        {
            "baru" or "new" or "info" => "badge-info",
            "pending" or "menunggu" or "preparing" or "diproses" or "maintenance" or "perawatan" or "draft" => "badge-warning",
            "approved" or "confirmed" or "disetujui" or "active" or "aktif" or "selesai" or "fulfilled" or "ready" or "siap" or "tersedia" or "available" => "badge-success",
            "rejected" or "rejected_admin" or "rejected_system" or "declined" or "ditolak" or "cancelled" or "dibatalkan" or "overdue" or "terlambat" or "inactive" or "tidak aktif" or "diblokir" or "blocked" => "badge-danger",
            _ => "badge-neutral"
        };
    }
}
